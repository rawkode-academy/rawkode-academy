{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"jsx": "preserve",
		"allowJs": false,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": ["vue"]
	},
	"include": [
		"panda.config.ts",
		"src/**/*.ts",
		"src/**/*.vue",
		"styled-system/**/*.ts"
	],
	"exclude": ["dist", "node_modules"]
}
