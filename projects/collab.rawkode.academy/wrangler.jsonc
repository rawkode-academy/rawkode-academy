{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rawkode-academy-collab",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "routes": [
    { "pattern": "collaborate.rawkode.academy", "custom_domain": true },
    // The previous host. The middleware redirects it to collaborate.
    { "pattern": "collab.rawkode.academy", "custom_domain": true }
  ],
  "observability": {
    "redact_query_string": true,
    "traces": { "enabled": true, "destinations": ["grafana-traces"] },
    "logs": { "enabled": true, "invocation_logs": false, "destinations": ["grafana-logs"] }
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://collaborate.rawkode.academy",
    "OIDC_ISSUER": "https://id.rawkode.academy",
    "OIDC_CLIENT_ID": "rawkode-collab"
  },
  // Sign-in state and sessions. No ID: Wrangler creates the namespace on the
  // first deploy and reuses it afterwards.
  "kv_namespaces": [{ "binding": "SESSION" }],
  // Every portal read and write goes through the federated API.
  "services": [{ "binding": "GATEWAY", "service": "platform-api-gateway" }]
}
