---
import { academyShell } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";
import "../styles/global.css";
import { Font } from "astro:assets";
import wordmark from "../assets/wordmark.svg?raw";
import PortalMenu from "../components/PortalMenu.vue";
import type { Session } from "../lib/types.ts";

interface Props {
	title: string;
	session?: Session;
	orgs?: { id: string; name: string }[];
}
const { title, session, orgs = [] } = Astro.props;
const styles = academyShell();
const artwork = wordmark
	.replace(/<\?xml[^>]*\?>/g, "")
	.replace(/<!DOCTYPE[^>]*>/g, "")
	.replace('width="512"', 'width="396"')
	.replace('viewBox="0 0 512 128"', 'viewBox="58 0 396 128"');
const viewAs = session?.viewAs;
const viewingOrg = viewAs ? orgs.find((org) => org.id === viewAs.orgId) : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="color-scheme" content="light dark" />
		<title>{title} · Partner portal</title>
		<Font cssVariable="--font-red-hat-display" preload />
		<Font cssVariable="--font-red-hat-text" preload />
		<Font cssVariable="--font-red-hat-mono" />
	</head>
	<body>
		<div class={styles.root}>
			<a class={styles.skip} href="#main-content">Skip to main content</a>
			{viewAs && (
				<div class="viewing" role="status">
					<span>Viewing as <strong>{viewingOrg?.name ?? viewAs.orgId}</strong>. Read-only.</span>
					<form method="post" action="/view-as"><input type="hidden" name="target" value="" /><button class="quiet">Exit</button></form>
				</div>
			)}
			<header class={styles.header}>
				<div class={styles.nav}>
					<a href="/" class={styles.brand} aria-label="Partner portal home"><span class={styles.brandArt} aria-hidden="true" set:html={artwork} /></a>
					<nav class={styles.links} aria-label="Primary navigation">
						<a href="/" class={styles.link} aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Collaborations</a>
						<a href="/analytics" class={styles.link} aria-current={Astro.url.pathname === "/analytics" ? "page" : undefined}>Analytics</a>
					</nav>
					<div class={styles.actions}>
						{session && (
							<div class={styles.account}>
								<div class="account-controls">
									{session.principal.admin && !viewAs && orgs.length > 0 && (
										<form method="post" action="/view-as" class="view-as">
											<label class="visually-hidden" for="view-as">View as</label>
											<select id="view-as" name="target" onchange="this.form.requestSubmit()">
												<option value="">View as…</option>
												{orgs.map((org) => <option value={org.id}>{org.name}</option>)}
											</select>
										</form>
									)}
									<span class="who">{session.principal.name}</span>
									<form method="post" action="/logout"><button class="quiet">Sign out</button></form>
								</div>
							</div>
							<PortalMenu client:media="(max-width: 1023px)" name={session.principal.name} orgs={orgs} canViewAs={Boolean(session.principal.admin && !viewAs)} currentPath={Astro.url.pathname} />
						)}
					</div>
				</div>
			</header>
			<main id="main-content" class={styles.main} tabindex="-1"><slot /></main>
		</div>
	</body>
</html>

<style is:global>
	.gutter { padding-inline: var(--spacing-academy-gutter, clamp(20px, 4vw, 48px)); }
	input, select, textarea { font-size: 1rem; }
	button, summary, .quiet { min-height: 2.5rem; }
	.viewing { display: flex; gap: 1rem; align-items: center; justify-content: center; padding: 0.5rem 1rem; background: var(--colors-academy-accent); color: var(--colors-academy-accent-foreground); font-family: var(--fonts-academy-text); font-size: 0.875rem; }
	.viewing .quiet { color: inherit; border-color: currentColor; }
	.quiet { font: inherit; font-family: var(--fonts-academy-text); font-weight: 600; background: transparent; color: var(--colors-academy-text); border: 1px solid var(--colors-academy-border); border-radius: var(--radii-academy-s); padding: 0.375rem 0.75rem; cursor: pointer; }
	.quiet:hover { border-color: var(--colors-academy-accent); }
	.who { font-family: var(--fonts-academy-text); font-size: 0.875rem; color: var(--colors-academy-text-soft); }
	.view-as select { font: inherit; font-family: var(--fonts-academy-text); font-size: 0.875rem; background: var(--colors-academy-panel); color: var(--colors-academy-text); border: 1px solid var(--colors-academy-border); border-radius: var(--radii-academy-s); padding: 0.375rem 0.5rem; }
	.account-controls { display: flex; gap: 0.75rem; align-items: center; }
	.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
