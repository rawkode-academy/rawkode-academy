{
  // The pull-request preview: its own Worker on workers.dev with its own KV,
  // seeded with fictional organisations and a sample video. Nothing here
  // touches production data, and sign-in is a persona picker, not GitHub.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rawkode-academy-collab-preview",
  "main": "src/main.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PREVIEW": "true",
    "PUBLIC_ORIGIN": "",
    "OIDC_ISSUER": "https://id.rawkode.academy",
    "OIDC_CLIENT_ID": "rawkode-collab"
  },
  "kv_namespaces": [{ "binding": "STORE" }]
}
