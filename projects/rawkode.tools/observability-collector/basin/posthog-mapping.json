	"$comment": "PostHog event name -> CloudEvents source and type in analytics.events_legacy (issue #1634). basin/import-posthog.py fails on any name not listed here. A family's cutoff is the first instant Basin has that family; the import takes only events before it. A null cutoff skips the family until it is set.",
	"families": {
		"server": {
			"cutoff": "2026-11-07T00:00:00Z",
			"comment": "Server CloudEvents reach events_archive from 7 Nov 2026."
		},
		"browser": {
			"cutoff": "2026-11-13T00:00:00Z",
			"comment": "capture()/track() browser events reach events_archive from 13 Nov 2026."
		},
		"sdk": {
			"cutoff": "2026-11-24T16:14:00Z",
