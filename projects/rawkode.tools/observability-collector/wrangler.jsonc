{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rawkode-tools-observability-collector",
	"main": "./src/index.ts",
	"compatibility_date": "2025-04-05",
	"compatibility_flags": ["nodejs_compat"],
	"minify": true,
	"vars": {
		"POSTHOG_HOST": "https://eu.i.posthog.com",
		"GRAFANA_OTLP_HOST": "https://otlp-gateway-prod-gb-south-1.grafana.net/otlp",
		"GRAFANA_INSTANCE_ID": "1457812"
	},
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	},
	"placement": {
		"mode": "smart"
	},
	"workers_dev": true,
	// Basin stream `analytics_events`, created by infrastructure.cue. Its only
	// column is a JSON `value`, so it is never replaced and this ID never changes.
	"pipelines": [
		{
			"binding": "EVENTS",
			"stream": "b04e490b37c44b7fb7026ff5818067e0"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DATA_BUFFER",
				"class_name": "DataBuffer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["DataBuffer"]
		}
	],
	"secrets_store_secrets": [
		{
			"binding": "POSTHOG_PROJECT_TOKEN",
			"store_id": "492e5e40b9d64ebeac7e7a77db91ff6e",
			"secret_name": "POSTHOG_PROJECT_TOKEN"
		},
		{
			"binding": "GRAFANA_OTLP_TOKEN",
			"store_id": "492e5e40b9d64ebeac7e7a77db91ff6e",
			"secret_name": "grafana-cloud-otlp-write"
		}
	]
}
