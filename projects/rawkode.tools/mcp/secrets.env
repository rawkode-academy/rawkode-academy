# Names of the Worker secrets the deploy task uploads with `wrangler deploy
# --secrets-file`. Values come from the process environment, which cuenv fills
# from Infisical (/projects/basin). This file holds no secret values.
BASIN_SQL_TOKEN=${BASIN_SQL_TOKEN}
MCP_GOOGLE_CLIENT_ID=${MCP_GOOGLE_CLIENT_ID}
MCP_GOOGLE_CLIENT_SECRET=${MCP_GOOGLE_CLIENT_SECRET}
MCP_OWNER_GOOGLE_SUB=${MCP_OWNER_GOOGLE_SUB}
