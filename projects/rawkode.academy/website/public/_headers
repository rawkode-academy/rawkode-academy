/courses/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin

/embed/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin

/opensearch.xml
  Content-Type: application/opensearchdescription+xml; charset=utf-8

# Feed MIME fallback mappings. The `/api/feeds/*` endpoints are SSR routes that
# set their own `Content-Type` headers via `new Response(..., { headers })`;
# these rules remain as static-asset fallback mappings so registered feed MIME
# types are preserved if any feed artifact is ever served statically:
#   - application/rss+xml for RSS 2.0
#   - application/feed+json for JSON Feed 1.1
# Atom feeds use the .atom extension and map to application/atom+xml by default.
/api/feeds/*.xml
  Content-Type: application/rss+xml; charset=utf-8

/api/feeds/*.json
  Content-Type: application/feed+json; charset=utf-8

/api/feeds/shows/*.xml
  Content-Type: application/rss+xml; charset=utf-8

/api/feeds/technology/*.xml
  Content-Type: application/rss+xml; charset=utf-8

/api/feeds/people/*.xml
  Content-Type: application/rss+xml; charset=utf-8