		"@astrojs/react": "7.1.1",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/ts-plugin": "1.10.12",
		"@astrojs/vue": "7.1.2",
		"@expressive-code/core": "0.44.3",
		"@expressive-code/plugin-frames": "0.44.3",
