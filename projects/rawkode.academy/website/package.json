{
	"name": "website",
	"type": "module",
	"scripts": {
		"build-storybook": "storybook build",
		"build": "bun run check:academy-shell && cd ../../../packages/design-system && bun run build && cd ../../projects/rawkode.academy/website && bun run check:academy-interactions && bun run check:academy-ssr && astro check && astro build",
		"dev": "astro dev",
		"format": "biome format --write",
		"preview": "astro preview",
		"check:academy-interactions": "vitest run src/tests/webcontainer.test.ts src/tests/command-palette.test.ts src/tests/theme.test.ts src/lib/games/guess-the-logo.test.ts src/lib/games/guess-the-logo-achievements.test.ts",
		"check:academy-shell": "node --test scripts/academy-source.test.mjs && node scripts/check-academy-shell.mjs",
		"check:academy-ssr": "node --experimental-vm-modules --import tsx --test src/tests/*.test.mjs",
		"start": "astro dev",
		"storybook": "storybook dev -p 6006",
		"test:seo": "vitest run src/tests/seo.test.ts",
		"test:performance": "vitest run src/tests/performance.test.ts src/tests/components/skeleton.spec.ts",
		"test:watch": "vitest",
		"test": "vitest run",
		"validate:seo": "bun scripts/validate-seo.ts",
		"check:sitemap": "bun scripts/check-sitemap.ts --base https://rawkode.academy --limit 400 --concurrency 10",
		"check:orphans": "bun scripts/orphan-check.ts --base https://rawkode.academy --maxDepth 3 --limit 1000",
		"check:cwv": "bun scripts/check-cwv.ts --base https://rawkode.academy",
		"knip": "knip"
	},
	"dependencies": {
		"@ark-ui/vue": "5.39.2",
		"@astrojs/check": "0.9.12",
		"@astrojs/cloudflare": "14.4.2",
