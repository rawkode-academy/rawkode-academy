{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rawkode-academy-review",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist-review"
  },
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    {
      "pattern": "preview.rawkode.academy",
      "custom_domain": true
    }
  ],
  "vars": {
    "REVIEW_ORIGIN": "https://preview.rawkode.academy"
  },
  "services": [
    {
      "binding": "PAYLOAD_CONTENT",
      "service": "rawkode-academy-payload",
      "entrypoint": "PublicContentBridge"
    },
    {
      "binding": "REVIEW_BACKEND",
      "service": "rawkode-academy-payload",
      "entrypoint": "ReviewBridge"
    }
  ]
}
