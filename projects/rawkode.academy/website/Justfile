@default:
	just --list

dev:
	bun run dev

format:
	nixfmt .
	bun run format

build:
	bun run build

test:
	bun run test

test-with-logs:
	bun run test --reporter=default --no-file-parallelism --disable-console-intercept

deploy:
	#!/usr/bin/env bash
	dagger call deploy --git-head $(git rev-parse --abbrev-ref HEAD) --cloudflare-api-token op://sa.rawkode.academy/cloudflare/password

preview:
	bun run preview

# Invalidate content caches (KV generation + CDN tags) through the website.
# Usage: just invalidate-content '{"tags":["videos:<id>"]}'  or  just invalidate-content '{"all":true}'
invalidate-content body='{"all":true}':
	#!/usr/bin/env bash
	set -euo pipefail
	curl -sS --fail-with-body -XPOST "https://rawkode.academy/api/cache/invalidate" \
		-H "Authorization: Bearer $CACHE_INVALIDATION_TOKEN" \
		-H "Content-Type: application/json" \
		-d '{{body}}'
