---
export const prerender = false;

import TopicHub from "@/components/technology/TopicHub.astro";
import NewsletterCTA from "@/components/newsletter/NewsletterCTA.astro";
import BreadcrumbJsonLd from "@/components/breadcrumb/BreadcrumbJsonLd.astro";
import RichText from "@/components/content/RichText.astro";
import Page from "@/wrappers/page.astro";
import TechnologyJsonLd from "@/components/html/technology-jsonld.astro";
import TechnologyArticleJsonLd from "@/components/html/technology-article-jsonld.astro";
import {
	getCollection,
	getEntry,
	optionalContent,
	renderEntry,
	setContentCache,
	type TechnologyData,
} from "@/lib/live-content";
import { resolveTechnologyIconUrl } from "@/utils/resolve-technology-icon";
import { normalizeTechnologyReferences } from "@/utils/normalize-technology-refs";
import { getVideoThumbnailUrl } from "@/lib/video-thumbnail";
import { isNewsPublished } from "@/lib/news-publication";
import { academyTechnology } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";
import { localTime } from "@/lib/local-time";

export interface Technology extends Omit<TechnologyData, "logos" | "body"> {
	id: string;
	logo?: string | undefined;
	videos?:
		| {
				id: string;
				title: string;
				thumbnailUrl: string;
				slug: string;
				publishedAt: Date | string;
		  }[]
		| undefined;
	videoCount?: number;
	articleCount?: number;
}

const id = Astro.params.id as string;
// getEntry loads the profile body (the list omits it) and normalises "/index".
const technologyEntry = id ? await getEntry("technologies", id) : undefined;
if (!technologyEntry) {
	return new Response(null, { status: 404 });
}

// The profile is the page; the video rails, related technologies and topic
// hub are optional and render nothing when the content layer is down.
const [items, allVideos] = await Promise.all([
	optionalContent(getCollection("technologies"), []),
	optionalContent(getCollection("videos"), []),
]);

const now = new Date();
// Published recordings about this technology, most recent first.
const technologyVideos = allVideos
	.filter(
		({ data }) =>
			data.publishedAt <= now &&
			normalizeTechnologyReferences(data.technologies).includes(technologyEntry.id),
	)
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const hasContent = technologyEntry.body.trim().length > 0;
const profileHtml = hasContent ? (await renderEntry(technologyEntry)).html : "";

const e = technologyEntry;
const technology: Technology = {
	id: e.id,
	name: e.data.name,
	seo: e.data.seo,
	documentation: e.data.documentation,
	website: e.data.website,
	source: e.data.source,
	aliases: e.data.aliases,
	terms: e.data.terms,
	relatedTechnologies: e.data.relatedTechnologies,
	license: e.data.license,
	category: e.data.category,
	subcategory: e.data.subcategory,
	status: e.data.status,
	logo: resolveTechnologyIconUrl(e.id, e.data.logos) ?? undefined,
	videos: technologyVideos.map((video) => ({
		id: video.data.id,
		title: video.data.title,
		thumbnailUrl: getVideoThumbnailUrl(video.data.id),
		slug: video.data.slug,
		duration: video.data.duration,
		publishedAt: video.data.publishedAt,
		type: video.data.type,
	})),
	matrix: e.data.matrix,
	cncf: e.data.cncf,
	community: e.data.community,
};

const videoCount = technology.videos?.length ?? 0;
const featuredVideos = (technology.videos ?? []).slice(0, 4);
const categoryLabel =
	technology.subcategory ?? technology.category ?? "Cloud Native";

// Build the "Related technologies" rail. Prefer explicit relatedTechnologies
// from frontmatter, then fall back to siblings in the same subcategory.
const RELATED_TECH_LIMIT = 6;
const explicitRelated = technology.relatedTechnologies ?? [];

const allTechItems = items;
const techById = new Map(allTechItems.map((t) => [t.id, t]));

const explicitMatches = explicitRelated
	.map((relId) => techById.get(relId))
	.filter((t): t is (typeof allTechItems)[number] => Boolean(t));

let siblingMatches: typeof allTechItems = [];
if (technology.category && technology.subcategory) {
	siblingMatches = allTechItems.filter(
		(t) =>
			t.id !== id &&
			!explicitMatches.some((e) => e.id === t.id) &&
			t.data.category === technology.category &&
			t.data.subcategory === technology.subcategory,
	);
}

const relatedTechSeed = [...explicitMatches, ...siblingMatches];
const relatedTechnologies = relatedTechSeed
	.slice(0, RELATED_TECH_LIMIT)
	.map((entry) => ({
		id: entry.id,
		name: entry.data.name,
		logoUrl: resolveTechnologyIconUrl(entry.id, entry.data.logos) ?? undefined,
		subcategory: entry.data.subcategory,
		status: entry.data.status,
	}));
const firstRelatedSubcategory = relatedTechnologies[0]?.subcategory?.trim();
const sharedRelatedSubcategory = firstRelatedSubcategory &&
	relatedTechnologies.every((related) => related.subcategory?.trim() === firstRelatedSubcategory)
		? firstRelatedSubcategory : undefined;
const relatedInitials = (name: string) => {
	const words = name.trim().split(/[\s-]+/u);
	return (words.length > 1
		? words.slice(0, 2).map((word) => Array.from(word)[0]).join("")
		: Array.from(name).slice(0, 2).join("")
	).toUpperCase();
};

const seoTitle =
	technology.seo?.title ??
	(videoCount > 0
		? `${technology.name} Tutorials, Videos & Guides`
		: `${technology.name} - ${categoryLabel}`);

const cncfStatusLabel = (() => {
	const status = (technology as any).cncf?.status as string | undefined;
	if (!status) return undefined;
	const labels: Record<string, string> = {
		sandbox: "CNCF Sandbox",
		incubating: "CNCF Incubating",
		graduated: "CNCF Graduated",
		archived: "CNCF Archived",
	};
	return labels[status] ?? `CNCF ${status}`;
})();

const seoDescription = (() => {
	if (technology.seo?.description) return technology.seo.description;
	const parts: string[] = [];
	const projectQualifier = cncfStatusLabel
		? `a ${cncfStatusLabel} ${categoryLabel} project`
		: `a ${categoryLabel} project`;
	if (videoCount > 0) {
		parts.push(
			`${videoCount} video${videoCount === 1 ? "" : "s"} and tutorials covering ${technology.name}, ${projectQualifier}`,
		);
	} else {
		parts.push(`${technology.name}, ${projectQualifier}`);
	}
	parts.push(
		`Watch tutorials, live coding, and interviews from Rawkode Academy.`,
	);
	return parts.join(". ");
})();

// Page is "thin" if it has no MDX body content AND no associated videos.
// noindex these so Google doesn't classify the site as low-quality.
const noindex = !hasContent && videoCount === 0;
const styles = academyTechnology();

const technologyUrl = new URL(
	`/technology/${technology.id}`,
	Astro.site,
).href;
const absoluteLogo = technology.logo
	? technology.logo.startsWith("http")
		? technology.logo
		: new URL(technology.logo, Astro.site).href
	: undefined;
const technologyKeywords = [
	technology.name,
	technology.category,
	technology.subcategory,
	cncfStatusLabel,
	...(technology.aliases ?? []),
	...(technology.terms ?? []),
]
	.filter((v): v is string => Boolean(v))
	.filter((value, index, values) => values.indexOf(value) === index);

// Status display helpers
const statusLabels: Record<string, string> = {
	skip: "Skip",
	watch: "Watch",
	explore: "Explore",
	learn: "Learn",
	adopt: "Adopt",
	advocate: "Advocate",
	graveyard: "Graveyard",
	"guilty-pleasure": "Guilty Pleasure",
	// Legacy values
	hold: "Skip",
	assess: "Watch",
	trial: "Explore",
};

const statusLabel = technology.matrix?.status
	? statusLabels[technology.matrix.status] ?? technology.matrix.status
	: undefined;
const description = technology.seo?.description?.trim();
const videoDate = (value: string | Date) =>
	localTime(value, { day: "numeric", month: "short", year: "numeric" }, "en-GB");
const historicalStatuses = new Set(["abandoned", "deprecated", "superseded"]);
const remainingVideos = (technology.videos ?? []).slice(featuredVideos.length);
const breadcrumbs = [
	{ title: "Home", link: "/" },
	{ title: "Technologies", link: "/technology" },
	{ title: technology.name, link: technologyUrl },
];
const metadata = [
	["Status", technology.status],
	["Category", technology.category],
	["Subcategory", technology.subcategory],
	["License", technology.license],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
const projectLinks = [
	["Official website", technology.website],
	["Documentation", technology.documentation],
	["Source code", technology.source],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
// Exact URLs only: a README fragment remains a distinct destination.
const officialLinks: Array<[string, string]> = [];
for (const [label, url] of projectLinks) {
	const existing = officialLinks.find((entry) => entry[1] === url);
	if (existing) existing[0] += ` / ${label}`;
	else officialLinks.push([label, url]);
}
const communityLabels: Record<string, string> = {
	twitter: "Twitter / X", youtube: "YouTube", slack: "Slack", discord: "Discord",
	blog: "Blog", mailingList: "Mailing list", githubDiscussions: "GitHub discussions", chat: "Chat",
};
const communityLinks = Object.entries(technology.community ?? {})
	.filter((entry): entry is [string, string] => Boolean(entry[1]))
	.map(([key, url]) => [communityLabels[key] ?? key, url]);
const cncfDates = [
	["Accepted", technology.cncf?.accepted],
	["Incubating", technology.cncf?.incubating],
	["Graduated", technology.cncf?.graduated],
	["Archived", technology.cncf?.archived],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
const cncfLinks = [
	["Developer statistics", technology.cncf?.devStatsUrl],
	["Annual review", technology.cncf?.annualReviewUrl],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
const confidenceLabels: Record<string, string> = {
	"deep-experience": "Deep experience", "some-experience": "Some experience", gut: "Gut feeling",
};
const matrixMetadata = [
	["First used", technology.matrix?.firstUsed],
	["Last used", technology.matrix?.lastUsed],
	["Confidence", technology.matrix?.confidence && confidenceLabels[technology.matrix.confidence]],
	["Trajectory", technology.matrix?.trajectory],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
const hasMatrixDetails = Boolean(
	technology.matrix?.why || technology.matrix?.spicyTake ||
	technology.matrix?.makesMeFeel,
);

// Mirror TopicHub's matching rules so its generic empty state cannot contradict
// the profile or videos already displayed here.
const normalizedTechnologyId = technology.id.replace(/\/index$/, "");
const matchesTechnology = (
	references: ReadonlyArray<string | { id: string }> | undefined,
) =>
	Array.isArray(references) && references.some((reference) => {
		const id = typeof reference === "string" ? reference : reference.id;
		return id.replace(/\/index$/, "") === normalizedTechnologyId;
	});
const [articles, news, learningPaths] = await Promise.all([
	optionalContent(getCollection("articles"), []),
	optionalContent(getCollection("news"), []),
	optionalContent(getCollection("learningPaths"), []),
]);
const hasTopicContent =
	articles.some(({ data }) => data.publishedAt <= now && matchesTechnology(data.technologies)) ||
	news.some(({ data }) => isNewsPublished(data.publishedAt, now) && matchesTechnology(data.technologies)) ||
	learningPaths.some(({ data }) => data.publishedAt <= now && matchesTechnology(data.technologies));
const hasAside = videoCount > 0 || hasMatrixDetails ||
	Boolean(technology.cncf?.status) || cncfDates.length > 0 || cncfLinks.length > 0 || communityLinks.length > 0;

// TopicHub (articles, news, learning paths), the video rails and the related
// technologies rail all list collections, so their tags and schedules apply.
const relatedEntryIds = new Set(relatedTechnologies.map((related) => related.id));
await setContentCache(Astro, {
	entries: [
		technologyEntry,
		...technologyVideos,
		...items.filter((t) => relatedEntryIds.has(t.id)),
		...(hasTopicContent
			? [
					...articles.filter(({ data }) => matchesTechnology(data.technologies)),
					...news.filter(({ data }) => matchesTechnology(data.technologies)),
					...learningPaths.filter(({ data }) => matchesTechnology(data.technologies)),
				]
			: []),
	],
	collections: ["technologies", "videos", "articles", "news", "learningPaths"],
});
---

<Page
	title={seoTitle}
	description={seoDescription}
	noindex={noindex}
	useImageDirectly={Boolean(absoluteLogo)}
	image={absoluteLogo ? { image: new URL(absoluteLogo) } : undefined}
>
	<TechnologyJsonLd
		slot="extra-head"
		name={technology.name}
		url={technologyUrl}
		description={seoDescription}
		image={absoluteLogo}
		website={technology.website}
		source={technology.source}
		documentation={technology.documentation}
		category={technology.category ?? categoryLabel}
		subcategory={technology.subcategory}
		aliases={technology.aliases}
		terms={technology.terms}
		license={technology.license}
		cncfStatus={cncfStatusLabel}
		matrixStatus={statusLabel}
	/>
	{hasContent && (
		<TechnologyArticleJsonLd
			slot="extra-head"
			headline={technology.name}
			description={seoDescription}
			url={technologyUrl}
			image={absoluteLogo}
			about={technology.name}
			keywords={technologyKeywords.join(", ")}
		/>
	)}
	<BreadcrumbJsonLd slot="extra-head" elements={breadcrumbs} />
	<Fragment slot="extra-head">
		<link
			rel="alternate"
			type="application/rss+xml"
			title={"Rawkode Academy - " + technology.name + " (RSS)"}
			href={"/api/feeds/technology/" + normalizedTechnologyId + ".xml"}
		/>
	</Fragment>
	<div class={styles.root}>
		<header class={styles.hero}>
			<nav aria-label="Breadcrumb">
				<ol class={styles.breadcrumb}>
					{breadcrumbs.map((crumb, index) => (
						<li>
							{index > 0 && <span aria-hidden="true">/</span>}
							{index === breadcrumbs.length - 1
								? <span aria-current="page">{crumb.title}</span>
								: <a class={styles.link} href={crumb.link}>{crumb.title}</a>}
						</li>
					))}
				</ol>
			</nav>
			<div class={styles.identity}>
				{technology.logo && (
					<img src={technology.logo} alt="" width="64" height="64" class={styles.logo}
						onerror="this.hidden=true;" />
				)}
				<h1 class={styles.title}>{technology.name}</h1>
			</div>
			{description && <p class={styles.description}>{description}</p>}
			{metadata.length > 0 && (
				<dl class={styles.metadata}>
					{metadata.map(([label, value]) => (
						<div><dt>{label}</dt><dd>{value}</dd></div>
					))}
				</dl>
			)}
			{statusLabel && !hasMatrixDetails && (
				<div class={styles.personalRating}>
					<p class={styles.copy}>Rawkode’s personal rating: <a class={styles.link} href="/technology/matrix">{statusLabel}</a></p>
					{matrixMetadata.map(([label, value]) => <span class={styles.copy}>{label}: {value}</span>)}
				</div>
			)}
			{officialLinks.length > 0 && (
				<ul class={styles.actions} aria-label="Project links">
					{officialLinks.map(([label, url]) => (
						<li><a href={url} class={styles.link} target="_blank" rel="noopener noreferrer">{label}</a></li>
					))}
				</ul>
			)}
		</header>

		<div class={hasAside ? styles.columns : styles.reading}>
			{hasContent ? (
				<article id="complete-guide" class={styles.prose} aria-label={technology.name + " profile"}>
					<RichText html={profileHtml} />
				</article>
			) : (
				<section class={styles.section} aria-labelledby="overview-heading">
					<h2 id="overview-heading" class={styles.heading}>Overview</h2>
					<p class={styles.copy}>A written overview of {technology.name} is not available here.</p>
					{officialLinks.length > 0 && (
						<p class={styles.copy}>Explore the project links above for information from its maintainers.</p>
					)}
				</section>
			)}

			{hasAside && (
				<aside class={styles.aside} aria-label={technology.name + " videos and resources"}>
					{featuredVideos.length > 0 && (
						<section class={styles.section} aria-labelledby="videos-heading">
							<h2 id="videos-heading" class={styles.heading}>Related recordings</h2>
							<ul class={styles.list}>
								{featuredVideos.map((video) => (
									<li>
										<a href={"/watch/" + video.slug} class={styles.video}>
											<img src={video.thumbnailUrl} alt="" loading="lazy" width="480" height="270" />
											<span>{video.title}</span>
											<time class={styles.videoDate} {...videoDate(video.publishedAt).attrs}>{videoDate(video.publishedAt).text}</time>
										</a>
									</li>
								))}
							</ul>
							{remainingVideos.length > 0 && (
								<a href="#more-videos" class={styles.link}>More {technology.name} videos ({remainingVideos.length})</a>
							)}
						</section>
					)}
					{technology.matrix && hasMatrixDetails && (
						<section class={styles.section} aria-labelledby="matrix-heading">
							<h2 id="matrix-heading" class={styles.heading}>Rawkode’s take</h2>
							{statusLabel && <p class={styles.copy}>Personal rating: <a class={styles.link} href="/technology/matrix">{statusLabel}</a></p>}
							{technology.matrix.makesMeFeel && <p class={styles.copy}>Makes me feel: {technology.matrix.makesMeFeel}</p>}
							{technology.matrix.why && <p class={styles.copy}>{technology.matrix.why}</p>}
							{technology.matrix.spicyTake && <blockquote class={styles.quote}>{technology.matrix.spicyTake}</blockquote>}
							{matrixMetadata.length > 0 && (
								<dl class={styles.facts}>
									{matrixMetadata.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
								</dl>
							)}
						</section>
					)}
					{(cncfStatusLabel || cncfDates.length > 0 || cncfLinks.length > 0) && (
						<section class={styles.section} aria-labelledby="cncf-heading">
							<h2 id="cncf-heading" class={styles.heading}>Cloud Native Computing Foundation</h2>
							{cncfStatusLabel && <p class={styles.copy}>{cncfStatusLabel}</p>}
							{cncfDates.length > 0 && (
								<dl class={styles.facts}>
									{cncfDates.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
								</dl>
							)}
							{cncfLinks.length > 0 && (
								<ul class={styles.list}>
									{cncfLinks.map(([label, url]) => (
										<li><a href={url} class={styles.link} target="_blank" rel="noopener noreferrer">{label}</a></li>
									))}
								</ul>
							)}
						</section>
					)}
					{communityLinks.length > 0 && (
						<section class={styles.section} aria-labelledby="community-heading">
							<h2 id="community-heading" class={styles.heading}>Community</h2>
							<ul class={styles.list}>
								{communityLinks.map(([label, url]) => (
									<li><a href={url} class={styles.link} target="_blank" rel="noopener noreferrer">{label}</a></li>
								))}
							</ul>
						</section>
					)}
				</aside>
			)}
		</div>

		{remainingVideos.length > 0 && (
			<section id="more-videos" class={styles.ruledSection} aria-labelledby="more-videos-heading">
				<h2 id="more-videos-heading" class={styles.heading}>More {technology.name} videos</h2>
				<ul class={styles.videoGrid}>
					{remainingVideos.map((video) => (
						<li>
							<a href={"/watch/" + video.slug} class={styles.video}>
								<img src={video.thumbnailUrl} alt="" loading="lazy" width="480" height="270" />
								<span>{video.title}</span>
								<time class={styles.videoDate} {...videoDate(video.publishedAt).attrs}>{videoDate(video.publishedAt).text}</time>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}
		{hasTopicContent && (
			<section id="more-content" class={styles.ruledSection} aria-label={technology.name + " learning resources"}>
				<TopicHub technologyId={technology.id} technologyName={technology.name}
					videos={technology.videos ?? []} showVideos={false} />
			</section>
		)}
		{relatedTechnologies.length > 0 && (
			<section class={styles.ruledSection} aria-labelledby="related-heading">
				<h2 id="related-heading" class={styles.heading}>Related technologies</h2>
				{sharedRelatedSubcategory && <p class={styles.relatedContext}>{sharedRelatedSubcategory}</p>}
				<ul class={styles.relatedGrid}>
					{relatedTechnologies.map((related) => (
						<li>
							<a href={"/technology/" + related.id.replace(/\/index$/, "")} class={styles.related}>
								<span class={styles.relatedMark} aria-hidden="true">
									{related.logoUrl && <img class={styles.relatedImage} src={related.logoUrl} alt="" width="40" height="40" loading="lazy" onerror="this.hidden=true; this.nextElementSibling.hidden=false;" />}
									<span class={styles.relatedInitials} hidden={Boolean(related.logoUrl)}>{relatedInitials(related.name)}</span>
								</span>
								<span class={styles.relatedBody}>
									<span class={styles.relatedName}>{related.name}</span>
									{!sharedRelatedSubcategory && related.subcategory && <span class={styles.copy}>{related.subcategory}</span>}
									{historicalStatuses.has(related.status) && <span class={styles.copy}>Project status: {related.status}</span>}
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}
		<div class={styles.newsletter}>
			<NewsletterCTA server:defer audience={"technology:" + technology.id} pagePath={Astro.url.pathname}
				badge="Rawkode Academy publications" headline={"New Academy publications about " + technology.name}
				subtitle="Get an email when Rawkode Academy publishes something new about this topic. These are Academy publications, not project release or maintenance updates.">
				<p slot="fallback" class={styles.copy}>Email signup loads here. You can also <a class={styles.link} href="/settings">manage email preferences in account settings</a>.</p>
			</NewsletterCTA>
		</div>
	</div>
</Page>
