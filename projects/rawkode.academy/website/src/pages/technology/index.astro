---
export const prerender = true;

import AcademyCatalogMasthead from "@/components/academy/AcademyCatalogMasthead.astro";
import { academyCatalog, academyLayout } from "@rawkodeacademy/design-system";
import Page from "@/wrappers/page.astro";
import { getCollection } from "astro:content";
import { resolveTechnologyIconUrl } from "@/utils/resolve-technology-icon";
import { createLogger } from "@/lib/logger";

const logger = createLogger("technology");

type Technology = {
	id: string;
	name: string;
	logo?: string;
	category: string | undefined;
	subcategory: string | undefined;
	description: string | undefined;
	terms: string[];
};

let technologies: Technology[] = [];
try {
	const items = await getCollection("technologies");

	technologies = items
		.map((e) => {
			const logo = resolveTechnologyIconUrl(e.id, e.data.logos);

			const tech: Technology = {
				id: e.id,
				name: e.data.name,
				...(logo && { logo }),
				category: e.data.category,
				subcategory: e.data.subcategory,
				description: e.data.seo?.description,
				terms: [...(e.data.aliases ?? []), ...(e.data.terms ?? [])],
			};
			return tech;
		})
		.sort((a, b) => a.name.localeCompare(b.name));
} catch (error) {
	logger.error("Failed to load technologies from content collection", error);
}
const styles = academyLayout({ width: "wide" });
const catalog = academyCatalog();
---

<Page
	title="Cloud Native Technologies"
	description="Cloud native technologies with tutorials, articles, and reference material."
	pageType="CollectionPage"
>
	<div class={styles.root}>
		<AcademyCatalogMasthead kicker="Technology map" title="Technologies" description="Tools and platforms." />

		<section class={styles.section} aria-label="Technology search">
			<div class={styles.container}>
				<div class={styles.toolbar}>
					<label for="technology-search">Filter technologies</label>
					<input
						id="technology-search"
						type="search"
						placeholder="Name, category, or keyword"
						class={styles.input}
						autocomplete="off"
						aria-controls="technologies"
						aria-describedby="technology-count"
					/>
					<p id="technology-count" class={catalog.resultCount} role="status" aria-atomic="true">
						{technologies.length} {technologies.length === 1 ? "technology" : "technologies"}
					</p>
				</div>

				<div id="technologies" class={catalog.identityGrid}>
					{
						technologies.map((tech) => {
							const searchKeywords = [
								tech.name, tech.category, tech.subcategory, tech.description, ...tech.terms,
							].filter(Boolean).join(" ").toLowerCase();
							const words = tech.name.trim().split(/[\s-]+/u);
							const initials = (words.length > 1
								? words.slice(0, 2).map((word) => Array.from(word)[0]).join("")
								: Array.from(tech.name).slice(0, 2).join("")
							).toUpperCase();
							const category = [tech.category, tech.subcategory].filter(Boolean).join(" / ");

							return (
								<a
									href={`/technology/${tech.id}`}
									class={catalog.identity}
									data-keywords={searchKeywords}
									aria-labelledby={`technology-${tech.id}`}
								>
									<span class={catalog.identityMark} aria-hidden="true">
										<span class={catalog.identityInitials} hidden={Boolean(tech.logo)}>{initials}</span>
										{tech.logo && <img
											src={tech.logo}
											alt=""
											width="32"
											height="32"
											class={catalog.identityLogo}
											loading="lazy"
											onerror="this.previousElementSibling.hidden=false; this.remove();"
										/>}
									</span>
									<span class={catalog.identityBody}>
										<span id={`technology-${tech.id}`} class={catalog.identityTitle}>{tech.name}</span>
										{category && <span class={catalog.identityMeta}>{category}</span>}
										{tech.description && <span class={catalog.identityDescription}>{tech.description}</span>}
									</span>
									<span class={catalog.identityArrow} aria-hidden="true">→</span>
								</a>
							);
						})
					}
				</div>

				<div id="technology-empty-state" class={catalog.empty} hidden={technologies.length !== 0}>
					<h2>No technologies match your search</h2>
					<p>Try another name, category, or keyword.</p>
				</div>
			</div>
		</section>

		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const searchInput = document.getElementById("technology-search") as HTMLInputElement | null;
				const cards = Array.from(
					document.querySelectorAll<HTMLElement>("#technologies [data-keywords]"),
				);
				const emptyState = document.getElementById("technology-empty-state");
				const count = document.getElementById("technology-count");

				const applySearch = () => {
					const query = (searchInput?.value ?? "").trim().toLowerCase();
					let visible = 0;

					cards.forEach((card) => {
						const keywords = card.dataset.keywords ?? "";
						const matchesSearch = keywords.includes(query);

						card.hidden = !matchesSearch;
						if (matchesSearch) {
							visible += 1;
						}
					});

					if (count) {
						count.textContent = query
							? `${visible} of ${cards.length} technologies`
							: `${cards.length} ${cards.length === 1 ? "technology" : "technologies"}`;
					}

					if (emptyState) {
						emptyState.hidden = visible !== 0;
					}
				};

				searchInput?.addEventListener("input", applySearch);
				applySearch();
			});
		</script>
	</div>
</Page>
