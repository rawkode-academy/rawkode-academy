---
import { env } from "cloudflare:workers";
import { z } from "astro/zod";
import Page from "@/wrappers/page.astro";
import { createEmailId, createLearnerId } from "@/actions/newsletter";
import { createLogger } from "@/lib/logger";
import { academyForms, academyDocument } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

export const prerender = false;

const logger = createLogger("unsubscribe");
const user = Astro.locals.user;
const pagePath = Astro.url.pathname;
let email = Astro.url.searchParams.get("email") ?? "";
let scope: "account" | "email" =
	!user || Astro.url.searchParams.has("email") || Astro.url.searchParams.get("scope") === "email"
		? "email"
		: "account";
let errorMessage = "";
let emailError = false;
let successMessage = "";

if (Astro.request.method === "POST") {
	let formData: FormData | undefined;
	try {
		formData = await Astro.request.formData();
	} catch {
		errorMessage = "Unable to read your request. Please try again.";
		Astro.response.status = 400;
	}

	if (formData) {
		const submittedScope = formData.get("scope");
		const submittedEmail = formData.get("email");
		email = typeof submittedEmail === "string" ? submittedEmail.toLowerCase().trim() : "";
		if (formData.getAll("scope").length !== 1 || (submittedScope !== "email" && submittedScope !== "account")) {
			errorMessage = "Choose an account or email subscription to unsubscribe.";
			Astro.response.status = 400;
		} else if (submittedScope === "account" && !user) {
			scope = "email";
			errorMessage = "Sign in to unsubscribe your account, or use the email form below.";
			Astro.response.status = 401;
		} else {
			scope = submittedScope;
			if (scope === "email" && (formData.getAll("email").length !== 1 || !z.email("Please enter a valid email address").safeParse(email).success)) {
				emailError = true;
				errorMessage = "Please enter a valid email address.";
				Astro.response.status = 400;
			} else {
				try {
					const identity = scope === "email" ? createEmailId(email) : createLearnerId(user!.id);
					const result = await env.EMAIL_PREFERENCES.setPreference(identity, {
						audience: "academy",
						channel: "newsletter",
						status: "unsubscribed",
						source: `website:newsletter:${pagePath}`,
					});
					if (!result.success) throw new Error("Unsubscribe was not confirmed");
					if (scope === "email") {
						Astro.cookies.delete("newsletter:academy:updates", { path: "/" });
					}
					successMessage = scope === "email"
						? `The email subscription for ${email} has been unsubscribed from the Rawkode Academy newsletter. Your account subscription, if any, is unchanged.`
						: "Your signed-in account has been unsubscribed from the Rawkode Academy newsletter. Any separate email-address subscription is unchanged.";
				} catch (error) {
					logger.error("Failed to unsubscribe", error);
					errorMessage = "Failed to process your unsubscribe request. Please try again.";
					Astro.response.status = 503;
				}
			}
		}
	}
}
const form = academyForms();
const doc = academyDocument();
---

<Page title="Unsubscribe" description="Unsubscribe from the Rawkode Academy newsletter." noindex>
	<section class={doc.reading}>
		<div class={doc.stack}>
			{successMessage ? <>
				<h1 class={doc.title}>Subscription removed.</h1>
				<p class={doc.lede} role="status">{successMessage}</p>
				<a class={doc.link} href="/">Back to the homepage →</a>
			</> : <>
				<h1 class={doc.title}>{scope === "account" ? "Unsubscribe your account" : "Unsubscribe an email address"}</h1>
				<p class={doc.lede}>{scope === "account"
					? "Stop the newsletter subscription attached to your signed-in account. Separate email-address subscriptions will not change."
					: "Enter the email address you used to subscribe. This will not change an account subscription."}</p>
				{errorMessage && <p id="unsubscribe-error" class={form.error} role="alert">{errorMessage}</p>}
				<form method="POST" action="/unsubscribe" class={form.form}>
					<input type="hidden" name="scope" value={scope} />
					{scope === "email" && <label class={form.field} for="unsubscribe-email">
						<span class={form.label}>Subscription email address</span>
						<input id="unsubscribe-email" type="email" name="email" value={email} autocomplete="email" required class={form.input} aria-describedby={errorMessage ? "unsubscribe-error" : undefined} aria-invalid={emailError ? "true" : undefined} />
					</label>}
					<button type="submit" class={form.button}>{scope === "account" ? "Unsubscribe my account" : "Unsubscribe this email address"}</button>
				</form>
				{scope === "account"
					? <a class={doc.link} href="/unsubscribe?scope=email">Unsubscribe a separate email address</a>
					: user && <a class={doc.link} href="/unsubscribe">Manage my account subscription instead</a>}
				<a class={doc.link} href="/">Go back home</a>
			</>}
		</div>
	</section>
</Page>
