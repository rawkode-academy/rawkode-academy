---
import { env } from "cloudflare:workers";
import Page from "@/wrappers/page.astro";
import { createEmailId, createLearnerId } from "@/actions/newsletter";
import { createLogger } from "@/lib/logger";
import { academyLayout } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

export const prerender = false;

const logger = createLogger("unsubscribe");

// Get email from query parameter
const email = Astro.url.searchParams.get("email");
const success = Astro.url.searchParams.get("success");
const user = Astro.locals.user;
const pagePath = Astro.url.pathname;

let unsubscribeResult: { success: boolean; message: string } | null = null;

// Handle form submission for anonymous users
if (Astro.request.method === "POST" && !user) {
	const formData = await Astro.request.formData();
	const submittedEmail = formData
		.get("email")
		?.toString()
		?.toLowerCase()
		?.trim();

	if (submittedEmail) {
		try {
			const prefixedUserId = createEmailId(submittedEmail);
			await env.EMAIL_PREFERENCES.setPreference(prefixedUserId, {
				audience: "academy",
				channel: "newsletter",
				status: "unsubscribed",
				source: `website:newsletter:${pagePath}`,
			});

			// Clear the newsletter cookie if present
			Astro.cookies.delete("newsletter:academy:updates", { path: "/" });

			// Redirect to success state
			return Astro.redirect(`/unsubscribe?success=true`);
		} catch (e) {
			logger.error("Failed to unsubscribe", e);
			unsubscribeResult = {
				success: false,
				message:
					"Failed to process your unsubscribe request. Please try again.",
			};
		}
	} else {
		unsubscribeResult = {
			success: false,
			message: "Please enter a valid email address.",
		};
	}
}

// Handle form submission for signed-in users
if (Astro.request.method === "POST" && user) {
	try {
		const prefixedUserId = createLearnerId(user.id);
		await env.EMAIL_PREFERENCES.setPreference(prefixedUserId, {
			audience: "academy",
			channel: "newsletter",
			status: "unsubscribed",
			source: `website:newsletter:${pagePath}`,
		});

		// Redirect to success state
		return Astro.redirect(`/unsubscribe?success=true`);
	} catch (e) {
		logger.error("Failed to unsubscribe", e);
		unsubscribeResult = {
			success: false,
			message: "Failed to process your unsubscribe request. Please try again.",
		};
	}
}
const layout = academyLayout({ width: "reading" });
---

<Page
	title="Unsubscribe"
	description="Unsubscribe from the Rawkode Academy newsletter."
	noindex
>
	<div class:list={[layout.root, "unsubscribe-page"]}>
		<div class:list={[layout.container, "unsubscribe-page__content"]}>
		{success === "true" ? (
			<>
				<div class="w-24 h-24 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mb-8">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
					</svg>
				</div>
				
				<h1 class={layout.title}>
					Unsubscribed Successfully
				</h1>
				
				<p class={layout.description}>
					You have been unsubscribed from the Rawkode Academy newsletter. We're sorry to see you go!
				</p>
				
				<a 
					href="/"
					class={layout.button}
				>
					Back to Home
				</a>
			</>
		) : (
			<>
				<h1 class={layout.title}>
					Unsubscribe from Newsletter
				</h1>
				
				<p class={layout.description}>
					{user 
						? "Click the button below to unsubscribe from the Rawkode Academy newsletter."
						: "Enter your email address to unsubscribe from the Rawkode Academy newsletter."
					}
				</p>

				{unsubscribeResult?.success === false && (
					<div class="mb-6 p-4 rounded-sm bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 max-w-md">
						{unsubscribeResult.message}
					</div>
				)}

				<form method="POST" class="unsubscribe-page__form">
					{!user && (
						<input
							type="email"
							name="email"
							value={email || ""}
							placeholder="Enter your email address"
							required
							class={layout.input}
						/>
					)}
					
					<button
						type="submit"
						class={layout.button}
					>
						Unsubscribe
					</button>
				</form>

				<p class="unsubscribe-page__return">
					Changed your mind? <a href="/">Go back home</a>
				</p>
			</>
		)}
		</div>
	</div>
</Page>

<style>
	.unsubscribe-page__content { display: grid; justify-items: center; min-height: 60vh; padding-block: 5rem; text-align: center; }
	.unsubscribe-page__form { display: grid; width: min(100%, 28rem); gap: 1rem; margin-top: 2rem; }
	.unsubscribe-page__return { margin-top: 2rem; color: var(--colors-academy-text-muted); }
	.unsubscribe-page__return a { color: var(--colors-academy-accent); text-underline-offset: 0.2em; }
</style>
