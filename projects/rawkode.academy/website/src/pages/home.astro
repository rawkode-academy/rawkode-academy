---
import { academyAccount } from "@rawkodeacademy/design-system";
const account = academyAccount();
import { getCollection } from "astro:content";
import VideoFeed from "@/components/video/video-feed.astro";
import Page from "@/wrappers/page.astro";
import { getVideoThumbnailUrl } from "@/lib/video-thumbnail";
import { academyLayout } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(
		`/api/auth/sign-in?returnTo=${encodeURIComponent("/home")}`,
	);
}

// No caching for personalized content
Astro.response.headers.set("Cache-Control", "private, no-store");

// Fetch continue watching list from the API
interface WatchPosition {
	videoId: string;
	positionSeconds: number;
	updatedAt: string;
}

let historyUnavailable = false;
let continueWatchingData: WatchPosition[] = [];

try {
	const response = await fetch("https://api.rawkode.academy/graphql", {
		method: "POST",
		headers: { "Content-Type": "application/json" },
		body: JSON.stringify({
			query: `
				query ContinueWatching($userId: String!, $limit: Int) {
					continueWatching(userId: $userId, limit: $limit) {
						videoId
						positionSeconds
						updatedAt
					}
				}
			`,
			variables: { userId: user.id, limit: 12 },
		}),
	});
	if (!response.ok) throw new Error("History unavailable");
	const result = (await response.json()) as {
		errors?: unknown[];
		data?: { continueWatching?: WatchPosition[] };
	};
	if (result.errors?.length) throw new Error("History unavailable");
	continueWatchingData = result?.data?.continueWatching ?? [];
} catch {
	historyUnavailable = true;
}

// Get all videos from collection to match with watch history
const allVideos = await getCollection("videos");

// Map watch history to video data, preserving the order from watch history
const continueWatchingVideos = continueWatchingData
	.map((watchItem) => {
		const video = allVideos.find((v) => v.data.id === watchItem.videoId);
		if (!video) return null;

		return {
			id: video.data.id,
			title: video.data.title,
			slug: video.data.slug,
			thumbnailUrl: getVideoThumbnailUrl(video.data.id),
			streamUrl: `https://content.rawkode.academy/videos/${video.data.id}/stream.m3u8`,
			duration:
				typeof video.data.duration === "number" ? video.data.duration : 0,
			publishedAt:
				video.data.publishedAt instanceof Date
					? video.data.publishedAt.toISOString()
					: String(video.data.publishedAt),
			type: video.data.type,
		};
	})
	.filter((v): v is NonNullable<typeof v> => v !== null);

// Build watch positions map for progress bars
const watchPositionsMap = continueWatchingData.reduce(
	(acc, item) => {
		acc[item.videoId] = item.positionSeconds;
		return acc;
	},
	{} as Record<string, number>,
);
const layout = academyLayout({ width: "wide" });
---

<Page title="Home - Rawkode Academy" description="Your personalized dashboard" noindex>
	<div class={layout.root}>
		<section class={layout.hero}>
			<div class={layout.container}>
				<h1 class={layout.title}>
				Welcome back{user.name ? `, ${user.name.split(" ")[0]}` : ""}
			</h1>
			<p class={layout.description}>
				Pick up where you left off
			</p>
			</div>
		</section>

		<section class={layout.section}>
			{continueWatchingVideos.length > 0 ? (
				<VideoFeed
					title="Continue Watching"
					description="Resume your recently watched videos"
					videos={continueWatchingVideos}
					watchPositions={watchPositionsMap}
					isAuthenticated={true}
				/>
			) : (
				<div class={layout.empty}>
				<div class={account.emptyIcon}>
					<svg class={account.icon} fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
				</div>
				<h2 class={layout.sectionTitle}>{historyUnavailable ? "Watch history is unavailable" : "No watch history yet"}</h2>
				<p class={layout.description}>
					{historyUnavailable ? "We could not load your progress. You can still browse videos, or reload this page to try again." : "Start watching videos and they will appear here so you can continue where you left off."}
				</p>
				<a
					href="/watch"
					class={layout.button}
				>
					Browse Videos
					<svg class={account.smallIcon} fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
					</svg>
				</a>
				</div>
			)}
		</section>
	</div>
</Page>
