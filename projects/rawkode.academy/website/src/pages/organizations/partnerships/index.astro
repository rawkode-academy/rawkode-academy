---
import { actions, isInputError } from "astro:actions";
import {
	type ContentEntry,
	disableContentCache,
	getCollection,
	getEntry,
} from "@/lib/live-content";
import PartnerLogos from "@/components/organizations/PartnerLogos.astro";
import PartnershipApplicationForm from "@/components/organizations/PartnershipApplicationForm.vue";
import ReviewPreview from "@/components/organizations/ReviewPreview.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	isVerbatimExcerpt,
	type PartnershipQuoteId,
	partnershipPullQuoteId,
	partnershipQuoteContext,
	partnershipQuoteExcerpts,
} from "@/lib/partnership-quotes";
import {
	type ApplicationPath,
	annualPartnershipDetails,
	annualPartnershipOffer,
	fitProofReview,
	PARTNERSHIP_EMAIL,
	type PartnershipOffer,
	partnershipAddOns,
	partnershipCapacity,
	partnershipCredentials,
	partnershipDescription,
	partnershipExperience,
	partnershipLatestEvent,
	partnershipOffer,
	partnershipPerks,
	partnershipReviewCredit,
	partnershipWatchEpisodes,
	productReviewCompletion,
	productReviewPath,
	productReviewScope,
	supporterOffer,
	renewalPerks,
	resolveApplicationPath,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = false;

// The page renders enquiry results and rejected submissions from Astro
// actions, so it is never stored by the CDN or the browser.
disableContentCache(Astro);
Astro.response.headers.set("Cache-Control", "private, no-cache");

const applyHref = (path: ApplicationPath) =>
	`/organizations/partnerships?route=${encodeURIComponent(path)}#enquiry-form`;
const reviewApplyHref = applyHref(productReviewPath);
const initialPath =
	resolveApplicationPath(Astro.url.searchParams.get("route")) ?? "Not sure yet";
const submittedEnquiry = Astro.getActionResult(actions.partnership.applyForm);
const submittedData = submittedEnquiry?.data;
const enquiryReceived =
	submittedData != null &&
	"success" in submittedData &&
	submittedData.success === true;
const enquiryRateLimited =
	submittedData != null &&
	"rateLimited" in submittedData &&
	submittedData.rateLimited === true;
const enquiryFallback =
	submittedData != null &&
	"fallback" in submittedData &&
	submittedData.fallback === "mailto";
const enquiryErrorCode =
	enquiryFallback &&
	submittedData != null &&
	"code" in submittedData &&
	typeof submittedData.code === "string"
		? submittedData.code
		: undefined;
const enquiryError = submittedEnquiry?.error;
const enquiryFields = ["name", "email", "company", "path", "message"] as const;
const serverFieldErrors =
	enquiryError && isInputError(enquiryError)
		? Object.fromEntries(
				enquiryFields.flatMap((field) => {
					const message = enquiryError.fields[field]?.find(
						(item) => item.length > 0,
					);
					return message ? [[field, message]] : [];
				}),
			)
		: {};
const emptySubmission = {
	name: "",
	email: "",
	company: "",
	path: "",
	message: "",
};
const submissionField = (formData: FormData, key: string) => {
	const value = formData.get(key);
	return typeof value === "string" ? value : "";
};
const readRejectedSubmission = async (request: Request) => {
	if (request.method !== "POST") return emptySubmission;
	try {
		const formData = await request.formData();
		return {
			name: submissionField(formData, "name"),
			email: submissionField(formData, "email"),
			company: submissionField(formData, "company"),
			path: submissionField(formData, "path"),
			message: submissionField(formData, "message"),
		};
	} catch {
		return emptySubmission;
	}
};
const submittedValues =
	enquiryError || enquiryRateLimited || enquiryFallback
		? await readRejectedSubmission(Astro.request)
		: emptySubmission;

const partnershipReviewHeroTitle =
	"See exactly where engineers get stuck with your product.";

// Content is optional on this page: the enquiry form must keep working when
// the content gateway is unavailable.
const owner = await getEntry("people", "rawkode").catch(() => undefined);
const ownerAvatar = owner?.data.avatarUrl
	? `${owner.data.avatarUrl}?s=96`
	: undefined;

const reviewSteps = [
	{
		title: "You give me access",
		detail:
			"A trial or sandbox account. We agree who I'm acting as, and where the run starts and ends.",
	},
	{
		title: "I work through it alone",
		detail:
			"As your target user, with nobody to rescue me. Delivered within 10 business days of getting access.",
	},
	{
		title: "You get a ranked report",
		detail:
			"Where engineers get stuck and what to fix first. Then a one-hour call to walk your team through it.",
	},
];

/** Split "$40,000 a year" into the amount and the period after it. */
const splitPrice = (price: string) => {
	const match = price.match(/^(\$[\d,]+)(?:\s+(.+))?$/);
	return { amount: match?.[1] ?? price, period: match?.[2] };
};

interface PricingCard {
	offer: PartnershipOffer;
	route: ApplicationPath;
	period: string;
	cta: string;
	ctaName?: string;
	ctaLocation: string;
	featured?: boolean;
	lead?: string;
	choices?: readonly string[];
}

const pricingCards: PricingCard[] = [
	{
		offer: fitProofReview,
		route: productReviewPath,
		period: "one-off, fixed",
		cta: "Ask about a product review",
		ctaLocation: "pricing-review",
		featured: true,
	},
	{
		offer: partnershipOffer,
		route: "90-day partnership",
		period: "fixed, 90 days",
		cta: "Ask about the 90-day plan",
		ctaName: "ask_about_the_90_day_plan",
		ctaLocation: "pricing-90-day",
		lead: "Everything in the product review, plus:",
	},
	{
		offer: annualPartnershipOffer,
		route: "Annual plan",
		period: splitPrice(annualPartnershipOffer.price).period ?? "a year",
		cta: "Ask about the annual plan",
		ctaName: "ask_about_the_annual_plan",
		ctaLocation: "pricing-annual",
		choices: annualPartnershipDetails,
	},
];

const pageSections = [
	{ id: "how-it-works", label: "How it works" },
	{ id: "pricing", label: "Pricing" },
	{ id: "supporter", label: "Supporter" },
	{ id: "questions", label: "FAQ" },
	{ id: "apply", label: "Enquire" },
];

const noLockIn = [
	{
		title: "Stop at any stage",
		detail: `Stop after the review and you've paid ${fitProofReview.price}. The 90-day partnership ends at day 90, with nothing more to pay.`,
	},
	{
		title: "Renew when it's working",
		detail:
			"The annual partnership is a 12-month contract, billed at $10,000 a quarter. Carrying on is always your choice.",
	},
	{
		title: "You own the work",
		detail:
			"You decide what each quarter covers, and you own the review, the report and the read-out.",
	},
];

const faqs = [
	{
		question: "How is this different from sponsoring a video?",
		answer:
			"A sponsorship buys airtime. Here you pay for my time and judgement on your product: the review, the ranked list and the advice. The live session is part of that work, labelled as a partner session, and it teaches a real use case. If the product isn't ready to teach yet, I tell you and the time goes on fixing that first.",
	},
	{
		question:
			"We could come on Rawkode Live for free. What does the review add?",
		answer:
			"A maintainer session is public, about an hour, and you are there steering, so I see the path you show me. In the review I work alone as your target user, with nobody to rescue me. I note every place I get stuck against the recording, rank what to fix, explain or teach and, if you continue, re-run it at day 90 to check what changed.",
	},
	{
		question: "Aren't you too experienced to get stuck where our users do?",
		answer:
			"Before starting we agree who I'm acting as, such as an application developer who has never run a cluster, and I work to what that person would know. The walkthrough call then checks the list against what your team already hears from users, so we focus on what matters most to them.",
	},
	{
		question: "What exactly does the review cover?",
		answer: productReviewScope,
	},
	{
		question: "How much of our engineers' time does it take?",
		answer:
			"About half a day across the 90 days: an hour to review the runnable example, plus an hour to prepare and the live hour itself if someone from your team co-hosts the session. I write the example. Your product lead joins the monthly sessions.",
	},
	{
		question: "Who on our side should own it?",
		answer:
			"Whoever owns developer adoption. Often that is the head of DevRel or developer experience, with product owning the fixes. The ranked list says which items are for product, which for docs and which for DevRel.",
	},
	{
		question: "Why are places limited?",
		answer:
			"I do every review and partnership myself, alongside running Rawkode Academy. Six partners at a time is what I can do properly, and two new reviews a month is what I can start without the existing ones slipping. The limits are the same whether or not places are free. A place is booked when the statement of work is signed and a start date is set; if the statement of work isn't signed within seven days, the place is released.",
	},
	{
		question: "Can we sponsor content as well?",
		answer:
			"Yes. As a community supporter, your docs, your latest announcement and a supporter badge appear on your technology page and on every video about your technology, from $1,000 a month.",
	},
	{
		question: "Do open-source maintainers have to pay to come on Rawkode Live?",
		answer:
			"No. Maintainer sessions on Rawkode Live are still free and unpaid, and they aren't labelled as partner sessions. The partnership is for teams who want the review, the advice and the work around the session.",
	},
];

// Excerpts are checked against their testimonials in CI
// (src/tests/partnership-quotes.test.ts). A quote that no longer matches is
// left out here rather than failing the request.
const testimonials: ContentEntry<"testimonials">[] = await getCollection(
	"testimonials",
).catch(() => []);
const quoteFor = (id: PartnershipQuoteId) => {
	const entry = testimonials.find((item) => item.id === id);
	const excerpt = partnershipQuoteExcerpts[id];
	if (!entry || !isVerbatimExcerpt(entry.data.quote, excerpt)) return undefined;
	return { id, excerpt, author: entry.data.author };
};
const pullQuote = quoteFor(partnershipPullQuoteId);
const partnerQuotes = (
	Object.keys(
		partnershipQuoteContext,
	) as (keyof typeof partnershipQuoteContext)[]
).flatMap((id) => {
	const quote = quoteFor(id);
	return quote ? [{ ...quote, context: partnershipQuoteContext[id] }] : [];
});
---

<Page
	title="Developer product reviews and partnerships"
	subtitle={partnershipReviewHeroTitle}
	description={partnershipDescription}
>
	<EditorialShell
		eyebrow="Partnerships"
		title={partnershipReviewHeroTitle}
		lede="I teach engineers new tools, live and unscripted. Then I show the teams who build them where engineers get stuck, and what to fix first."
	>
		<dl class="partnership-facts" slot="intro">
			<div>
				<dt>Price</dt>
				<dd>{fitProofReview.price} fixed</dd>
			</div>
			<div>
				<dt>Delivered in</dt>
				<dd>10 business days</dd>
			</div>
		</dl>
		<div class="partnership-hero-actions" slot="actions">
			<a id="partnership-hero-cta" class="editorial-button" href={reviewApplyHref} data-apply-path={productReviewPath} data-partnership-cta data-cta-location="hero">Ask about a product review</a>
			<a class="partnership-text-link" href="#pricing">See all pricing</a>
		</div>
		<p class="partnership-watch" slot="actions">
			Watch me try a new tool live:
			{partnershipWatchEpisodes.map((episode, index) => (
				<>
					{index > 0 && <span aria-hidden="true"> · </span>}
					<a class="partnership-text-link" href={episode.href} data-partnership-cta data-cta={`watch_${episode.label.toLowerCase()}`} data-cta-location="hero-watch">{episode.label} →</a>
				</>
			))}
		</p>
		<div class="partnership-byline" slot="actions">
			{ownerAvatar && <img src={ownerAvatar} alt="" width="48" height="48" loading="eager" decoding="async" />}
			<p>
				<strong>David Flanagan</strong>
				<span>Runs Rawkode Academy and Rawkode Live</span>
				<span class="partnership-byline__stats">28.2K YouTube subscribers · over 450 hours of developer education</span>
				<span class="partnership-byline__stats">{partnershipLatestEvent}</span>
				<span class="partnership-byline__bio">{partnershipExperience.map((part) => part.href ? <a href={part.href} rel={part.href.startsWith("http") ? "noopener" : undefined}>{part.text}</a> : part.text)}</span>
				<span class="partnership-byline__stats partnership-byline__credentials">
					{partnershipCredentials.map((credential, index) => (
						<>
							{index > 0 && <span aria-hidden="true"> · </span>}
							<a href={credential.href} rel="noopener">{credential.label} ↗</a>
						</>
					))}
				</span>
			</p>
		</div>
		<ReviewPreview slot="aside" placement="hero" />

		<nav class="partnership-rail" aria-label="On this page">
			<ul>
				{pageSections.map((section) => <li><a href={`#${section.id}`}>{section.label}</a></li>)}
			</ul>
		</nav>

		<section id="who-ive-worked-with" class="editorial-section" aria-labelledby="who-ive-worked-with-title">
			<p id="who-ive-worked-with-title" class="partnership-label">Teams I've worked with</p>
			<PartnerLogos variant="grid" />
		</section>

		{pullQuote && (
		<section id="pull-quote" class="editorial-section" aria-label="What builders say">
			<figure class="partnership-pull-quote">
				<blockquote>{pullQuote.excerpt}</blockquote>
				<figcaption><strong>{pullQuote.author.name}</strong>, {pullQuote.author.title}</figcaption>
			</figure>
		</section>
		)}

		<section id="how-it-works" class="editorial-section editorial-section--split" aria-labelledby="how-it-works-title">
			<div class="editorial-section__header">
				<h2 id="how-it-works-title" class="editorial-section__title">How the review works</h2>
			</div>
			<div class="partnership-steps-body">
				<ol class="partnership-steps">
					{reviewSteps.map((step, index) => (
						<li>
							<span class="partnership-steps__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
							<div>
								<h3>{step.title}</h3>
								<p>{step.detail}</p>
							</div>
						</li>
					))}
				</ol>
				<ReviewPreview placement="inline" />
				<p class="partnership-promise">{productReviewCompletion}</p>
			</div>
		</section>

		<section id="fit" class="editorial-section editorial-section--split" aria-labelledby="fit-title">
			<div class="editorial-section__header">
				<h2 id="fit-title" class="editorial-section__title">Teams I work best with</h2>
			</div>
			<ul class="partnership-fit">
				<li>You build developer tools: infrastructure tools, Kubernetes and cloud native projects, cloud platforms or AI infrastructure.</li>
				<li>You're between seed and Series C.</li>
				<li>An engineer can install or sign up for your product and try it, including open-source projects installed from GitHub or Helm.</li>
			</ul>
		</section>

		<section id="perks" class="editorial-section editorial-section--split" aria-labelledby="perks-title">
			<div class="editorial-section__header">
				<h2 id="perks-title" class="editorial-section__title">What else you get</h2>
				<p class="editorial-section__lede">Included with every 90-day and annual partnership.</p>
			</div>
			<div class="partnership-perks">
				<h3 class="partnership-label">Every partnership</h3>
				<ul>
					{partnershipPerks.map((perk) => (
						<li>
							<strong>{perk.title}</strong>
							<p>{perk.detail}</p>
						</li>
					))}
				</ul>
				<h3 class="partnership-label">When you renew</h3>
				<ul>
					{renewalPerks.map((perk) => (
						<li>
							<strong>{perk.title}</strong>
							<p>{perk.detail}</p>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section id="pricing" class="editorial-section" aria-labelledby="pricing-title">
			<div class="partnership-pricing__header">
				<div class="editorial-section__header">
					<h2 id="pricing-title" class="editorial-section__title">Pricing</h2>
					<p class="editorial-section__lede">Start with the review. Continue only if it's useful.</p>
					<p class="partnership-label">{partnershipCapacity.places} partner places · {partnershipCapacity.newStartsPerMonth} new reviews a month</p>
				</div>
				<p class="partnership-credit">{partnershipReviewCredit}</p>
			</div>
			<div class="partnership-pricing">
				{pricingCards.map((card) => {
					const { amount } = splitPrice(card.offer.price);
					return (
						<article class:list={["partnership-plan", card.featured && "partnership-plan--featured"]} aria-labelledby={`plan-${card.offer.id}`}>
							<div class="partnership-plan__heading">
								<h3 id={`plan-${card.offer.id}`}>{card.offer.name}</h3>
								{card.featured && <span class="partnership-plan__badge">Start here</span>}
							</div>
							<p class="partnership-plan__price"><span>{amount}</span> <span class="partnership-plan__period">{card.period}</span></p>
							<p class="partnership-plan__cadence">{card.offer.cadence}</p>
							{card.featured && <p class="partnership-plan__summary">{card.offer.summary}</p>}
							<div class="partnership-plan__body">
								{card.lead && <p class="partnership-plan__lead">{card.lead}</p>}
								<ul class="partnership-plan__list">
									{card.offer.included.map((item) => <li>{item}</li>)}
								</ul>
								{card.choices && (
									<div class="partnership-plan__choices">
										<p class="partnership-plan__lead">Each quarter, you choose one:</p>
										<ul>
											{card.choices.map((choice) => <li>{choice}</li>)}
										</ul>
									</div>
								)}
								{card.offer.notes.map((note) => <p class="partnership-plan__note">{note}</p>)}
							</div>
							<a
								class:list={["editorial-button", !card.featured && "editorial-button--secondary"]}
								href={applyHref(card.route)}
								data-apply-path={card.route}
								data-partnership-cta
								data-cta={card.ctaName}
								data-cta-location={card.ctaLocation}
							>{card.cta}</a>
						</article>
					);
				})}
			</div>
			<div class="partnership-addons">
				<h3 id="addons-title" class="partnership-label">Add-ons</h3>
				<ul>
					{partnershipAddOns.map((addOn) => (
						<li>
							<p class="partnership-addons__heading"><strong>{addOn.title}</strong> <span>{addOn.price}</span></p>
							<p>{addOn.detail}</p>
							<a
								class="partnership-text-link"
								href={applyHref(addOn.route)}
								data-apply-path={addOn.route}
								data-partnership-cta
								data-cta={`ask_about_${addOn.id.replaceAll("-", "_")}`}
								data-cta-location="pricing-addon"
							>{addOn.cta}</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section id="no-lock-in" class="editorial-section" aria-labelledby="no-lock-in-title">
			<div class="partnership-terms">
				<h2 id="no-lock-in-title">Simple terms</h2>
				<ul>
					{noLockIn.map((term) => (
						<li>
							<strong>{term.title}</strong>
							<span>{term.detail}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section id="supporter" class="editorial-section editorial-section--split" aria-labelledby="supporter-title">
			<div class="editorial-section__header">
				<h2 id="supporter-title" class="editorial-section__title">Fund free content for the community</h2>
				<p class="editorial-section__lede">{supporterOffer.summary}</p>
			</div>
			<article class="partnership-plan partnership-supporter" aria-labelledby={`plan-${supporterOffer.id}`}>
				<div class="partnership-plan__heading">
					<h3 id={`plan-${supporterOffer.id}`}>{supporterOffer.name}</h3>
				</div>
				<p class="partnership-plan__price"><span>{splitPrice(supporterOffer.price).amount}</span> <span class="partnership-plan__period">{splitPrice(supporterOffer.price).period}</span></p>
				<p class="partnership-plan__cadence">{supporterOffer.cadence}</p>
				<ul class="partnership-plan__list">
					{supporterOffer.included.map((item) => <li>{item}</li>)}
				</ul>
				<a
					class="editorial-button editorial-button--secondary"
					href={applyHref("Community supporter")}
					data-apply-path="Community supporter"
					data-partnership-cta
					data-cta="become_a_supporter"
					data-cta-location="pricing-supporter"
				>Become a supporter</a>
			</article>
		</section>

		{partnerQuotes.length > 0 && (
		<section id="partner-quotes" class="editorial-section" aria-labelledby="partner-quotes-title">
			<div class="editorial-section__header">
				<h2 id="partner-quotes-title" class="editorial-section__title">What partners say</h2>
			</div>
			<ul class="partnership-quotes">
				{partnerQuotes.map(({ excerpt, author, context }) => (
					<li>
						<figure>
							<p class="partnership-label">{context}</p>
							<blockquote>{excerpt}</blockquote>
							<figcaption>
								{author.link ? <a href={author.link}>{author.name}</a> : <strong>{author.name}</strong>}
								<span>{author.title}</span>
							</figcaption>
						</figure>
					</li>
				))}
			</ul>
		</section>
		)}

		<section id="questions" class="editorial-section editorial-section--split" aria-labelledby="questions-title">
			<div class="editorial-section__header">
				<h2 id="questions-title" class="editorial-section__title">Questions</h2>
				<p class="editorial-section__lede">Something else? Email <a class="partnership-text-link" href={`mailto:${PARTNERSHIP_EMAIL}`}>{PARTNERSHIP_EMAIL}</a></p>
			</div>
			<div class="partnership-faq">
				{faqs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section id="apply" class="editorial-section editorial-section--split partnerships-apply" aria-labelledby="apply-title">
			<div class="editorial-section__header">
				<h2 id="apply-title" class="editorial-section__title">What are you building?</h2>
				<p class="editorial-section__lede">A few lines about your product and what you're after is enough. I read every one and tell you which option fits: a review, a partnership or supporting the community.</p>
			</div>
			<div id="enquiry-form" class="partnerships-apply__body">
				{enquiryReceived ? (
					<div>
						<h3>Enquiry received</h3>
						<p>I read every enquiry and will reply by email.</p>
					</div>
				) : (
					<>
						{enquiryRateLimited && <p role="alert">Too many enquiries were sent recently. Please wait a minute and try again.</p>}
						{enquiryFallback && <p role="alert" data-error-code={enquiryErrorCode}>Something went wrong, so your enquiry wasn't sent. Please <a href={`mailto:${PARTNERSHIP_EMAIL}`}>email me directly</a>.</p>}
						{submittedEnquiry?.error && <p role="alert">Please check the highlighted fields.</p>}
						<PartnershipApplicationForm client:visible initialPath={initialPath} submittedValues={submittedValues} serverFieldErrors={serverFieldErrors} />
					</>
				)}
			</div>
		</section>
	</EditorialShell>

	<div class="partnership-pinned" data-partnership-pinned>
		<p>
			<strong>{fitProofReview.name}</strong>
			<span>{fitProofReview.price} · fixed price</span>
		</p>
		<a class="partnership-pinned__cta" href={reviewApplyHref} data-apply-path={productReviewPath} data-partnership-cta data-cta-location="pinned" tabindex="-1">Ask about a review</a>
	</div>
</Page>

<script>
	document.querySelectorAll("[data-partnership-cta]").forEach((cta) => {
		cta.addEventListener("click", () => {
			const label = cta.textContent?.trim() ?? "";
			window.posthog?.capture("cta_clicked", {
				cta: cta.getAttribute("data-cta") ?? "book_a_product_review",
				label,
				location: cta.getAttribute("data-cta-location"),
				path: window.location.pathname,
			});
		});
	});

	// The pinned bar appears once the hero button has scrolled away and
	// leaves again when the enquiry form is reached. Positions are read on
	// scroll (once per frame) so jumps such as anchor links are handled too.
	const pinned = document.querySelector<HTMLElement>(
		"[data-partnership-pinned]",
	);
	const pinnedCta = pinned?.querySelector<HTMLAnchorElement>("a");
	const heroCta = document.getElementById("partnership-hero-cta");
	const enquiry = document.getElementById("apply");
	if (pinned && pinnedCta && heroCta && enquiry) {
		let frame = 0;
		const update = () => {
			frame = 0;
			const pastHero = heroCta.getBoundingClientRect().bottom < 0;
			const atEnquiry =
				enquiry.getBoundingClientRect().top < window.innerHeight;
			const show = pastHero && !atEnquiry;
			pinned.toggleAttribute("data-visible", show);
			pinnedCta.tabIndex = show ? 0 : -1;
		};
		const schedule = () => {
			if (!frame) frame = window.requestAnimationFrame(update);
		};
		window.addEventListener("scroll", schedule, { passive: true });
		window.addEventListener("resize", schedule, { passive: true });
		update();
	}
</script>

