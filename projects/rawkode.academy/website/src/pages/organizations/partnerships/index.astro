---
import FAQJsonLD from "@/components/html/faq-jsonld.astro";
import PartnershipApplicationForm from "@/components/organizations/PartnershipApplicationForm.vue";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	fitProofReview,
	partnershipBoundaries,
	partnershipOffer,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const faqs = [
	{
		question: "How does Slack access work?",
		answer:
			"Slack Connect is the place for questions, reviews, and decisions as they come up. It is async partner communication, not on-call support or incident response. Questions are normally answered within two business days.",
	},
	{
		question: "What do we need to provide?",
		answer:
			"A working environment, technical subject-matter expert, relevant docs or repository, source material, and timely approvals. You keep ownership of implementation and execution.",
	},
	{
		question: "How is additional work handled?",
		answer:
			"Additional demos or strategy work are separately scoped. The programme does not include audience rental or guaranteed sign-ups.",
	},
];

const process = [
	{
		step: "01",
		title: "Apply with a real problem",
		body: "Tell us who needs to trust the product, what they need to see, and where the current proof falls short.",
	},
	{
		step: "02",
		title: "Agree the first workflow",
		body: "We choose a technical buyer workflow, the working environment, the first proof gap, and the first quarter's asset.",
	},
	{
		step: "03",
		title: "Build, review, and learn",
		body: "Slack keeps the work moving. The monthly session makes decisions. The quarterly report tells us what to keep, change, or stop.",
	},
];

const badFits = partnershipBoundaries;
const applyHref = `/organizations/partnerships?route=${encodeURIComponent(partnershipOffer.name)}#apply`;
const reviewApplyHref = `/organizations/partnerships?route=${encodeURIComponent(fitProofReview.name)}#apply`;
---

<Page
	title="Partnerships"
	description="Rawkode Academy's Adoption Advisory partner programme for infrastructure companies that need technical proof, useful demos, and practitioner trust."
>
	<FAQJsonLD questions={faqs} slot="extra-head" />
	<EditorialShell
		eyebrow="Rawkode Partner Programme"
		title="Turn technical depth into practitioner trust."
		lede={partnershipOffer.summary}
	>
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href={applyHref} data-apply-path={partnershipOffer.name}>Apply for Adoption Advisory</a>
			<a class="editorial-button editorial-button--secondary" href="#programme">See the programme</a>
		</div>

		<section id="programme" class="editorial-section editorial-section--split" aria-labelledby="programme-title">
			<div class="editorial-section__header">
				<h2 id="programme-title" class="editorial-section__title">{partnershipOffer.name}</h2>
				<p class="editorial-section__lede">Work with David on a specific technical workflow. Your team keeps ownership of the product, content, and community. The partnership includes agreed proof assets and distribution, backed by technical critique and practitioner context.</p>
			</div>
			<div class="partner-offer-card">
				<div>
					<p class="partner-offer-card__price">{partnershipOffer.price}</p>
					<p class="partner-offer-card__cadence">{partnershipOffer.cadence}</p>
				</div>
				<ul class="editorial-list">
					{partnershipOffer.included.map((item) => <li>{item}</li>)}
				</ul>
				<a class="editorial-button" href={applyHref} data-apply-path={partnershipOffer.name}>Apply for the programme</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="review-title">
			<div class="editorial-section__header">
				<p class="editorial-kicker">Optional starting point</p>
				<h2 id="review-title" class="editorial-section__title">{fitProofReview.name}</h2>
				<p class="editorial-section__lede">{fitProofReview.summary}</p>
			</div>
			<div class="partner-offer-card">
				<div>
					<p class="partner-offer-card__price">{fitProofReview.price}</p>
					<p class="partner-offer-card__cadence">{fitProofReview.cadence}</p>
				</div>
				<ul class="editorial-list">
					{fitProofReview.included.map((item) => <li>{item}</li>)}
				</ul>
				<a class="partner-card__link" href={reviewApplyHref} data-apply-path={fitProofReview.name}>Start with a fit review</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="process-title">
			<div class="editorial-section__header">
				<h2 id="process-title" class="editorial-section__title">How it starts</h2>
			</div>
			<div class="partner-process">
				{process.map((item) => (
					<article class="partner-process__item">
						<span class="partner-process__step">{item.step}</span>
						<h3 class="editorial-card__title">{item.title}</h3>
						<p class="editorial-card__body">{item.body}</p>
					</article>
				))}
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="boundaries-title">
			<div class="editorial-section__header">
				<h2 id="boundaries-title" class="editorial-section__title">Clear boundaries</h2>
			</div>
			<ul class="editorial-list partner-boundaries">
				{badFits.map((item) => <li>{item}</li>)}
			</ul>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="faq-title">
			<div class="editorial-section__header">
				<h2 id="faq-title" class="editorial-section__title">Before you apply</h2>
			</div>
			<div class="editorial-faq">
				{faqs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section id="apply" class="editorial-section editorial-section--split partnerships-apply" aria-labelledby="apply-title">
			<div class="editorial-section__header">
				<p class="editorial-kicker">Apply</p>
				<h2 id="apply-title" class="editorial-section__title">Bring the next adoption problem.</h2>
				<p class="editorial-section__lede">Tell us who needs to trust the product, what they need to see, and what you want to build this quarter. Rough context is enough.</p>
			</div>
			<div class="partnerships-apply__body">
				<PartnershipApplicationForm client:visible />
			</div>
		</section>
	</EditorialShell>
</Page>

<style>
	.partner-process__step {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--colors-academy-accent);
	}

	.partner-offer-card {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}

	.partner-offer-card__price {
		margin: 0.4rem 0 0;
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: clamp(1.9rem, 5vw, 2.8rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--colors-academy-text);
	}

	.partner-offer-card__cadence {
		margin: 0.15rem 0 0;
		color: var(--colors-academy-text-muted);
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.partner-card__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--colors-academy-accent);
		text-decoration: none;
	}

	.partner-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.partner-card__link:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}

	.partner-process {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--colors-academy-border);
		border-bottom: 1px solid var(--colors-academy-border);
	}

	.partner-process__item {
		display: grid;
		gap: 0.5rem;
		padding: 1rem 0;
	}

	.partner-process__item + .partner-process__item {
		border-top: 1px solid var(--colors-academy-border);
	}

	.partner-process__item h3 {
		margin: 0;
	}

	.partner-boundaries {
		margin: 0;
	}

	@media (min-width: 760px) {
		.partner-process__item {
			padding: 1rem;
		}
	}
</style>
