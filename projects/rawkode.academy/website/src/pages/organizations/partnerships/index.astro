		<a class="partnership-pinned__cta" href={supportAcademyApplyHref} data-apply-path={supportAcademyPath} data-partnership-cta data-cta="support_the_academy" data-cta-location="pinned" tabindex="-1">Support the Academy</a>
	</div>
</Page>

<script>
	document.querySelectorAll("[data-partnership-cta]").forEach((cta) => {
		cta.addEventListener("click", () => {
			const label = cta.textContent?.trim() ?? "";
			window.posthog?.capture("cta_clicked", {
				cta: cta.getAttribute("data-cta") ?? "partnership_enquiry",
				label,
				location: cta.getAttribute("data-cta-location"),
				path: window.location.pathname,
			});
		});
	});

	// The pinned bar appears once the hero button has scrolled away and
	// leaves again when the enquiry form is reached. Positions are read on
	// scroll (once per frame) so jumps such as anchor links are handled too.
	const pinned = document.querySelector<HTMLElement>("[data-partnership-pinned]");
	const pinnedCta = pinned?.querySelector<HTMLAnchorElement>("a");
	const heroCta = document.getElementById("partnership-hero-cta");
	const enquiry = document.getElementById("apply");
	if (pinned && pinnedCta && heroCta && enquiry) {
		const pinnedName = pinned.querySelector("strong");
		const pinnedPrice = pinned.querySelector("p span");
		const plans = Array.from(
			document.querySelectorAll<HTMLElement>("[data-pinned-name]"),
		);
		const defaultName = pinnedName?.textContent ?? "";
		const defaultPrice = pinnedPrice?.textContent ?? "";
		const defaultCta = pinnedCta.textContent ?? "";
		const defaultHref = pinnedCta.href;
		const defaultRoute = pinnedCta.dataset.applyPath ?? "Support the Academy";
		const defaultCtaName = pinnedCta.dataset.cta ?? "partnership_enquiry";
		let currentPlan: HTMLElement | undefined;

		const follow = (plan?: HTMLElement) => {
			if (plan === currentPlan) return;
			currentPlan = plan;
			if (pinnedName)
				pinnedName.textContent = plan?.dataset.pinnedName ?? defaultName;
			if (pinnedPrice)
				pinnedPrice.textContent = plan?.dataset.pinnedPrice ?? defaultPrice;
			pinnedCta.textContent = plan?.dataset.pinnedCta ?? defaultCta;
			pinnedCta.href = plan?.dataset.pinnedHref ?? defaultHref;
			pinnedCta.dataset.applyPath = plan?.dataset.pinnedRoute ?? defaultRoute;
			pinnedCta.dataset.cta = plan?.dataset.pinnedCtaName ?? defaultCtaName;
		};

		let frame = 0;
		const update = () => {
			frame = 0;
			const pastHero = heroCta.getBoundingClientRect().bottom < 0;
			const atEnquiry = enquiry.getBoundingClientRect().top < window.innerHeight;
			const show = pastHero && !atEnquiry;
			pinned.toggleAttribute("data-visible", show);
			pinnedCta.tabIndex = show ? 0 : -1;

			// Follow the card with the most visible height. This also handles cards
			// taller than two screens; a 50% intersection threshold never sees those.
			let activePlan: HTMLElement | undefined;
			let mostVisible = 0;
			const viewportBottom =
				window.innerHeight - (show ? pinned.getBoundingClientRect().height : 0);
			for (const plan of plans) {
				const rect = plan.getBoundingClientRect();
				const visible =
					Math.min(rect.bottom, viewportBottom) - Math.max(rect.top, 0);
				if (rect.width > 0 && visible > mostVisible) {
					activePlan = plan;
					mostVisible = visible;
				}
			}
			follow(activePlan);
		};
		const schedule = () => {
			if (!frame) frame = window.requestAnimationFrame(update);
		};
		window.addEventListener("scroll", schedule, { passive: true });
		window.addEventListener("resize", schedule, { passive: true });
		update();
	}
</script>

