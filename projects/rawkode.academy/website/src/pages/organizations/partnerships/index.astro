---
import { actions, isInputError } from "astro:actions";
import {
	type ContentEntry,
	disableContentCache,
	getCollection,
	getEntry,
} from "@/lib/live-content";
import PartnerLogos from "@/components/organizations/PartnerLogos.astro";
import PartnershipApplicationForm from "@/components/organizations/PartnershipApplicationForm.vue";
import ReviewPreview from "@/components/organizations/ReviewPreview.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	isVerbatimExcerpt,
	type PartnershipQuoteId,
	partnershipPullQuoteId,
	partnershipQuoteContext,
	partnershipQuoteExcerpts,
} from "@/lib/partnership-quotes";
import {
	type ApplicationPath,
	adoptionStages,
	fitProofReview,
	independenceRules,
	notSurePath,
	ongoingPartnershipOffer,
	PARTNERSHIP_EMAIL,
	type PartnershipOffer,
	partnershipAddOns,
	partnershipAdvice,
	partnershipCapacity,
	partnershipCredentials,
	partnershipDescription,
	partnershipExperience,
	partnershipFacts,
	partnershipPerks,
	partnershipReviewCredit,
	partnershipWatchEpisodes,
	productReviewScope,
	supporterOffer,
	teamBriefMailto,
	renewalPerks,
	resolveApplicationPath,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = false;

// The page renders enquiry results and rejected submissions from Astro
// actions, so it is never stored by the CDN or the browser.
disableContentCache(Astro);
Astro.response.headers.set("Cache-Control", "private, no-cache");

const applyHref = (path: ApplicationPath) =>
	`/organizations/partnerships?route=${encodeURIComponent(path)}#enquiry-form`;
const notSureApplyHref = applyHref(notSurePath);
const initialPath =
	resolveApplicationPath(Astro.url.searchParams.get("route")) ?? "Not sure yet";
const submittedEnquiry = Astro.getActionResult(actions.partnership.applyForm);
const submittedData = submittedEnquiry?.data;
const enquiryReceived =
	submittedData != null &&
	"success" in submittedData &&
	submittedData.success === true;
const enquiryRateLimited =
	submittedData != null &&
	"rateLimited" in submittedData &&
	submittedData.rateLimited === true;
const enquiryFallback =
	submittedData != null &&
	"fallback" in submittedData &&
	submittedData.fallback === "mailto";
const enquiryErrorCode =
	enquiryFallback &&
	submittedData != null &&
	"code" in submittedData &&
	typeof submittedData.code === "string"
		? submittedData.code
		: undefined;
const enquiryError = submittedEnquiry?.error;
const enquiryFields = ["name", "email", "company", "path", "message"] as const;
const serverFieldErrors =
	enquiryError && isInputError(enquiryError)
		? Object.fromEntries(
				enquiryFields.flatMap((field) => {
					const message = enquiryError.fields[field]?.find(
						(item) => item.length > 0,
					);
					return message ? [[field, message]] : [];
				}),
			)
		: {};
const emptySubmission = {
	name: "",
	email: "",
	company: "",
	path: "",
	message: "",
};
const submissionField = (formData: FormData, key: string) => {
	const value = formData.get(key);
	return typeof value === "string" ? value : "";
};
const readRejectedSubmission = async (request: Request) => {
	if (request.method !== "POST") return emptySubmission;
	try {
		const formData = await request.formData();
		return {
			name: submissionField(formData, "name"),
			email: submissionField(formData, "email"),
			company: submissionField(formData, "company"),
			path: submissionField(formData, "path"),
			message: submissionField(formData, "message"),
		};
	} catch {
		return emptySubmission;
	}
};
const submittedValues =
	enquiryError || enquiryRateLimited || enquiryFallback
		? await readRejectedSubmission(Astro.request)
		: emptySubmission;

const partnershipHeroTitle =
	"Get engineers further with your product, wherever they're stuck.";

// Content is optional on this page: the enquiry form must keep working when
// the content gateway is unavailable.
const owner = await getEntry("people", "rawkode").catch(() => undefined);
const ownerAvatar = owner?.data.avatarUrl
	? `${owner.data.avatarUrl}?s=96`
	: undefined;

/** Split "$12,000 a quarter" into the amount and the period after it. */
const splitPrice = (price: string) => {
	const match = price.match(/^(\$[\d,]+)(?:\s+(.+))?$/);
	return { amount: match?.[1] ?? price, period: match?.[2] };
};

interface PricingCard {
	offer: PartnershipOffer;
	route: ApplicationPath;
	period: string;
	cta: string;
	ctaName?: string;
	ctaLocation: string;
	featured?: boolean;
	lead?: string;
}

/** Fixed-price stages show "one-off, fixed"; quoted stages show no period. */
const stagePeriod = (offer: PartnershipOffer) =>
	offer.price.startsWith("$") ? "one-off, fixed" : undefined;

const pricingCards: PricingCard[] = [
	{
		offer: ongoingPartnershipOffer,
		route: "Ongoing partnership",
		period:
			splitPrice(ongoingPartnershipOffer.price).period ?? "a quarter",
		cta: "Ask about an ongoing partnership",
		ctaName: "ask_about_an_ongoing_partnership",
		ctaLocation: "pricing-ongoing",
		lead: "After any first engagement:",
	},
];

const pageSections = [
	{ id: "stages", label: "Where to start" },
	{ id: "pricing", label: "Keep going" },
	{ id: "independence", label: "Independence" },
	{ id: "supporter", label: "Supporter" },
	{ id: "questions", label: "FAQ" },
	{ id: "apply", label: "Enquire" },
];

const noLockIn = [
	{
		title: "Stop at any stage",
		detail:
			"Stop after a field report, a review or a workshop and that's all you pay. You keep everything it produced.",
	},
	{
		title: "Renew when it's working",
		detail:
			"An ongoing partnership goes quarter by quarter, or as a 12-month contract billed at $10,000 a quarter. Nothing renews automatically.",
	},
	{
		title: "You own the work",
		detail:
			"You own the reports, the read-outs and the example repositories.",
	},
];

const faqs = [
	{
		question: "Which stage should we start with?",
		answer:
			"The one where your engineers are stuck today. If you're not sure, tell me what you're seeing in the form below and I'll say which fits, or that none does yet.",
	},
	{
		question: "We already know where engineers get stuck. Do we need the review?",
		answer:
			"No. The review is one way in, not a gate. Teams that already have that data usually start with a field report or a workshop.",
	},
	{
		question: "How is a field report different from sponsoring a video?",
		answer:
			"Sponsorship buys airtime and a script. A field report pays for my time and judgement: I choose real problems, solve them with your product, publish what actually happens, labelled as paid, and tell you privately what I'd change.",
	},
	{
		question:
			"We could come on Rawkode Live for free. What does the review add?",
		answer:
			"A maintainer session is public, about an hour, and you are there steering, so I see the path you show me. In the review I work alone as your target user, with nobody to rescue me. I note every place I get stuck against the recording, rank what to fix, explain or teach and, if you continue, re-run it at day 90 to check what changed.",
	},
	{
		question: "Aren't you too experienced to get stuck where our users do?",
		answer:
			"Before starting we agree who I'm acting as, such as an application developer who has never run a cluster, and I work to what that person would know. The walkthrough call then checks the list against what your team already hears from users, so we focus on what matters most to them.",
	},
	{
		question: "What exactly does the review cover?",
		answer: productReviewScope,
	},
	{
		question: "How much of our engineers' time does it take?",
		answer:
			"Not much. For a field report or a review, an hour or two to set up access, plus the walkthrough call. For a workshop, whoever presents with me. I write the examples. In an ongoing partnership, your product lead joins the monthly sessions.",
	},
	{
		question: "Who on our side should own it?",
		answer:
			"It depends on the stage: marketing or developer relations for a field report, developer experience or product for a getting-started review, product or solutions engineering for a production review, and customer success or education for workshops.",
	},
	{
		question: "Why are places limited?",
		answer:
			"I do every review and partnership myself, so I keep the number of partners small and give each one my full attention.",
	},
	{
		question: "Can we sponsor content as well?",
		answer:
			"A field report is paid content, on the terms above. For something lighter, community supporters get their docs, latest announcement and a supporter badge on their technology page and on every video about their technology, from $1,000 a month.",
	},
	{
		question: "Do open-source maintainers have to pay to come on Rawkode Live?",
		answer:
			"Maintainer sessions on Rawkode Live are free, as they always have been, and aren't labelled as paid. Partnerships are for teams who want the stage work and the advice around it.",
	},
];

// Excerpts are checked against their testimonials in CI
// (src/tests/partnership-quotes.test.ts). A quote that no longer matches is
// left out here rather than failing the request.
const testimonials: ContentEntry<"testimonials">[] = await getCollection(
	"testimonials",
).catch(() => []);
const quoteFor = (id: PartnershipQuoteId) => {
	const entry = testimonials.find((item) => item.id === id);
	const excerpt = partnershipQuoteExcerpts[id];
	if (!entry || !isVerbatimExcerpt(entry.data.quote, excerpt)) return undefined;
	return { id, excerpt, author: entry.data.author };
};
const pullQuote = quoteFor(partnershipPullQuoteId);
const partnerQuotes = (
	Object.keys(
		partnershipQuoteContext,
	) as (keyof typeof partnershipQuoteContext)[]
).flatMap((id) => {
	const quote = quoteFor(id);
	return quote ? [{ ...quote, context: partnershipQuoteContext[id] }] : [];
});
---

<Page
	title="Partnerships for developer tool companies"
	subtitle={partnershipHeroTitle}
	description={partnershipDescription}
>
	<EditorialShell
		eyebrow="Partnerships"
		title={partnershipHeroTitle}
		lede="I teach engineers new tools, live and unscripted. Work with me at the stage your engineers are stuck: finding you, getting it working, running it in production, or getting better with it."
	>
		<dl class="partnership-facts" slot="intro">
			<div>
				<dt>Start at</dt>
				<dd>Any stage</dd>
			</div>
			<div>
				<dt>From</dt>
				<dd>{fitProofReview.price} fixed</dd>
			</div>
		</dl>
		<div class="partnership-hero-actions" slot="actions">
			<a id="partnership-hero-cta" class="editorial-button" href={notSureApplyHref} data-apply-path={notSurePath} data-partnership-cta data-cta="tell_me_where_youre_stuck" data-cta-location="hero">Tell me where you're stuck</a>
			<a class="partnership-text-link" href="#stages">See the four stages</a>
		</div>
		<div class="partnership-watch" slot="actions">
			<p id="partnership-watch-title">Watch me try a new tool live</p>
			<ul aria-labelledby="partnership-watch-title">
				{partnershipWatchEpisodes.map((episode) => (
					<li><a href={episode.href} data-partnership-cta data-cta={`watch_${episode.label.toLowerCase()}`} data-cta-location="hero-watch"><span aria-hidden="true">▶</span> {episode.label}</a></li>
				))}
			</ul>
		</div>
		<div class="partnership-byline" slot="actions">
			<div class="partnership-byline__who">
				{ownerAvatar && <img src={ownerAvatar} alt="" width="48" height="48" loading="eager" decoding="async" />}
				<p><strong>David Flanagan</strong><span>Runs Rawkode Academy and Rawkode Live</span></p>
			</div>
			<p class="partnership-byline__bio">{partnershipExperience.map((part) => part.href ? <a href={part.href} rel={part.href.startsWith("http") ? "noopener" : undefined}>{part.text}</a> : part.text)}</p>
			<ul class="partnership-byline__facts">
				{partnershipFacts.map((fact) => <li>{fact}</li>)}
			</ul>
			<ul class="partnership-byline__credentials" aria-label="Linux Foundation badges">
				{partnershipCredentials.map((credential) => (
					<li><a href={credential.href} rel="noopener">{credential.label} <span aria-hidden="true">↗</span></a></li>
				))}
			</ul>
		</div>

		<nav class="partnership-rail" aria-label="On this page">
			<ul>
				{pageSections.map((section) => <li><a href={`#${section.id}`}>{section.label}</a></li>)}
			</ul>
		</nav>

		<section id="who-ive-worked-with" class="editorial-section" aria-labelledby="who-ive-worked-with-title">
			<p id="who-ive-worked-with-title" class="partnership-label">Teams I've worked with</p>
			<PartnerLogos />
		</section>

		{pullQuote && (
		<section id="pull-quote" class="editorial-section" aria-label="What builders say">
			<figure class="partnership-pull-quote">
				<blockquote>{pullQuote.excerpt}</blockquote>
				<figcaption><strong>{pullQuote.author.name}</strong>, {pullQuote.author.title}</figcaption>
			</figure>
		</section>
		)}

		<section id="stages" class="editorial-section" aria-labelledby="stages-title">
			<div class="partnership-pricing__header">
				<div class="editorial-section__header">
					<h2 id="stages-title" class="editorial-section__title">Start where your engineers are stuck</h2>
					<p class="editorial-section__lede">Four stages of adoption, each with its own first piece of work. Pick one; you don't need the others first.</p>
					<p class="partnership-label">{partnershipCapacity.places} partner places · {partnershipCapacity.newStartsPerMonth} new starts a month</p>
				</div>
				<p class="partnership-credit">{partnershipAdvice}</p>
			</div>
			<ol class="partnership-stages">
				{adoptionStages.map((stage, index) => {
					const { amount } = splitPrice(stage.offer.price);
					const period = stagePeriod(stage.offer);
					return (
						<li>
							<article
								class="partnership-plan partnership-stage"
								aria-labelledby={`plan-${stage.offer.id}`}
								data-pinned-name={stage.offer.name}
								data-pinned-price={period ? `${amount} · ${period}` : stage.offer.price}
								data-pinned-route={stage.route}
								data-pinned-href={applyHref(stage.route)}
								data-pinned-cta={stage.cta}
							>
								<p class="partnership-stage__kicker"><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span> {stage.stage}</p>
								<p class="partnership-stage__problem">{stage.problem}</p>
								<div class="partnership-plan__heading">
									<h3 id={`plan-${stage.offer.id}`}>{stage.offer.name}</h3>
								</div>
								<p class:list={["partnership-plan__price", !period && "partnership-plan__price--quoted"]}><span>{amount}</span> {period && <span class="partnership-plan__period">{period}</span>}</p>
								<p class="partnership-plan__cadence">{stage.offer.cadence}</p>
								<p class="partnership-plan__summary">{stage.offer.summary}</p>
								<div class="partnership-plan__body">
									<ul class="partnership-plan__list">
										{stage.offer.included.map((item) => <li>{item}</li>)}
									</ul>
									{stage.offer.notes.map((note) => <p class="partnership-plan__note">{note}</p>)}
									<p class="partnership-plan__note">{stage.owner}</p>
								</div>
								<a
									class="editorial-button editorial-button--secondary"
									href={applyHref(stage.route)}
									data-apply-path={stage.route}
									data-partnership-cta
									data-cta={stage.cta.toLowerCase().replaceAll(/[^a-z]+/g, "_")}
									data-cta-location={stage.ctaLocation}
								>{stage.cta}</a>
							</article>
						</li>
					);
				})}
			</ol>
			<div class="partnership-review-preview">
				<p class="partnership-label">What a getting-started or production review hands over</p>
				<ReviewPreview placement="always" />
			</div>
		</section>

		{partnerQuotes.length > 0 && (
		<section id="partner-quotes" class="editorial-section" aria-labelledby="partner-quotes-title">
			<div class="editorial-section__header">
				<h2 id="partner-quotes-title" class="editorial-section__title">What partners say</h2>
			</div>
			<ul class="partnership-quotes">
				{partnerQuotes.map(({ excerpt, author, context }) => (
					<li>
						<figure>
							<p class="partnership-label">{context}</p>
							<blockquote>{excerpt}</blockquote>
							<figcaption>
								{author.link ? <a href={author.link}>{author.name}</a> : <strong>{author.name}</strong>}
								<span>{author.title}</span>
							</figcaption>
						</figure>
					</li>
				))}
			</ul>
		</section>
		)}

		<section id="fit" class="editorial-section editorial-section--split" aria-labelledby="fit-title">
			<div class="editorial-section__header">
				<h2 id="fit-title" class="editorial-section__title">Teams I work best with</h2>
			</div>
			<ul class="partnership-fit">
				<li>You build developer tools: infrastructure tools, Kubernetes and cloud native projects, cloud platforms or AI infrastructure.</li>
				<li>An engineer can install or sign up for your product and try it, including open-source projects installed from GitHub or Helm.</li>
				<li>Any size of company, from a first open-source release to a public company.</li>
			</ul>
		</section>

		<section id="pricing" class="editorial-section" aria-labelledby="pricing-title">
			<div class="partnership-pricing__header">
				<div class="editorial-section__header">
					<h2 id="pricing-title" class="editorial-section__title">Keep going</h2>
					<p class="editorial-section__lede">When a first engagement is useful, carry on quarter by quarter and choose each quarter's work as you go.</p>
				</div>
				<p class="partnership-credit">{partnershipReviewCredit}</p>
				<a class="partnership-text-link" href={teamBriefMailto} data-partnership-cta data-cta="send_to_team" data-cta-location="pricing-brief">Send this to your team</a>
			</div>
			<div class="partnership-pricing">
				{pricingCards.map((card) => {
					const { amount } = splitPrice(card.offer.price);
					return (
						<article
							class:list={["partnership-plan", card.featured && "partnership-plan--featured"]}
							aria-labelledby={`plan-${card.offer.id}`}
							data-pinned-name={card.offer.name}
							data-pinned-price={`${amount} · ${card.period}`}
							data-pinned-route={card.route}
							data-pinned-href={applyHref(card.route)}
							data-pinned-cta={card.cta}
							data-pinned-cta-name={card.ctaName}
						>
							<div class="partnership-plan__heading">
								<h3 id={`plan-${card.offer.id}`}>{card.offer.name}</h3>
								{card.featured && <span class="partnership-plan__badge">Start here</span>}
							</div>
							<p class="partnership-plan__price"><span>{amount}</span> <span class="partnership-plan__period">{card.period}</span></p>
							<p class="partnership-plan__cadence">{card.offer.cadence}</p>
							{card.featured && <p class="partnership-plan__summary">{card.offer.summary}</p>}
							<div class="partnership-plan__body">
								{card.lead && <p class="partnership-plan__lead">{card.lead}</p>}
								<ul class="partnership-plan__list">
									{card.offer.included.map((item) => <li>{item}</li>)}
								</ul>
								{card.offer.notes.map((note) => <p class="partnership-plan__note">{note}</p>)}
							</div>
							<a
								class:list={["editorial-button", !card.featured && "editorial-button--secondary"]}
								href={applyHref(card.route)}
								data-apply-path={card.route}
								data-partnership-cta
								data-cta={card.ctaName}
								data-cta-location={card.ctaLocation}
							>{card.cta}</a>
						</article>
					);
				})}
			</div>
			<div class="partnership-addons">
				<h3 id="addons-title" class="partnership-label">Add-ons</h3>
				<ul>
					{partnershipAddOns.map((addOn) => (
						<li>
							<p class="partnership-addons__heading"><strong>{addOn.title}</strong> <span>{addOn.price}</span></p>
							<p>{addOn.detail}</p>
							<a
								class="partnership-text-link"
								href={applyHref(addOn.route)}
								data-apply-path={addOn.route}
								data-partnership-cta
								data-cta={`ask_about_${addOn.id.replaceAll("-", "_")}`}
								data-cta-location="pricing-addon"
							>{addOn.cta}</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section id="perks" class="editorial-section editorial-section--split" aria-labelledby="perks-title">
			<div class="editorial-section__header">
				<h2 id="perks-title" class="editorial-section__title">What else you get</h2>
				<p class="editorial-section__lede">Ongoing partners get these, on top of the stage work.</p>
			</div>
			<div class="partnership-perks">
				<h3 class="partnership-label">Every ongoing partnership</h3>
				<ul>
					{partnershipPerks.map((perk) => (
						<li>
							<strong>{perk.title}</strong>
							<p>{perk.detail}</p>
						</li>
					))}
				</ul>
				<details class="partnership-perks__renew">
					<summary class="partnership-label">When you renew ({renewalPerks.length})</summary>
					<ul>
						{renewalPerks.map((perk) => (
							<li>
								<strong>{perk.title}</strong>
								<p>{perk.detail}</p>
							</li>
						))}
					</ul>
				</details>
			</div>
		</section>

		<section id="no-lock-in" class="editorial-section" aria-labelledby="no-lock-in-title">
			<div class="partnership-terms">
				<h2 id="no-lock-in-title">Simple terms</h2>
				<ul>
					{noLockIn.map((term) => (
						<li>
							<strong>{term.title}</strong>
							<span>{term.detail}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section id="independence" class="editorial-section editorial-section--split" aria-labelledby="independence-title">
			<div class="editorial-section__header">
				<h2 id="independence-title" class="editorial-section__title">How paid work stays honest</h2>
				<p class="editorial-section__lede">Engineers trust what I show them because nobody scripts it. These rules apply to every stage, and they're why the work is worth paying for.</p>
			</div>
			<ul class="partnership-fit partnership-independence">
				{independenceRules.map((rule) => (
					<li><strong>{rule.title}.</strong> {rule.detail}</li>
				))}
			</ul>
		</section>

		<section id="supporter" class="editorial-section editorial-section--split" aria-labelledby="supporter-title">
			<div class="editorial-section__header">
				<h2 id="supporter-title" class="editorial-section__title">Fund free content for the community</h2>
				<p class="editorial-section__lede">{supporterOffer.summary}</p>
			</div>
			<article
				class="partnership-plan partnership-supporter"
				aria-labelledby={`plan-${supporterOffer.id}`}
				data-pinned-name={supporterOffer.name}
				data-pinned-price={supporterOffer.price}
				data-pinned-route="Community supporter"
				data-pinned-href={applyHref("Community supporter")}
				data-pinned-cta="Become a supporter"
				data-pinned-cta-name="become_a_supporter"
			>
				<div class="partnership-plan__heading">
					<h3 id={`plan-${supporterOffer.id}`}>{supporterOffer.name}</h3>
				</div>
				<p class="partnership-plan__price"><span>{splitPrice(supporterOffer.price).amount}</span> <span class="partnership-plan__period">{splitPrice(supporterOffer.price).period}</span></p>
