---
import { actions, isInputError } from "astro:actions";
import {
	type ContentEntry,
	disableContentCache,
	getCollection,
	getEntry,
} from "@/lib/live-content";
import PartnerLogos from "@/components/organizations/PartnerLogos.astro";
import PartnershipApplicationForm from "@/components/organizations/PartnershipApplicationForm.vue";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	isVerbatimExcerpt,
	type PartnershipQuoteId,
	partnershipPullQuoteId,
	partnershipQuoteContext,
	partnershipQuoteExcerpts,
} from "@/lib/partnership-quotes";
import {
	type ApplicationPath,
	adoptionStages,
	bespokeProjectOffer,
	supportAcademyOffer,
	independenceRules,
	ongoingPartnershipOffer,
	ongoingQuarterExample,
	PARTNERSHIP_EMAIL,
	partnershipAddOns,
	partnershipCredentials,
	partnershipDescription,
	partnershipExperience,
	partnershipFacts,
	partnershipOwnership,
	partnershipWatchEpisodes,
	teamBriefMailto,
	resolveApplicationPath,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = false;

// The page renders enquiry results and rejected submissions from Astro
// actions, so it is never stored by the CDN or the browser.
disableContentCache(Astro);
Astro.response.headers.set("Cache-Control", "private, no-cache");

const applyHref = (path: ApplicationPath) =>
	`/organizations/partnerships?route=${encodeURIComponent(path)}#enquiry-form`;
const partnershipPath = "Partnership" satisfies ApplicationPath;
const supportAcademyPath = "Support the Academy" satisfies ApplicationPath;
const supportAcademyApplyHref = applyHref(supportAcademyPath);
const initialPath =
	resolveApplicationPath(Astro.url.searchParams.get("route")) ?? supportAcademyPath;
const submittedEnquiry = Astro.getActionResult(actions.partnership.applyForm);
const submittedData = submittedEnquiry?.data;
const enquiryReceived =
	submittedData != null &&
	"success" in submittedData &&
	submittedData.success === true;
const enquiryRateLimited =
	submittedData != null &&
	"rateLimited" in submittedData &&
	submittedData.rateLimited === true;
const enquiryFallback =
	submittedData != null &&
	"fallback" in submittedData &&
	submittedData.fallback === "mailto";
const enquiryErrorCode =
	enquiryFallback &&
	submittedData != null &&
	"code" in submittedData &&
	typeof submittedData.code === "string"
		? submittedData.code
		: undefined;
const enquiryError = submittedEnquiry?.error;
const enquiryFields = ["name", "email", "company", "path", "message"] as const;
const serverFieldErrors =
	enquiryError && isInputError(enquiryError)
		? Object.fromEntries(
				enquiryFields.flatMap((field) => {
					const message = enquiryError.fields[field]?.find(
						(item) => item.length > 0,
					);
					return message ? [[field, message]] : [];
				}),
			)
		: {};
const emptySubmission = {
	name: "",
	email: "",
	company: "",
	path: "",
	message: "",
};
const submissionField = (formData: FormData, key: string) => {
	const value = formData.get(key);
	return typeof value === "string" ? value : "";
};
const readRejectedSubmission = async (request: Request) => {
	if (request.method !== "POST") return emptySubmission;
	try {
		const formData = await request.formData();
		return {
			name: submissionField(formData, "name"),
			email: submissionField(formData, "email"),
			company: submissionField(formData, "company"),
			path: submissionField(formData, "path"),
			message: submissionField(formData, "message"),
		};
	} catch {
		return emptySubmission;
	}
};
const submittedValues =
	enquiryError || enquiryRateLimited || enquiryFallback
		? await readRejectedSubmission(Astro.request)
		: emptySubmission;

const partnershipHeroTitle =
	"Make your product the one engineers reach for.";

// Content is optional on this page: the enquiry form must keep working when
// the content gateway is unavailable.
const owner = await getEntry("people", "rawkode").catch(() => undefined);
const ownerAvatar = owner?.data.avatarUrl
	? `${owner.data.avatarUrl}?s=96`
	: undefined;

/** Split "$12,000 a quarter" into the amount and the period after it. */
const splitPrice = (price: string) => {
	const match = price.match(/^(\$[\d,]+)(?:\s+(.+))?$/);
	return { amount: match?.[1] ?? price, period: match?.[2] };
};

const ongoingPath = partnershipPath;
const ongoingPrice = splitPrice(ongoingPartnershipOffer.price);
const supportAcademyPrice = splitPrice(supportAcademyOffer.price);
const challengeOffer = partnershipAddOns[0];

const pageSections = [
	{ id: "pricing", label: "Support & partnership" },
	{ id: "stages", label: "The work" },
	{ id: "bespoke", label: "Bespoke projects" },
	{ id: "challenges", label: "Community challenges" },
	{ id: "questions", label: "FAQ" },
	{ id: "apply", label: "Enquire" },
];

const noLockIn = [
	{
		title: "Agreed before we start",
		detail: "We agree the priorities, deliverables, dates and review rounds in writing. Bespoke projects and community challenges are scoped separately.",
	},
	{
		title: "Partnership renewal",
		detail: "Work quarter by quarter, or as a 12-month contract billed at $10,000 a quarter. Nothing renews automatically.",
	},
	{
		title: "You keep the work",
		detail: partnershipOwnership,
	},
];

const faqs = [
	{
		question: "Where should we start?",
		answer: "Choose 'Support the Academy' to help fund free developer education and give your team a visible place in the Academy. A Partnership adds agreed hands-on engineering, content and community work around your product. Bespoke projects and community challenges are scoped separately.",
	},
	{
		question: "Does the partnership cover all three areas?",
		answer: "Awareness, Adoption, and Support describe the work we can do together. Each quarter has agreed priorities and outputs, based on what your users and team need most. We review that plan together as the work progresses.",
	},
	{
		question: "What does Support cover?",
		answer: "Docs, runnable examples, community participation, technical Q&A, public speaking, conference workshops, customer education and office hours. We choose the work your users need and agree its scope and frequency.",
	},
	{
		question: "Can we commission event content or a specific project?",
		answer: "Yes. Bespoke projects can include technical hosting, interviews, live builds, workshops or a defined piece of content. We agree preparation, production, travel, publication channels and reuse rights before quoting.",
	},
	{
		question: "How much of our engineers' time does it take?",
		answer: "I need access to the product, someone who knows your users and someone to check technical accuracy. We agree preparation and review time with the scope. Partnership working sessions are monthly and last 60 minutes.",
	},
	{
		question: "How do you account for different levels of experience?",
		answer: "I bring an experienced engineer's perspective. We define the intended users and what they should need to know, then compare the findings with your user feedback and support questions. An expert review complements evidence from real users.",
	},
	{
		question: "Who on our side should own it?",
		answer: "Choose someone who can set priorities and get the right people involved. That's often marketing or DevRel for awareness, product or developer experience for adoption, and community, customer success or DevRel for support.",
	},
	{
		question: "Do open-source maintainers have to pay to come on Rawkode Live?",
		answer: "Maintainer sessions on Rawkode Live are free, as they always have been. Partnerships pay for agreed engineering, content and community work around your product.",
	},
];

// Excerpts are checked against their testimonials in CI
// (src/tests/partnership-quotes.test.ts). A quote that no longer matches is
// left out here rather than failing the request.
const testimonials: ContentEntry<"testimonials">[] = await getCollection(
	"testimonials",
).catch(() => []);
const quoteFor = (id: PartnershipQuoteId) => {
	const entry = testimonials.find((item) => item.id === id);
	const excerpt = partnershipQuoteExcerpts[id];
	if (!entry || !isVerbatimExcerpt(entry.data.quote, excerpt)) return undefined;
	return { id, excerpt, author: entry.data.author };
};
const pullQuote = quoteFor(partnershipPullQuoteId);
const partnerQuotes = (
	Object.keys(
		partnershipQuoteContext,
	) as (keyof typeof partnershipQuoteContext)[]
).flatMap((id) => {
	const quote = quoteFor(id);
	return quote ? [{ ...quote, context: partnershipQuoteContext[id] }] : [];
});
---

<Page
	title="Partnerships for developer tool companies"
	subtitle={partnershipHeroTitle}
	description={partnershipDescription}
>
	<EditorialShell
		eyebrow="Partnerships"
		title={partnershipHeroTitle}
		lede="I work hands-on with your product to show engineers what it can do, find where they get stuck and help them be successful from dev to prod."
	>
		<dl class="partnership-facts" slot="intro">
			<div>
				<dt>Support the Academy</dt>
				<dd>{supportAcademyOffer.price}</dd>
			</div>
			<div>
				<dt>Partnership</dt>
				<dd>{ongoingPartnershipOffer.price}</dd>
			</div>
		</dl>
		<div class="partnership-hero-actions" slot="actions">
			<a id="partnership-hero-cta" class="editorial-button" href={supportAcademyApplyHref} data-apply-path={supportAcademyPath} data-partnership-cta data-cta="support_the_academy" data-cta-location="hero">Support the Academy</a>
			<a class="partnership-text-link" href="#plan-partnership">Explore a partnership</a>
		</div>
		<div class="partnership-watch" slot="actions">
			<p id="partnership-watch-title">Watch me try a new tool live</p>
			<ul aria-labelledby="partnership-watch-title">
				{partnershipWatchEpisodes.map((episode) => (
					<li><a href={episode.href} data-partnership-cta data-cta={`watch_${episode.label.toLowerCase()}`} data-cta-location="hero-watch"><span aria-hidden="true">▶</span> {episode.label}</a></li>
				))}
			</ul>
		</div>
		<div class="partnership-byline" slot="actions">
			<div class="partnership-byline__who">
				{ownerAvatar && <img src={ownerAvatar} alt="" width="48" height="48" loading="eager" decoding="async" />}
				<p><strong>David Flanagan</strong><span>Runs Rawkode Academy and Rawkode Live</span></p>
			</div>
			<p class="partnership-byline__bio">{partnershipExperience.map((part) => part.href ? <a href={part.href} rel={part.href.startsWith("http") ? "noopener" : undefined}>{part.text}</a> : part.text)}</p>
			<ul class="partnership-byline__facts">
				{partnershipFacts.map((fact) => <li>{fact}</li>)}
			</ul>
			<ul class="partnership-byline__credentials" aria-label="Linux Foundation badges">
				{partnershipCredentials.map((credential) => (
					<li><a href={credential.href} rel="noopener">{credential.label} <span aria-hidden="true">↗</span></a></li>
				))}
			</ul>
		</div>

		<nav class="partnership-rail" aria-label="On this page">
			<ul>
				{pageSections.map((section) => <li><a href={`#${section.id}`}>{section.label}</a></li>)}
			</ul>
		</nav>

		<section id="pricing" class="editorial-section" aria-labelledby="pricing-title">
			<div class="partnership-pricing__header">
				<div class="editorial-section__header">
					<h2 id="pricing-title" class="editorial-section__title">Support the Academy or work together</h2>
					<p class="editorial-section__lede">Help fund free developer education, with your company credited alongside the work. A Partnership adds agreed hands-on engineering, content and community work around your product.</p>
				</div>
				<a class="partnership-text-link" href={teamBriefMailto} data-partnership-cta data-cta="send_to_team" data-cta-location="pricing-brief">Send this to your team</a>
			</div>
			<div class="partnership-main">
				<article id="supporter" class="partnership-plan partnership-academy-support"
					aria-labelledby={`plan-${supportAcademyOffer.id}`}
					data-pinned-name={supportAcademyOffer.name} data-pinned-price={supportAcademyOffer.price}
					data-pinned-route={supportAcademyPath} data-pinned-href={supportAcademyApplyHref}
					data-pinned-cta="Support the Academy" data-pinned-cta-name="support_the_academy">
					<div class="partnership-plan__heading"><h3 id={`plan-${supportAcademyOffer.id}`}>{supportAcademyOffer.name}</h3></div>
					<p class="partnership-plan__price"><span>{supportAcademyPrice.amount}</span> <span class="partnership-plan__period">{supportAcademyPrice.period}</span></p>
					<p class="partnership-plan__cadence">{supportAcademyOffer.cadence}</p>
					<p class="partnership-plan__summary">{supportAcademyOffer.summary}</p>
					<ul class="partnership-plan__list">{supportAcademyOffer.included.map((item) => <li>{item}</li>)}</ul>
					{supportAcademyOffer.notes.map((note) => <p class="partnership-plan__note">{note}</p>)}
					<a class="editorial-button" href={supportAcademyApplyHref} data-apply-path={supportAcademyPath} data-partnership-cta data-cta="support_the_academy" data-cta-location="pricing-support">Support the Academy</a>
				</article>
				<div class="partnership-details">
					<article
						class="partnership-plan partnership-ongoing"
						aria-labelledby={`plan-${ongoingPartnershipOffer.id}`}
						data-pinned-name={ongoingPartnershipOffer.name}
						data-pinned-price={ongoingPartnershipOffer.price}
						data-pinned-route={ongoingPath}
						data-pinned-href={applyHref(ongoingPath)}
						data-pinned-cta="Ask about a partnership"
						data-pinned-cta-name="ask_about_a_partnership"
					>
						<div class="partnership-plan__heading"><h3 id={`plan-${ongoingPartnershipOffer.id}`}>{ongoingPartnershipOffer.name}</h3></div>
						<p class="partnership-plan__price"><span>{ongoingPrice.amount}</span> <span class="partnership-plan__period">{ongoingPrice.period}</span></p>
						<p class="partnership-plan__cadence">{ongoingPartnershipOffer.cadence}</p>
						<p class="partnership-plan__summary">{ongoingPartnershipOffer.summary}</p>
						<ul class="partnership-plan__list">{ongoingPartnershipOffer.included.map((item) => <li>{item}</li>)}</ul>
						{ongoingPartnershipOffer.notes.map((note) => <p class="partnership-plan__note">{note}</p>)}
						<a class="editorial-button" href={applyHref(ongoingPath)} data-apply-path={ongoingPath} data-partnership-cta data-cta="ask_about_a_partnership" data-cta-location="pricing-ongoing">Ask about a partnership</a>
					</article>
					<div class="partnership-quarter-example" aria-labelledby="quarter-example-title">
						<h3 id="quarter-example-title">An example quarter</h3>
						<p>A review and a practical build around one agreed developer workflow. Your statement of work fixes the deliverables, dates and review rounds.</p>
						<ul class="partnership-plan__list">{ongoingQuarterExample.map((item) => <li>{item}</li>)}</ul>
					</div>
				</div>
			</div>
		</section>

		<section id="stages" class="editorial-section" aria-labelledby="stages-title">
			<div class="editorial-section__header">
				<h2 id="stages-title" class="editorial-section__title">Awareness, Adoption, and Support</h2>
				<p class="editorial-section__lede">We choose the work that helps your engineers next, from discovering the product to succeeding with it in production.</p>
			</div>
			<ul class="partnership-work-areas">
				{adoptionStages.map((stage) => (
					<li aria-labelledby={`work-${stage.id}`}>
						<div>
							<h3 id={`work-${stage.id}`}>{stage.stage}</h3>
							<p class="partnership-label">{stage.tagline}</p>
						</div>
						<div class="partnership-work-area__body">
							<p>{stage.summary}</p>
							<ul>{stage.activities.map((activity) => <li>{activity}</li>)}</ul>
						</div>
					</li>
				))}
			</ul>
		</section>

		<section id="measurement" class="editorial-section editorial-section--split" aria-labelledby="measurement-title">
			<div class="editorial-section__header">
				<h2 id="measurement-title" class="editorial-section__title">Agree what success looks like</h2>
				<p class="editorial-section__lede">Before we start, we agree what you want engineers to be able to do, the starting point and how we'll assess the work.</p>
			</div>
			<div class="partnership-steps-body">
				<p>We choose useful measures and agree who provides the data. At the read-out, you get the findings, what changed and recommended next steps.</p>
				<ul class="partnership-fit">
					<li><strong>Awareness:</strong> relevant reach, engaged viewing, tagged referrals and use of published examples where measurable. Organic performance and paid amplification are reported separately.</li>
					<li><strong>Adoption:</strong> reproducible obstacles and ranked fixes. If a retest is included, we check the agreed workflow again after your team makes changes.</li>
					<li><strong>Support:</strong> questions addressed, use of learning materials, participation and recurring problems, using the evidence available for the agreed work.</li>
				</ul>
				<p>Activation and retention need product data from your team. We report observed changes and the limits of the evidence. An expert review does not replace research with your users, and results are not guaranteed.</p>
			</div>
		</section>

		<section id="who-ive-worked-with" class="editorial-section" aria-labelledby="who-ive-worked-with-title">
			<p id="who-ive-worked-with-title" class="partnership-label">Teams I've worked with</p>
			<PartnerLogos />
		</section>

		{pullQuote && (
		<section id="pull-quote" class="editorial-section" aria-label="What builders say">
			<figure class="partnership-pull-quote">
				<blockquote>{pullQuote.excerpt}</blockquote>
				<figcaption><strong>{pullQuote.author.name}</strong>, {pullQuote.author.title}</figcaption>
			</figure>
		</section>
		)}

		{partnerQuotes.length > 0 && (
		<section id="partner-quotes" class="editorial-section" aria-labelledby="partner-quotes-title">
			<div class="editorial-section__header">
				<h2 id="partner-quotes-title" class="editorial-section__title">What partners say</h2>
			</div>
			<ul class="partnership-quotes">
				{partnerQuotes.map(({ excerpt, author, context }) => (
					<li>
						<figure>
							<p class="partnership-label">{context}</p>
							<blockquote>{excerpt}</blockquote>
							<figcaption>
								{author.link ? <a href={author.link}>{author.name}</a> : <strong>{author.name}</strong>}
								<span>{author.title}</span>
							</figcaption>
						</figure>
					</li>
				))}
			</ul>
		</section>
		)}

		<section id="fit" class="editorial-section editorial-section--split" aria-labelledby="fit-title">
			<div class="editorial-section__header">
				<h2 id="fit-title" class="editorial-section__title">Teams I work best with</h2>
			</div>
			<ul class="partnership-fit">
				<li>You build developer tools: infrastructure tools, Kubernetes and cloud native projects, cloud platforms or AI infrastructure.</li>
				<li>An engineer can install or sign up for your product and try it, including open-source projects installed from GitHub or Helm.</li>
				<li>Any size of company, from a first open-source release to a public company.</li>
				<li>You have a clear priority for your users and someone who can provide access, check technical accuracy and help act on the findings.</li>
			</ul>
		</section>

		<section id="bespoke" class="editorial-section editorial-section--split" aria-labelledby="bespoke-title">
			<div class="editorial-section__header">
				<h2 id="bespoke-title" class="editorial-section__title">Bespoke projects</h2>
				<p class="editorial-section__lede">A specific piece of work, with a clear scope and a price agreed before we start.</p>
			</div>
			<article class="partnership-plan" aria-labelledby={`plan-${bespokeProjectOffer.id}`}
				data-pinned-name={bespokeProjectOffer.name} data-pinned-price={bespokeProjectOffer.price}
				data-pinned-route="Bespoke project" data-pinned-href={applyHref("Bespoke project")}
				data-pinned-cta="Discuss a project" data-pinned-cta-name="discuss_a_project">
				<div class="partnership-plan__heading"><h3 id={`plan-${bespokeProjectOffer.id}`}>{bespokeProjectOffer.name}</h3></div>
				<p class="partnership-plan__price partnership-plan__price--quoted"><span>{bespokeProjectOffer.price}</span></p>
				<p class="partnership-plan__summary">{bespokeProjectOffer.summary}</p>
				<ul class="partnership-plan__list">{bespokeProjectOffer.included.map((item) => <li>{item}</li>)}</ul>
				{bespokeProjectOffer.notes.map((note) => <p class="partnership-plan__note">{note}</p>)}
				<a class="editorial-button editorial-button--secondary" href={applyHref("Bespoke project")} data-apply-path="Bespoke project" data-partnership-cta data-cta="discuss_a_project" data-cta-location="bespoke">Discuss a project</a>
			</article>
		</section>

		<section id="challenges" class="editorial-section editorial-section--split" aria-labelledby="challenges-title">
			<div class="editorial-section__header">
				<h2 id="challenges-title" class="editorial-section__title">Community challenges</h2>
				<p class="editorial-section__lede">Give engineers a reason to build, experiment and share what they learn.</p>
			</div>
			<article class="partnership-plan" aria-labelledby={`plan-${challengeOffer.id}`}
				data-pinned-name={challengeOffer.title} data-pinned-price={challengeOffer.price}
				data-pinned-route={challengeOffer.route} data-pinned-href={applyHref(challengeOffer.route)}
				data-pinned-cta={challengeOffer.cta} data-pinned-cta-name="ask_about_a_challenge_series">
				<div class="partnership-plan__heading"><h3 id={`plan-${challengeOffer.id}`}>{challengeOffer.title}</h3></div>
				<p class="partnership-plan__price partnership-plan__price--quoted"><span>{challengeOffer.price}</span></p>
				<p class="partnership-plan__summary">{challengeOffer.detail}</p>
				<a class="editorial-button editorial-button--secondary" href={applyHref(challengeOffer.route)} data-apply-path={challengeOffer.route} data-partnership-cta data-cta="ask_about_a_challenge_series" data-cta-location="challenges">{challengeOffer.cta}</a>
			</article>
		</section>

		<section id="no-lock-in" class="editorial-section" aria-labelledby="no-lock-in-title">
			<div class="partnership-terms">
				<h2 id="no-lock-in-title">Simple terms</h2>
				<ul>
					{noLockIn.map((term) => (
						<li>
							<strong>{term.title}</strong>
							<span>{term.detail}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section id="independence" class="editorial-section editorial-section--split" aria-labelledby="independence-title">
			<div class="editorial-section__header">
				<h2 id="independence-title" class="editorial-section__title">Independent public work</h2>
				<p class="editorial-section__lede">Your team helps set the scope and checks technical accuracy. What I publish about the product reflects my experience of using it.</p>
			</div>
			<ul class="partnership-fit partnership-independence">
				{independenceRules.map((rule) => (
					<li><strong>{rule.title}.</strong> {rule.detail}</li>
				))}
			</ul>
		</section>

		<section id="questions" class="editorial-section editorial-section--split" aria-labelledby="questions-title">
			<div class="editorial-section__header">
				<h2 id="questions-title" class="editorial-section__title">Questions</h2>
				<p class="editorial-section__lede">Something else? Email <a class="partnership-text-link" href={`mailto:${PARTNERSHIP_EMAIL}`}>{PARTNERSHIP_EMAIL}</a></p>
			</div>
			<div class="partnership-faq">
				{faqs.map((faq) => (
					<details>
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section id="apply" class="editorial-section editorial-section--split partnerships-apply" aria-labelledby="apply-title">
			<div class="editorial-section__header">
				<h2 id="apply-title" class="editorial-section__title">What are you building?</h2>
				<p class="editorial-section__lede">Tell me about your product, who uses it and what you want to help them do. I read every enquiry and reply with a recommendation for how we could work together.</p>
			</div>
			<div id="enquiry-form" class="partnerships-apply__body">
				{enquiryReceived ? (
					<div>
						<h3>Enquiry received</h3>
						<p>I read every enquiry and will reply by email.</p>
					</div>
				) : (
					<>
