---
import FAQJsonLD from "@/components/html/faq-jsonld.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	adoptionAdvisory,
	adoptionStuckAreas,
	fitProofSprint,
	partnershipBoundaries,
	partnershipRoles,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const faqs = [
	{
		question: "When is this useful?",
		answer:
			"When your product has real technical depth, but adoption is getting stuck somewhere between positioning, docs, demos, DevRel activity, and the proof developers need before they trust it.",
	},
	{
		question: "How do we start?",
		answer:
			"Start with a Fit & Proof Sprint (£2,500, about two weeks). If we both want to continue, Adoption Advisory is £4,000 per month — founding rate, 90 days then month-to-month.",
	},
	{
		question: "How does Slack access work?",
		answer:
			"Slack Connect links your workspace with Rawkode Academy's. It is advisory access, practitioner to practitioner: questions get considered answers within a couple of working days. Bigger threads become the focus of the monthly review. It is not on-call support.",
	},
	{
		question: "Do you work with competing companies?",
		answer:
			"No. One company per problem space at a time. If a direct competitor applies while we work together, they wait.",
	},
	{
		question: "Does a partnership affect Rawkode Live coverage?",
		answer:
			"No. Advisory clients get no coverage, and coverage decisions never consider who pays. The audience's trust is the product; it is not for sale.",
	},
	{
		question: "Is there an annual option?",
		answer:
			"Yes. Pay twelve months, get two free. Otherwise Adoption Advisory continues month-to-month after the opening 90 days.",
	},
	{
		question: "What is intentionally out of scope?",
		answer:
			"This is not outsourced DevRel, campaign planning, custom content on demand, lead generation, audience rental, or paid coverage. Your team owns execution; Rawkode brings a practitioner's read and adoption patterns that have worked elsewhere.",
	},
];
---

<Page
	title="Partnerships"
	description="A practitioner advisor for DevTools and cloud-native teams: Fit & Proof Sprint, then Adoption Advisory. You own execution. Coverage is not for sale."
>
	<FAQJsonLD questions={faqs} slot="extra-head" />

	<div class="ops-org">
		<EditorialShell
			eyebrow="Partnerships"
			title="We help your team turn technical depth into developer adoption."
			lede="A practitioner advisor in your Slack — someone who watches developers evaluate tools every week, and tells you what to fix, prove, or test next. One advisor. No agency in between."
		>
			<div class="editorial-actions" slot="actions">
				<a class="editorial-button editorial-button--peach" href="/organizations/lets-chat">
					Start with a Fit & Proof Sprint
				</a>
				<a class="editorial-button editorial-button--secondary" href="#adoption-advisory">
					What’s in Adoption Advisory
				</a>
			</div>

			<section class="editorial-section" aria-label="How the partnership works">
				<div class="editorial-stat-grid">
					{partnershipRoles.map((point) => (
						<div class="editorial-stat">
							<span class="editorial-stat__value">{point.value}</span>
							<span class="editorial-stat__label">{point.label}</span>
						</div>
					))}
				</div>
			</section>

			<section class="editorial-section editorial-section--split" aria-labelledby="stuck-title">
				<div class="editorial-section__header">
					<p class="editorial-kicker">Where teams get stuck</p>
					<h2 id="stuck-title" class="editorial-section__title">Where adoption gets unclear</h2>
					<p class="editorial-section__lede">
						The problem is rarely that the team is not doing enough. It is that product, marketing, DevRel, and engineering each see a different part of the adoption story. Developers feel that gap before your dashboard does.
					</p>
				</div>
				<div class="ops-rows">
					{adoptionStuckAreas.map((area) => (
						<article class="ops-row">
							<h3 class="editorial-card__title">{area.title}</h3>
							<p class="editorial-card__body">{area.body}</p>
						</article>
					))}
				</div>
			</section>

			<section
				id="adoption-advisory"
				class="editorial-section editorial-section--split ops-offer"
				aria-labelledby="advisory-title"
			>
				<div class="editorial-section__header">
					<p class="editorial-kicker">{adoptionAdvisory.label}</p>
					<h2 id="advisory-title" class="editorial-section__title">{adoptionAdvisory.name}</h2>
					<p class="editorial-section__lede">{adoptionAdvisory.summary}</p>
				</div>
				<article class="ops-offer-card">
					<div class="ops-offer-card__top">
						<p class="ops-offer-card__price">{adoptionAdvisory.price}</p>
						<p class="ops-offer-card__cadence">{adoptionAdvisory.cadence}</p>
						<ul class="ops-note-list">
							{adoptionAdvisory.notes.map((note) => <li>{note}</li>)}
						</ul>
					</div>
					<div class="ops-offer-card__body">
						<p class="editorial-kicker">Included</p>
						<ul class="editorial-list">
							{adoptionAdvisory.included.map((item) => <li>{item}</li>)}
						</ul>
						<p class="editorial-kicker ops-offer-card__exclude-kicker">Not included</p>
						<ul class="editorial-list">
							{adoptionAdvisory.excluded.map((item) => <li>{item}</li>)}
						</ul>
					</div>
					<div class="ops-offer-card__cta">
						<a class="editorial-button editorial-button--peach" href="/organizations/lets-chat">
							Start with a Fit & Proof Sprint
						</a>
						<p class="ops-offer-card__cta-note">
							Advisory seats start after a Sprint. Apply on the Sprint page — no self-serve checkout.
						</p>
					</div>
				</article>
			</section>

			<section class="editorial-section editorial-section--split" aria-labelledby="start-title">
				<div class="editorial-section__header">
					<p class="editorial-kicker">{fitProofSprint.label}</p>
					<h2 id="start-title" class="editorial-section__title">{fitProofSprint.name}</h2>
					<p class="editorial-section__lede">
						{fitProofSprint.price} · {fitProofSprint.cadence}. {fitProofSprint.summary}
					</p>
				</div>
				<div class="ops-sprint-block">
					<ul class="editorial-list">
						{fitProofSprint.included.map((item) => <li>{item}</li>)}
					</ul>
					<p class="ops-credit">
						Credit rule: if you start Adoption Advisory within 30 days, the Sprint fee is credited in full.
					</p>
					<a class="editorial-button editorial-button--peach" href="/organizations/lets-chat">
						Start with a Fit & Proof Sprint
					</a>
				</div>
			</section>

			<section class="editorial-section editorial-section--split" aria-labelledby="not-for-title">
				<div class="editorial-section__header">
					<p class="editorial-kicker">Not for</p>
					<h2 id="not-for-title" class="editorial-section__title">What this does not solve</h2>
				</div>
				<ul class="ops-boundary-list">
					{partnershipBoundaries.map((item) => <li>{item}</li>)}
				</ul>
			</section>

			<section class="editorial-section editorial-section--split" aria-labelledby="faq-title">
				<div class="editorial-section__header">
					<p class="editorial-kicker">Questions</p>
					<h2 id="faq-title" class="editorial-section__title">Before you apply</h2>
				</div>
				<div class="editorial-faq">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</EditorialShell>
	</div>
</Page>

<style>
	.ops-org :global(.editorial-shell),
	.ops-org :global(.page-masthead) {
		background: var(--ctp-mocha-base);
		color: var(--ctp-mocha-text);
		border-color: var(--ctp-mocha-surface1);
	}

	.ops-org :global(.page-masthead h1),
	.ops-org :global(.editorial-section__title),
	.ops-org :global(.editorial-card__title),
	.ops-org :global(.editorial-stat__value),
	.ops-org :global(.editorial-faq summary) {
		color: var(--ctp-mocha-text);
		font-family: var(--font-inter-tight), system-ui, sans-serif;
		font-style: normal;
	}

	.ops-org :global(.page-masthead h1) {
		font-weight: 750;
		letter-spacing: -0.02em;
	}

	.ops-org :global(.page-masthead__dek),
	.ops-org :global(.editorial-section__lede),
	.ops-org :global(.editorial-card__body),
	.ops-org :global(.editorial-list),
	.ops-org :global(.editorial-stat__label),
	.ops-org :global(.editorial-faq p) {
		color: var(--ctp-mocha-subtext1);
	}

	.ops-org :global(.page-masthead__section),
	.ops-org :global(.editorial-kicker) {
		color: var(--ctp-mocha-teal);
	}

	.ops-org :global(.editorial-section),
	.ops-org :global(.page-masthead),
	.ops-org :global(.editorial-stat) {
		border-color: var(--ctp-mocha-surface1);
	}

	.ops-org :global(.editorial-faq details) {
		background: var(--ctp-mocha-mantle);
		border-color: var(--ctp-mocha-surface1);
	}

	.ops-org :global(.editorial-card),
	.ops-org :global(.editorial-button),
	.ops-org :global(.editorial-faq details) {
		border-radius: 2px;
	}

	.ops-org :global(.editorial-button--secondary) {
		background: transparent;
		color: var(--ctp-mocha-text);
		border-color: var(--ctp-mocha-surface2);
	}

	.ops-org :global(.editorial-button--secondary:hover) {
		background: var(--ctp-mocha-surface0);
		border-color: var(--ctp-mocha-subtext0);
		color: var(--ctp-mocha-text);
	}

	.ops-org :global(.editorial-button--peach) {
		background: var(--ctp-mocha-peach);
		border-color: var(--ctp-mocha-peach);
		color: var(--ctp-mocha-base);
	}

	.ops-org :global(.editorial-button--peach:hover) {
		background: color-mix(in oklab, var(--ctp-mocha-peach) 88%, white);
		border-color: color-mix(in oklab, var(--ctp-mocha-peach) 88%, white);
		color: var(--ctp-mocha-base);
	}

	.ops-org :global(.editorial-prose a),
	.ops-org :global(.ops-row a) {
		color: var(--ctp-mocha-blue);
	}

	.ops-offer {
		scroll-margin-top: 5rem;
	}

	.ops-rows {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--ctp-mocha-surface1);
		border-bottom: 1px solid var(--ctp-mocha-surface1);
	}

	.ops-row {
		border-top: 1px solid var(--ctp-mocha-surface1);
		display: grid;
		gap: 0.4rem;
		padding: 1rem 0;
	}

	.ops-row:first-child {
		border-top: 0;
	}

	.ops-row :global(.editorial-card__title) {
		margin: 0;
	}

	.ops-offer-card {
		display: grid;
		gap: 1.25rem;
		border: 1px solid var(--ctp-mocha-surface2);
		border-radius: 2px;
		background: var(--ctp-mocha-mantle);
		padding: 1.35rem;
		box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--ctp-mocha-teal) 22%, transparent);
	}

	.ops-offer-card__top {
		display: grid;
		gap: 0.45rem;
	}

	.ops-offer-card__price {
		margin: 0;
		font-family: var(--font-jetbrains-mono), ui-monospace, monospace;
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--ctp-mocha-text);
	}

	.ops-offer-card__cadence {
		margin: 0;
		font-family: var(--font-jetbrains-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ctp-mocha-subtext0);
	}

	.ops-note-list {
		list-style: none;
		padding: 0;
		margin: 0.35rem 0 0;
		display: grid;
		gap: 0.4rem;
	}

	.ops-note-list li {
		font-family: var(--font-inter-tight), system-ui, sans-serif;
		font-size: 0.92rem;
		line-height: 1.45;
		color: var(--ctp-mocha-subtext1);
		padding-left: 0.85rem;
		position: relative;
	}

	.ops-note-list li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.3rem;
		height: 0.3rem;
		border-radius: 999px;
		background: var(--ctp-mocha-peach);
	}

	.ops-offer-card__body {
		display: grid;
		gap: 0.75rem;
	}

	.ops-offer-card__exclude-kicker {
		margin-top: 0.5rem;
	}

	.ops-offer-card__cta {
		display: grid;
		gap: 0.65rem;
		justify-items: start;
	}

	.ops-offer-card__cta-note {
		margin: 0;
		font-family: var(--font-inter-tight), system-ui, sans-serif;
		font-size: 0.88rem;
		line-height: 1.45;
		color: var(--ctp-mocha-subtext0);
	}

	.ops-sprint-block {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}

	.ops-credit {
		margin: 0;
		font-family: var(--font-jetbrains-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1.5;
		color: var(--ctp-mocha-teal);
	}

	.ops-boundary-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.ops-boundary-list li {
		border: 1px solid var(--ctp-mocha-surface1);
		border-radius: 2px;
		padding: 0.8rem 1rem;
		background: var(--ctp-mocha-mantle);
		color: var(--ctp-mocha-subtext1);
		font-family: var(--font-inter-tight), system-ui, sans-serif;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	@media (min-width: 900px) {
		.ops-offer-card {
			grid-template-columns: minmax(12rem, 0.4fr) minmax(0, 1fr);
			grid-template-areas:
				"top body"
				"cta body";
			align-items: start;
		}

		.ops-offer-card__top {
			grid-area: top;
		}

		.ops-offer-card__body {
			grid-area: body;
		}

		.ops-offer-card__cta {
			grid-area: cta;
		}
	}

	@media (max-width: 700px) {
		.ops-offer-card__cta :global(.editorial-button),
		.ops-sprint-block :global(.editorial-button) {
			width: 100%;
		}
	}
</style>
