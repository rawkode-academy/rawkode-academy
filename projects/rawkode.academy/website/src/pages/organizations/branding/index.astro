---
import EditorialShell from "@/components/ui/EditorialShell.astro";
import Page from "@/wrappers/page.astro";
import iconSvgRaw from "@/components/branding/logos/logo.svg?raw";
import monogramSvgRaw from "@/components/branding/logos/monogram.svg?raw";
import wordmarkSvgRaw from "@/components/branding/logos/wordmark.svg?raw";
import { academyLogoDownload } from "@/lib/branding";

export const prerender = true;

const colors = [
	{ label: "Canvas", value: "#f4f7fb", usage: "The light reading surface." },
	{ label: "Ink", value: "#0c1626", usage: "Primary text and solid artwork on light surfaces." },
	{ label: "Accent", value: "#c2185b", usage: "Links, primary actions, and selected states on light surfaces." },
	{ label: "Night", value: "#0a1220", usage: "The dark reading surface." },
	{ label: "Light ink", value: "#e8eef8", usage: "Primary text and solid artwork on dark surfaces." },
	{ label: "Night accent", value: "#ff7ab6", usage: "Links and actions on dark surfaces." },
];

const typefaces = [
	{ name: "Red Hat Display", role: "Display", sample: "Understand the system.", usage: "Headlines and section titles. Bold, upright, and tightly set." },
	{ name: "Red Hat Text", role: "Body", sample: "Practical lessons for the people building cloud native.", usage: "Body copy and interface text. Clear at reading sizes." },
	{ name: "Red Hat Mono", role: "Mono", sample: "kubectl get pods", usage: "Code, timestamps, and concise technical metadata." },
];

const logoAssets = [
	{
		slug: "monogram",
		name: "Monogram",
		format: "square",
		description:
			"Use for avatars, favicons, social icons, and tight square placements.",
		asset: monogramSvgRaw,
		downloadName: "Rawkode-Academy-Monogram.svg",
	},
	{
		slug: "icon",
		name: "Icon",
		format: "square",
		description:
			"Use for app tiles, partner lockups, product UI, and compact brand moments.",
		asset: iconSvgRaw,
		downloadName: "Rawkode-Academy-Icon.svg",
	},
	{
		slug: "wordmark",
		name: "Wordmark",
		format: "wide",
		description:
			"Use when the full Rawkode Academy name needs to be legible at a glance.",
		asset: wordmarkSvgRaw,
		downloadName: "Rawkode-Academy-Wordmark.svg",
	},
];

---

<Page
	title="Branding"
	description="Official Rawkode Academy logos, colors, and usage rules for partners and collaborators."
>
	<EditorialShell
		eyebrow="Partner resources"
		title="Branding"
		lede="Official Rawkode Academy artwork, color values, and simple usage rules. Keep it consistent, legible, and uncluttered."
	>
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href="#assets">Download assets</a>
			<a class="editorial-button editorial-button--secondary" href="#usage">Usage rules</a>
		</div>

		<section id="assets" class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<p class="editorial-kicker">Logo assets</p>
				<h2 class="editorial-section__title">Use the right lockup for the space</h2>
				<p class="editorial-section__lede">
					Download an ink mark for light backgrounds or a white mark for dark backgrounds.
				</p>
			</div>
			<div class="branding-logo-grid" data-logo-preview>
				{logoAssets.map((logo) => (
					<article class={`editorial-card brand-asset brand-asset--${logo.format}`}>
						<div class="brand-asset__preview">
							<div
								class={`brand-logo ${logo.format === "square" ? "brand-logo--padded" : "brand-logo--wide"}`}
								set:html={logo.asset}
							/>
						</div>
						<div class="brand-asset__copy">
							<h3 class="editorial-card__title">{logo.name}</h3>
							<p class="editorial-card__body">{logo.description}</p>
							<div class="brand-downloads">
								<a class="logo-download-link" href={academyLogoDownload(logo.asset, "#0c1626")} download={logo.downloadName.replace(".svg", "-ink.svg")} aria-label={`Download ${logo.name} in ink (SVG)`}>Ink SVG</a>
								<a class="logo-download-link" href={academyLogoDownload(logo.asset, "#ffffff")} download={logo.downloadName.replace(".svg", "-white.svg")} aria-label={`Download ${logo.name} in white (SVG)`}>White SVG</a>
							</div>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<p class="editorial-kicker">Color</p>
				<h2 class="editorial-section__title">One canonical palette</h2>
				<p class="editorial-section__lede">
					Cool blue surfaces, navy type, and a pink action color. The website uses
					paired light and dark values so contrast stays clear in either theme.
					Use a solid, high-contrast treatment for the logo.
				</p>
			</div>
			<div class="editorial-grid">
				<div class="brand-color-grid">
					{colors.map((color) => (
						<article class="editorial-card brand-color">
							<div class="brand-color__swatch" style={`background:${color.value}`} />
							<div>
								<h3 class="editorial-card__title">{color.label}</h3>
								<p class="editorial-meta">{color.value}</p>
								<p class="editorial-card__body">{color.usage}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<p class="editorial-kicker">Type</p>
				<h2 class="editorial-section__title">Three typefaces, three jobs</h2>
				<p class="editorial-section__lede">
					The Red Hat family connects headlines, reading, and code. Display gives
					the page its voice; Text and Mono keep the technical content legible.
				</p>
			</div>
			<div class="editorial-grid">
				<div class="brand-type-grid">
					{typefaces.map((typeface) => (
						<article class="editorial-card brand-typeface">
							<p class={`brand-typeface__sample brand-typeface__sample--${typeface.role.toLowerCase()}`}>
								{typeface.sample}
							</p>
							<h3 class="editorial-card__title">{typeface.name}</h3>
							<p class="editorial-meta">{typeface.role}</p>
							<p class="editorial-card__body">{typeface.usage}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="usage" class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<p class="editorial-kicker">Usage</p>
				<h2 class="editorial-section__title">Keep the mark simple</h2>
				<p class="editorial-section__lede">
					The brand works best with contrast, room to breathe, and no extra effects competing with the logo.
				</p>
			</div>
			<div class="editorial-grid editorial-grid--2">
				<article class="editorial-card">
					<h3 class="editorial-card__title">Rules</h3>
					<ul class="editorial-list">
						<li>Keep clearspace around the mark on all sides.</li>
						<li>Do not stretch, skew, outline, or add shadows to the logo.</li>
						<li>Do not apply gradients to the logo; tint it as a single solid color.</li>
						<li>Use the wordmark where the full name needs to be understood quickly.</li>
						<li>Use the monogram or icon in constrained square placements.</li>
						<li>Avoid busy backgrounds unless there is enough contrast.</li>
					</ul>
				</article>
				<article class="editorial-card">
					<h3 class="editorial-card__title">Inline SVG tinting</h3>
					<div class="editorial-prose branding-code">
						<pre tabindex="0" role="region" aria-label="SVG tinting CSS"><code>{`.brand-logo svg * {
  fill: currentColor !important;
}

.brand-logo--accent {
  color: #c2185b;
}`}</code></pre>
					</div>
				</article>
			</div>
		</section>
	</EditorialShell>
</Page>

<style is:global>
	.branding-code pre {
		margin: 0;
		max-width: 100%;
		overflow-x: auto;
		font-size: 0.875rem;
	}
	.branding-code pre:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}
	.brand-downloads { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.logo-download-link {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		min-height: 44px;
		border: 1px solid var(--colors-academy-border);
		border-radius: 4px;
		background: var(--colors-academy-canvas);
		color: var(--colors-academy-text);
		cursor: pointer;
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		padding: 0.65rem 0.8rem;
	}

	.logo-download-link:hover {
		background: var(--colors-academy-text);
		border-color: var(--colors-academy-text);
		color: var(--colors-academy-canvas);
	}
	.logo-download-link:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}

	.logo-download-link {
		width: fit-content;
		margin-top: 1rem;
	}

	.branding-logo-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		--brand-logo-surface: var(--colors-academy-text);
	}

	.brand-asset--wide {
		grid-column: 1 / -1;
	}

	.brand-asset__preview {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 14rem;
		border: 1px solid var(--colors-academy-border);
		border-radius: 4px;
		background: var(--colors-academy-canvas);
		padding: 1.25rem;
	}

	.brand-asset--wide .brand-asset__preview {
		min-height: 8rem;
	}

	.brand-asset__copy {
		margin-top: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.brand-logo svg * {
		fill: currentColor !important;
	}

	.brand-logo {
		--logo-padding: 0;
		color: var(--brand-logo-surface);
		width: 100%;
		height: 100%;
		min-height: 7rem;
		display: flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		position: relative;
		padding: var(--logo-padding);
	}

	.brand-logo--padded {
		--logo-padding: 1rem;
	}

	.brand-logo svg {
		display: block;
		width: 100%;
		height: 100%;
		max-width: 100%;
		max-height: 100%;
	}

	.brand-logo--wide svg {
		width: 100%;
		height: auto;
	}

	.brand-color-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.brand-color {
		padding: 0;
		overflow: hidden;
	}

	.brand-color > div:last-child {
		padding: 1rem;
	}

	.brand-color__swatch {
		height: 5rem;
		border-bottom: 1px solid var(--colors-academy-border);
	}

	.brand-type-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
	}

	.brand-typeface__sample {
		min-height: 4.5rem;
		margin: 0 0 0.75rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--colors-academy-border);
		font-size: 1.35rem;
		line-height: 1.25;
		color: var(--colors-academy-text);
	}

	.brand-typeface__sample--display {
		font-family: var(--fonts-academy-display), system-ui, sans-serif;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.brand-typeface__sample--body {
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
	}

	.brand-typeface__sample--mono {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 1rem;
	}

	@media (max-width: 760px) {
		.branding-logo-grid,
		.brand-color-grid,
		.brand-type-grid {
			grid-template-columns: 1fr;
		}

		.brand-asset--wide {
			grid-column: auto;
		}
	}
</style>
