---
import PartnershipExperience from "@/components/organizations/PartnershipExperience.astro";
import PartnershipProof from "@/components/organizations/PartnershipProof.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import { setContentCache } from "@/lib/live-content";
import {
	fitProofReview,
	organizationsStartingPoint,
	partnershipAudience,
	partnershipCapacitySummary,
	partnershipDescription,
	partnershipHeroLede,
	partnershipHeroTitle,
	partnershipOffer,
	partnershipOutcomes,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

// PartnershipProof counts published videos and courses and quotes
// testimonials; a component cannot set cache tags, so the page does.
await setContentCache(Astro, {
	collections: ["videos", "courses", "testimonials"],
});
---

<Page title="For teams building developer products | Rawkode Academy" description={partnershipDescription}>
	<EditorialShell eyebrow={partnershipAudience} title={partnershipHeroTitle} lede={partnershipHeroLede}>
		<p class="partnership-hero-intro" slot="intro">{organizationsStartingPoint}</p>
		<div class="partnership-hero-offer" slot="actions">
			<p class="partnership-hero-commitment">Start with a {fitProofReview.price} review. Continue to the full 90 days, {partnershipOffer.price} in total, only if it’s useful.</p>
			<p class="partnership-capacity">{partnershipCapacitySummary}</p>
			<div class="editorial-actions">
				<a class="editorial-button" href="/organizations/partnerships?route=Product%20review#enquiry-form">Book a product review</a>
				<a class="editorial-button editorial-button--secondary" href="/organizations/partnerships">See the 90 days</a>
			</div>
		</div>

		<section id="programme" class="editorial-section editorial-section--split" aria-labelledby="programme-title">
			<div class="editorial-section__header">
				<h2 id="programme-title" class="editorial-section__title">By day 90 you have</h2>
			</div>
			<div class="organizations-offer">
				<ul class="editorial-list">
					{partnershipOutcomes.map((outcome) => <li><strong>{outcome.title}</strong> ({outcome.inReview ? `included in the ${fitProofReview.price} review` : "if you continue"}). {outcome.detail}</li>)}
				</ul>
				<a class="organizations-card__link" href="/organizations/partnerships">See the plan, price and terms</a>
			</div>
		</section>

		<PartnershipProof compact />

		<PartnershipExperience compact />
	</EditorialShell>
</Page>

<style>
	.partnership-capacity { margin: 0; max-width: 68ch; font-family: var(--fonts-academy-mono), ui-monospace, monospace; font-size: 0.875rem; line-height: 1.6; letter-spacing: 0.01em; color: var(--colors-academy-text); }

	.partnership-hero-intro { margin: 0; max-width: 68ch; font-family: var(--fonts-academy-text), system-ui, sans-serif; font-size: 1.125rem; line-height: 1.7; color: var(--colors-academy-text-muted); }
	.partnership-hero-offer { display: grid; gap: 1rem; }
	.partnership-hero-commitment { margin: 0; font-family: var(--fonts-academy-text), system-ui, sans-serif; font-size: 1.25rem; font-weight: 750; color: var(--colors-academy-text); }

	.organizations-offer {
		display: grid;
		gap: 1rem;
	}

	.organizations-offer > a { justify-self: start; }

	.organizations-card__link:focus-visible { outline: 2px solid var(--colors-academy-accent); outline-offset: 4px; }

	.organizations-card__link {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--colors-academy-accent);
		text-decoration: none;
	}

	.organizations-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

</style>
