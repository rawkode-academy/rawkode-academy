---
import EditorialShell from "@/components/ui/EditorialShell.astro";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const routes = [
	{
		title: "Partnerships",
		body: "A practitioner advisor on your adoption problems. You own execution. Coverage is not for sale.",
		href: "/organizations/partnerships",
		cta: "The partnership",
		primary: true,
	},
	{
		title: "Brand assets",
		body: "Marks, palette, and usage guidance. Not the commercial offer.",
		href: "/organizations/branding",
		cta: "View brand kit",
		primary: false,
	},
];
---

<Page
	title="For organizations"
	description="Partnerships for DevTools and cloud-native teams who need practitioner proof, not another agency. Brand assets if you already work together."
>
	<div class="ops-org">
		<EditorialShell
			eyebrow="For organizations"
			title="For organizations"
			lede="Partnerships for DevTools and cloud-native teams who need practitioner proof, not another agency. Brand assets if you already work together."
		>
			<section class="editorial-section" aria-label="Organization routes">
				<div class="ops-hub-grid">
					{routes.map((route) => (
						<article class:list={["ops-hub-card", { "ops-hub-card--primary": route.primary }]}>
							<p class="editorial-kicker">{route.primary ? "Primary" : "Utility"}</p>
							<h2 class="ops-hub-card__title">{route.title}</h2>
							<p class="ops-hub-card__body">{route.body}</p>
							<a
								class:list={[
									"editorial-button",
									route.primary ? "editorial-button--peach" : "editorial-button--secondary",
								]}
								href={route.href}
							>
								{route.cta}
							</a>
						</article>
					))}
				</div>
			</section>
		</EditorialShell>
	</div>
</Page>

<style>
	/* Org funnel is Mocha-first (matches Ops Console preview), not light paper. */
	.ops-org :global(.editorial-shell),
	.ops-org :global(.page-masthead) {
		background: var(--ctp-mocha-base);
		color: var(--ctp-mocha-text);
		border-color: var(--ctp-mocha-surface1);
	}

	.ops-org :global(.page-masthead h1),
	.ops-org :global(.editorial-section__title),
	.ops-org :global(.editorial-card__title),
	.ops-org :global(.editorial-stat__value) {
		color: var(--ctp-mocha-text);
		font-family: var(--font-inter-tight), system-ui, sans-serif;
		font-style: normal;
	}

	.ops-org :global(.page-masthead h1) {
		font-weight: 750;
		letter-spacing: -0.02em;
	}

	.ops-org :global(.page-masthead__dek),
	.ops-org :global(.editorial-section__lede),
	.ops-org :global(.editorial-card__body),
	.ops-org :global(.editorial-list),
	.ops-org :global(.editorial-stat__label) {
		color: var(--ctp-mocha-subtext1);
	}

	.ops-org :global(.page-masthead__section),
	.ops-org :global(.editorial-kicker) {
		color: var(--ctp-mocha-teal);
	}

	.ops-org :global(.editorial-section),
	.ops-org :global(.page-masthead) {
		border-bottom-color: var(--ctp-mocha-surface1);
	}

	.ops-org :global(.editorial-card),
	.ops-org :global(.editorial-button),
	.ops-org :global(.editorial-faq details) {
		border-radius: 2px;
	}

	.ops-org :global(.editorial-button--peach) {
		background: var(--ctp-mocha-peach);
		border-color: var(--ctp-mocha-peach);
		color: var(--ctp-mocha-base);
	}

	.ops-org :global(.editorial-button--peach:hover) {
		background: color-mix(in oklab, var(--ctp-mocha-peach) 88%, white);
		border-color: color-mix(in oklab, var(--ctp-mocha-peach) 88%, white);
		color: var(--ctp-mocha-base);
	}

	.ops-org :global(a:not(.editorial-button)) {
		color: var(--ctp-mocha-blue);
	}

	.ops-hub-grid {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 760px) {
		.ops-hub-grid {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
			align-items: stretch;
		}
	}

	.ops-hub-card {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		align-items: flex-start;
		border: 1px solid var(--ctp-mocha-surface1);
		border-radius: 2px;
		background: var(--ctp-mocha-mantle);
		padding: 1.35rem;
		min-width: 0;
	}

	.ops-hub-card--primary {
		border-color: var(--ctp-mocha-surface2);
		box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--ctp-mocha-teal) 28%, transparent);
	}

	.ops-hub-card__title {
		margin: 0;
		font-family: var(--font-inter-tight), system-ui, sans-serif;
		font-size: 1.55rem;
		font-weight: 750;
		line-height: 1.05;
		color: var(--ctp-mocha-text);
	}

	.ops-hub-card__body {
		margin: 0;
		flex: 1;
		font-family: var(--font-inter-tight), system-ui, sans-serif;
		font-size: 0.98rem;
		line-height: 1.55;
		color: var(--ctp-mocha-subtext1);
	}

	.ops-hub-card :global(.editorial-button) {
		margin-top: 0.35rem;
	}

	@media (max-width: 700px) {
		.ops-hub-card :global(.editorial-button) {
			width: 100%;
		}
	}
</style>
