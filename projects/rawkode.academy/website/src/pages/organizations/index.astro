---
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	decisionBriefMailto,
	fitProofReview,
	partnershipBoundaries,
	partnershipOffer,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const reviewScope = [
	{
		term: "What we build",
		detail: "Technical demos, proof assets, companion pages, and reusable clips.",
	},
	{
		term: "What we review",
		detail: "Docs, architecture, operational claims, adoption risks, and technical buyer objections.",
	},
	{
		term: "Who owns the work",
		detail: "Your marketing, product, DevRel, sales engineering, and technical teams. Rawkode brings the practitioner read and the proof work.",
	},
];

const proofWork = [
	"A working technical demo or proof asset each quarter",
	"A companion page and reusable clips for your team",
	"Slack Connect for questions and decisions as they come up",
	"A monthly working session and quarterly performance report",
];

const badFits = partnershipBoundaries;
---

<Page
	title="For Organizations"
	description="Rawkode Academy partnerships for infrastructure companies that need sharper technical proof, useful demos, and practitioner trust."
>
	<EditorialShell
		eyebrow="For Organizations"
		title="Partner with Rawkode Academy"
		lede="We help infrastructure companies turn complex products into technical proof that practitioners can understand, test, and trust. Your team keeps execution. Rawkode brings the demos, critique, and distribution."
	>
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href="/organizations/partnerships">Explore the programme</a>
			<a class="editorial-button editorial-button--secondary" href={decisionBriefMailto}>Apply by email</a>
		</div>

		<section class="editorial-section">
			<dl class="organizations-scope">
				{reviewScope.map((row) => (
					<div class="organizations-scope__row">
						<dt>{row.term}</dt>
						<dd>{row.detail}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<h2 class="editorial-section__title">Adoption Advisory</h2>
				<p class="editorial-section__lede">{partnershipOffer.summary}</p>
			</div>
			<div class="organizations-offer">
				<div>
					<p class="organizations-offer__price">{partnershipOffer.price}</p>
					<p class="organizations-offer__cadence">{partnershipOffer.cadence}</p>
				</div>
				<ul class="editorial-list">
					{proofWork.map((item) => <li>{item}</li>)}
				</ul>
				<a class="editorial-button" href="/organizations/partnerships">See what is included</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<h2 class="editorial-section__title">{fitProofReview.name}</h2>
				<p class="editorial-section__lede">{fitProofReview.summary}</p>
			</div>
			<div class="organizations-offer">
				<div>
					<p class="organizations-offer__price">{fitProofReview.price}</p>
					<p class="organizations-offer__cadence">{fitProofReview.cadence}</p>
				</div>
				<ul class="editorial-list">
					{fitProofReview.included.map((item) => <li>{item}</li>)}
				</ul>
				<a class="organizations-card__link" href="/organizations/lets-chat">Start a fit check</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<h2 class="editorial-section__title">What the programme does not promise</h2>
			</div>
			<ul class="organizations-list">
				{badFits.map((item) => <li>{item}</li>)}
			</ul>
		</section>
	</EditorialShell>
</Page>

<style>
	.organizations-scope {
		margin: 0;
		border-top: 1px solid var(--colors-academy-border);
		border-bottom: 1px solid var(--colors-academy-border);
	}

	.organizations-scope__row {
		display: grid;
		gap: 0.35rem;
		padding: 0.9rem 0;
	}

	.organizations-scope__row + .organizations-scope__row {
		border-top: 1px solid var(--colors-academy-border);
	}

	.organizations-scope dt {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--colors-academy-accent);
	}

	.organizations-scope dd {
		margin: 0;
		color: var(--colors-academy-text-soft);
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: 0.98rem;
		line-height: 1.55;
	}

	.organizations-offer {
		display: grid;
		gap: 1rem;
	}

	.organizations-offer > a { justify-self: start; }

	.organizations-card__link:focus-visible { outline: 2px solid var(--colors-academy-accent); outline-offset: 4px; }

	.organizations-offer__price {
		margin: 0.4rem 0 0;
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: clamp(1.8rem, 5vw, 2.6rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--colors-academy-text);
	}

	.organizations-offer__cadence {
		margin: 0.15rem 0 0;
		color: var(--colors-academy-text-muted);
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.organizations-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.organizations-list li {
		border-bottom: 1px solid var(--colors-academy-border);
		padding: 0.8rem 0;
		color: var(--colors-academy-text-soft);
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.organizations-card__link {
		font-family: var(--fonts-academy-mono), ui-monospace, monospace;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--colors-academy-accent);
		text-decoration: none;
	}

	.organizations-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	@media (min-width: 760px) {
		.organizations-scope__row {
			grid-template-columns: minmax(11rem, 0.28fr) minmax(0, 1fr);
			gap: 1.5rem;
			align-items: baseline;
		}
	}
</style>
