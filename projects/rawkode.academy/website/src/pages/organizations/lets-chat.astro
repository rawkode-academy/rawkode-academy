---
import ContactFallback from "@/components/organizations/ContactFallback.astro";
import PartnershipApplicationForm from "@/components/organizations/PartnershipApplicationForm.vue";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	fitProofSprint,
	sprintApplyMailto,
	sprintApplySubject,
	sprintApplyTemplate,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;
---

<Page
	title="Fit & Proof Sprint"
	description="Fit & Proof Sprint · £2,500 · about two weeks. Prove whether Rawkode is the right advisor for your adoption problem before ongoing advisory."
>
	<div class="ops-org">
		<EditorialShell
			eyebrow="Fit & Proof Sprint"
			title={`${fitProofSprint.name} · ${fitProofSprint.price} · about two weeks`}
			lede={fitProofSprint.summary}
		>
			<div class="editorial-actions" slot="actions">
				<a class="editorial-button editorial-button--peach" href="#apply">
					Start with a Fit & Proof Sprint
				</a>
				<a class="editorial-button editorial-button--secondary" href="/organizations/partnerships">
					What’s in Adoption Advisory
				</a>
			</div>

			<section class="editorial-section editorial-section--split" aria-labelledby="inout-title">
				<div class="editorial-section__header">
					<p class="editorial-kicker">Scope</p>
					<h2 id="inout-title" class="editorial-section__title">In and out</h2>
					<p class="editorial-section__lede">
						A bounded sprint. No coverage, no lead gen, no open-ended retainer.
					</p>
				</div>
				<div class="ops-inout-grid">
					<article class="ops-inout">
						<p class="editorial-kicker">Included</p>
						<ul class="editorial-list">
							{fitProofSprint.included.map((item) => <li>{item}</li>)}
						</ul>
					</article>
					<article class="ops-inout ops-inout--out">
						<p class="editorial-kicker">Not included</p>
						<ul class="editorial-list">
							{fitProofSprint.excluded.map((item) => <li>{item}</li>)}
						</ul>
					</article>
				</div>
			</section>

			<section class="editorial-section editorial-section--split" aria-labelledby="credit-title">
				<div class="editorial-section__header">
					<p class="editorial-kicker">If you continue</p>
					<h2 id="credit-title" class="editorial-section__title">Credit toward Adoption Advisory</h2>
				</div>
				<div class="ops-credit-panel">
					<p class="editorial-card__body">
						If you start Adoption Advisory within 30 days of the Sprint, the £2,500 fee is credited in full. No self-serve checkout — David replies to every application.
					</p>
					<ul class="ops-meta-list">
						{fitProofSprint.notes.map((note) => <li>{note}</li>)}
					</ul>
				</div>
			</section>

			<section
				id="apply"
				class="editorial-section editorial-section--split ops-apply"
				aria-labelledby="apply-title"
			>
				<div class="editorial-section__header">
					<p class="editorial-kicker">Apply</p>
					<h2 id="apply-title" class="editorial-section__title">Four fields. Rough context is enough.</h2>
					<p class="editorial-section__lede">
						Company/product, technical buyer, adoption problem, and links. We reply either way.
					</p>
				</div>
				<div class="ops-apply__body">
					<PartnershipApplicationForm client:visible />
					<ContactFallback
						subject={sprintApplySubject}
						template={sprintApplyTemplate}
					/>
					<p class="ops-apply__mailto">
						Prefer email?
						<a href={sprintApplyMailto}>Open a prefilled Sprint application</a>
					</p>
				</div>
			</section>
		</EditorialShell>
	</div>
</Page>

<style>
	.ops-org :global(.page-masthead h1) {
		font-family: var(--font-inter-tight), system-ui, sans-serif;
		font-style: normal;
		font-weight: 750;
		letter-spacing: -0.02em;
	}

	.ops-org :global(.page-masthead__section),
	.ops-org :global(.editorial-kicker) {
		color: var(--ctp-mocha-teal);
	}

	.ops-org :global(.editorial-card),
	.ops-org :global(.editorial-button),
	.ops-org :global(.editorial-faq details) {
		border-radius: 2px;
	}

	.ops-org :global(.editorial-button--peach) {
		background: var(--ctp-mocha-peach);
		border-color: var(--ctp-mocha-peach);
		color: var(--ctp-mocha-base);
	}

	.ops-org :global(.editorial-button--peach:hover) {
		background: color-mix(in oklab, var(--ctp-mocha-peach) 88%, white);
		border-color: color-mix(in oklab, var(--ctp-mocha-peach) 88%, white);
		color: var(--ctp-mocha-base);
	}

	.ops-org :global(a:not(.editorial-button)) {
		color: var(--ctp-mocha-blue);
	}

	.ops-inout-grid {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 760px) {
		.ops-inout-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.ops-inout {
		border: 1px solid var(--ctp-mocha-surface1);
		border-radius: 2px;
		background: var(--ctp-mocha-mantle);
		padding: 1.2rem;
		display: grid;
		gap: 0.85rem;
	}

	.ops-inout--out {
		border-color: var(--ctp-mocha-surface2);
	}

	.ops-credit-panel {
		display: grid;
		gap: 0.85rem;
		border: 1px solid var(--ctp-mocha-surface1);
		border-radius: 2px;
		background: var(--ctp-mocha-mantle);
		padding: 1.2rem;
	}

	.ops-meta-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.45rem;
	}

	.ops-meta-list li {
		font-family: var(--font-jetbrains-mono), ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1.5;
		color: var(--ctp-mocha-subtext0);
	}

	.ops-apply {
		scroll-margin-top: 5rem;
	}

	.ops-apply__body {
		display: grid;
		gap: 1.5rem;
		justify-items: start;
		width: 100%;
		max-width: 40rem;
	}

	.ops-apply__mailto {
		margin: 0;
		font-family: var(--font-inter-tight), system-ui, sans-serif;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--ctp-mocha-subtext1);
	}
</style>
