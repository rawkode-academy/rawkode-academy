---
import ContactFallback from "@/components/organizations/ContactFallback.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import { decisionBriefMailto, decisionBriefSubject, decisionBriefTemplate } from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;
---

<Page title="Partner application" description="Apply for the Rawkode Academy partner programme or a Fit & Proof Review.">
	<EditorialShell compact eyebrow="Work with Rawkode Academy" title="Let’s find the right fit."
		lede="Tell David about your product, the people you need to reach, and the technical problem standing in their way. A short email is enough to start.">
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href={decisionBriefMailto}>Start an email</a>
			<a class="editorial-button editorial-button--secondary" href="/organizations/partnerships">Review the programme</a>
		</div>

		<section class="editorial-section" aria-labelledby="application-context">
			<div class="editorial-section__header">
				<h2 id="application-context" class="editorial-section__title">Give us the useful context.</h2>
				<p class="editorial-section__lede">The template below covers the essentials. Add links to your demo, documentation, or repository, the stakeholders involved, and any deadline or launch window. You don’t need to know which programme is right for you yet.</p>
			</div>
			<ContactFallback subject={decisionBriefSubject} template={decisionBriefTemplate} />
		</section>

		<section class="editorial-section" aria-labelledby="application-next">
			<div class="editorial-section__header">
				<h2 id="application-next" class="editorial-section__title">What happens next?</h2>
				<p class="editorial-section__lede">David will reply with a recommendation: Adoption Advisory, a Fit & Proof Review, or neither. If a conversation would help, we’ll arrange a call from there.</p>
			</div>
		</section>
	</EditorialShell>
</Page>
