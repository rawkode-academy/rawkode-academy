---
import ContactFallback from "@/components/organizations/ContactFallback.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	decisionBriefMailto,
	decisionBriefSubject,
	decisionBriefTemplate,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;
---

<Page title="Partner application" description="Enquire about a Rawkode Academy partnership.">
	<EditorialShell compact eyebrow="Work with Rawkode Academy" title="Tell us about your product."
		lede="Tell us about your product, the developers you need to reach and where they get stuck. David reads every enquiry and replies by email.">
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href="/organizations/partnerships#apply">Apply online</a>
			<a class="editorial-button editorial-button--secondary" href={decisionBriefMailto}>Prefer email?</a>
		</div>

		<section class="editorial-section" aria-labelledby="application-context">
			<div class="editorial-section__header">
				<h2 id="application-context" class="editorial-section__title">What to include in your email</h2>
				<p class="editorial-section__lede">Tell us what your product does, who you want to use it and where they get stuck. Add links to your product, demo, documentation or repository, who needs to be involved and any deadline. You can ask about any stage, an ongoing partnership, or both.</p>
			</div>
			<ContactFallback subject={decisionBriefSubject} template={decisionBriefTemplate} />
		</section>

		<section class="editorial-section" aria-labelledby="application-next">
			<div class="editorial-section__header">
				<h2 id="application-next" class="editorial-section__title">What happens next?</h2>
				<p class="editorial-section__lede">David replies by email with a recommendation: which stage to start at, or that none fits yet, and why. If a call would help, he'll suggest times.</p>
			</div>
		</section>
	</EditorialShell>
</Page>
