---
import ContactFallback from "@/components/organizations/ContactFallback.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	decisionBriefSubject,
	decisionBriefTemplate,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const requiredContext = [
	"Company or product category",
	"Preferred route: Adoption Advisory, Fit & Proof Review, or not sure yet",
	"Target technical evaluator",
	"Team stakeholders",
	"The adoption risk or decision to review",
	"Working demo, docs, or repository",
	"Budget and preferred quarter",
	"Deadline or launch window",
];

const optionalContext = [
	"Helm charts, CRDs, RBAC/IAM notes, Terraform, architecture notes, telemetry, tenancy, runbooks, demo environment, or docs paths",
	"Current blockers from sales, product, marketing, DevRel, sales engineering, platform, or security",
	"What happens next if the partnership is useful",
];
---

<Page
title="Partner application"
description="Apply for the Rawkode Academy partner programme or a Fit & Proof Review."
>
	<EditorialShell
		eyebrow="Rawkode Partner Programme"
		title="Start with the real adoption problem"
		lede="Send rough context on the product, the practitioner you need to reach, the proof gap, and the quarter you want to work in. David will reply with the next useful step."
	>
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href="#email">Email application</a>
			<a class="editorial-button editorial-button--secondary" href="/organizations/partnerships">Review the programme</a>
		</div>

		<section class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<p class="editorial-kicker">What to send</p>
				<h2 class="editorial-section__title">Rough context is enough.</h2>
				<p class="editorial-section__lede">
					This is not a procurement form. The first email should make the adoption problem, technical proof, and desired quarter clear enough to judge fit.
				</p>
			</div>
			<div class="fit-check-grid">
				<article class="editorial-card">
					<h3 class="editorial-card__title">Useful first email</h3>
					<ul class="editorial-list">
						{requiredContext.map((item) => <li>{item}</li>)}
					</ul>
				</article>
				<article class="editorial-card editorial-card--paper">
					<h3 class="editorial-card__title">Optional links</h3>
					<ul class="editorial-list">
						{optionalContext.map((item) => <li>{item}</li>)}
					</ul>
				</article>
			</div>
		</section>

		<section id="email" class="editorial-section editorial-section--split">
			<div class="editorial-section__header">
				<p class="editorial-kicker">What happens next</p>
				<h2 class="editorial-section__title">The reply should make the next move obvious.</h2>
			</div>
			<div class="editorial-card editorial-card--paper">
				<p class="editorial-card__body">
					David will tell you whether Adoption Advisory, Fit & Proof Review, or neither is the right next step. If a call is useful, it can be arranged from there.
				</p>
			</div>
			<ContactFallback
				subject={decisionBriefSubject}
				template={decisionBriefTemplate}
			/>
		</section>
	</EditorialShell>
</Page>

<style>
	.fit-check-grid {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 760px) {
		.fit-check-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
