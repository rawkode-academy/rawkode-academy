---
import ContactFallback from "@/components/organizations/ContactFallback.astro";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	decisionBriefMailto,
	decisionBriefSubject,
	decisionBriefTemplate,
	supportAcademyOffer,
} from "@/lib/partnerships";
import Page from "@/wrappers/page.astro";

export const prerender = true;
---

<Page title="Enquire about working with Rawkode Academy" description="Ask about a Partnership or supporting Rawkode Academy's free developer education.">
	<EditorialShell compact eyebrow="Work with Rawkode Academy" title="Tell David what you're exploring."
		lede="Ask about a Partnership or supporting free developer education. David reads every enquiry and replies by email.">
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href="/organizations/partnerships#apply">Partnership enquiry</a>
			<a class="editorial-button editorial-button--secondary" href="/organizations/support-our-work#apply">Support Our Work enquiry</a>
			<a class="editorial-button editorial-button--secondary" href={decisionBriefMailto}>Partnership by email</a>
			<a class="editorial-button editorial-button--secondary" href={supportAcademyOffer.mailto}>Support Our Work by email</a>
		</div>

		<section class="editorial-section" aria-labelledby="application-context">
			<div class="editorial-section__header">
				<h2 id="application-context" class="editorial-section__title">What to include in a partnership email</h2>
				<p class="editorial-section__lede">For a Partnership, tell us what your product does, who uses it and what you'd like to work on. Add links to your product, demo, documentation or repository. For Support Our Work, tell us about your company and why you want to fund free developer education.</p>
			</div>
			<ContactFallback subject={decisionBriefSubject} template={decisionBriefTemplate} />
		</section>

		<section class="editorial-section" aria-labelledby="application-next">
			<div class="editorial-section__header">
				<h2 id="application-next" class="editorial-section__title">What happens next?</h2>
				<p class="editorial-section__lede">David replies by email with a recommendation: what work would help and how to approach it. If a call would help, he'll suggest times.</p>
			</div>
		</section>
	</EditorialShell>
</Page>
