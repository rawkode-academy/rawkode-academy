---
import { academyAccount } from "@rawkodeacademy/design-system";
const account = academyAccount();
import { env } from "cloudflare:workers";
import Page from "@/wrappers/page.astro";
import EmailPreferences from "@/components/settings/EmailPreferences.vue";
import TestEmailButton from "@/components/settings/TestEmailButton.vue";
import Avatar from "vue-boring-avatars";
import { createLearnerId } from "@/actions/newsletter";
import { academyLayout } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(
		`/api/auth/sign-in?returnTo=${encodeURIComponent("/settings")}`,
	);
}

Astro.response.headers.set("Cache-Control", "private, no-store");
let preferencesUnavailable = false;

const prefixedUserId = createLearnerId(user.id);

interface EmailPreference {
	channel: string;
	audience: string;
}

let academyNewsletter = false;
let matrixNewsletter = false;
let kubernetesReleaseUpdates = false;
let marketingEmails = false;
let serviceEmails = false;
let technologySubscriptions: string[] = [];

try {
	const allPrefs: EmailPreference[] =
		await env.EMAIL_PREFERENCES.getPreferences(prefixedUserId);

	for (const pref of allPrefs) {
		if (pref.channel === "newsletter" && pref.audience === "academy") {
			academyNewsletter = true;
		} else if (pref.channel === "newsletter" && pref.audience === "matrix") {
			matrixNewsletter = true;
		} else if (
			pref.channel === "newsletter" &&
			pref.audience === "kubernetes-release-updates"
		) {
			kubernetesReleaseUpdates = true;
		} else if (pref.channel === "marketing" && pref.audience === "academy") {
			marketingEmails = true;
		} else if (pref.channel === "service" && pref.audience === "academy") {
			serviceEmails = true;
		} else if (
			pref.channel === "newsletter" &&
			pref.audience.startsWith("technology:")
		) {
			technologySubscriptions.push(pref.audience.replace("technology:", ""));
		}
	}
} catch (e) {
	preferencesUnavailable = true;
	console.error("Failed to fetch email preferences", e);
}
const layout = academyLayout({ width: "reading" });
---

<Page noindex title="Settings - Rawkode Academy" description="Manage your account settings and email preferences.">
	<div class={layout.root}>
		<section class={layout.hero}>
			<div class={layout.container}>
				<h1 class={layout.title}>
			Settings
		</h1>
				<p class={layout.description}>Manage your profile and the emails you receive.</p>
			</div>
		</section>

		<div class={layout.section}>
		<div class={account.stack}>
			<!-- Profile Section -->
			<section class={account.panel}>
				<div class={account.header}>
					<h2 class={account.title}>
						Profile
					</h2>
				</div>
				<div class={account.body}>
					<div class={account.row}>
						{user.image ? (
							<img
								src={user.image}
								alt={`Profile picture for ${user.name || 'user'}`}
								class={account.avatar}
								loading="lazy"
							/>
						) : (
							<Avatar client:load name={user.name || ""} variant="pixel" class={account.avatar} />
						)}
						<div>
							<p class={account.title}>
								{user.name}
							</p>
							<p class={account.description}>
								{user.email}
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Email Preferences Section -->
				<section class={account.panel}>
					<div class={account.header}>
						<h2 class={account.title}>
							Email Preferences
						</h2>
					<p class={account.description}>
						Manage what emails you receive from Rawkode Academy.
					</p>
				</div>
					<div class={account.body}>
						{preferencesUnavailable ? (<p class={account.error} role="alert">Your preferences could not be loaded. Reload this page before making changes.</p>) : (<EmailPreferences
							client:only="vue"
							academyNewsletter={academyNewsletter}
							matrixNewsletter={matrixNewsletter}
							kubernetesReleaseUpdates={kubernetesReleaseUpdates}
							marketingEmails={marketingEmails}
							serviceEmails={serviceEmails}
							technologySubscriptions={technologySubscriptions}
						/>)}
					</div>
				</section>

				<!-- Email Tools -->
				<section class={account.panel}>
					<div class={account.header}>
						<h2 class={account.title}>
							Email Tools
						</h2>
						<p class={account.description}>
							Send yourself a quick test message to confirm email delivery works.
						</p>
					</div>
					<div class={account.body}>
						<TestEmailButton client:load />
					</div>
				</section>
		</div>
		</div>
	</div>
</Page>
