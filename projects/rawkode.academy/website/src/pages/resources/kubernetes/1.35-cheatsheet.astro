---
import { env } from "cloudflare:workers";
import Page from "@/wrappers/page.astro";
import K8sCheatsheetCTA from "@/components/lead-magnet/K8sCheatsheetCTA.vue";
import { createLearnerId } from "@/actions/newsletter";
import { academyLayout, academyReference } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

export const prerender = false;

const user = Astro.locals.user;
const pagePath = Astro.url.pathname;
const signInUrl = `/api/auth/sign-in?returnTo=${encodeURIComponent(pagePath)}`;

// Check for the cheatsheet cookie (indicates user has subscribed)
const hasCheatsheetCookie =
	Astro.cookies.get("lead-magnet:k8s-1-35-cheatsheet")?.value === "true";

// Set the cookie if user just subscribed
if (Astro.url.searchParams.has("subscribed")) {
	Astro.cookies.set("lead-magnet:k8s-1-35-cheatsheet", "true", {
		path: "/",
		maxAge: 60 * 60 * 24 * 365, // 1 year
		sameSite: "lax",
	});
}

// Check if signed-in user has subscribed to kubernetes-release-updates newsletter
let hasNewsletterSubscription = false;
if (user) {
	try {
		const prefixedUserId = createLearnerId(user.id);
		const allPrefs = await env.EMAIL_PREFERENCES.getPreferences(prefixedUserId);
		hasNewsletterSubscription = allPrefs.some(
			(pref: { channel: string; audience: string }) =>
				pref.channel === "newsletter" &&
				pref.audience === "kubernetes-release-updates",
		);
	} catch (e) {
		console.error("Failed to fetch email preferences", e);
	}
}

// User has access if they've subscribed (via preferences, cookie, or query param)
const hasAccess =
	hasNewsletterSubscription ||
	hasCheatsheetCookie ||
	Astro.url.searchParams.has("subscribed");

const pageTitle = "Kubernetes 1.35 Cheat Sheet";
const pageDescription =
	"A guide to Kubernetes 1.35 - breaking changes, new GA features, AI/ML scheduler primitives, and a migration checklist for cloud native engineers.";
const reference = academyReference();
const layout = academyLayout({ width: "reading" });
---

<Page title={pageTitle} description={pageDescription}>
	<div class={layout.root}>
	{hasAccess ? (
		<!-- Cheatsheet Content for Subscribed Users -->
		<section class={layout.section}>
			<div class={layout.container}>
				<!-- Success Header -->
				<div class:list={[layout.hero, reference.center]}>
					<div class={reference.iconBadge}>
						<svg class={reference.icon} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
					</div>
					<h1 class={layout.title}>
						Your Kubernetes 1.35 Cheat Sheet
					</h1>
					<p class={layout.description}>
						Thank you for joining the Rawkode Academy community. Here's everything you need to know about Kubernetes 1.35.
					</p>
				</div>

				<!-- Release Info Banner -->
				<div class={reference.notice}>
					<div class={reference.row}>
						<div>
							<h2 class={reference.label}>Release Date: December 17, 2025</h2>
							<p class={reference.muted}>Cycle started September 15, 2025 - Code Freeze: November 6, 2025</p>
						</div>
						<div class={reference.tag}>
							<span class={reference.dotWrap}>
								<span class={reference.pulse}></span>
								<span class={reference.dot}></span>
							</span>
							~60 Enhancements
						</div>
					</div>
				</div>

				<!-- Cheatsheet Content Card -->
				<div class:list={[layout.card, reference.panel]}>
					<h2 class={reference.heading}>
						What's New in Kubernetes 1.35
					</h2>

					<div class={reference.stack}>
						<!-- Breaking Changes -->
						<div>
							<h3 class={reference.subheading}>
								<span class={reference.danger}>🚨</span> Breaking Changes (Action Required!)
							</h3>
							<div class={reference.notice}>

								<!-- cgroup v1 -->
								<div>
									<h4 class={reference.label}>cgroup v1 Support Disabled by Default</h4>
									<p class={reference.muted}>The Kubelet config <code class={reference.inlineCode}>failCgroupV1</code> now defaults to <code class={reference.inlineCode}>true</code>. If a node boots with legacy cgroup v1 hierarchy, the Kubelet <strong>crashes immediately on startup</strong>.</p>
									<div class={reference.code}>
										<div>
											<p class={reference.muted}># Check if your nodes use cgroups v2</p>
											<p class={reference.success}>stat -fc %T /sys/fs/cgroup/</p>
											<p class={reference.muted}># Returns: cgroup2fs (v2) or tmpfs (v1 - WILL FAIL!)</p>
										</div>
									</div>
								</div>

								<!-- containerd -->
								<div>
									<h4 class={reference.label}>containerd 1.x End of Support</h4>
									<p class={reference.muted}>Kubernetes 1.35 is the <strong>last version</strong> to support containerd 1.7. You must upgrade to containerd 2.0+ before upgrading to Kubernetes 1.36.</p>
									<div class={reference.code}>
										<p class={reference.muted}># Monitor affected nodes with this metric</p>
										<p class={reference.success}>kubelet_cri_losing_support</p>
									</div>
								</div>

								<!-- Image Pull -->
								<div>
									<h4 class={reference.label}>Image Pull Credential Verification (Enabled by Default)</h4>
									<p class={reference.muted}>The <code class={reference.inlineCode}>KubeletEnsureSecretPulledImages</code> feature is now enabled. Pods must have valid credentials for cached images.</p>
								</div>
							</div>
						</div>

						<!-- GA Features -->
						<div>
							<h3 class={reference.subheading}>
								<span class={reference.success}>🎓</span> Graduating to Stable (GA)
							</h3>
							<div class={reference.notice}>
								<ul class={reference.list}>
									<li class={reference.row}>
										<span class={reference.success}>✓</span>
										<div class={reference.text}>
											<strong class={reference.text}>In-place Pod Resource Updates</strong>
											<p class={reference.muted}>Adjust CPU and memory without restarting pods! No more recreating stateful workloads for vertical scaling.</p>
											<div class={reference.code}>
												<p class={reference.success}>kubectl patch pod my-pod --subresource='resize' -p '&#123;"spec":&#123;"containers":[&#123;"name":"app","resources":&#123;"requests":&#123;"memory":"512Mi"&#125;&#125;&#125;]&#125;&#125;'</p>
											</div>
										</div>
									</li>
									<li class={reference.row}>
										<span class={reference.success}>✓</span>
										<div class={reference.text}>
											<strong class={reference.text}>Structured Authentication Configuration</strong>
											<p class={reference.muted}>Configure multiple OIDC providers via file, not flags. Hot-reload without API server restarts.</p>
										</div>
									</li>
								</ul>
							</div>
						</div>

						<!-- AI/ML Features -->
						<div>
							<h3 class={reference.subheading}>
								<span class={reference.accent}>🤖</span> AI/ML & Scheduler Enhancements
							</h3>
							<div class={reference.notice}>
								<ul class={reference.list}>
									<li class={reference.row}>
										<span class={reference.accent}>α</span>
										<div class={reference.text}>
											<strong class={reference.text}>Gang Scheduling (PodGroup)</strong>
											<p class={reference.muted}>Native "all-or-nothing" scheduling for distributed training. If a job needs 16 GPUs and only 10 are free, the scheduler waits for all 16.</p>
										</div>
									</li>
									<li class={reference.row}>
										<span class={reference.accent}>β</span>
										<div class={reference.text}>
											<strong class={reference.text}>DRA Binding Conditions</strong>
											<p class={reference.muted}>Dynamic Resource Allocation now waits for hardware initialization. GPUs and FPGAs that take seconds to configure won't cause pod failures.</p>
										</div>
									</li>
								</ul>
							</div>
						</div>

						<!-- Security -->
						<div>
							<h3 class={reference.subheading}>
								<span class={reference.accent}>🔐</span> Security
							</h3>
							<div class={reference.notice}>
								<ul class={reference.list}>
									<li class={reference.row}>
										<span class={reference.accent}>β</span>
										<div class={reference.text}>
											<strong class={reference.text}>User Namespaces Support</strong>
											<p class={reference.muted}>Run containers as UID 0 inside, but unprivileged on the host. Set <code class={reference.inlineCode}>hostUsers: false</code> in your pod spec.</p>
										</div>
									</li>
									<li class={reference.row}>
										<span class={reference.accent}>α</span>
										<div class={reference.text}>
											<strong class={reference.text}>Constrained Impersonation</strong>
											<p class={reference.muted}>When impersonating another user, you can't escalate beyond your own privileges.</p>
										</div>
									</li>
								</ul>
							</div>
						</div>

						<!-- Migration Checklist -->
						<div>
							<h3 class={reference.subheading}>
								<span class={reference.accent}>✓</span> Migration Checklist
							</h3>
							<div class={reference.notice}>
								<ul class={reference.list}>
									<li class={reference.row}>
										<input type="checkbox" class={reference.checkbox} />
										<span class={reference.text}><strong>Verify cgroups v2</strong> - Run <code class={reference.inlineCode}>stat -fc %T /sys/fs/cgroup/</code> on all nodes</span>
									</li>
									<li class={reference.row}>
										<input type="checkbox" class={reference.checkbox} />
										<span class={reference.text}><strong>Check containerd version</strong> - Must be 1.7+ (2.0+ recommended)</span>
									</li>
									<li class={reference.row}>
										<input type="checkbox" class={reference.checkbox} />
										<span class={reference.text}><strong>Verify image pull secrets</strong> - Pods need valid credentials for cached images</span>
									</li>
									<li class={reference.row}>
										<input type="checkbox" class={reference.checkbox} />
										<span class={reference.text}><strong>Test in staging</strong> - Upgrade staging cluster first</span>
									</li>
									<li class={reference.row}>
										<input type="checkbox" class={reference.checkbox} />
										<span class={reference.text}><strong>Backup etcd</strong> - Always before any upgrade</span>
									</li>
								</ul>
							</div>
						</div>

						<!-- Feature Gates -->
						<div>
							<h3 class={reference.subheading}>
								<span class={reference.muted}>⚙️</span> Key Feature Gates
							</h3>
							<!-- Mobile: Card view -->
							<div class={reference.mobile}>
								<div class={reference.notice}>
									<div class={reference.row}>
										<span class={reference.tag}>GA</span>
										<span class={reference.muted}>true (locked)</span>
									</div>
									<p class={reference.inlineCode}>InPlacePodVerticalScaling</p>
								</div>
								<div class={reference.notice}>
									<div class={reference.row}>
										<span class={reference.tag}>GA</span>
										<span class={reference.muted}>true (locked)</span>
									</div>
									<p class={reference.inlineCode}>StructuredAuthenticationConfiguration</p>
								</div>
								<div class={reference.notice}>
									<div class={reference.row}>
										<span class={reference.tag}>Beta</span>
										<span class={reference.muted}>true</span>
									</div>
									<p class={reference.inlineCode}>UserNamespacesSupport</p>
								</div>
								<div class={reference.notice}>
									<div class={reference.row}>
										<span class={reference.tag}>Beta</span>
										<span class={reference.muted}>true</span>
									</div>
									<p class={reference.inlineCode}>KubeletEnsureSecretPulledImages</p>
								</div>
							</div>
							<!-- Desktop: Table view -->
							<div class:list={[layout.tableWrap, reference.desktop]}>
								<table class={layout.table}>
									<thead>
										<tr class={reference.cell}>
											<th class={reference.cell}>Feature Gate</th>
											<th class={reference.cell}>Stage</th>
											<th class={reference.cell}>Default</th>
										</tr>
									</thead>
									<tbody class={reference.muted}>
										<tr class={reference.cell}>
											<td class={reference.monoCell}>InPlacePodVerticalScaling</td>
											<td class={reference.cell}><span class={reference.tag}>GA</span></td>
											<td class={reference.cell}>true (locked)</td>
										</tr>
										<tr class={reference.cell}>
											<td class={reference.monoCell}>StructuredAuthenticationConfiguration</td>
											<td class={reference.cell}><span class={reference.tag}>GA</span></td>
											<td class={reference.cell}>true (locked)</td>
										</tr>
										<tr class={reference.cell}>
											<td class={reference.monoCell}>UserNamespacesSupport</td>
											<td class={reference.cell}><span class={reference.tag}>Beta</span></td>
											<td class={reference.cell}>true</td>
										</tr>
										<tr class={reference.cell}>
											<td class={reference.monoCell}>KubeletEnsureSecretPulledImages</td>
											<td class={reference.cell}><span class={reference.tag}>Beta</span></td>
											<td class={reference.cell}>true</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>

				<!-- CTA -->
				<div class={reference.center}>
					<div class={reference.panel}>
						<h3 class={reference.subheading}>
							More Kubernetes resources
						</h3>
						<p class={reference.muted}>
							Watch our hands-on Kubernetes tutorials and stay up-to-date with the latest cloud native content.
						</p>
						<div class={reference.actions}>
							<a
								href="/"
								class={layout.button}
							>
								Back to Academy
							</a>
							<a
								href="/watch"
								class={layout.buttonSecondary}
							>
								Watch Kubernetes Videos
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	) : (
		<!-- Lead Magnet CTA for Non-Subscribers -->
		<section class={layout.section}>
			<div class:list={[layout.container, reference.center]}>
				<h1 class={layout.title}>
					Be Ready for <span class={reference.accent}>Kubernetes 1.35</span>
				</h1>
				<p class={layout.description}>
					The biggest Kubernetes release of 2025 is coming. Don't get caught off guard by breaking changes.
				</p>
			</div>

			<div class={layout.container}>
				<K8sCheatsheetCTA
					client:visible
					isSignedIn={!!user}
					isSubscribed={false}
					signInUrl={signInUrl}
					pagePath={pagePath}
				/>
			</div>

			<!-- Additional context -->
			<div class:list={[layout.container, reference.context]}>
				<div class:list={[layout.card, reference.panel]}>
					<h2 class={reference.subheading}>
						Why You Need This Cheat Sheet
					</h2>
					<div class={reference.grid}>
						<div>
							<h3 class={reference.label}>Breaking Changes</h3>
							<p class={reference.text}>
								cgroup v1 is disabled by default - kubelet will crash on older nodes. containerd 1.x support ends. Know what to fix before you upgrade.
							</p>
						</div>
						<div>
							<h3 class={reference.label}>New GA Features</h3>
							<p class={reference.text}>
								In-place pod scaling is finally stable. Resize CPU and memory without restarts. Structured authentication enables hot-swap OIDC.
							</p>
						</div>
						<div>
							<h3 class={reference.label}>AI/ML Scheduling</h3>
							<p class={reference.text}>
								Native gang scheduling for distributed training. DRA binding conditions for GPU initialization. Built for expensive hardware.
							</p>
						</div>
						<div>
							<h3 class={reference.label}>Migration Checklist</h3>
							<p class={reference.text}>
								Step-by-step checklist to prepare your clusters. kubectl commands to verify compatibility. Feature gate reference table.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	)}
	</div>
</Page>
