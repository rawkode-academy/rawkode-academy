---
import { getCollection, getEntries } from "astro:content";
import { getImage } from "astro:assets";
import AcademyCatalogCard from "@/components/academy/AcademyCatalogCard.astro";
import AcademyCatalogMasthead from "@/components/academy/AcademyCatalogMasthead.astro";
import CourseItemListJsonLd from "@/components/html/course-itemlist-jsonld.astro";
import { academyCatalog, academyLayout } from "@rawkodeacademy/design-system";
import { getCourseModuleSlug } from "@/utils/course-path";
import Page from "@/wrappers/page.astro";

export const prerender = true;

// Get all courses and sort by published date
const allCourses = (await getCollection("courses")).sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const featuredCourse = allCourses[0];
const libraryCourses = allCourses.slice(1);
const allModules = await getCollection("courseModules");
function availabilityLabel(courseId: string) {
	const count = allModules.filter(
		(module) => module.data.course.id === courseId && !module.data.draft,
	).length;
	return count === 0
		? "Announced · no lessons available yet"
		: `${count} lesson${count === 1 ? "" : "s"} available`;
}
const courseImages = new Map(
	await Promise.all(
		allCourses.map(
			async (course) =>
				[
					course.id,
					course.data.cover
						? (
								await getImage({
									src: course.data.cover.image,
									width: 960,
									format: "webp",
								})
							).src
						: undefined,
				] as const,
		),
	),
);

// Get course modules for featured course
let featuredModuleCount = 0;
let featuredAvailableModuleCount = 0;
let firstModuleSlug: string | undefined;
let featuredAuthors: { name: string; avatarUrl?: string | undefined }[] = [];
let featuredPublishedLabel: string | undefined;

if (featuredCourse) {
	const courseModules = allModules
		.filter((module) => module.data.course.id === featuredCourse.id)
		.sort((a, b) => a.data.order - b.data.order);

	featuredModuleCount = courseModules.length;
	featuredAvailableModuleCount = courseModules.filter(
		(module) => !module.data.draft,
	).length;

	const publishedModules = courseModules.filter((module) => !module.data.draft);
	firstModuleSlug = publishedModules[0]
		? getCourseModuleSlug(featuredCourse.id, publishedModules[0].id)
		: undefined;

	const authors = await getEntries(featuredCourse.data.authors);
	featuredAuthors = authors.map((author) => ({
		name: author.data.name,
		avatarUrl: author.data.avatarUrl,
	}));
	featuredPublishedLabel = featuredCourse.data.publishedAt.toLocaleDateString(
		"en-US",
		{
			month: "short",
			day: "numeric",
			year: "numeric",
		},
	);
}

const pageTitle = "Cloud Native Courses";
const pageDescription =
	"Hands-on cloud native courses, labs, and walkthroughs covering Kubernetes, identity, GraphQL, Rust, and the tooling behind real platform engineering.";
const styles = academyLayout({ width: "wide" });
const catalog = academyCatalog();
---

<Page title={pageTitle} description={pageDescription} pageType="CollectionPage">
	<CourseItemListJsonLd
		slot="extra-head"
		courses={allCourses}
		listUrl={new URL("/courses", Astro.site ?? Astro.url).href}
		listName="Cloud Native Courses"
	/>
	<div class={styles.root}>
		<AcademyCatalogMasthead title="Courses" description="Structured courses and labs." figure={allCourses.length} figureLabel={allCourses.length === 1 ? "course" : "courses"} />
		<section class={styles.section}>
			<div class={styles.container}>
			{featuredCourse ? (
				<article class={catalog.featured}>
					<div class={catalog.featuredBody}>
						<p class={catalog.featuredKicker}>Featured course · {featuredAvailableModuleCount > 0 ? `${featuredAvailableModuleCount}/${featuredModuleCount} lessons available` : availabilityLabel(featuredCourse.id)}</p>
						<h2 class={catalog.featuredTitle}>{featuredCourse.data.title}</h2>
						<p class={catalog.featuredDescription}>{featuredCourse.data.description}</p>
						<p class={catalog.rowMeta}>{featuredCourse.data.difficulty} · {featuredPublishedLabel}{featuredAuthors.length > 0 && ` · ${featuredAuthors.map((author) => author.name).join(", ")}`}</p>
						<a class={styles.button} href={firstModuleSlug ? `/courses/${featuredCourse.id}/${firstModuleSlug}` : `/courses/${featuredCourse.id}`}>{firstModuleSlug ? "Start the course →" : "View course plan →"}</a>
					</div>
					{courseImages.get(featuredCourse.id) && <a class={catalog.featuredMedia} href={`/courses/${featuredCourse.id}`} aria-label={`Explore ${featuredCourse.data.title}`}>
						<img class={catalog.featuredImage} src={courseImages.get(featuredCourse.id)} alt={featuredCourse.data.cover?.alt ?? ""} width="960" height="540" fetchpriority="high" />
					</a>}
				</article>
			) : (
				<div class={styles.empty}>No courses are published yet.</div>
			)}
			</div>
		</section>

		{libraryCourses.length > 0 && <section id="all-courses" class={styles.section}>
			<div class={styles.container}>
			<header class={styles.sectionHeader}>
				<h2 class={styles.sectionTitle}>More courses</h2>
			</header>

				<div class={styles.grid}>
					{libraryCourses.map((course) => (
						<AcademyCatalogCard href={`/courses/${course.id}`} title={course.data.title} description={course.data.description} meta={[course.data.difficulty, availabilityLabel(course.id)]} image={courseImages.get(course.id)} imageAlt={course.data.cover?.alt ?? ""} />
					))}
				</div>
			</div>
		</section>}
	</div>
</Page>
