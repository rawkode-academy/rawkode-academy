<script>
	import { captureGrowthClientEvent, GROWTH_EVENTS } from "@/lib/analytics/growth";

	// Client-side CTA clicks; the checkout endpoint and invoice action record
	// the server-side conversions.
	document.querySelectorAll<HTMLElement>("[data-cohort-cta]").forEach((cta) => {
		cta.addEventListener("click", () => {
			captureGrowthClientEvent(GROWTH_EVENTS.COHORT_CTA_CLICKED, {
				cta_location: cta.dataset.cohortCta,
				content_id: "operations-for-ai",
			});
		});
	});
</script>
