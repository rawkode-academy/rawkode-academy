---
import { academyCourse, academyLayout } from "@rawkodeacademy/design-system";
const s = academyCourse();
const styles = academyLayout({ width: "reading" });
import { getImage } from "astro:assets";
import {
	type CollectionEntry,
	getCollection,
	getEntries,
	render,
} from "astro:content";
import CourseModules from "@/components/courses/CourseModules.astro";
import CourseSignupFormCompact from "@/components/courses/CourseSignupFormCompact.astro";
import CourseDetailHero from "@/components/courses/CourseDetailHero.vue";
import BreadcrumbJsonLd from "@/components/breadcrumb/BreadcrumbJsonLd.astro";
import CourseJsonLd from "@/components/html/course-jsonld.astro";
import Page from "@/wrappers/page.astro";
import type { GetStaticPaths, GetStaticPathsResult } from "astro";

export const prerender = true;

type Props = {
	course: CollectionEntry<"courses">;
};

export const getStaticPaths: GetStaticPaths =
	async (): Promise<GetStaticPathsResult> => {
		const courses = await getCollection("courses");

		return courses.map((course: CollectionEntry<"courses">) => {
			return {
				params: {
					slug: course.id,
				},
				props: {
					course,
				},
			};
		});
	};

const { course } = Astro.props;

const { Content } = await render(course);
const authors = await getEntries(course.data.authors);

// Get all modules for this course
const allCourseModules = (await getCollection("courseModules"))
	.filter((module) => module.data.course.id === course.id)
	.sort((a, b) => a.data.order - b.data.order);

const totalModules = allCourseModules.length;
const availableModules = allCourseModules.filter(
	(module) => !module.data.draft,
);
const availableModuleCount = availableModules.length;
// Only advertise a runtime when every published lesson has a recorded duration.
const hasCompleteDuration =
	availableModules.length > 0 &&
	availableModules.every(
		(module) => module.data.duration != null && module.data.duration > 0,
	);
const totalDuration = hasCompleteDuration
	? availableModules.reduce(
			(total, module) => total + (module.data.duration ?? 0),
			0,
		)
	: undefined;

function formatDuration(minutes: number): string {
	const hours = Math.floor(minutes / 60);
	const mins = minutes % 60;
	if (hours === 0) return `${mins}m`;
	if (mins === 0) return `${hours}h`;
	return `${hours}h ${mins}m`;
}

const coverImage = course.data.cover
	? await getImage({ src: course.data.cover.image })
	: undefined;
const imageUrl = coverImage ? new URL(coverImage.src, Astro.site) : undefined;
const cover =
	coverImage && course.data.cover
		? {
				src: coverImage.src,
				alt: course.data.cover.alt,
				width: course.data.cover.image.width,
				height: course.data.cover.image.height,
			}
		: undefined;
const hasCourseResources = Boolean(course.data.resources?.length);
const hasSupplementaryContent = Boolean(
	course.data.signupConfig || hasCourseResources,
);

// Format authors for the hero component
const formattedAuthors = authors.map((author) => ({
	name: author.data.name,
	href: `/people/${author.data.id}`,
	avatarUrl: author.data.avatarUrl,
}));

function getResourceHref(
	resource: NonNullable<typeof course.data.resources>[number],
) {
	if (resource.type === "url") return resource.url;
	if (resource.type === "file" && resource.filePath)
		return `/resources/${resource.filePath}`;
	return undefined;
}
---

<Page
	title={course.data.title}
	description={course.data.description}
	image={imageUrl
		? {
				image: imageUrl,
				text: course.data.title,
				format: "png" as const,
			}
		: undefined}
	publishedAt={course.data.publishedAt}
	updatedAt={course.data.updatedAt}
	authors={authors}
>
	{imageUrl && (
		<CourseJsonLd
			slot="extra-head"
			course={course}
			imageUrl={imageUrl}
			modules={allCourseModules}
			authors={authors}
		/>
	)}
	<BreadcrumbJsonLd
		slot="extra-head"
		elements={[
			{ title: "Home", link: "/" },
			{ title: "Courses", link: "/courses" },
			{ title: course.data.title, link: `/courses/${course.id}` },
		]}
	/>
	
	<CourseDetailHero
		title={course.data.title}
		description={course.data.description}
		moduleCount={totalModules}
		availableModuleCount={availableModuleCount}
		totalDuration={totalDuration === undefined ? undefined : formatDuration(totalDuration)}
		difficulty={course.data.difficulty.charAt(0).toUpperCase() + course.data.difficulty.slice(1)}
		authors={formattedAuthors}
		cover={cover}
	/>

	<div class={s.detailBody}>
		<section id="course-content" class={s.curriculum} aria-labelledby="curriculum-title">
			<h2 id="curriculum-title" class={s.sectionHeading}>Curriculum</h2>
			<CourseModules course={course} modules={allCourseModules} />
		</section>

		<div class={hasSupplementaryContent ? s.detailGrid : s.detailStack}>
			<div class={s.detailStack}>
				{course.data.learningPath.length > 0 && (
					<section class={s.detailStack} aria-labelledby="objectives-title">
						<h2 id="objectives-title" class={s.sectionHeading}>Learning objectives</h2>
						<ul class={s.objectiveList}>
							{course.data.learningPath.map((objective) => <li>{objective}</li>)}
						</ul>
					</section>
				)}
				<article class={styles.prose}>
					<Content />
				</article>
			</div>

			{hasSupplementaryContent && (
				<aside class={s.supplementary} aria-label="Course updates and resources">
					{course.data.signupConfig && (
						<section class={s.signup} aria-labelledby="course-updates-title">
							<h2 id="course-updates-title" class={s.sectionHeading}>Course updates</h2>
							<CourseSignupFormCompact
								courseId={course.id}
								courseTitle={course.data.title}
								pagePath={Astro.url.pathname}
								signupConfig={course.data.signupConfig}
								server:defer
							>
								<p slot="fallback" class={s.copy}>
									Loading optional course email signup. If it does not load, <a href={Astro.url.pathname}>reload this course to retry</a>.
									Signup requires JavaScript; all course content remains available without signing up.
								</p>
							</CourseSignupFormCompact>
						</section>
					)}
					{hasCourseResources && (
						<section class={s.detailStack} aria-labelledby="course-resources-title">
							<h2 id="course-resources-title" class={s.sectionHeading}>References</h2>
							<div class={s.detailStack}>
								{course.data.resources?.map((resource) => {
									const href = getResourceHref(resource);
									return (
										<div class={s.lessonCopy}>
											{href ? (
												<a
													href={href}
													target={resource.type === "url" ? "_blank" : undefined}
													rel={resource.type === "url" ? "noopener noreferrer" : undefined}
												class:list={[s.link, s.referenceLink]}
												>{resource.title}</a>
											) : <h3 class={s.lessonTitle}>{resource.title}</h3>}
											{resource.description && <p class={s.lessonDescription}>{resource.description}</p>}
										</div>
									);
								})}
							</div>
						</section>
					)}
				</aside>
			)}
		</div>
	</div>
</Page>
