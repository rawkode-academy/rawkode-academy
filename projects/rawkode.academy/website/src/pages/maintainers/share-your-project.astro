---
import EditorialShell from "@/components/ui/EditorialShell.astro";
import Page from "@/wrappers/page.astro";

export const prerender = true;

const application = "mailto:david@rawkode.academy?subject=Share%20my%20open-source%20project&body=Project%20name%3A%0AProject%20URL%3A%0AMaintainers%3A%0AWhat%20you%20want%20to%20cover%3A%0AWhy%20this%20is%20useful%20for%20developers%3A";
const processSteps = [
	{ title: "Tell us about the project", body: "Send the project, maintainers, and what you want to cover. We check fit before confirming a slot." },
	{ title: "Shape a focused session", body: "We send prep notes and work with you on a demo, architecture walkthrough, or technical discussion." },
	{ title: "Join David live", body: "Walk through the project, explain the trade-offs, and answer questions from the audience." },
	{ title: "Share the recording", body: "Use the recording and session links in your documentation, contributor guides, and community channels." },
];
const expectations = [
	"Cloud native systems, developer tools, infrastructure, and automation projects are the strongest fit.",
	"You do not need to be the original creator. Maintainers and contributors who know the project deeply are welcome.",
	"Bring a working demo and an honest account of the trade-offs. The session is for working developers, not a sales pitch.",
	"This is not paid placement, endorsement, or lead generation. Commercial work belongs in our partnership programme.",
];
---

<Page title="Share Your Project on Rawkode Live" description="Bring your open-source project to Rawkode Live for a maintainer conversation, technical demo, and audience Q&A.">
	<EditorialShell eyebrow="For open-source maintainers" title="Show us how it works."
		lede="Bring your project to Rawkode Live. Spend 60–90 minutes with David exploring the architecture, running a demo, and answering real questions. Free for open-source projects.">
		<div class="editorial-actions" slot="actions">
			<a class="editorial-button" href={application}>Pitch your session</a>
			<a class="editorial-button editorial-button--secondary" href="/shows/rawkode-live">Watch previous sessions</a>
		</div>

		<section class="editorial-section editorial-section--split" aria-labelledby="session-process">
			<div class="editorial-section__header">
				<h2 id="session-process" class="editorial-section__title">From idea to live demo.</h2>
				<p class="editorial-section__lede">A useful walkthrough your community can keep coming back to.</p>
			</div>
			<ol class="session-steps">
				{processSteps.map((step) => (
					<li><h3>{step.title}</h3><p>{step.body}</p></li>
				))}
			</ol>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="session-fit">
			<div class="editorial-section__header">
				<h2 id="session-fit" class="editorial-section__title">Is your project a fit?</h2>
			</div>
			<div class="session-copy">
				<ul class="editorial-list">{expectations.map((expectation) => <li>{expectation}</li>)}</ul>
				<a href="https://rawkode.link/live-prep">Read the session prep notes ↗</a>
			</div>
		</section>

		<section class="editorial-section editorial-section--split" aria-labelledby="session-contact">
			<div class="editorial-section__header">
				<h2 id="session-contact" class="editorial-section__title">What would you like to show?</h2>
				<p class="editorial-section__lede">Send a short email. We’ll reply if it is a fit and arrange a time together.</p>
			</div>
			<div class="session-copy">
				<ul class="editorial-list">
					<li>Project name, URL, and maintainer contacts</li>
					<li>The problem it solves and the demo you have in mind</li>
					<li>Any timing constraints around a release or community event</li>
				</ul>
				<a href={application}>david@rawkode.academy</a>
			</div>
		</section>
	</EditorialShell>
</Page>

<style>
	.session-steps { counter-reset: step; display: grid; margin: 0; padding: 0; list-style: none; }
	.session-steps li { counter-increment: step; display: grid; grid-template-columns: 2rem minmax(0, 1fr); column-gap: 1rem; padding-block: 1.25rem; border-bottom: 1px solid var(--colors-academy-border); }
	.session-steps li:first-child { padding-top: 0; }
	.session-steps li:last-child { border: 0; padding-bottom: 0; }
	.session-steps li::before { content: counter(step, decimal-leading-zero); grid-row: span 2; padding-top: 0.2rem; color: var(--colors-academy-accent); font-family: var(--fonts-academy-mono); font-size: 0.8rem; }
	.session-steps h3 { font-family: var(--fonts-academy-display); font-size: 1.25rem; font-weight: 700; line-height: 1.3; }
	.session-steps p { margin-top: 0.5rem; color: var(--colors-academy-text-soft); line-height: 1.65; }
	.session-copy { display: grid; align-content: start; gap: 1.5rem; }
	.session-copy a { width: fit-content; min-height: 2.75rem; display: inline-flex; align-items: center; color: var(--colors-academy-accent); text-underline-offset: 0.2em; }
	.session-copy a:focus-visible { outline: 2px solid var(--colors-academy-accent); outline-offset: 4px; }
</style>
