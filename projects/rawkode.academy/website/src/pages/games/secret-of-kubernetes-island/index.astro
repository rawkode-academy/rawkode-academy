---
import PageWrapper from "@/wrappers/page.astro";
import { DISABLE_GAME_AUTH } from "astro:env/server";
import { academyLayout, academyMedia } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

const disableAuth = DISABLE_GAME_AUTH === "true";
const layout = academyLayout({ width: "wide" });
const media = academyMedia();
---

<PageWrapper
	title="Secret of Kubernetes Island"
	description="A verbal combat game where you breach Kubernetes clusters one insult at a time"
>
	<div class:list={[layout.root, media.root, "game-route"]}>
	<div class:list={[layout.section, media.frame, media.canvas, "game-wrapper"]}>
		<div id="game-root" data-disable-auth={disableAuth ? "true" : "false"}></div>
	</div>
	</div>
</PageWrapper>

<script>
	import { createApp } from "vue";
	import Game from "@/components/game/Game.vue";

	const app = createApp(Game);
	app.mount("#game-root");
</script>

<style>
	.game-wrapper {
		width: 100%;
		min-height: calc(100vh - 200px);
		border-radius: 12px;
		overflow: hidden;
	}

	#game-root {
		width: 100%;
		height: 100%;
		min-height: calc(100vh - 200px);
	}
</style>
