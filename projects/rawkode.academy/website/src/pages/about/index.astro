---
import { Image } from "astro:assets";
import { academyAbout, academyLayout } from "@rawkodeacademy/design-system";
import Page from "@/wrappers/page.astro";
import headerPhoto from "./_header.png";

export const prerender = true;

const layout = academyLayout({ width: "wide" });
const styles = academyAbout();

const principles = [
	{
		title: "Show the whole process",
		body: "The mistakes, dead ends, and fixes are part of the lesson. We show the work as it happens.",
	},
	{
		title: "Learn from maintainers",
		body: "Hear the decisions, constraints, and trade-offs from the people who build and contribute to the project.",
	},
	{
		title: "Keep experimenting",
		body: "Explore emerging runtimes, infrastructure patterns, and developer workflows before they become default practice.",
	},
];

const milestones = [
	{
		period: "2003–2016",
		title: "Building and operating systems",
		body: "David worked across ticketing systems, custom kernels, and automation. At TeamRock, he helped move workloads from virtual machines to containers on AWS as traffic grew.",
	},
	{
		period: "2016–2019",
		title: "Making education a daily practice",
		body: "As a developer advocate at InfluxData, working with Kubernetes metrics, Telegraf, and operators brought together live demos, teaching, and direct technical support.",
	},
	{
		period: "2019",
		title: "Rawkode Academy launches",
		body: "The first video set the tone: practical exploration of cloud native tools and conversations with the people behind them.",
	},
];

const formats = [
	{
		id: "rawkode-live",
		title: "Rawkode Live",
		href: "/shows/rawkode-live",
		body: "Live coding and conversations with maintainers and practitioners. Follow the releases, bugs, and decisions as they unfold.",
	},
	{
		id: "klustered",
		title: "Klustered",
		href: "/shows/klustered",
		body: "Experts repair deliberately broken Kubernetes clusters under pressure. Watch how they reason through the problem.",
	},
	{
		id: "learning-paths",
		title: "Learning paths",
		href: "/learning-paths",
		body: "Selected lessons organized into a sequence. Work through a topic at your own pace.",
	},
];
---

<Page
	title="About Rawkode Academy"
	description="The story, mission, and formats behind Rawkode Academy and its practical cloud native education."
	pageType="AboutPage"
>
	<div class={layout.root}>
		<div class={layout.section}>
			<header class={styles.hero}>
				<div class={styles.introduction}>
					<p class={styles.kicker}>About Rawkode Academy</p>
					<h1 class={styles.title}>Cloud native learning, out in the open.</h1>
					<p class={styles.lede}>
						Rawkode Academy helps engineers understand modern infrastructure by watching
						real people build, break, debug, and explain real systems.
					</p>
					<p class={styles.byline}>Built by David Flanagan, known as Rawkode.</p>
				</div>
				<figure class={styles.figure}>
					<Image
						src={headerPhoto}
						alt="David Flanagan presenting on stage beside a slide about InfluxDB."
						class={styles.photo}
						width={1280}
						widths={[480, 768, 1280, 1920]}
						sizes="(min-width: 1180px) 620px, (min-width: 1024px) 54vw, 100vw"
						format="webp"
						loading="eager"
						fetchpriority="high"
					/>
					<figcaption class={styles.caption}>David Flanagan (Rawkode), sharing the work on stage.</figcaption>
				</figure>
			</header>

			<section class={styles.mission} aria-labelledby="about-mission">
				<div class={styles.sectionHeading}>
					<p class={styles.kicker}>The approach</p>
					<h2 id="about-mission" class={styles.sectionTitle}>Complex systems. Honest explanations.</h2>
					<p class={styles.copy}>
						Make complex systems easier to learn without pretending they are simple.
						That means context, trade-offs, tooling, mistakes, and repetition.
					</p>
				</div>
				<ul class={styles.principles}>
					{principles.map((principle) => (
						<li class={styles.principle}>
							<h3 class={styles.itemTitle}>{principle.title}</h3>
							<p class={styles.copy}>{principle.body}</p>
						</li>
					))}
				</ul>
			</section>

			<section class={styles.story} aria-labelledby="about-story">
				<div class={styles.sectionHeading}>
					<p class={styles.kicker}>The story</p>
					<h2 id="about-story" class={styles.sectionTitle}>A builder’s path into teaching.</h2>
					<p class={styles.copy}>
						From building systems to explaining how they work. Today, the academy brings
						together shows, articles, and partnerships around the same idea: learn by doing the real work.
					</p>
				</div>
				<div class={styles.storyBody}>
					<ol class={styles.timeline}>
						{milestones.map((milestone) => (
							<li class={styles.milestone}>
								<p class={styles.period}>{milestone.period}</p>
								<div class={styles.milestoneBody}>
									<h3 class={styles.itemTitle}>{milestone.title}</h3>
									<p class={styles.copy}>{milestone.body}</p>
								</div>
							</li>
						))}
					</ol>
					<aside class={styles.origins} aria-labelledby="about-origins">
						<h3 id="about-origins" class={styles.archiveTitle}>From the early archive</h3>
						<ul class={styles.archiveLinks}>
							<li>
								<a class={styles.archiveLink} href="https://www.youtube.com/watch?v=ebei2vbn2o8">
									Last Week in Kubernetes <span class={styles.linkMeta}>on YouTube <span aria-hidden="true">↗</span></span>
								</a>
							</li>
							<li>
								<a class={styles.archiveLink} href="https://www.youtube.com/watch?v=teB22ZuV_z8">
									Klustered, episode one <span class={styles.linkMeta}>on YouTube <span aria-hidden="true">↗</span></span>
								</a>
							</li>
						</ul>
					</aside>
				</div>
			</section>

			<section class={styles.formats} aria-labelledby="about-formats">
				<div class={styles.sectionHeading}>
					<p class={styles.kicker}>Put it into practice</p>
					<h2 id="about-formats" class={styles.sectionTitle}>Find your way into the work.</h2>
				</div>
				<div class={styles.formatGrid}>
					{formats.map((format) => (
						<a class={styles.formatLink} href={format.href} aria-labelledby={"about-" + format.id}>
							<h3 id={"about-" + format.id} class={styles.formatTitle}>
								{format.title}<span class={styles.arrow} aria-hidden="true">→</span>
							</h3>
							<p class={styles.copy}>{format.body}</p>
						</a>
					))}
				</div>
			</section>
		</div>
	</div>
</Page>
