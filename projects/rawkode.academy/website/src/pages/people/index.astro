---
export const prerender = true;

import PersonItemListJsonLd from "@/components/html/person-itemlist-jsonld.astro";
import AcademyCatalogMasthead from "@/components/academy/AcademyCatalogMasthead.astro";
import { academyCatalog, academyLayout } from "@rawkodeacademy/design-system";
import Page from "@/wrappers/page.astro";
import { getCollection } from "astro:content";
import { getPublishedVideos } from "@/lib/content";
import { getPersonIdentityUrls } from "@/lib/person-identity-links";

const people = await getCollection("people");
const sortedPeople = people.sort((a, b) =>
	a.data.name.localeCompare(b.data.name),
);

const peopleJsonLd = sortedPeople.map((person) => ({
	id: person.data.id,
	name: person.data.name,
	avatarUrl: person.data.avatarUrl,
	sameAs: getPersonIdentityUrls(person.data),
}));
// The masthead shows the most recent guests first, in the order they
// appeared on the Academy, then fills with everyone else who has a portrait.
const recentGuestIds = (await getPublishedVideos())
	.slice(0, 40)
	.flatMap((video) => video.data.guests.map((guest) => guest.id));
const portraitOf = new Map(
	sortedPeople
		.filter((person) => person.data.avatarUrl)
		.map((person) => [person.id, person.data.avatarUrl as string]),
);
const mosaic = [...new Set([...recentGuestIds, ...portraitOf.keys()])]
	.map((id) => portraitOf.get(id))
	.filter((src): src is string => Boolean(src));
const styles = academyLayout({ width: "wide" });
const catalog = academyCatalog({ identityLayout: "portrait" });
---

<Page
	title="People"
	description="Meet the hosts, guests, contributors, and instructors behind Rawkode Academy."
	pageType="CollectionPage"
>
	<PersonItemListJsonLd
		slot="extra-head"
		people={peopleJsonLd}
		listUrl={new URL("/people", Astro.site ?? Astro.url).href}
		listName="Rawkode Academy People"
	/>
	<div class={styles.root}>
		<AcademyCatalogMasthead title="People" description="The hosts, guests, and contributors who build, break, and explain things on the Academy." figure={sortedPeople.length} figureLabel="people" mosaic={mosaic} mosaicShape="portrait" />

		<section class={styles.section} aria-label="People search">
			<div class={styles.container}>
				<div class={styles.toolbar}>
					<label for="people-search">Filter people</label>
					<input
						id="people-search"
						type="search"
						placeholder="Name or handle"
						class={styles.input}
						autocomplete="off"
						aria-controls="people"
						aria-describedby="people-count"
					/>
					<p id="people-count" class={catalog.resultCount} role="status" aria-atomic="true">
						{people.length} {people.length === 1 ? "person" : "people"}
					</p>
				</div>

				<div id="people" class={catalog.identityGrid}>
					{
						sortedPeople.map((person) => {
							const handles = Object.values(person.data.handles).filter(Boolean);
							const handle = person.data.handles.twitter
								|| person.data.handles.github
								|| person.data.handles.bluesky;
							const searchKeywords = [
								person.data.name, ...handles.map((value) => `@${value}`), ...(person.data.terms ?? []),
							].join(" ").toLowerCase();
							const names = person.data.name.trim().split(/\s+/u);
							const initials = (names.length > 1
								? [...names.slice(0, 1), ...names.slice(-1)].map((name) => Array.from(name)[0]).join("")
								: Array.from(person.data.name).slice(0, 2).join("")
							).toUpperCase();

							return (
								<a
									href={`/people/${person.data.id}`}
									class={catalog.identity}
									data-keywords={searchKeywords}
									aria-labelledby={`person-${person.data.id}`}
								>
									<span class={catalog.identityPortrait} aria-hidden="true">
										<span class={catalog.identityInitials} hidden={Boolean(person.data.avatarUrl)}>{initials}</span>
										{person.data.avatarUrl && <img
											src={person.data.avatarUrl}
											alt=""
											width="192"
											height="192"
											class={catalog.identityAvatar}
											loading="lazy"
											onerror="this.previousElementSibling.hidden=false; this.remove();"
										/>}
									</span>
									<span class={catalog.identityBody}>
										<span id={`person-${person.data.id}`} class={catalog.identityTitle} data-name>{person.data.name}</span>
										{handle && <span class={catalog.identityMeta}>@{handle.replace(/^@/, "")}</span>}
									</span>
									<span class={catalog.identityArrow} aria-hidden="true">→</span>
								</a>
							);
						})
					}
				</div>

				<div id="people-empty-state" class={catalog.empty} hidden={people.length !== 0}>
					<h2>No people match your search</h2>
					<p>Try another name or handle.</p>
				</div>
			</div>
		</section>

		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const searchInput = document.getElementById("people-search") as HTMLInputElement | null;
				const cards = Array.from(
					document.querySelectorAll<HTMLElement>("#people [data-keywords]"),
				);
				const emptyState = document.getElementById("people-empty-state");
				const count = document.getElementById("people-count");

				const applySearch = () => {
					const query = (searchInput?.value ?? "").trim().toLowerCase();
					let visible = 0;

					cards.forEach((card) => {
						const keywords = card.dataset.keywords ?? "";
						const matchesSearch = keywords.includes(query);

						card.hidden = !matchesSearch;
						if (matchesSearch) {
							visible += 1;
						}
					});

					if (count) {
						count.textContent = query
							? `${visible} of ${cards.length} people`
							: `${cards.length} ${cards.length === 1 ? "person" : "people"}`;
					}

					if (emptyState) {
						emptyState.hidden = visible !== 0;
					}
				};

				searchInput?.addEventListener("input", applySearch);
				applySearch();
			});
		</script>
	</div>
</Page>
