---
import { academyDocument, academyLayout } from "@rawkodeacademy/design-system";
const doc = academyDocument();
const styles = academyLayout({ width: "reading" });
export const prerender = true;

import Page from "@/wrappers/page.astro";
import { getCollection, getEntries, render } from "astro:content";
import VideoFeed from "@/components/video/video-feed.astro";
import ShowCard from "@/components/show/ShowCard.astro";
import PersonJsonLd from "@/components/html/person-jsonld.astro";
import type { ShowSummary } from "@/types/show";
import { normalizeTechnologyReferences } from "@/utils/normalize-technology-refs";
import { getVideoThumbnailUrl } from "@/lib/video-thumbnail";
import { getPersonIdentityUrls } from "@/lib/person-identity-links";
import { isNewsPublished } from "@/lib/news-publication";

export async function getStaticPaths() {
	const people = await getCollection("people");
	return people.map((person) => ({
		params: { id: person.data.id },
		props: { person },
	}));
}

const { person } = Astro.props;

const now = new Date();
const videos = await getCollection("videos", ({ data }) => data.publishedAt <= now);
const shows = await getCollection("shows", ({ data }) => data.publish);
const technologies = await getCollection("technologies");
const news = await getCollection("news", ({ data }) => isNewsPublished(data.publishedAt, now));
const articles = await getCollection("articles", ({ data }) => data.publishedAt <= now);
const techNameById = new Map(
	technologies.map((t) => [t.id.replace(/\/index$/, ""), t.data.name] as const),
);

// Helper to match references
const matchRef = (
	ref: { collection: string; id: string } | string,
	id: string,
) => {
	if (typeof ref === "string") return ref === id;
	return ref.id === id;
};

const hostedShows = shows.filter((show) =>
	show.data.hosts.some((h) => matchRef(h, person.data.id)),
);

const guestVideos = videos.filter((video) =>
	video.data.guests.some((g) => matchRef(g, person.data.id)),
);

const authoredNews = news
	.filter((story) =>
		story.data.authors.some((author) => matchRef(author, person.data.id)),
	)
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const authoredArticles = articles
	.filter((article) =>
		article.data.authors.some((author) => matchRef(author, person.data.id)),
	)
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const formatPublishDate = (date: Date) =>
	new Intl.DateTimeFormat("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
	}).format(date);

// Prepare Show Summaries
const showSummaries: ShowSummary[] = await Promise.all(
	hostedShows.map(async (show) => {
		const showVideos = videos.filter((v) => v.data.show?.id === show.data.id);
		const hosts = await getEntries(show.data.hosts);

		return {
			id: show.data.id,
			name: show.data.name,
			hosts: hosts.map((h) => ({
				forename: h.data.forename ?? null,
				surname: h.data.surname ?? null,
			})),
			cover: show.data.cover,
			episodes: showVideos.map((v) => ({
				video: {
					title: v.data.title,
					thumbnailUrl: getVideoThumbnailUrl(v.data.id),
					publishedAt: v.data.publishedAt.toISOString(),
				},
			})),
		};
	}),
);

// Prepare Guest Videos for Feed
const guestVideoFeed = guestVideos
	.map((video) => ({
		id: video.data.id,
		title: video.data.title,
		thumbnailUrl: getVideoThumbnailUrl(video.data.id),
		streamUrl: `https://content.rawkode.academy/videos/${video.data.id}/stream.m3u8`,
		duration: typeof video.data.duration === "number" ? video.data.duration : 0,
		slug: video.data.slug,
		publishedAt:
			video.data.publishedAt instanceof Date
				? video.data.publishedAt.toISOString()
				: String(video.data.publishedAt),
		type: video.data.type,
	}))
	.sort(
		(a, b) =>
			new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime(),
	);

// Render any biography MDX body content (most people have empty bodies)
const { Content: BiographyContent } = await render(person);
const hasBiography = Boolean(person.body && person.body.trim().length > 0);

// Build a data-driven description so each profile is unique to Google
const videoCount = guestVideos.length;
const showCount = hostedShows.length;

// Top technologies this person has talked about, sorted by frequency
const techCounts = new Map<string, number>();
for (const v of guestVideos) {
	for (const techId of normalizeTechnologyReferences(v.data.technologies)) {
		const id = techId.replace(/\/index$/, "");
		techCounts.set(id, (techCounts.get(id) ?? 0) + 1);
	}
}
const topTechNames = [...techCounts.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 5)
	.map(([id]) => techNameById.get(id) ?? id);

const showNames = hostedShows.map((s) => s.data.name);

const newsCount = authoredNews.length;
const articleCount = authoredArticles.length;

// Thin profiles (no shows hosted, no guest appearances, no authored content,
// no biography) get noindex'd so Google doesn't classify them as low-quality
// and drag down site quality.
const noindex =
	videoCount === 0 &&
	showCount === 0 &&
	newsCount === 0 &&
	articleCount === 0 &&
	!hasBiography;

const pageTitle = (() => {
	if (showCount > 0) {
		return `${person.data.name}: Host of ${showNames[0]}`;
	}
	if (topTechNames.length > 0) {
		return `${person.data.name}: Talks on ${topTechNames.slice(0, 2).join(" & ")}`;
	}
	return person.data.name;
})();

const pageDescription = (() => {
	const parts: string[] = [];
	if (showCount > 0) {
		parts.push(
			`Host of ${showNames.slice(0, 2).join(" and ")}${showCount > 2 ? ` and ${showCount - 2} more shows` : ""}`,
		);
	}
	if (videoCount > 0) {
		parts.push(
			`${videoCount} appearance${videoCount === 1 ? "" : "s"} on Rawkode Academy`,
		);
	}
	const writtenCount = newsCount + articleCount;
	if (writtenCount > 0) {
		parts.push(
			`${writtenCount} published ${writtenCount === 1 ? "story" : "stories"}`,
		);
	}
	if (topTechNames.length > 0) {
		parts.push(`covering ${topTechNames.slice(0, 4).join(", ")}`);
	}
	if (parts.length === 0) {
		return `${person.data.name} on Rawkode Academy: interviews, live coding, and conversations with leaders in Cloud Native and open source.`;
	}
	return `${person.data.name}: ${parts.join(", ")}. Watch interviews, live coding, and technical discussions on Rawkode Academy.`;
})();

const profileUrl = new URL(`/people/${person.data.id}`, Astro.site).href;

const authoredSocialLinks = [
	person.data.mastodon && {
		name: "Mastodon",
		url: person.data.mastodon,
		filled: true,
		icon: "M21.327 8.566c0-4.339-2.843-5.61-2.843-5.61-1.433-.658-3.894-.935-6.451-.956h-.063c-2.557.021-5.016.298-6.45.956 0 0-2.843 1.272-2.843 5.61 0 .993-.019 2.181.012 3.441.103 4.243.778 8.425 4.701 9.463 1.809.479 3.362.579 4.612.51 2.268-.126 3.541-.809 3.541-.809l-.075-1.646s-1.621.511-3.441.449c-1.804-.062-3.707-.194-3.999-2.409a4.523 4.523 0 0 1-.041-.621s1.77.433 4.014.536c1.372.063 2.658-.08 3.965-.236 2.506-.299 4.688-1.843 4.962-3.254.434-2.223.398-5.424.398-5.424zm-3.353 5.59h-2.081V9.057c0-1.075-.452-1.62-1.357-1.62-1 0-1.501.647-1.501 1.927v2.791h-2.069V9.364c0-1.28-.501-1.927-1.502-1.927-.905 0-1.357.546-1.357 1.62v5.099H6.026V8.903c0-1.074.273-1.927.823-2.558.566-.631 1.307-.955 2.228-.955 1.065 0 1.872.409 2.405 1.228l.518.869.519-.869c.533-.819 1.34-1.228 2.405-1.228.92 0 1.662.324 2.228.955.549.631.822 1.484.822 2.558v5.253z",
	},
	person.data.bluesky && {
		name: "Bluesky",
		url: person.data.bluesky,
		filled: true,
		icon: "M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z",
	},
	person.data.twitter && {
		name: "Twitter",
		url: person.data.twitter,
		icon: "M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z",
	},
	person.data.github && {
		name: "GitHub",
		url: person.data.github,
		icon: "M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22",
	},
	person.data.linkedin && {
		name: "LinkedIn",
		url: person.data.linkedin,
		icon: "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z M2 4a2 2 0 1 1 4 0 2 2 0 0 1-4 0z",
	},
	person.data.website && {
		name: "Website",
		url: person.data.website,
		icon: "M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71",
	},
	person.data.youtube && {
		name: "YouTube",
		url: person.data.youtube,
		icon: "M10 8l6 4-6 4V8Z M3 5h18v14H3V5Z",
	},
].filter((link) => typeof link === "object");

// Exact equality only: authored fragments can identify different destinations.
const linksByUrl = new Map<string, { name: string; url: string; icon: string; filled?: boolean }>();
for (const link of authoredSocialLinks) {
	const existing = linksByUrl.get(link.url);
	if (existing) existing.name += ` / ${link.name}`;
	else linksByUrl.set(link.url, { ...link });
}
const socialLinks = [...linksByUrl.values()];

// Keep dedicated social-profile identity links consistent with the directory.
// Website/YouTube links remain visible without claiming they identify a Person.
const relMeUrls = getPersonIdentityUrls(person.data);
const identityUrls = new Set(relMeUrls);
---

<Page
 title={pageTitle}
 description={pageDescription}
 noindex={noindex}
 pageType="ProfilePage"
 useImageDirectly={Boolean(person.data.avatarUrl)}
 image={person.data.avatarUrl ? { image: new URL(person.data.avatarUrl) } : undefined}
>
 <PersonJsonLd
 slot="extra-head"
 name={person.data.name}
 url={profileUrl}
 description={pageDescription}
 image={person.data.avatarUrl}
 sameAs={relMeUrls}
 />
 <Fragment slot="extra-head">
 {relMeUrls.map((url) => (
 <link rel="me" href={url} />
 ))}
 <link
 rel="alternate"
 type="application/rss+xml"
 title={`Rawkode Academy: ${person.data.name} (RSS)`}
 href={`/api/feeds/people/${person.data.id}.xml`}
 />
 </Fragment>
	<div class={[doc.section, doc.stack].join(" ")}>
		<header class={doc.personHero}>
			<div class={doc.portrait} aria-hidden="true">
				{person.data.avatarUrl && <img
					src={person.data.avatarUrl}
					alt=""
					width="160"
					height="160"
					class={doc.image}
					onerror="this.hidden=true; this.nextElementSibling.hidden=false;"
				/>}
				<span class={doc.portraitInitials} hidden={Boolean(person.data.avatarUrl)}>{person.data.name.split(/\s+/).map((part: string) => part[0]).slice(0, 2).join("")}</span>
			</div>
			<div class={doc.stack}>
				<a href="/people" class={doc.link}>← People</a>
				<h1 class={doc.title}>{person.data.name}</h1>
				{(showCount > 0 || videoCount > 0 || articleCount + newsCount > 0) && <p class={doc.meta}>{
					[
						showCount > 0 ? `Host of ${showCount} ${showCount === 1 ? "show" : "shows"}` : undefined,
						videoCount > 0 ? `${videoCount} guest ${videoCount === 1 ? "appearance" : "appearances"}` : undefined,
						articleCount + newsCount > 0 ? `${articleCount + newsCount} published stories` : undefined,
					].filter(Boolean).join(" · ")
				}</p>}
				{socialLinks.length > 0 && <nav class={doc.actions} aria-label={`${person.data.name}'s links`}>
					{socialLinks.map((link: any) => <a href={link.url} target="_blank" rel={identityUrls.has(link.url) ? "me noopener noreferrer" : "noopener noreferrer"} class={doc.socialLink}>
						<svg class={doc.iconSmall} viewBox="0 0 24 24" fill={link.filled ? "currentColor" : "none"} stroke={link.filled ? "none" : "currentColor"} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={link.icon} /></svg>
						{link.name}
					</a>)}
				</nav>}
			</div>
		</header>

		{hasBiography && <section class={styles.prose} aria-label="Biography"><BiographyContent /></section>}
		{noindex && <p class={doc.copy}>No published contributions yet.</p>}

		{showSummaries.length > 0 && <section class={doc.stack} aria-labelledby="hosted-shows">
			<h2 id="hosted-shows" class={doc.sectionTitle}>Shows</h2>
			<div class={doc.gridTwo}>{showSummaries.map((show) => <ShowCard show={show} />)}</div>
		</section>}

		{guestVideoFeed.length > 0 && <section class={doc.stack} aria-labelledby="guest-appearances">
			<h2 id="guest-appearances" class={doc.sectionTitle}>Guest appearances</h2>
			<VideoFeed title="" description="" videos={guestVideoFeed} />
		</section>}

		{[
			{ id: "articles", heading: "Articles", entries: authoredArticles, prefix: "/read" },
			{ id: "news", heading: "News", entries: authoredNews, prefix: "/news" },
		].map(({id, heading, entries, prefix}) => entries.length > 0 && <section class={doc.stack} aria-labelledby={id}>
			<h2 id={id} class={doc.sectionTitle}>{heading}</h2>
			<ul class={doc.list}>
				{entries.map((entry) => <li class={doc.listItem}>
					<article class={doc.stackSmall}>
						<time class={doc.meta} datetime={entry.data.publishedAt.toISOString()}>{formatPublishDate(entry.data.publishedAt)}</time>
						<h3 class={doc.cardTitle}><a href={`${prefix}/${entry.id}`} class={doc.link}>{entry.data.title}</a></h3>
						<p class={doc.copy}>{entry.data.description}</p>
					</article>
				</li>)}
			</ul>
		</section>)}
	</div>
</Page>
