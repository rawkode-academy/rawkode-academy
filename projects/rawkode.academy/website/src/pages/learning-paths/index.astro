---
export const prerender = true;

import { getCollection, getEntries } from "astro:content";
import AcademyPage from "@/components/academy/AcademyPage.vue";
import Page from "@/wrappers/page.astro";
import LearningPathItemListJsonLd from "@/components/html/learning-path-itemlist-jsonld.astro";

const now = new Date();
const [learningPaths, technologies] = await Promise.all([
	getCollection("learningPaths", ({ data }) => data.publishedAt <= now),
	getCollection("technologies"),
]);

learningPaths.sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const technologyNameById = new Map<string, string>();
for (const technology of technologies) {
	technologyNameById.set(
		technology.id.replace(/\/index$/, ""),
		technology.data.name,
	);
}

const itemListPaths = await Promise.all(
	learningPaths.map(async (path) => {
		const authorEntries = await getEntries(path.data.authors);
		return {
			path,
			authors: authorEntries.map((author) => ({
				id: author.data.id,
				name: author.data.name,
			})),
			technologyLabels: (path.data.technologies ?? []).map(
				(technologyId) => technologyNameById.get(technologyId) ?? technologyId,
			),
		};
	}),
);

const compactCopy = (value: string | undefined, maxLength = 220) => {
	const normalized = (value ?? "").replace(/\s+/g, " ").trim();
	if (!normalized) return "A practical route through cloud native work.";
	const firstSentence = normalized.match(/^.*?[.!?](?:\s|$)/)?.[0]?.trim();
	if (firstSentence && firstSentence.length <= maxLength) return firstSentence;
	if (normalized.length <= maxLength) return normalized;
	return `${normalized.slice(0, maxLength).trimEnd()}…`;
};

const formatPathDuration = (minutes?: number | null) => {
	if (!minutes || minutes <= 0) return "Self-paced";
	if (minutes < 60) return `${minutes} min core video`;
	const hours = Math.floor(minutes / 60);
	const remainder = minutes % 60;
	return remainder > 0 ? `${hours}h ${remainder}m core video` : `${hours}h core video`;
};

const paths = learningPaths.map((path) => ({
	href: `/learning-paths/${path.id}`,
	title: path.data.title,
	description: compactCopy(path.data.description),
	meta: [
		path.data.difficulty.charAt(0).toUpperCase() +
			path.data.difficulty.slice(1),
		formatPathDuration(path.data.estimatedDuration),
	] as [string, string],
}));

const pageTitle = "Learning Paths";
const pageDescription =
	"Step-by-step learning paths for Kubernetes, platform engineering, and cloud native systems.";
---

<Page title={pageTitle} description={pageDescription}>
		<LearningPathItemListJsonLd
			slot="extra-head"
			paths={itemListPaths}
			listUrl={new URL("/learning-paths", Astro.site ?? Astro.url).href}
			listName="Rawkode Academy Learning Paths"
		/>
		<AcademyPage
			page="learn"
			learningPaths={paths}
		/>
</Page>
