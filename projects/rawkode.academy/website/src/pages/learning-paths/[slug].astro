---
import { academyDocument, academyLayout } from "@rawkodeacademy/design-system";
const doc = academyDocument();
const styles = academyLayout({ width: "reading" });
import {
	getCollection,
	getEntries,
	getEntry,
	optionalContent,
	renderEntry,
	setContentCache,
} from "@/lib/live-content";
import RichText from "@/components/content/RichText.astro";
import Page from "@/wrappers/page.astro";
import ArticleTOC from "@/components/read/ArticleTOC.astro";
import NewsletterCTA from "@/components/newsletter/NewsletterCTA.astro";
import LearningPathJsonLd from "@/components/html/learning-path-jsonld.astro";
import BreadcrumbJsonLd from "@/components/breadcrumb/BreadcrumbJsonLd.astro";
import { localTime } from "@/lib/local-time";

export const prerender = false;

const learningPath = await getEntry("learningPaths", Astro.params.slug);
if (!learningPath) {
	return new Response(null, { status: 404 });
}

const [{ html, headings }, authors, allTechnologies] = await Promise.all([
	renderEntry(learningPath),
	getEntries(learningPath.data.authors),
	// Labels fall back to the technology id when the listing is unavailable.
	optionalContent(getCollection("technologies"), []),
]);

await setContentCache(Astro, {
	entries: [learningPath, ...authors],
	// Technology labels come from the technologies listing; the body is autolinked.
	collections: ["technologies"],
});

const technologyNameById = new Map<string, string>();
for (const technology of allTechnologies) {
	technologyNameById.set(technology.id, technology.data.name);
}
const technologyLabels = (learningPath.data.technologies ?? []).map(
	(technologyId) => technologyNameById.get(technologyId) ?? technologyId,
);
const technologyTags = (learningPath.data.technologies ?? []).map(
	(technologyId) => ({
		id: technologyId,
		label: technologyNameById.get(technologyId) ?? technologyId,
	}),
);

function formatDuration(minutes: number): string {
	const hours = Math.floor(minutes / 60);
	const mins = minutes % 60;
	if (!hours) return `${mins}m`;
	if (!mins) return `${hours}h`;
	return `${hours}h ${mins}m`;
}

const durationLabel = learningPath.data.estimatedDuration > 0
	? formatDuration(learningPath.data.estimatedDuration)
	: undefined;
// The content owns the resource sequence; use its rendered slug, not a second index.
const firstResource = headings.find(
	(heading) => heading.depth === 3 && /^\d+\.\s/.test(heading.text),
);
const prerequisites = learningPath.data.prerequisites ?? [];

const difficultyLabel =
	learningPath.data.difficulty.charAt(0).toUpperCase() +
	learningPath.data.difficulty.slice(1);

const publishDate = localTime(learningPath.data.publishedAt, {
	month: "short",
	day: "numeric",
	year: "numeric",
});

const pageTitle = `${learningPath.data.title} | Learning Path`;
const pageDescription = learningPath.data.description;
---

<Page
	title={pageTitle}
	description={pageDescription}
	publishedAt={learningPath.data.publishedAt}
	authors={authors}
>
	<LearningPathJsonLd
		slot="extra-head"
		learningPath={learningPath}
		authors={authors}
		technologyLabels={technologyLabels}
	/>
	<BreadcrumbJsonLd
		slot="extra-head"
		elements={[
			{ title: "Home", link: "/" },
			{ title: "Learning Paths", link: "/learning-paths" },
			{ title: learningPath.data.title, link: `/learning-paths/${learningPath.id}` },
		]}
	/>

	<div class={doc.root}>
		<header class={doc.pathHero}>
			<div class={doc.body}>
			<div class={[doc.main, styles.container, styles.heroCopy].join(" ")}>
				<a class={doc.link} href="/learning-paths">Learning paths</a>
				<h1 class={doc.title}>{learningPath.data.title}</h1>
				<div class={styles.meta}>
					<span>{difficultyLabel}</span>
					{durationLabel && <span>{durationLabel} core video</span>}
					<time {...publishDate.attrs}>{publishDate.text}</time>
				</div>
				{durationLabel && <p class={doc.meta}>Exercises and bonus material take extra time.</p>}
				<div class={doc.actions}>
					{authors.map((author) => (
						<a class={doc.author} href={`/people/${author.data.id}`}>
							{author.data.avatarUrl && <img class={doc.avatar} src={author.data.avatarUrl} alt="" width="44" height="44" loading="lazy" />}
							<span class={doc.authorMeta}>{author.data.name}</span>
						</a>
					))}
				</div>
				{learningPath.id === "build-your-first-kubernetes-developer-platform" && (
					<aside class={styles.prose} aria-labelledby="waypoint-history">
						<h2 id="waypoint-history">Waypoint lesson: historical material</h2>
						<p>
							This path includes the legacy open source Waypoint workflow.
							HashiCorp ended active development in 2023, and the repository
							was archived in January 2024. The Waypoint server,
							<code>waypoint.hcl</code>, <code>waypoint up</code>, and pipeline
							suggestions below are historical examples, not current
							deployment recommendations. Skip this lesson when choosing
							tooling for a new platform.
						</p>
						<p>
							Read <a href="https://www.hashicorp.com/en/blog/a-new-vision-for-hcp-waypoint">HashiCorp's product announcement</a>
							{" "}and the <a href="https://github.com/hashicorp/waypoint">archived repository</a>
							{" "}for context. <a href="https://developer.hashicorp.com/hcp/docs/waypoint">HCP Waypoint</a>
							{" "}is a different product; this video does not teach its current workflow.
						</p>
					</aside>
				)}
				<div class={doc.actions}>
					<a class={doc.button} href={firstResource ? `#${firstResource.slug}` : "#path-content"}>
						Start learning
					</a>
				</div>
			</div>
			</div>
		</header>

		<div class={doc.body}>
			<div class={[doc.main, styles.container, doc.stack].join(" ")}>
				{prerequisites.length > 0 && (
					<details>
						<summary class={doc.tocSummary}>Before you start</summary>
						<div class={styles.prose}>
							<ul>
								{prerequisites.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					</details>
				)}

				{/* The content supplies the introduction, objectives, and ordered resources once. */}
				<article id="path-content" class={[styles.prose, doc.pathProse].join(" ")}>
					<RichText html={html} />
				</article>

				{technologyTags.length > 0 && (
					<p class={doc.copy}>
						Technologies: {technologyTags.map((technology, index) => (
							<Fragment>
								{index > 0 && ", "}
								<a class={doc.link} href={`/technology/${technology.id}`} rel="tag">{technology.label}</a>
							</Fragment>
						))}
					</p>
				)}

				<nav class={doc.end} aria-label="More learning resources">
					<a class={doc.link} href="/learning-paths">Browse learning paths</a>
					<a class={doc.link} href="/watch">Watch the archive</a>
				</nav>
			</div>

			<ArticleTOC headings={headings} maxDepth={3} />
		</div>

		<NewsletterCTA
			class={doc.section ?? ""}
			audience="learning-paths"
			badge="Learning path updates"
			headline="Get notified when we ship new learning paths"
			subtitle="Structured roadmaps for cloud native, AI infra, and platform engineering, delivered when they're ready."
		/>
	</div>
</Page>
