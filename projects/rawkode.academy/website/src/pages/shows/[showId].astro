---
import { academyDocument } from "@rawkodeacademy/design-system";
const doc = academyDocument();
export const prerender = false;

import {
	getEntries,
	getEntry,
	sameId,
	setContentCache,
} from "@/lib/live-content";
import { getPublishedVideos } from "@/lib/content";
import Breadcrumb from "@/components/breadcrumb/Breadcrumb.astro";
import VideoMetadata from "@/components/html/video-metadata.astro";
import PodcastSeriesJsonLd from "@/components/html/podcast-series-jsonld.astro";
import VideoFeed from "@/components/video/video-feed.astro";
import SubscribeLinks from "@/components/show/SubscribeLinks.astro";
import NewsletterCTA from "@/components/newsletter/NewsletterCTA.astro";
import Page from "@/wrappers/page.astro";
import { Image } from "astro:assets";
import { createLogger } from "@/lib/logger";
import { getVideoThumbnailUrl } from "@/lib/video-thumbnail";
import ShowNav from "@/components/show/ShowNav.astro";
import { getShowNav, hasExtension } from "@/lib/shows/registry";
import { localTime } from "@/lib/local-time";

const logger = createLogger("shows");
const { showId } = Astro.params;

if (!showId) {
	logger.error("Missing showId parameter for show page");
	return new Response(null, { status: 404 });
}

const showEntry = await getEntry("shows", showId);

if (!showEntry || !showEntry.data.publish) {
	return new Response(null, { status: 404 });
}

const isComingSoon = showEntry.data.status === "coming-soon";
const isArchived = showEntry.data.status === "archived";
const statusLabel = isComingSoon ? "Coming soon" : isArchived ? "Archived" : "Show";

// Get published videos only (filters out future-dated for scheduled publishing)
const videos = await getPublishedVideos();

const videosForShow = videos.filter((video) =>
	sameId(video.data.show, showEntry.data.id),
);

const hostEntries = await getEntries(showEntry.data.hosts);
const hostNames = hostEntries
	.map((host) => String(host.data.name).trim())
	.filter((name) => name.length > 0);

const feedVideos = videosForShow
	.map((video) => ({
		id: video.data.id,
		title: video.data.title,
		thumbnailUrl: getVideoThumbnailUrl(video.data.id),
		streamUrl: `https://content.rawkode.academy/videos/${video.data.id}/stream.m3u8`,
		duration: typeof video.data.duration === "number" ? video.data.duration : 0,
		slug: video.data.slug,
		publishedAt:
			video.data.publishedAt instanceof Date
				? video.data.publishedAt.toISOString()
				: String(video.data.publishedAt),
		type: video.data.type,
	}))
	.sort(
		(a, b) =>
			new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime(),
	);
const hasEpisodeFeed = !isComingSoon && feedVideos.length > 0;

// The episode list comes from the videos collection: listing it caps maxAge
// at the next scheduled video so new episodes appear on time.
await setContentCache(Astro, {
	entries: [showEntry, ...hostEntries],
	collections: ["videos"],
});

// Only https links leave the site from the game-format button.
const gameFormatUrl = showEntry.data.gameFormatUrl?.startsWith("https://")
	? showEntry.data.gameFormatUrl
	: undefined;

const showDescription =
	showEntry.data.description?.trim() ||
	(isComingSoon
		? `${showEntry.data.name} is coming soon on Rawkode Academy.`
		: `Watch ${showEntry.data.name} on Rawkode Academy.`);

const breadcrumbElements = [
	{ title: "Home", link: "/" },
	{ title: "Shows", link: "/shows" },
	{ title: showEntry.data.name, link: `/shows/${showEntry.data.id}` },
];

const pageTitle = isComingSoon
	? `${showEntry.data.name}: Coming soon`
	: isArchived
		? `${showEntry.data.name}: Archive`
		: `${showEntry.data.name} Episodes`;

const showNav = hasExtension(showEntry.data.id)
	? getShowNav(showEntry.data.id)
	: [];

const latestEpisode = hasEpisodeFeed ? feedVideos[0] : undefined;
const totalDurationSeconds = hasEpisodeFeed ? feedVideos.reduce((sum, v) => sum + v.duration, 0) : 0;
const totalHours = Math.floor(totalDurationSeconds / 3600);

const cover = showEntry.data.cover;
let podcastImageUrl: string | undefined;
if (hasEpisodeFeed && showEntry.data.podcast?.artworkUrl) {
	podcastImageUrl = showEntry.data.podcast.artworkUrl;
} else if (hasEpisodeFeed && cover) {
	try {
		podcastImageUrl = new URL(cover.image.src, Astro.site ?? Astro.url).href;
	} catch {
		// Fall through with no image - JSON-LD `image` is optional.
	}
}

function formatDate(dateString: string) {
	return localTime(dateString, {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}

function formatDuration(seconds: number) {
	if (seconds <= 0) return "--:--";
	const hours = Math.floor(seconds / 3600);
	const minutes = Math.floor((seconds % 3600) / 60);
	const remainingSeconds = Math.floor(seconds % 60);
	if (hours > 0) {
		return `${hours}:${minutes.toString().padStart(2, "0")}:${remainingSeconds.toString().padStart(2, "0")}`;
	}
	return `${minutes}:${remainingSeconds.toString().padStart(2, "0")}`;
}
---

<Page title={pageTitle} description={showDescription}>
 {hasEpisodeFeed && (
	<link
		slot="extra-head"
		rel="alternate"
		type="application/rss+xml"
		title={`${showEntry.data.name} (Podcast RSS)`}
		href={`/api/feeds/shows/${showEntry.data.id}.xml`}
	/>
 )}
 {hasEpisodeFeed && (
	<PodcastSeriesJsonLd
		slot="extra-head"
		show={showEntry}
		hosts={hostEntries}
		episodeCount={feedVideos.length}
		{...(podcastImageUrl ? { imageUrl: podcastImageUrl } : {})}
	/>
 )}
 {hasEpisodeFeed && (
	<VideoMetadata
		slot="extra-head"
		title={pageTitle}
		description={showDescription}
		isVideoList={true}
	/>
 )}

 <!-- Hero -->
 <section class={doc.hero}>
 <div class={[doc.container, doc.stack].join(" ")}>
 <Breadcrumb elements={breadcrumbElements} />

 <div class={doc.showHero}>
 <!-- Show info -->
 <div class={[doc.spacer, doc.stack].join(" ")}>
 <p class={doc.kicker}>{statusLabel}</p>

 <h1 class={doc.title}>
 {showEntry.data.name}
 </h1>

 {showEntry.data.tagline && (
 <p class={doc.kicker}>
 {showEntry.data.tagline}
 </p>
 )}

 {hostNames.length > 0 && (
 <div class={doc.actions}>
 <span class={doc.meta}>Hosted by</span>
 {hostEntries.map((host) => (
 <a class={doc.link} href={`/people/${host.data.id}`}>{host.data.name}</a>
 ))}
 </div>
 )}

 <p class={doc.lede}>
 {showDescription}
 </p>

 {gameFormatUrl && (
 <div class={doc.actions}>
 <a href={gameFormatUrl} class={doc.buttonSecondary} rel="noopener noreferrer">Explore the game format ↗</a>
 </div>
 )}

 {hasEpisodeFeed && (
 <div class={doc.meta}>
 <div class={doc.row}>
 <svg class={doc.iconSmall} fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" />
 </svg>
 <span>{feedVideos.length} {feedVideos.length === 1 ? "episode" : "episodes"}</span>
 </div>
 {totalHours > 0 && (
 <div class={doc.row}>
 <svg class={doc.iconSmall} fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
 </svg>
 <span>{totalHours}+ hours of content</span>
 </div>
 )}
 </div>
 )}

 {!isComingSoon && <SubscribeLinks links={showEntry.data.subscribeLinks} />}
 </div>

 <!-- Cover image or latest episode thumbnail -->
 {cover ? (
 <div class={doc.mediaColumn}>
 <div class={doc.media}>
 <Image
 src={cover.image.src}
 width={cover.image.width}
 height={cover.image.height}
 alt={cover.alt}
 class={doc.image}
 />
 </div>
 </div>
 ) : latestEpisode ? (
 <div class={doc.mediaColumn}>
 <a href={`/watch/${latestEpisode.slug}`} class={doc.main}>
 <div class={doc.media}>
 <img
 src={latestEpisode.thumbnailUrl}
 alt={`Latest episode: ${latestEpisode.title}`}
 class={doc.image}
 loading="eager"
 />
 <div class={doc.mediaOverlay}></div>
 <div class={doc.playOverlay} aria-hidden="true">
 <div class={doc.play}>
 <svg class={doc.iconLarge} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
 <path d="M8 5v14l11-7z" />
 </svg>
 </div>
 </div>
 <div class={doc.mediaCaption}>
 <p class={doc.mediaMeta}>Latest Episode</p>
 <p class={doc.mediaTitle}>{latestEpisode.title}</p>
 <div class={doc.mediaMeta}>
 <time {...formatDate(latestEpisode.publishedAt).attrs}>{formatDate(latestEpisode.publishedAt).text}</time>
 {latestEpisode.duration > 0 && (
 <span>{formatDuration(latestEpisode.duration)}</span>
 )}
 </div>
 </div>
 </div>
 </a>
 </div>
 ) : null}
 </div>

 </div>
 </section>

 {showNav.length > 0 && (
 <ShowNav showId={showEntry.data.id} nav={showNav} active={null} />
 )}

 <!-- Episodes -->
 <section class={doc.section}>
 <div class={[doc.container, doc.stack].join(" ")}>
 {isComingSoon ? (
 <div class={doc.empty}>
 <p class={doc.kicker}>Coming soon</p>
 <h2 class={doc.sectionTitle}>This show is being prepared for the stage.</h2>
 <p class={doc.copy}>Follow the show to hear when it is ready. No episodes or schedule have been announced.</p>
 </div>
 ) : hasEpisodeFeed ? (
 <VideoFeed
 title="Episodes"
 description={`Watch all ${feedVideos.length} episodes from ${showEntry.data.name}.`}
 videos={feedVideos}
 />
 ) : (
 <div class={doc.empty}>
 <svg
 class={doc.iconLarge}
 fill="none"
 viewBox="0 0 24 24"
 stroke="currentColor"
 aria-hidden="true"
 >
 <path
 stroke-linecap="round"
 stroke-linejoin="round"
 stroke-width="1.5"
 d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z"
 />
 </svg>
 <p class={doc.lede}>
 {isArchived ? "This show is archived" : "No published episodes available"}
 </p>
 <p class={doc.meta}>
 Browse the <a href="/shows" class={doc.link}>show archive</a> for other programs.
 </p>
 </div>
 )}
 </div>
 </section>
 <section class={doc.section}>
 <NewsletterCTA
 audience={`show:${showEntry.data.id}`}
 badge={isComingSoon ? "Coming soon" : isArchived ? "Show updates" : "New episodes by email"}
 headline={`Follow ${showEntry.data.name}`}
 subtitle={isComingSoon ? "Be the first to know when this show is ready." : isArchived ? "Get an email if there is news about this show." : "Get an email when a new episode is published."}
 />
 </section>
</Page>
