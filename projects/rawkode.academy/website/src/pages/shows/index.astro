---
export const prerender = false;

import {
	getCollection,
	getEntries,
	sameId,
	setContentCache,
} from "@/lib/live-content";
import ShowItemListJsonLd from "@/components/html/show-itemlist-jsonld.astro";
import ShowCard from "@/components/show/ShowCard.astro";
import AcademyCatalogMasthead from "@/components/academy/AcademyCatalogMasthead.astro";
import { academyCatalog, academyLayout } from "@rawkodeacademy/design-system";
import Page from "@/wrappers/page.astro";
import type { ShowSummary } from "@/types/show";
import { getVideoThumbnailUrl } from "@/lib/video-thumbnail";
import { getPublishedVideos } from "@/lib/content";

// Build shows from the live content collections. `publish: false` shows are
// drafts - they don't belong in the public directory.
const showEntries = (await getCollection("shows")).filter(
	(s) => s.data.publish,
);
const videos = await getPublishedVideos();
const hostsByShow = new Map(
	await Promise.all(
		showEntries.map(
			async (s) => [s.id, await getEntries(s.data.hosts)] as const,
		),
	),
);

// The page lists shows and counts/teases published episodes, so a newly
// published (or scheduled) video must refresh it: list both collections.
await setContentCache(Astro, {
	entries: [...showEntries, ...[...hostsByShow.values()].flat()],
	collections: ["shows", "videos"],
});

const showsToRender: ShowSummary[] = await (async () => {
	const list: ShowSummary[] = [];
	for (const s of showEntries) {
		const people = hostsByShow.get(s.id) ?? [];
		const hosts = people.map((p) => {
			const parts = String(p.data.name).trim().split(/\s+/);
			return {
				forename: parts[0] || "",
				surname: parts.slice(1).join(" ") || "",
			};
		});
		const eps = videos
			.filter((v) => s.data.status !== "coming-soon" && sameId(v.data.show, s.data.id))
			.map((v) => ({
				video: {
					title: v.data.title,
					thumbnailUrl: getVideoThumbnailUrl(v.data.id),
					publishedAt:
						v.data.publishedAt instanceof Date
							? v.data.publishedAt.toISOString()
							: String(v.data.publishedAt),
				},
			}));
		list.push({
			id: s.data.id,
			name: s.data.name,
			status: s.data.status,
			tagline: s.data.tagline,
			gameFormatUrl: s.data.gameFormatUrl,
			hosts,
			episodes: eps,
			cover: s.data.cover,
		});
	}
	return list;
})();

const hasShows = showsToRender.length > 0;
const artworkOf = (show: ShowSummary) =>
	show.cover?.image.src ?? show.episodes?.[0]?.video?.thumbnailUrl;
const episodeCount = (show: ShowSummary) => show.episodes?.length ?? 0;
const statusLine = (show: ShowSummary) =>
	show.status === "coming-soon"
		? "Coming soon"
		: `${show.status === "archived" ? "Archived · " : ""}${episodeCount(show)} published ${episodeCount(show) === 1 ? "episode" : "episodes"}`;
// Shows with episodes and artwork lead, the largest archive first, as framed
// cards. Shows that are announced (or have nothing to picture yet) follow as
// a ledger: a name, a line and a status, with no empty frame.
const pictured = showsToRender
	.filter((show) => show.status !== "coming-soon" && artworkOf(show))
	.sort(
		(a, b) => episodeCount(b) - episodeCount(a) || a.name.localeCompare(b.name),
	);
const listed = showsToRender.filter((show) => !pictured.includes(show));
const listedTitle = listed.every((show) => show.status === "coming-soon")
	? "Announced"
	: "More shows";

const showsJsonLd = showEntries.map((s) => {
	const episodeCount = videos.filter(
		(v) => s.data.status !== "coming-soon" && sameId(v.data.show, s.data.id),
	).length;
	return {
		id: s.data.id,
		name: s.data.name,
		...(s.data.description ? { description: s.data.description } : {}),
		...(episodeCount > 0 ? { episodeCount } : {}),
	};
});
const styles = academyLayout({ width: "wide" });
const catalog = academyCatalog();
---

<Page
	title="Shows"
	description="Browse live and recurring shows from Rawkode Academy: interviews, technical discussions, and hands-on cloud native streams."
	pageType="CollectionPage"
>
	<ShowItemListJsonLd
		slot="extra-head"
		shows={showsJsonLd}
		listUrl={new URL("/shows", Astro.site ?? Astro.url).href}
		listName="Rawkode Academy Shows"
	/>
	<div class={styles.root}>
		<AcademyCatalogMasthead title="Shows" description="Recurring programmes, each with its own format, hosts, and archive of episodes." figure={showsToRender.length} figureLabel={showsToRender.length === 1 ? "show" : "shows"} mosaic={showsToRender.map(artworkOf).filter((src): src is string => Boolean(src))} mosaicShape="video" />

		{(pictured.length > 0 || !hasShows) && (
			<section class={styles.section} aria-label="Shows">
				<div class={styles.container}>
					{hasShows ? (
						<div class={catalog.pairGrid}>
							{pictured.map((show) => (
								<ShowCard show={show} heading="h2" />
							))}
						</div>
					) : (
						<div class={styles.empty}>No shows available yet. New programs will appear here when they are ready.</div>
					)}
				</div>
			</section>
		)}

		{listed.length > 0 && (
			<section class={styles.section} aria-labelledby="listed-shows-title">
				<div class={styles.container}>
					<header class={styles.sectionHeader}>
						<h2 id="listed-shows-title" class={styles.sectionTitle}>{listedTitle}</h2>
					</header>
					<div class={catalog.rows}>
						{listed.map((show) => (
							<a class={catalog.row} href={`/shows/${show.id}`} data-show-status={show.status}>
								<span class={catalog.rowMeta}>{statusLine(show)}</span>
								<div class={catalog.rowMain}>
									<h3 class={catalog.rowTitle}>{show.name}</h3>
									{show.tagline && <span class={catalog.rowDescription}>{show.tagline}</span>}
								</div>
							</a>
						))}
					</div>
				</div>
			</section>
		)}
	</div>
</Page>
