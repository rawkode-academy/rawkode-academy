---
import { academyDocument, academyLayout } from "@rawkodeacademy/design-system";
const doc = academyDocument();
const styles = academyLayout({ width: "reading" });
import { getEntry } from "@/lib/payload-content";
import CmsBody from "@/components/content/CmsBody.astro";
import SeriesArticles from "@/components/articles/series/SeriesArticles.astro";
import ArticleHeader from "@/components/read/ArticleHeader.astro";
import BreadcrumbJsonLd from "@/components/breadcrumb/BreadcrumbJsonLd.astro";
import Page from "@/wrappers/page.astro";
export const prerender = false;

const slug = Astro.params.slug;
const series = slug ? await getEntry("series", { slug }) : undefined;
if (!series) return new Response(null, { status: 404 });
const imageUrl = series.data.cover?.image?.src
	? new URL(series.data.cover.image.src, Astro.site ?? Astro.url)
	: undefined;
---

<Page
	title={series.data.title}
	description={`${series.data.title} - a multi-part article series from Rawkode Academy covering hands-on cloud native and Kubernetes engineering.`}
	image={{ image: imageUrl }}
>
	<BreadcrumbJsonLd
		slot="extra-head"
		elements={[
			{ title: "Home", link: "/" },
			{ title: "Series", link: "/series" },
			{ title: series.data.title, link: `/series/${series.slug}` },
		]}
	/>
	<ArticleHeader
		breadcrumbs={[{ label: "Series", href: "/series" }]}
		kicker="Article series"
		title={series.data.title}
	/>
	<article class={[doc.reading, styles.prose].join(" ")}>
		<CmsBody entry={series} />
	</article>
	<section class={[doc.section, doc.stack].join(" ")}>
		<h2 class={doc.sectionTitle}>Articles</h2>
		<SeriesArticles series={series} />
	</section>
</Page>
