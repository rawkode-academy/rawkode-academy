---
export const prerender = false;

import { getCollection, setContentCache } from "@/lib/live-content";
import { academyPage, button } from "@rawkodeacademy/design-system";
import AcademyCatalogMasthead from "@/components/academy/AcademyCatalogMasthead.astro";
import NewsletterCTA from "@/components/newsletter/NewsletterCTA.astro";
import Page from "@/wrappers/page.astro";
import VideoItemListJsonLd from "@/components/html/video-itemlist-jsonld.astro";
import { getPublishedVideos, getUpcomingVideos } from "@/lib/content";
import { getVideoThumbnailUrl } from "@/lib/video-thumbnail";
import { selectWatchArchive, watchArchiveHref, WATCH_PAGE_SIZE } from "@/lib/watch-archive";
import { localDateTime } from "@/lib/local-time";
import { formatRuntime } from "@/lib/video-runtime";
import VideoCard from "@/components/video/VideoCard.astro";

const styles = academyPage();
const [publishedVideos, upcomingVideos, technologies, people, shows] = await Promise.all([
	getPublishedVideos(),
	getUpcomingVideos(),
	getCollection("technologies"),
	getCollection("people"),
	getCollection("shows"),
]);
const archive = selectWatchArchive(publishedVideos, {
	query: Astro.url.searchParams.get("q"),
	page: Astro.url.searchParams.get("page"),
	technologies, people, shows,
});

const compactCopy = (value: string | undefined, maxLength = 220) => {
	const normalized = (value ?? "").replace(/\s+/g, " ").trim();
	if (!normalized)
		return "A practical session from the Rawkode Academy archive.";
	const firstSentence = normalized.match(/^.*?[.!?](?:\s|$)/)?.[0]?.trim();
	if (firstSentence && firstSentence.length <= maxLength) return firstSentence;
	if (normalized.length <= maxLength) return normalized;
	return `${normalized.slice(0, maxLength).trimEnd()}…`;
};

const videos = archive.items.map((video) => ({
	href: `/watch/${video.data.slug}`,
	title: video.data.title,
	description: compactCopy(video.data.subtitle || video.data.description),
	runtime: formatRuntime(video.data.duration),
	duration: video.data.duration,
	publishedAt: video.data.publishedAt,
	type: video.data.type,
	mediaSrc: getVideoThumbnailUrl(video.data.id),
}));
const jsonLdVideos = archive.items.map(({ data }) => ({
	id: data.id,
	slug: data.slug,
	title: data.title,
	description: data.description,
	publishedAt: data.publishedAt,
	...(typeof data.duration === "number" ? { duration: data.duration } : {}),
}));
const upcomingStreams = upcomingVideos.map((video) => ({
	href: `/watch/${video.data.slug}`,
	title: video.data.title,
	description: compactCopy(video.data.subtitle || video.data.description),
	publishedAt: video.data.publishedAt,
	scheduledAt: localDateTime(video.data.publishedAt),
	mediaSrc: video.data.youtubeId
		? `https://i.ytimg.com/vi/${video.data.youtubeId}/hqdefault.jpg`
		: getVideoThumbnailUrl(video.data.id),
}));
const showUpcomingStreams = !archive.query && archive.page === 1 && upcomingStreams.length > 0;
const featured = archive.showFeatured ? videos[0] : undefined;
// The latest session gets its own feature below, so the masthead schedules
// the sessions that came before it.
const mosaic = publishedVideos.slice(1, 10).map((video) => getVideoThumbnailUrl(video.data.id));
const libraryVideos = featured ? videos.slice(1) : videos;
const listUrl = new URL(watchArchiveHref(archive.query, archive.page), Astro.site ?? Astro.url).href;

// The archive lists videos (published and upcoming streams) and searches
// technology, people and show names. Listing "videos" caps the cache
// lifetime at the next scheduled video, so a stream moves from "upcoming"
// into the archive on time.
await setContentCache(Astro, {
	collections: ["videos", "technologies", "people", "shows"],
});
Astro.response.headers.set("X-Build-Time", new Date().toISOString());

// Only the unfiltered first page is a search landing page. Later pages and
// search results stay crawlable (follow) but out of the index, matching /read.
const noindex = archive.query.length > 0 || archive.page > 1;

const pageTitle = "Watch Cloud Native Sessions";
const pageDescription =
	"Recorded sessions and live builds from the Rawkode Academy cloud native archive.";
---

<Page title={pageTitle} description={pageDescription} noindex={noindex}>
	<Fragment slot="extra-head">
		<link rel="alternate" type="application/rss+xml" title="Rawkode Academy - Videos (RSS)" href="/api/feeds/videos.xml" />
		<link rel="alternate" type="application/atom+xml" title="Rawkode Academy - Videos (Atom)" href="/api/feeds/videos.atom" />
		<link rel="alternate" type="application/feed+json" title="Rawkode Academy - Videos (JSON Feed)" href="/api/feeds/videos.json" />
		<VideoItemListJsonLd
			videos={jsonLdVideos}
			listUrl={listUrl}
			listName="Rawkode Academy Videos"
			limit={WATCH_PAGE_SIZE}
		/>
	</Fragment>
	<div class={styles.root}>
		<AcademyCatalogMasthead
			title="Videos"
			description="Live builds, deep dives, and honest conversations with the people behind the tools. Every session is recorded and searchable."
			figure={publishedVideos.length}
			figureLabel={publishedVideos.length === 1 ? "video in the library" : "videos in the library"}
			mosaic={mosaic}
			mosaicShape="video"
		/>
		{showUpcomingStreams && (
			<section class={styles.section} aria-labelledby="upcoming-streams-title">
				<div class={styles.sectionHead}>
					<h2 id="upcoming-streams-title" class={styles.sectionTitle}>Upcoming live streams</h2>
				</div>
				{upcomingStreams.length < 3 ? (
					<div class={styles.streamList}>
						{upcomingStreams.map((item) => (
							<a href={item.href} class={styles.streamFeature}>
								<div class={styles.cardArt}>
									<img src={item.mediaSrc} alt="" class={styles.cardImage} width="960" height="540" loading="lazy" />
								</div>
								<div class={styles.featureCopy}>
									<p class={styles.streamMeta}><span data-label>Upcoming live stream</span><time {...item.scheduledAt.attrs}>{item.scheduledAt.text}</time></p>
									<h3 class={styles.streamTitle}>{item.title}</h3>
									<p class={styles.sectionLede}>{item.description}</p>
									<span class={styles.textLink}>Get notified <span aria-hidden="true">→</span></span>
								</div>
							</a>
						))}
					</div>
				) : (
					<div class={styles.feedGrid}>
						{upcomingStreams.map((item) => (
							<VideoCard href={item.href} title={item.title} thumbnailUrl={item.mediaSrc} publishedAt={item.publishedAt} description={item.description} scheduled />
						))}
					</div>
				)}
			</section>
		)}
		{featured && (
			<section class={styles.section} aria-label="Featured session">
				<a href={featured.href} class={styles.watchFeature}>
					<div class={styles.featureArt}>
						<img src={featured.mediaSrc} alt="" class={styles.featureImage} width="1280" height="720" fetchpriority="high" />
						<span class={styles.play} data-play aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l12-7.5z" /></svg></span>
					</div>
					<div class={styles.featureCopy}>
						<p class={styles.kicker}>Latest session{featured.runtime && ` · ${featured.runtime}`}</p>
						<h2 class={styles.watchTitle}>{featured.title}</h2>
						<p class={styles.lede}>{featured.description}</p>
						<span class={styles.textLink}>Watch the session <span aria-hidden="true">→</span></span>
					</div>
				</a>
			</section>
		)}
		<section class={styles.section} aria-labelledby="watch-archive-title">
			<div class={styles.sectionHead}>
				<h2 id="watch-archive-title" class={styles.sectionTitle}>The video library</h2>
			</div>
			<form action="/watch" method="get" role="search" aria-label="Search the video library" class={styles.searchBar}>
				<label for="video-search">Find a session</label>
				<input id="video-search" name="q" value={archive.query} class={styles.input} type="search" placeholder="Search topics, tools, or speakers" autocomplete="off" />
				<button class={button({ variant: "outline", size: "lg" })} type="submit">Search</button>
			</form>
			<div class={styles.sectionHead}>
				{archive.total > 0 && <p class={styles.resultCount}>Showing {archive.first}–{archive.last} of {archive.total} {archive.total === 1 ? "video" : "videos"}{archive.query && ` matching “${archive.query}”`}</p>}
				{archive.query && <a href="/watch" class={styles.textLink}>Clear search</a>}
			</div>
			{archive.total > 0 ? (
				<>
					<div class={styles.feedGrid}>
						{libraryVideos.map((item) => (
							<VideoCard href={item.href} title={item.title} thumbnailUrl={item.mediaSrc} duration={item.duration} publishedAt={item.publishedAt} type={item.type} />
						))}
					</div>
				</>
			) : (
				<p class={styles.empty}>{archive.query ? `No videos match “${archive.query}”. Try a tool name, speaker, or a broader topic.` : "No published videos are available yet."}</p>
			)}
			{archive.pageCount > 1 && (
				<nav class={styles.more} aria-label="Video library pages">
					<div class={styles.actions}>
						{archive.page > 1 && <a class={button({ variant: "outline" })} href={watchArchiveHref(archive.query, archive.page - 1)} rel="prev">Previous</a>}
						<p class={styles.resultCount}>Page {archive.page} of {archive.pageCount}</p>
						{archive.page < archive.pageCount && <a class={button({ variant: "outline" })} href={watchArchiveHref(archive.query, archive.page + 1)} rel="next">Next</a>}
					</div>
				</nav>
			)}
		</section>
		<section class={styles.section} aria-label="Newsletter">
			<NewsletterCTA />
		</section>
	</div>
</Page>
