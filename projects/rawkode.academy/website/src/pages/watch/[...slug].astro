---
import {
	disableContentCache,
	getCollection,
	getEntries,
	getEntry,
	optionalContent,
	renderEntry,
	setContentCache,
} from "@/lib/live-content";
import RichText from "@/components/content/RichText.astro";
import BreadcrumbJsonLd from "@/components/breadcrumb/BreadcrumbJsonLd.astro";
import VideoMetadata from "@/components/html/video-metadata.astro";
import VideoPlayer from "@/components/video/player.vue";
import LiveStreamGate from "@/components/video/LiveStreamGate.vue";
import VideoReactions from "@/components/video/VideoReactions.astro";
import VideoContentTabs from "@/components/video/video-content-tabs.vue";
import VideoTranscript from "@/components/video/VideoTranscript.astro";
import VideoCast from "@/components/video/VideoCast.astro";
import TechnologyVideoSection from "@/components/video/TechnologyVideoSection.astro";
import ShowVideoSection from "@/components/video/ShowVideoSection.astro";
import StreamNotifyButton from "@/components/video/StreamNotifyButton.vue";
import NewsletterCTA from "@/components/newsletter/NewsletterCTA.astro";
import MLabel from "@/components/ui/MLabel.vue";
import LiveDot from "@/components/ui/LiveDot.vue";
import Page from "@/wrappers/page.astro";
import { resolveTechnologyIconUrl } from "@/utils/resolve-technology-icon";
import { normalizeTechnologyReferences } from "@/utils/normalize-technology-refs";
import { buildWatchVideoSeoText } from "@/utils/watch-video-seo";
import { getVideoThumbnailUrl } from "@/lib/video-thumbnail";
import { buildVideoClips, type VideoClip } from "@/lib/video-clips";
import { formatVideoRuntimeLabel } from "@/lib/video-runtime";
import {
	academyLayout,
	academyMedia,
	academyWatch,
} from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";
import {
	getStudioLiveState,
	shouldMountStudioLiveGate,
	type StudioBindingEnv,
} from "@/lib/studio-live";
import { env } from "cloudflare:workers";
import { localTime } from "@/lib/local-time";

export const prerender = false;
const layout = academyLayout({ width: "wide" });
const media = academyMedia();
const watch = academyWatch();

const { slug } = Astro.params;

// Videos include scheduled (future-dated) entries: upcoming streams have pages.
const videos = await getCollection("videos");
let video: (typeof videos)[0] | undefined = videos.find(
	(v) => v.data.slug === slug,
);

if (!video) {
	return new Response(null, { status: 404 });
}

// Live sessions render the studio's live state: never cache them.
if (video.data.type === "live") {
	disableContentCache(Astro);
	Astro.response.headers.set("Cache-Control", "no-store");
}
Astro.response.headers.set("X-Build-Time", new Date().toISOString());

// Plain-text Markdown source for meta descriptions and SEO text; the page
// body renders the description document (marked-equivalent profile).
const processedDescription = video.data.description.replace(/\\n/g, "\n");
const { html: renderedDescriptionHtml } = await renderEntry(video);

type Chapter = { startTime: number; title: string };
let clips: VideoClip[] = [];
const durationSec: number | null =
	typeof video.data.duration === "number" ? video.data.duration : null;

const chapterSource: Chapter[] = Array.isArray(video.data.chapters)
	? (video.data.chapters as Chapter[]).map((c) => ({
			title: c.title,
			startTime: Math.max(0, Math.floor(c?.startTime ?? 0)),
		}))
	: [];

if (chapterSource.length > 0) {
	clips = buildVideoClips(chapterSource, durationSec);
}

const formatTimestamp = (seconds: number) => {
	const h = Math.floor(seconds / 3600);
	const m = Math.floor((seconds % 3600) / 60);
	const s = Math.floor(seconds % 60);
	return h > 0
		? `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`
		: `${m}:${String(s).padStart(2, "0")}`;
};

const formatDate = (date: Date | string) =>
	localTime(date, { year: "numeric", month: "long", day: "numeric" });

const formatLabel = (value?: string | null) => {
	if (!value) return null;
	return value.replace(/[-_]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
};

// Resolve referenced show and technologies
// The show block is optional too.
const showEntry =
	(await optionalContent(getEntry(video.data.show), undefined)) ?? null;

const RELATED_VIDEO_LIMIT = 6;
const now = new Date();
// Match getPublishedVideos' publishedAt <= now policy, excluding this video.
const relatedCandidates = videos
	.filter((candidate) => candidate.data.slug !== slug && candidate.data.publishedAt <= now)
	.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const toRelatedVideo = (candidate: (typeof videos)[number]) => ({
	id: candidate.data.id,
	title: candidate.data.title,
	thumbnailUrl: getVideoThumbnailUrl(candidate.data.id),
	slug: candidate.data.slug,
	duration: typeof candidate.data.duration === "number" ? candidate.data.duration : undefined,
	publishedAt: candidate.data.publishedAt,
	type: candidate.data.type,
});
const showRelatedAll = showEntry
	? relatedCandidates.filter((candidate) => {
		const reference = candidate.data.show;
		const id = typeof reference === "string" ? reference : reference?.id;
		return id?.replace(/\/index$/, "") === showEntry.id.replace(/\/index$/, "");
	})
	: [];
const showRelatedVideos = showRelatedAll.slice(0, RELATED_VIDEO_LIMIT).map(toRelatedVideo);

const normalizedTechIds = normalizeTechnologyReferences(
	video.data.technologies,
);
// One cached list lookup instead of a technologyById request per technology
// (the page shows names and logos, not profile bodies). A failure renders no
// technologies rather than failing the page.
const technologiesById = new Map(
	(await optionalContent(getCollection("technologies"), [])).map(
		(technology) => [technology.id, technology] as const,
	),
);
const techEntries = normalizedTechIds
	.map((id) => technologiesById.get(id))
	.filter((t): t is NonNullable<typeof t> => Boolean(t));

let technologyRecommendation: {
	technology: (typeof techEntries)[number];
	videos: typeof showRelatedVideos;
	totalVideos: number;
} | null = null;
if (showRelatedVideos.length === 0) {
	// Declaration order is intentional. Stop as soon as one technology has
	// published alternatives; do not collect rails for every technology.
	for (const technology of techEntries) {
		const id = technology.id;
		const related = relatedCandidates.filter((candidate) =>
			normalizeTechnologyReferences(candidate.data.technologies).includes(id),
		);
		if (related.length === 0) continue;
		technologyRecommendation = {
			technology,
			videos: related.slice(0, RELATED_VIDEO_LIMIT).map(toRelatedVideo),
			totalVideos: related.length,
		};
		break;
	}
}

// The cast is optional: a people lookup failure renders no cast.
const hostEntries = showEntry
	? await optionalContent(getEntries(showEntry.data.hosts), [])
	: [];
const guestEntries = await optionalContent(getEntries(video.data.guests), []);

if (video.data.type !== "live") {
	// Everything shown on the page, plus the video listing behind the
	// recommendations (a scheduled video caps the cache lifetime). Signed-in
	// renders (watch position) are skipped by setContentCache.
	await setContentCache(Astro, {
		entries: [video, showEntry, ...techEntries, ...hostEntries, ...guestEntries],
		collections: ["videos"],
	});
}

const thumbnailUrl = video.data.youtubeId
	? `https://i.ytimg.com/vi/${video.data.youtubeId}/hqdefault.jpg`
	: getVideoThumbnailUrl(video.data.id);
const streamUrl = `https://content.rawkode.academy/videos/${video.data.id}/stream.m3u8`;
const captionUrl = `https://content.rawkode.academy/videos/${video.data.id}/captions/en.vtt`;
const isLive = video.data.type === "live";
const isUpcomingLive = isLive && video.data.publishedAt > now;
const studioLiveState = isLive
	? await getStudioLiveState(env as StudioBindingEnv, video.data.slug)
	: {
			live: false,
			playbackUrl: null,
			session: null,
		};
const shouldMountLiveGate = shouldMountStudioLiveGate({
	isLive,
	isUpcomingLive,
	liveState: studioLiveState,
	now,
	publishedAt: video.data.publishedAt,
});
const shouldRenderVodFallback =
	shouldMountLiveGate && !isUpcomingLive && !studioLiveState.live;

const META_DESCRIPTION_LIMIT = 160;
const metaDescription = (() => {
	const firstParagraph =
		processedDescription.replace(/\r\n/g, "\n").split(/\n{2,}/)[0] ?? "";
	const raw = firstParagraph
		.replace(/[*_`]+/g, "")
		.replace(/\s+/g, " ")
		.trim();
	if (!raw) return video.data.description ?? "";
	if (raw.length <= META_DESCRIPTION_LIMIT) return raw;
	const truncated = raw.slice(0, META_DESCRIPTION_LIMIT);
	const lastSpace = truncated.lastIndexOf(" ");
	return `${truncated.slice(0, lastSpace > 80 ? lastSpace : META_DESCRIPTION_LIMIT)}…`;
})();

const creatorRefs =
	hostEntries.length > 0
		? hostEntries.map((host) => ({
				name: host.data.name,
				url: `https://rawkode.academy/people/${host.id}`,
			}))
		: undefined;

const guestRefs = guestEntries.map((guest) => ({
	name: guest.data.name,
	url: `https://rawkode.academy/people/${guest.id}`,
}));

const partOfSeriesRef = showEntry
	? {
			name: showEntry.data.name,
			url: `https://rawkode.academy/shows/${showEntry.id}`,
		}
	: undefined;
const watchVideoSeoText = await buildWatchVideoSeoText({
	captionUrl,
	description: processedDescription,
	chapters: chapterSource,
});
const transcriptCues = watchVideoSeoText.transcriptParagraphs ?? [];

const user = Astro.locals.user;
const isAuthenticated = !!user;

let initialPosition = 0;
if (
	(!shouldMountLiveGate || shouldRenderVodFallback) &&
	isAuthenticated &&
	user?.id
) {
	try {
		const response = await fetch("https://api.rawkode.academy/", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({
				query: `
					query GetWatchPosition($userId: String!, $videoId: String!) {
						getWatchPosition(userId: $userId, videoId: $videoId) {
							positionSeconds
						}
					}
				`,
				variables: { userId: user.id, videoId: video.data.id },
			}),
		});
		const result = (await response.json()) as {
			data?: { getWatchPosition?: { positionSeconds?: number } };
		};
		initialPosition = result?.data?.getWatchPosition?.positionSeconds ?? 0;
	} catch {
		// Silently fail - not critical
	}
}

// Editorial header bits
const categoryLabel =
	formatLabel(video.data.category) ||
	(video.data.type === "live" ? "Live session" : "Recorded session");
const runtimeLabel = formatVideoRuntimeLabel(
	{
		duration: durationSec,
		publishedAt: video.data.publishedAt,
		type: video.data.type,
	},
	now,
);
const publishedLabel = formatDate(video.data.publishedAt);
const scheduled = localTime(video.data.publishedAt, {
	weekday: "long",
	year: "numeric",
	month: "long",
	day: "numeric",
	hour: "numeric",
	minute: "2-digit",
	timeZoneName: "short",
});
const notificationsPublicKey = env.NOTIFICATIONS_VAPID_PUBLIC_KEY ?? "";
const publishedIso =
	video.data.publishedAt instanceof Date
		? video.data.publishedAt.toISOString()
		: String(video.data.publishedAt);
const heroDescription =
	video.data.tagline ?? video.data.subtitle;
const isLiveNow = isLive && studioLiveState.live;
const watchStatusLabel = isLiveNow
	? "Live now"
	: isUpcomingLive
		? "Upcoming"
		: null;
---

<Page
	title={video.data.title}
	description={metaDescription}
	noindex={metaDescription.length < 30}
	useImageDirectly={true}
	image={{ image: new URL(thumbnailUrl) }}
>
	<VideoMetadata
		slot="extra-head"
		title={video.data.title}
		description={video.data.description}
		thumbnailUrl={thumbnailUrl}
		publishedAt={publishedIso}
		duration={durationSec ?? undefined}
		streamUrl={streamUrl}
		captionUrl={captionUrl}
		transcript={watchVideoSeoText.transcriptExcerpt}
		keywords={techEntries.map((tech) => tech.data.name)}
		isLiveBroadcast={video.data.type === "live"}
		category={video.data.category}
		clips={clips}
		creators={creatorRefs}
		guests={guestRefs}
		partOfSeries={partOfSeriesRef}
	/>
	<BreadcrumbJsonLd
		slot="extra-head"
		elements={[
			{ title: "Home", link: "/" },
			{ title: "Watch", link: "/watch" },
			...(showEntry
				? [{ title: showEntry.data.name, link: `/shows/${showEntry.id}` }]
				: []),
			{ title: video.data.title, link: `/watch/${video.data.slug}` },
		]}
	/>
	<link slot="extra-head" rel="alternate" type="application/rss+xml" title="Rawkode Academy - Videos (RSS)" href="/api/feeds/videos.xml" />
	<link slot="extra-head" rel="alternate" type="application/atom+xml" title="Rawkode Academy - Videos (Atom)" href="/api/feeds/videos.atom" />
	<link slot="extra-head" rel="alternate" type="application/feed+json" title="Rawkode Academy - Videos (JSON Feed)" href="/api/feeds/videos.json" />

	<div class:list={[layout.root, media.root, watch.root]}>
		<div class={watch.breadcrumb}>
			<a class={watch.crumb} href="/watch">Watch</a>
			<span aria-hidden="true">/</span>
			{showEntry ? (
				<>
					<a class={watch.crumb} href={`/shows/${showEntry.id}`}>{showEntry.data.name}</a>
				</>
			) : (
				<>
					<span>{categoryLabel}</span>
				</>
			)}
			{watchStatusLabel && <span class={watch.breadcrumbStatus}>{watchStatusLabel}</span>}
		</div>

		<section
			class={watch.hero}
			aria-labelledby="watch-detail-title"
			data-watch-hero
		>
			<header class={watch.summary}>
				<div class={watch.summaryCopy}>
					<MLabel tone={isLiveNow ? "amber" : "accent"}>
						{isLiveNow && <LiveDot color="amber" />}
						{isLiveNow ? "Live · " : ""}{categoryLabel}
					</MLabel>
					<h1 id="watch-detail-title" class={watch.title}>
						{video.data.title}
					</h1>
					{heroDescription && (
						<p class={watch.dek}>{heroDescription}</p>
					)}
				</div>

				<dl class={watch.facts}>
					<div class={watch.fact}>
						<dt class={watch.factLabel}>Date</dt>
						<dd class={watch.factValue}><time {...publishedLabel.attrs}>{publishedLabel.text}</time></dd>
					</div>
					<div class={watch.fact}>
						<dt class={watch.factLabel}>Runtime</dt>
						{runtimeLabel !== "--:--" && (
							<dd class={watch.factValue}>{runtimeLabel}</dd>
						)}
					</div>
					<div class={watch.fact}>
						<dt class={watch.factLabel}>Share</dt>
						<dd class={watch.factValue}>
							<button
								type="button"
								class={watch.copyButton}
								data-copy-link
								title="Copy a link to this video at the current timestamp"
							>
								<span data-copy-link-label>Copy link</span>
							</button>
						</dd>
					</div>
				</dl>

				{isUpcomingLive && !studioLiveState.live && (
					<div class={watch.upcoming} aria-label="Upcoming stream details">
						<h2 class={watch.noticeTitle}>This session has not started yet.</h2>
						<p class={watch.noticeCopy}>
							Join us on <time {...scheduled.attrs}>{scheduled.text}</time>.
							The player will activate when the stream is available.
						</p>
						{video.data.youtubeId && (
							<a
								class={watch.factLink}
								href={`https://www.youtube.com/live/${video.data.youtubeId}`}
								target="_blank"
								rel="noopener noreferrer"
							>
								Open the scheduled stream on YouTube ↗
							</a>
						)}
						<StreamNotifyButton
							client:visible
							videoSlug={video.data.slug}
							publicKey={notificationsPublicKey}
						/>
					</div>
				)}
			</header>

			<div class={watch.playerWrap}>
				<div id="watch-detail-player" class={watch.playerFrame} data-watch-player-frame>
					<img
						class={watch.poster}
						data-watch-player-poster
						src={thumbnailUrl}
						alt=""
						width="1280"
						height="720"
						fetchpriority="high"
						decoding="async"
					/>
					{shouldMountLiveGate ? (
						<LiveStreamGate
							client:only="vue"
							videoSlug={video.data.slug}
							initialState={studioLiveState}
							thumbnailUrl={thumbnailUrl}
							title={video.data.title}
							fallbackVideoId={shouldRenderVodFallback ? video.data.id : undefined}
							fallbackInitialPosition={initialPosition}
							fallbackIsAuthenticated={isAuthenticated}
							youtubeId={isUpcomingLive ? undefined : video.data.youtubeId}
						/>
					) : (
						<VideoPlayer
							client:only="vue"
							video={video.data.id}
							thumbnailUrl={thumbnailUrl}
							initialPosition={initialPosition}
							isAuthenticated={isAuthenticated}
						/>
					)}
					<noscript>
						<div class={watch.noscript}>
							<p>The embedded player needs JavaScript.</p>
							<p class={watch.noscriptLinks}>
								<a href={streamUrl}>Open the video stream (HLS)</a>
								<a href={captionUrl}>Download captions (VTT)</a>
							</p>
						</div>
					</noscript>
				</div>
			</div>
		</section>

		<div class={watch.body}>
			<VideoReactions server:defer videoId={video.data.slug} />

			<section class={watch.section}>
				<h2 class={watch.sectionTitle}>About this video</h2>
				{video.data.whatYouWillLearn.length > 0 && (
					<section class={watch.learn} aria-labelledby="watch-detail-learn-heading">
						<h3 id="watch-detail-learn-heading" class={watch.learnTitle}>
							What You'll Learn
						</h3>
						<ol class={watch.learnList} data-academy-learn-list>
							{video.data.whatYouWillLearn.map((item) => (
								<li>{item}</li>
							))}
						</ol>
					</section>
				)}
				<div class:list={[layout.prose, watch.description]} data-academy-prose><RichText html={renderedDescriptionHtml} /></div>
			</section>

			{chapterSource.length > 0 && (
				<section class={watch.section} aria-labelledby="watch-detail-chapters-heading">
					<h2 id="watch-detail-chapters-heading" class={watch.sectionTitle}>
						Jump to a chapter
					</h2>
					<details class={watch.transcriptDetails}>
						<summary class={watch.transcriptSummary}>View {chapterSource.length} chapters</summary>
						<ol class={watch.chapterList}>
							{chapterSource.map((chapter) => (
								<li>
									<a
										class={watch.chapterLink}
										href={`?t=${chapter.startTime}`}
										data-chapter-link={String(chapter.startTime)}
									>
										<span class={watch.chapterTime}>
											{formatTimestamp(chapter.startTime)}
										</span>
										<span class={watch.chapterName}>{chapter.title}</span>
									</a>
								</li>
							))}
						</ol>
					</details>
				</section>
			)}

			{transcriptCues.length > 0 && (
				<section class={watch.section} aria-labelledby="watch-detail-transcript-heading">
					<h2 id="watch-detail-transcript-heading" class={watch.sectionTitle}>Transcript</h2>
					<p class={watch.transcriptNote}>Generated from English captions. Select a timestamp to jump to that moment.</p>
					<details class={watch.transcriptDetails}>
						<summary class={watch.transcriptSummary}>Read and search the transcript</summary>
						<VideoTranscript
							cues={transcriptCues}
							chapters={chapterSource}
						/>
					</details>
				</section>
			)}

			{techEntries.length > 0 && (
				<section class={watch.section} aria-labelledby="watch-detail-tech-heading">
					<h2 id="watch-detail-tech-heading" class={watch.sectionTitle}>Technologies featured</h2>
					<div class={watch.techGrid}>
						{techEntries.map((tech) => (
							<a
								href={`/technology/${tech.id}`}
								class={watch.techChip}
							>
								{resolveTechnologyIconUrl(tech.id, tech.data.logos) && <span class={watch.techIcon}>
									<img
										src={resolveTechnologyIconUrl(tech.id, tech.data.logos)!}
										alt=""
										width="20"
										height="20"
										loading="lazy"
										decoding="async"
										onerror="this.parentElement.hidden=true"
									/>
								</span>}
								<span class={watch.techName}>{tech.data.name}</span>
								<span class={watch.techArrow} aria-hidden="true">→</span>
							</a>
						))}
					</div>
				</section>
			)}

			<VideoCast hosts={hostEntries} guests={guestEntries} />

			<VideoContentTabs
				client:idle
				videoId={video.data.id}
				resources={video.data.resources ?? []}
			/>

			{showEntry && showRelatedVideos.length > 0 ? (
				<ShowVideoSection
					show={showEntry}
					videos={showRelatedVideos}
					totalVideos={showRelatedAll.length}
				/>
			) : technologyRecommendation && (
				<TechnologyVideoSection
					technology={technologyRecommendation.technology}
					videos={technologyRecommendation.videos}
					totalVideos={technologyRecommendation.totalVideos}
				/>
			)}
			<NewsletterCTA />
		</div>

	</div>
</Page>

<script>
	function getPlayerVideo(): HTMLVideoElement | null {
		return document.querySelector<HTMLVideoElement>(
			"#watch-detail-player video",
		);
	}

	async function copyText(text: string): Promise<boolean> {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			const input = document.createElement("textarea");
			input.value = text;
			input.setAttribute("readonly", "");
			input.style.position = "fixed";
			input.style.opacity = "0";
			document.body.appendChild(input);
			input.select();
			let copied = false;
			try {
				copied = document.execCommand("copy");
			} catch {
				copied = false;
			}
			input.remove();
			return copied;
		}
	}

	const copyButton = document.querySelector<HTMLButtonElement>(
		"[data-copy-link]",
	);
	const copyLabel = copyButton?.querySelector<HTMLElement>(
		"[data-copy-link-label]",
	);
	let copyResetTimer: ReturnType<typeof setTimeout> | undefined;

	copyButton?.addEventListener("click", async () => {
		const url = new URL(
			window.location.origin + window.location.pathname,
		);
		const media = getPlayerVideo();
		const seconds = media ? Math.floor(media.currentTime) : 0;
		if (seconds > 0) {
			url.searchParams.set("t", String(seconds));
		}
		const copied = await copyText(url.toString());
		if (!copyLabel) return;
		copyLabel.textContent = copied ? "Link copied" : "Copy failed";
		if (copyResetTimer) clearTimeout(copyResetTimer);
		copyResetTimer = setTimeout(() => {
			copyLabel.textContent = "Copy link";
		}, 2000);
	});

	// Chapter links carry ?t=SECONDS so they work as plain navigations
	// (the player reads ?t on load). When the player is already hydrated,
	// seek in place instead of reloading.
	for (const link of document.querySelectorAll<HTMLAnchorElement>(
		"[data-chapter-link]",
	)) {
		link.addEventListener("click", (event) => {
			const seconds = Number.parseInt(link.dataset.chapterLink ?? "", 10);
			if (Number.isNaN(seconds)) return;
			const media = getPlayerVideo();
			if (!media) return;
			event.preventDefault();
			media.currentTime = seconds;
			void media.play()?.catch(() => {});
			const url = new URL(window.location.href);
			url.searchParams.set("t", String(seconds));
			history.replaceState(null, "", url);
			document
				.getElementById("watch-detail-player")
				?.scrollIntoView({ behavior: "smooth", block: "center" });
		});
	}
</script>
