---
import { academyDocument, academyLayout } from "@rawkodeacademy/design-system";
const doc = academyDocument();
const styles = academyLayout({ width: "reading" });
import {
	getCollection,
	getEntries,
	getEntry,
	renderEntry,
	setContentCache,
} from "@/lib/live-content";
import RichText from "@/components/content/RichText.astro";
import ArticleHeader from "@/components/read/ArticleHeader.astro";
import ArticleByline from "@/components/read/ArticleByline.astro";
import BreadcrumbJsonLd from "@/components/breadcrumb/BreadcrumbJsonLd.astro";
import NewsJsonLd from "@/components/html/news-jsonld.astro";
import RelatedNews from "@/components/news/RelatedNews.astro";
import NewsletterCTA from "@/components/newsletter/NewsletterCTA.astro";
import Page from "@/wrappers/page.astro";
import { calculateReadingTime } from "@/utils/reading-time";
import { isNewsPublished } from "@/lib/news-publication";
import { localTime } from "@/lib/local-time";

export const prerender = false;

const now = new Date();
const entry = await getEntry("news", Astro.params.slug ?? "");
// getEntry already hides scheduled stories; the explicit check also rejects
// invalid dates, matching the publication rule used by every listing.
const article =
	entry && isNewsPublished(entry.data.publishedAt, now) ? entry : undefined;
if (!article) return new Response(null, { status: 404 });

// Tag labels have a fallback and related stories are optional, so a failing
// collection degrades the page (cached briefly) instead of taking it down.
let degraded = false;
async function optional<T>(promise: Promise<T[]>): Promise<T[]> {
	try {
		return await promise;
	} catch {
		degraded = true;
		return [];
	}
}
const [{ html }, authors, allTechnologies, publishedNews] = await Promise.all([
	renderEntry(article),
	getEntries(article.data.authors),
	optional(getCollection("technologies")),
	optional(
		getCollection("news", ({ data }) => isNewsPublished(data.publishedAt, now)),
	),
]);

// Related stories list the news collection; tag labels and body autolinks
// come from the technologies collection.
await setContentCache(Astro, {
	entries: [article, ...authors],
	collections: ["news", "technologies"],
	...(degraded ? { maxAge: 60, swr: 0 } : {}),
});

const technologyNameById = new Map<string, string>();
for (const technology of allTechnologies) {
	technologyNameById.set(technology.id, technology.data.name);
}

function formatTechnologyLabel(value: string): string {
	const fromCollection = technologyNameById.get(value);
	if (fromCollection) return fromCollection;
	return value
		.split(/[-/]/g)
		.filter(Boolean)
		.map((segment) =>
			segment.length <= 3
				? segment.toUpperCase()
				: `${segment.charAt(0).toUpperCase()}${segment.slice(1)}`,
		)
		.join(" ");
}

const tags = (article.data.technologies ?? []).map((technologyId) => ({
	id: technologyId,
	label: formatTechnologyLabel(technologyId),
	href: `/technology/${technologyId}`,
}));

const publishDate = localTime(article.data.publishedAt, {
	month: "short",
	day: "numeric",
	year: "numeric",
});

const readingTime = calculateReadingTime(article.body || "");

const breadcrumbItems = [{ label: "News", href: "/news" }];
---

<Page
	title={article.data.title}
	description={article.data.description}
	isArticle={true}
	publishedAt={article.data.publishedAt}
	authors={authors}
	articleSection="News"
	articleTags={tags.map((tag) => tag.label)}
>
	<Fragment slot="extra-head">
		<NewsJsonLd article={article} authors={authors} />
		<BreadcrumbJsonLd
			elements={[
				{ title: "Home", link: "/" },
				{ title: "News", link: "/news" },
				{ title: article.data.title, link: `/news/${article.id}` },
			]}
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Rawkode Academy - News (RSS)"
			href="/api/feeds/news.xml"
		/>
		<link
			rel="alternate"
			type="application/atom+xml"
			title="Rawkode Academy - News (Atom)"
			href="/api/feeds/news.atom"
		/>
		<link
			rel="alternate"
			type="application/feed+json"
			title="Rawkode Academy - News (JSON Feed)"
			href="/api/feeds/news.json"
		/>
	</Fragment>

	<div class={doc.root}>
		<ArticleHeader
			breadcrumbs={breadcrumbItems}
			kicker="News"
			eyebrow=""
			title={article.data.title}
			dek={article.data.description}
		>
			<ArticleByline
				authors={authors}
				date={publishDate}
				readingTime={readingTime.text}
				tags={tags.map((t) => ({ label: t.label, href: t.href }))}
			/>
		</ArticleHeader>

		<div class={doc.reading}>
			<article class={styles.prose}>
				<RichText html={html} />
			</article>

		</div>

		<div class={doc.section}>
			<RelatedNews currentStory={article} stories={publishedNews} limit={3} />
			<NewsletterCTA audience="news" badge="Cloud native news" headline="Stay on top of cloud-native releases" subtitle="Kubernetes, AI infrastructure, and CNCF news by email." />
		</div>
	</div>
</Page>
