---
import { academyDocument, academyLayout } from "@rawkodeacademy/design-system";
const doc = academyDocument();
const styles = academyLayout({ width: "reading" });
import {
	getEntries,
	getEntry,
} from "@/lib/payload-content";
import CmsBody from "@/components/content/CmsBody.astro";
import ArticleHeader from "@/components/read/ArticleHeader.astro";
import ArticleByline from "@/components/read/ArticleByline.astro";
import BreadcrumbJsonLd from "@/components/breadcrumb/BreadcrumbJsonLd.astro";
import NewsJsonLd from "@/components/html/news-jsonld.astro";
import RelatedNews from "@/components/news/RelatedNews.astro";
import NewsletterCTA from "@/components/newsletter/NewsletterCTA.astro";
import Page from "@/wrappers/page.astro";
import { calculateReadingTime } from "@/utils/reading-time";
import { isNewsPublished } from "@/lib/news-publication";
export const prerender = false;

const slug = Astro.params.slug;
const article = slug ? await getEntry("news", { slug }) : undefined;
if (!article || !isNewsPublished(article.data.publishedAt, new Date())) {
	return new Response(null, { status: 404 });
}
const authors = await getEntries(article.data.authors);

const technologyEntries = (
	await Promise.all(
		article.data.technologies.map((reference) =>
			getEntry("technologies", reference),
		),
	)
).filter((entry): entry is NonNullable<typeof entry> => entry !== undefined);
const technologyById = new Map(technologyEntries.map((entry) => [entry.id, entry] as const));

function formatTechnologyLabel(value: string): string {
	return value
		.split(/[-/]/g)
		.filter(Boolean)
		.map((segment) =>
			segment.length <= 3
				? segment.toUpperCase()
				: `${segment.charAt(0).toUpperCase()}${segment.slice(1)}`,
		)
		.join(" ");
}

const tags = article.data.technologies.map((reference) => {
	const technology = technologyById.get(reference.id);
	const slug = technology?.slug ?? reference.slug;
	if (!slug) return undefined;
	return {
		id: reference.id,
		label: technology?.data.name ?? formatTechnologyLabel(slug),
		href: `/technology/${slug}`,
	};
}).filter((tag) => tag !== undefined);

const publishDate = new Intl.DateTimeFormat("en-US", {
	month: "short",
	day: "numeric",
	year: "numeric",
	timeZone: "UTC",
}).format(article.data.publishedAt);

const readingTime = calculateReadingTime(article.body || "");

const breadcrumbItems = [{ label: "News", href: "/news" }];
---

<Page
	title={article.data.title}
	description={article.data.description}
	isArticle={true}
	publishedAt={article.data.publishedAt}
	authors={authors}
	articleSection="News"
	articleTags={tags.map((tag) => tag.label)}
>
	<Fragment slot="extra-head">
		<NewsJsonLd article={article} authors={authors} />
		<BreadcrumbJsonLd
			elements={[
				{ title: "Home", link: "/" },
				{ title: "News", link: "/news" },
				{ title: article.data.title, link: `/news/${article.slug}` },
			]}
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Rawkode Academy - News (RSS)"
			href="/api/feeds/news.xml"
		/>
		<link
			rel="alternate"
			type="application/atom+xml"
			title="Rawkode Academy - News (Atom)"
			href="/api/feeds/news.atom"
		/>
		<link
			rel="alternate"
			type="application/feed+json"
			title="Rawkode Academy - News (JSON Feed)"
			href="/api/feeds/news.json"
		/>
	</Fragment>

	<div class={doc.root}>
		<ArticleHeader
			breadcrumbs={breadcrumbItems}
			kicker="News"
			eyebrow=""
			title={article.data.title}
			dek={article.data.description}
		>
			<ArticleByline
				authors={authors}
				date={publishDate}
				readingTime={readingTime.text}
				tags={tags.map((t) => ({ label: t.label, href: t.href }))}
			/>
		</ArticleHeader>

		<div class={doc.reading}>
			<article class={styles.prose}>
				<CmsBody entry={article} />
			</article>

		</div>

		<div class={doc.section}>
			<RelatedNews currentStory={article} limit={3} />
			<NewsletterCTA audience="news" badge="Cloud native news" headline="Stay on top of cloud-native releases" subtitle="Kubernetes, AI infrastructure, and CNCF news by email." />
		</div>
	</div>
</Page>
