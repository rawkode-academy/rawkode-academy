---
import { getCollection, setContentCache } from "@/lib/live-content";
import { isNewsPublished } from "@/lib/news-publication";
import NewsItemListJsonLd from "@/components/html/news-itemlist-jsonld.astro";
import Page from "@/wrappers/page.astro";
import NewsSubscribeCard from "@/components/news/NewsSubscribeCard.astro";
import AcademyCatalogMasthead from "@/components/academy/AcademyCatalogMasthead.astro";
import NewsStoryRow from "@/components/news/NewsStoryRow.astro";
import { getTechnologyLogos, logosFor } from "@/lib/technology-logos";
import { academyCatalog, academyLayout } from "@rawkodeacademy/design-system";
import { localTime } from "@/lib/local-time";

export const prerender = false;

const now = new Date();
const allNews = (
	await getCollection("news", ({ data }) =>
		isNewsPublished(data.publishedAt, now),
	)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const [leadStory, ...archive] = allNews;
// News has no artwork of its own, so the masthead schedules the projects the
// stories cover, newest story first.
const mosaic = logosFor(
	allNews.flatMap((story) => story.data.technologies),
	await getTechnologyLogos(),
);
// The archive lists every published story; the masthead mosaic reads the
// technologies collection. "news" also caps maxAge at the next scheduled story.
await setContentCache(Astro, {
	entries: allNews,
	collections: ["news", "technologies"],
});
// The lead story shows its publication day as a numeral with the month and
// year beneath it. Dates are calendar days in UTC.
const leadDay = (date: Date) => localTime(date, { day: "2-digit" }, "en-GB");
const leadMonth = (date: Date) =>
	localTime(date, { month: "short", year: "numeric" }, "en-GB");
const styles = academyLayout({ width: "wide" });
const catalog = academyCatalog();
---

<Page title="Cloud Native News" description="Releases, security updates, and changes across the cloud native ecosystem, with practical context for engineers." pageType="CollectionPage">
	<Fragment slot="extra-head">
		<NewsItemListJsonLd stories={allNews} listUrl={new URL("/news", Astro.site ?? Astro.url).href} />
		<link rel="alternate" type="application/rss+xml" title="Rawkode Academy - News (RSS)" href="/api/feeds/news.xml" />
		<link rel="alternate" type="application/atom+xml" title="Rawkode Academy - News (Atom)" href="/api/feeds/news.atom" />
		<link rel="alternate" type="application/feed+json" title="Rawkode Academy - News (JSON Feed)" href="/api/feeds/news.json" />
	</Fragment>
	<div class={styles.root}>
		<AcademyCatalogMasthead title="News" description="Releases, security updates, and changes worth understanding." figure={allNews.length} figureLabel={allNews.length === 1 ? "story" : "stories"} mosaic={mosaic} mosaicShape="logo">
			<a slot="actions" class={catalog.feedLink} href="/api/feeds/news.xml">Follow the RSS feed ↗</a>
		</AcademyCatalogMasthead>

		{leadStory && <section class={styles.section} aria-label="Latest story">
			<article class={catalog.lead}>
				<p class={catalog.leadDate}><time datetime={leadStory.data.publishedAt.toISOString()}><strong data-datetime={leadDay(leadStory.data.publishedAt).iso} data-local-time={leadDay(leadStory.data.publishedAt).attrs["data-local-time"]}>{leadDay(leadStory.data.publishedAt).text}</strong><span data-datetime={leadMonth(leadStory.data.publishedAt).iso} data-local-time={leadMonth(leadStory.data.publishedAt).attrs["data-local-time"]}>{leadMonth(leadStory.data.publishedAt).text}</span></time></p>
				<div class={catalog.leadBody}>
					<p class={catalog.leadKicker}>Latest story</p>
					<h2 class={catalog.leadTitle}>{leadStory.data.title}</h2>
					<p class={catalog.leadDescription}>{leadStory.data.description}</p>
					<a class={styles.button} href={`/news/${leadStory.id}`}>Read the story →</a>
				</div>
			</article>
		</section>}

		<section class={styles.section} aria-labelledby="news-archive">
			<header class={styles.sectionHeader}>
				<h2 id="news-archive" class={styles.sectionTitle}>Earlier stories</h2>
				<p class={catalog.resultCount}>{archive.length} stories</p>
			</header>
			<div class={catalog.editorialList}>
				{archive.map((story) => <NewsStoryRow story={story} />)}
			</div>
		</section>

		<section class={styles.section} aria-label="Newsletter">
			<NewsSubscribeCard />
		</section>
	</div>
</Page>
