---
import { env } from "cloudflare:workers";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	type DashboardQuery,
	dashboardQueries,
	NEWSLETTER_EVENTS,
	parseRange,
	RANGES,
	SIGN_IN_EVENTS,
} from "@/lib/analytics/queries";
import { basinQuery, type Row } from "@/server/basin";
import Page from "@/wrappers/page.astro";

export const prerender = false;

// BASIN_SQL_TOKEN is a secret uploaded by scripts/wrangler-deploy.ts.
const vars = env as unknown as {
	ANALYTICS_ADMIN_EMAILS?: string;
	BASIN_BUCKET?: string;
	BASIN_SQL_TOKEN?: string;
	CLOUDFLARE_ACCOUNT_ID?: string;
};

const admins = (vars.ANALYTICS_ADMIN_EMAILS ?? "")
	.split(",")
	.map((email) => email.trim().toLowerCase())
	.filter(Boolean);
const email = Astro.locals.user?.email?.toLowerCase();
if (!import.meta.env.DEV && (!email || !admins.includes(email))) {
	return new Response("Not found", { status: 404 });
}

const range = parseRange(Astro.url.searchParams.get("range"));
const config = {
	accountId: vars.CLOUDFLARE_ACCOUNT_ID ?? "",
	bucket: vars.BASIN_BUCKET ?? "rawkode-analytics",
	token: vars.BASIN_SQL_TOKEN ?? "",
};
const configured = Boolean(config.accountId && config.token);

type Panel = { rows: Row[]; error?: string };
const queries = dashboardQueries(range);
const results = Object.fromEntries(
	await Promise.all(
		(Object.keys(queries) as DashboardQuery[]).map(async (name) => {
			if (!configured) return [name, { rows: [], error: "not configured" }];
			try {
				return [name, { rows: await basinQuery(config, queries[name]) }];
			} catch (error) {
				return [
					name,
					{ rows: [], error: error instanceof Error ? error.message : String(error) },
				];
			}
		}),
	),
) as Record<DashboardQuery, Panel>;

const num = (value: unknown) => Number(value ?? 0);
const fmt = new Intl.NumberFormat("en-GB");
const pct = (part: number, whole: number) =>
	whole > 0 ? `${((part / whole) * 100).toFixed(1)}%` : "–";

const signInCount = (event: string) =>
	results.signIn.rows
		.filter((row) => row.event === event)
		.reduce((sum, row) => sum + num(row.events), 0);
const initiated = signInCount(SIGN_IN_EVENTS.initiated);
const completed = signInCount(SIGN_IN_EVENTS.completed);
const registered = signInCount(SIGN_IN_EVENTS.registered);
const failed = signInCount(SIGN_IN_EVENTS.failed);

const newsletter = new Map(
	results.newsletter.rows.map((row) => [String(row.event), num(row.events)]),
);
const [attemptsEvent, subscribedEvent] = NEWSLETTER_EVENTS;
const attempts = newsletter.get(attemptsEvent) ?? 0;
const subscribed = newsletter.get(subscribedEvent) ?? 0;

// All links, not just the top 25 listed below.
const linkClicks = num(results.linkTotals.rows[0]?.clicks);
---

<Page title="Analytics" description="First-party analytics from the Basin lake.">
	<EditorialShell
		eyebrow="Internal"
		title="Analytics"
		lede={`Server events and matched short-link redirects, last ${RANGES[range]} days. Known bots are filtered during ingestion. Results cached for 10 minutes.`}
	>
		<nav class="ranges" aria-label="Date range">
			{
				Object.keys(RANGES).map((key) => (
					<a href={`?range=${key}`} aria-current={key === range ? "page" : undefined}>
						{key}
					</a>
				))
			}
		</nav>

		{
			!configured && (
				<p class="notice">
					Basin SQL isn't configured: set the <code>BASIN_SQL_TOKEN</code> secret
					(see projects/rawkode.tools/observability-collector/basin/README.md).
				</p>
			)
		}

		<p class="notice">
			Browser traffic, referrers, campaigns and CTA impressions/clicks are unavailable
			until browser event ingestion is migrated. The figures below cover server events
			and short-link redirects only. Bot totals are unavailable because filtered
			traffic is not stored; events without a user agent are not classified as human.
		</p>

		<section class="panel">
			<h2>Server events</h2>
			{results.events.error && <p class="error">{results.events.error}</p>}
			<table>
				<thead><tr><th>Event (top 100)</th><th>Events</th></tr></thead>
				<tbody>
					{results.events.rows.map((row) => (
						<tr><td>{row.event}</td><td>{fmt.format(num(row.events))}</td></tr>
					))}
				</tbody>
			</table>
		</section>

		<div class="grid">
			<section class="panel">
				<h2>Sign-in events</h2>
				<p>Counts are events; percentages compare totals rather than linked user journeys.</p>
				{results.signIn.error && <p class="error">{results.signIn.error}</p>}
				<dl class="funnel">
					<dt>Started (events)</dt><dd>{fmt.format(initiated)}</dd>
					<dt>Completed</dt><dd>{fmt.format(completed)} <span>{pct(completed, initiated)}</span></dd>
					<dt>New accounts</dt><dd>{fmt.format(registered)}</dd>
					<dt>Failed</dt><dd>{fmt.format(failed)}</dd>
				</dl>
			</section>

			<section class="panel">
				<h2>Newsletter submissions</h2>
				{results.newsletter.error && <p class="error">{results.newsletter.error}</p>}
				<dl class="funnel">
					<dt>Submitted</dt><dd>{fmt.format(attempts)}</dd>
					<dt>Subscribed</dt><dd>{fmt.format(subscribed)} <span>{pct(subscribed, attempts)}</span></dd>
				</dl>
			</section>

			<section class="panel">
				<h2>Video engagement</h2>
				<p>Viewer estimates exclude anonymous events. Rates compare event totals, not linked user journeys.</p>
				{results.video.error && <p class="error">{results.video.error}</p>}
				<table>
					<thead><tr><th>Video</th><th>Plays</th><th>Completes</th><th>Viewers</th></tr></thead>
					<tbody>
						{results.video.rows.map((row) => (
							<tr>
								<td>{row.video_id ?? "unknown"}</td>
								<td>{fmt.format(num(row.plays))}</td>
								<td>{fmt.format(num(row.completes))} <span>{pct(num(row.completes), num(row.plays))}</span></td>
								<td>~{fmt.format(num(row.viewers))}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>

			<section class="panel">
				<h2>Link redirects</h2>
				{results.linkTotals.error && <p class="error">{results.linkTotals.error}</p>}
				{results.links.error && <p class="error">{results.links.error}</p>}
				<p class="stat">
					<strong>{fmt.format(linkClicks)}</strong> matched redirects
				</p>
				<table>
					<thead><tr><th>Link</th><th>Redirects</th></tr></thead>
					<tbody>
						{results.links.rows.map((row) => (
							<tr>
								<td>{row.domain}/{String(row.path ?? "").replace(/^\//, "")}</td>
								<td>{fmt.format(num(row.clicks))}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>
		</div>
	</EditorialShell>
</Page>

<style>
	.ranges {
		display: flex;
		gap: 0.5rem;
		margin-block-end: 1.5rem;
		font-family: var(--fonts-academy-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}
	.ranges a {
		padding: 0.25rem 0.625rem;
		border: 1px solid var(--colors-academy-border);
		border-radius: var(--radii-sm);
		color: var(--colors-academy-text-soft);
		text-decoration: none;
	}
	.ranges a[aria-current="page"] {
		border-color: var(--colors-academy-text);
		color: var(--colors-academy-text);
	}
	.grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
	}
	.panel {
		border-top: 2px solid var(--colors-academy-text);
		padding-block: 1rem 1.5rem;
		min-width: 0;
	}
	.panel h2 {
		font-size: 1.5rem;
		margin-block-end: 0.75rem;
	}
	.panel h3 {
		margin-block: 1.25rem 0.5rem;
		font-size: 1rem;
	}
	.stat {
		color: var(--colors-academy-text-soft);
		margin-block-end: 0.75rem;
	}
	.stat strong {
		font-family: var(--fonts-academy-display);
		font-style: italic;
		font-size: 2rem;
		font-weight: 400;
		color: var(--colors-academy-text);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
	}
	th,
	td {
		padding: 0.375rem 0.5rem 0.375rem 0;
		border-bottom: 1px solid var(--colors-academy-border);
		text-align: right;
		vertical-align: top;
	}
	th:first-child,
	td:first-child {
		text-align: left;
		overflow-wrap: anywhere;
	}
	th {
		font-family: var(--fonts-academy-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--colors-academy-text-muted);
	}
	td span,
	dd span {
		color: var(--colors-academy-text-muted);
		font-size: 0.75rem;
	}
	.funnel {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0;
		font-variant-numeric: tabular-nums;
	}
	.funnel dt,
	.funnel dd {
		margin: 0;
		padding-block: 0.5rem;
		border-bottom: 1px solid var(--colors-academy-border);
	}
	.funnel dd {
		text-align: right;
		color: var(--colors-academy-text);
	}
	.notice,
	.error {
		font-size: 0.875rem;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--colors-academy-status-rust);
		color: var(--colors-academy-text-soft);
		margin-block-end: 1rem;
	}
</style>
