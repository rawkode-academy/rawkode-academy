---
import { academyDocument, academyLayout } from "@rawkodeacademy/design-system";
const doc = academyDocument();
const styles = academyLayout({ width: "reading" });
import {
	type ContentEntry,
	getEntries,
	getEntry,
	renderEntry,
	setContentCache,
} from "@/lib/live-content";
import RichText from "@/components/content/RichText.astro";
import AdrJsonLd from "@/components/html/adr-jsonld.astro";
import BreadcrumbJsonLd from "@/components/breadcrumb/BreadcrumbJsonLd.astro";
import { createLogger } from "@/lib/logger";
import ArticleHeader from "@/components/read/ArticleHeader.astro";
import ArticleByline from "@/components/read/ArticleByline.astro";
import Page from "@/wrappers/page.astro";
import { localDate } from "@/lib/local-time";

const logger = createLogger("adrs");

const adr = Astro.params.slug
	? await getEntry("adrs", Astro.params.slug)
	: undefined;
if (!adr) return new Response(null, { status: 404 });

const { html } = await renderEntry(adr);

let authors: ContentEntry<"people">[] = [];
try {
	authors = await getEntries(adr.data.authors);
} catch (error) {
	logger.error(`Error fetching authors for ADR ${adr.id}`, error);
}

await setContentCache(Astro, {
	entries: [adr, ...authors],
	// The body autolinks technologies, so renames and additions refresh it.
	collections: ["technologies"],
});

const formatDate = (date: Date) =>
	localDate(date);

const adrNumber = adr.id.match(/^(\d{4})-/)?.[1] || "0000";
const adoptedLabel = adr.data.adoptedAt
	? formatDate(adr.data.adoptedAt)
	: "Not adopted";
const validAuthors = authors.filter((author) => author && author.data);
---

<Page
	title={`ADR-${adrNumber}: ${adr.data.title}`}
	description={`Architecture Decision Record: ${adr.data.title}`}
	isArticle={true}
	publishedAt={adr.data.adoptedAt}
	{...(adr.data.recordUpdatedAt ? { updatedAt: adr.data.recordUpdatedAt } : {})}
	authors={validAuthors}
	articleSection="Architecture Decision Records"
>
	<Fragment slot="extra-head">
		<AdrJsonLd adr={adr} authors={authors} />
		<BreadcrumbJsonLd
			elements={[
				{ title: "Home", link: "/" },
				{ title: "Architecture Decision Records", link: "/adrs" },
				{ title: `ADR-${adrNumber}: ${adr.data.title}`, link: `/adrs/${adr.id}` },
			]}
		/>
	</Fragment>
	<ArticleHeader
		breadcrumbs={[
			{ label: "Home", href: "/" },
			{ label: "Architecture decisions", href: "/adrs" },
		]}
		kicker={`ADR-${adrNumber}`}
		title={adr.data.title}
	>
		<ArticleByline authors={validAuthors} date={adoptedLabel} />
	</ArticleHeader>

		<section class={doc.reading}>
			<article class={[styles.prose, doc.adrProse].join(" ")}>
				<RichText html={html} />
			</article>
		</section>
</Page>
