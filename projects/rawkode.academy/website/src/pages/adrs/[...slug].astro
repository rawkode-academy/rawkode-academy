---
import { academyDocument, academyLayout } from "@rawkodeacademy/design-system";
const doc = academyDocument();
const styles = academyLayout({ width: "reading" });
import { getEntry, getEntries } from "@/lib/payload-content";
import type { CollectionEntry } from "@/lib/payload-content";
import AdrJsonLd from "@/components/html/adr-jsonld.astro";
import { createLogger } from "@/lib/logger";
import ArticleHeader from "@/components/read/ArticleHeader.astro";
import ArticleByline from "@/components/read/ArticleByline.astro";
import Page from "@/wrappers/page.astro";
import CmsBody from "@/components/content/CmsBody.astro";

export const prerender = false;

const logger = createLogger("adrs");

const slug = Astro.params.slug;
const adr = slug ? await getEntry("adrs", { slug }) : undefined;
if (!adr) return new Response(null, { status: 404 });

let authors: CollectionEntry<"people">[] = [];
try {
	authors = await getEntries(adr.data.authors);
} catch (error) {
	logger.error(`Error fetching authors for ADR ${adr.id}`, error);
}

const formatDate = (date: Date): string => {
	return new Intl.DateTimeFormat("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	}).format(date);
};

const adrNumber = adr.id.match(/^(\d{4})-/)?.[1] || "0000";
const adoptedLabel = adr.data.adoptedAt
	? formatDate(adr.data.adoptedAt)
	: "Not adopted";
const validAuthors = authors.filter((author) => author && author.data);
---

<Page
	title={`ADR-${adrNumber}: ${adr.data.title}`}
	description={`Architecture Decision Record: ${adr.data.title}`}
>
	<AdrJsonLd slot="extra-head" adr={adr} authors={authors} />
	<ArticleHeader
		breadcrumbs={[{ label: "Architecture decisions", href: "/adrs" }]}
		kicker={`ADR-${adrNumber}`}
		title={adr.data.title}
	>
		<ArticleByline authors={validAuthors} date={adoptedLabel} />
	</ArticleHeader>

		<section class={doc.reading}>
			<article class={[styles.prose, doc.adrProse].join(" ")}>
				<CmsBody entry={adr} />
			</article>
		</section>
</Page>
