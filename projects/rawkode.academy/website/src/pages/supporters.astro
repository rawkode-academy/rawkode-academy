---
export const prerender = false;

import AcademyCatalogMasthead from "@/components/academy/AcademyCatalogMasthead.astro";
import EmptyState from "@/components/ui/EmptyState.vue";
import MLabel from "@/components/ui/MLabel.vue";
import { academyLayout, button } from "@rawkodeacademy/design-system";
import Page from "@/wrappers/page.astro";
import {
	getCollection,
	optionalContent,
	setContentCache,
} from "@/lib/live-content";
import { supporterLogo } from "@/lib/supporter-logos";
import { BECOME_A_SUPPORTER_PATH, supporterHost } from "@/lib/supporters";
import { buildTechnologyTags } from "@/lib/technology-tags";

// The supporters are the page; technology names are secondary, so a label
// falls back to the technology id, unlinked, when it cannot be loaded.
const [supporters, technologies] = await Promise.all([
	getCollection("supporters"),
	optionalContent(getCollection("technologies"), []),
]);

// The gateway lists active supporters only, longest-standing first.
const wall = supporters
	.filter(({ data }) => data.name && data.websiteUrl)
	.map((supporter) => ({
		supporter,
		logo: supporterLogo(supporter, technologies),
	}))
	.map(({ supporter: { id, data }, logo }) => ({
		id,
		name: data.name,
		websiteUrl: data.websiteUrl,
		host: supporterHost(data.websiteUrl),
		logoUrl: logo?.src,
		// An icon-only mark keeps the name beside it.
		wordmark: logo?.wordmark,
		technologies: buildTechnologyTags(
			data.technologies.map((technology) => technology.id),
			technologies,
			(technologyId) => technologyId,
		),
	}));

const supportedIds = new Set(
	wall.flatMap((supporter) => supporter.technologies.map(({ id }) => id)),
);
await setContentCache(Astro, {
	entries: [
		...supporters,
		...technologies.filter((technology) => supportedIds.has(technology.id)),
	],
	collections: ["supporters", "technologies"],
});
const styles = academyLayout({ width: "wide" });
---

<Page
	title="Community supporters"
	description="The organisations that fund Rawkode Academy's free tutorials, live streams and shows for the cloud native community."
	pageType="CollectionPage"
>
	<div class={styles.root}>
		<AcademyCatalogMasthead
			title="Community supporters"
			description="These organisations keep every Rawkode Academy tutorial, live stream and show free to watch."
			figure={wall.length}
			figureLabel={wall.length === 1 ? "supporter" : "supporters"}
		/>

		<section class={styles.section} aria-labelledby="supporter-wall-title">
			<div class={styles.container}>
				<h2 id="supporter-wall-title" class="sr-only">Our community supporters</h2>
				{wall.length > 0 ? (
					<>
						<p class="supporter-wall__thanks">Thank you for keeping the Academy free to watch.</p>
						<ul class="supporter-wall">
							{wall.map((supporter) => (
								<li class="supporter-wall__item" data-supporter={supporter.id}>
									<h3 class="supporter-wall__heading">
										<a
											class="supporter-wall__identity"
											href={supporter.websiteUrl}
											target="_blank"
											rel="sponsored noopener"
										>
											{supporter.logoUrl && (
												<img
													class="supporter-wall__logo"
													src={supporter.logoUrl}
													alt={supporter.wordmark ? "" : supporter.name}
													width="320"
													height="96"
													onerror="this.hidden=true; this.nextElementSibling.hidden=false;"
												/>
											)}
											<span class="supporter-wall__name" hidden={Boolean(supporter.logoUrl) && !supporter.wordmark}>{supporter.name}</span>
											<span class="sr-only"> (opens in a new tab)</span>
											<span class="supporter-wall__arrow" aria-hidden="true">↗</span>
										</a>
									</h3>
									<div class="supporter-wall__detail">
										{supporter.host && <p class="supporter-wall__host">{supporter.host}</p>}
										{supporter.technologies.length > 0 && (
											<div class="supporter-wall__support">
												<MLabel>Supports</MLabel>
												<ul class="supporter-wall__technologies">
													{supporter.technologies.map((technology) => (
														<li>{technology.href
															? <a class="supporter-wall__technology" href={technology.href}>{technology.label}</a>
															: technology.label}</li>
													))}
												</ul>
											</div>
										)}
									</div>
								</li>
							))}
							<li class="supporter-wall__invite">
								<p class="supporter-wall__invite-title">Your logo here</p>
								<p class="supporter-wall__invite-body">Keep the Academy free to watch, and take your place on the wall.</p>
								<a class={button({ variant: "outline" })} href={BECOME_A_SUPPORTER_PATH}>Become a community supporter <span data-part="arrow" aria-hidden="true">→</span></a>
							</li>
						</ul>
					</>
				) : (
					<EmptyState
						title="Be the first community supporter"
						body="Help keep Rawkode Academy's tutorials, live streams and shows free for everyone."
					>
						<a slot="actions" class={button()} href={BECOME_A_SUPPORTER_PATH}>Become a community supporter</a>
					</EmptyState>
				)}
			</div>
		</section>
	</div>
</Page>

<style>
	.supporter-wall__thanks {
		max-width: 18ch;
		margin: 0 0 2.5rem;
		font-family: var(--fonts-academy-display);
		font-size: var(--font-sizes-academy-section);
		font-weight: 800;
		letter-spacing: var(--letter-spacings-academy-display);
		line-height: 1.02;
		text-wrap: balance;
	}

	.supporter-wall {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.supporter-wall__item,
	.supporter-wall__invite {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 19rem;
		border: 1px solid var(--colors-academy-border);
		border-radius: var(--radii-academy-m);
	}

	.supporter-wall__item {
		background: var(--colors-academy-panel);
		transition: border-color var(--durations-base) var(--easings-academy-out);
	}

	.supporter-wall__item:hover,
	.supporter-wall__item:focus-within {
		border-color: var(--colors-academy-text);
	}

	.supporter-wall__heading {
		display: flex;
		flex: 1;
		margin: 0;
		font: inherit;
		letter-spacing: normal;
	}

	/* The stage: the mark, large and centred, is the whole link. */
	.supporter-wall__identity {
		position: relative;
		display: flex;
		flex: 1;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem 1rem;
		min-width: 0;
		padding: 3rem 2rem;
		border-radius: var(--radii-academy-m);
		color: var(--colors-academy-text);
		text-decoration: none;
	}

	/* Marks are one ink on a transparent ground: set them in the text colour. */
	.supporter-wall__logo {
		width: auto;
		max-width: min(100%, 15rem);
		height: clamp(3rem, 6vw, 4.25rem);
		object-fit: contain;
		filter: brightness(0);
		opacity: 0.82;
		transition:
			opacity var(--durations-base) var(--easings-academy-out),
			transform var(--durations-base) var(--easings-academy-out);
	}

	:global(html.dark) .supporter-wall__logo {
		filter: brightness(0) invert(1);
	}

	.supporter-wall__name {
		font-family: var(--fonts-academy-display);
		font-size: clamp(2rem, 4.5vw, 3rem);
		font-weight: 800;
		letter-spacing: var(--letter-spacings-academy-display);
		line-height: 1;
		overflow-wrap: anywhere;
	}

	.supporter-wall__arrow {
		position: absolute;
		top: 1rem;
		right: 1.25rem;
		color: var(--colors-academy-text-muted);
		font-size: 1.25rem;
		line-height: 1;
		transition:
			transform var(--durations-base) var(--easings-academy-out),
			color var(--durations-base) var(--easings-academy-out);
	}

	.supporter-wall__identity:hover .supporter-wall__logo {
		opacity: 1;
		transform: scale(1.04);
	}

	.supporter-wall__identity:hover .supporter-wall__arrow {
		color: var(--colors-academy-accent);
		transform: translate(0.15rem, -0.15rem);
	}

	@media (prefers-reduced-motion: reduce) {
		.supporter-wall__item,
		.supporter-wall__logo,
		.supporter-wall__arrow {
			transition: none;
		}

		.supporter-wall__identity:hover .supporter-wall__logo,
		.supporter-wall__identity:hover .supporter-wall__arrow {
			transform: none;
		}
	}

	.supporter-wall__detail {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding: 1rem 1.25rem;
		border-top: 1px solid var(--colors-academy-border);
	}

	.supporter-wall__support {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem 0.75rem;
	}

	.supporter-wall__technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.supporter-wall__technology {
		color: var(--colors-academy-text);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: var(--colors-academy-input-border);
		text-underline-offset: 0.2em;
	}

	.supporter-wall__technology:hover {
		text-decoration-color: var(--colors-academy-accent);
	}

	.supporter-wall__host {
		margin: 0;
		color: var(--colors-academy-text-muted);
		font-family: var(--fonts-academy-mono);
		font-size: 0.8125rem;
	}

	/* Same ring as the design system's focusRing fragment. */
	.supporter-wall__identity:focus-visible,
	.supporter-wall__technology:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 2px;
	}

	/* The open place on the wall. */
	.supporter-wall__invite {
		align-items: flex-start;
		justify-content: center;
		gap: 0.75rem;
		padding: 2rem;
		border-style: dashed;
		border-color: var(--colors-academy-input-border);
	}

	.supporter-wall__invite-title {
		margin: 0;
		font-family: var(--fonts-academy-display);
		font-size: clamp(2rem, 4.5vw, 3rem);
		font-weight: 800;
		letter-spacing: var(--letter-spacings-academy-display);
		line-height: 1;
	}

	.supporter-wall__invite-body {
		max-width: 28ch;
		margin: 0 0 0.75rem;
		color: var(--colors-academy-text-soft);
	}
</style>
