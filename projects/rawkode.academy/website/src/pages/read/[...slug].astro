---
import { academyDocument, academyLayout } from "@rawkodeacademy/design-system";
const doc = academyDocument();
const styles = academyLayout({ width: "reading" });
import {
	type ContentEntry,
	documentToMarkdown,
	getCollection,
	getEntries,
	getEntry,
	optionalContent,
	renderEntry,
	setContentCache,
} from "@/lib/live-content";
import RichText from "@/components/content/RichText.astro";

import Page from "@/wrappers/page.astro";

import ArticleJsonLd from "@/components/html/article-jsonld.astro";
import BreadcrumbJsonLd from "@/components/breadcrumb/BreadcrumbJsonLd.astro";
import { buildHowToJsonLd } from "@/lib/howto-jsonld";

import RelatedArticles from "@/components/articles/RelatedArticles.astro";
import Resources from "@/components/articles/Resources.astro";
import Updates from "@/components/articles/Updates.astro";
import RelatedVideos from "@/components/articles/RelatedVideos.astro";
import NewsletterCTA from "@/components/newsletter/NewsletterCTA.astro";

import ArticleHeader from "@/components/read/ArticleHeader.astro";
import ArticleByline from "@/components/read/ArticleByline.astro";
import ArticleTOC from "@/components/read/ArticleTOC.astro";
import EndSlug from "@/components/read/EndSlug.astro";

import { calculateReadingTime } from "@/utils/reading-time";
import { getTypeBadgeConfig } from "@/utils/article-types";
import { localTime } from "@/lib/local-time";

export const prerender = false;

const RELATED_ARTICLE_LIMIT = 3;

// Every article id resolves (drafts included, as before); scheduled
// (future-dated) articles stay hidden until their publication time.
const article = Astro.params.slug
	? await getEntry("articles", Astro.params.slug)
	: undefined;
if (!article) return new Response(null, { status: 404 });

const [{ html, headings }, authors, allArticles, allTechnologies] =
	await Promise.all([
		renderEntry(article),
		getEntries(article.data.authors),
		// Related reading and tag labels are optional: a content failure
		// leaves them out instead of failing the article.
		optionalContent(getCollection("articles"), []),
		optionalContent(getCollection("technologies"), []),
	]);

// Same pool and ranking RelatedArticles applies, resolved here so the cache
// tags cover the related cards (and their authors).
const relatedArticles = allArticles
	.filter((candidate) => candidate.id !== article.id)
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	.slice(0, RELATED_ARTICLE_LIMIT);

await setContentCache(Astro, {
	entries: [article, ...authors, ...relatedArticles],
	// Related articles and videos are listed; the body autolinks and the tags
	// are labelled from technologies.
	collections: ["articles", "videos", "technologies"],
});

const computeImageUrl = (
	entry: ContentEntry<"articles">,
): URL | undefined =>
	entry.data.cover
		? new URL(entry.data.cover.image.src, Astro.site ?? Astro.url)
		: undefined;

const imageUrl = computeImageUrl(article);

const howToJsonLd = article.data.howto
	? buildHowToJsonLd({
			siteUrl: (Astro.site ?? Astro.url).origin,
			articleUrl: new URL(`/read/${article.id}`, Astro.site ?? Astro.url).href,
			name: article.data.title,
			description: article.data.description,
			...(imageUrl ? { imageUrl: imageUrl.href } : {}),
			publishedAt: new Date(article.data.publishedAt),
			...(article.data.updatedAt
				? { updatedAt: new Date(article.data.updatedAt) }
				: {}),
			headings,
			body: await documentToMarkdown(article.data.body),
		})
	: undefined;

const readingTime = calculateReadingTime(article.body || "");

// Technology → readable label (technology ids carry no "/index").
const technologyNameById = new Map<string, string>();
for (const technology of allTechnologies) {
	technologyNameById.set(technology.id, technology.data.name);
}

function formatTechnologyLabel(value: string): string {
	const fromCollection = technologyNameById.get(value);
	if (fromCollection) return fromCollection;
	return value
		.split(/[-/]/g)
		.filter(Boolean)
		.map((segment) =>
			segment.length <= 3
				? segment.toUpperCase()
				: `${segment.charAt(0).toUpperCase()}${segment.slice(1)}`,
		)
		.join(" ");
}

const tags = (article.data.technologies ?? []).map((technologyId) => ({
	label: formatTechnologyLabel(technologyId),
	href: `/technology/${technologyId}`,
}));

const articleType = article.data.type || "tutorial";
const badgeConfig = getTypeBadgeConfig(articleType);

const dateOptions: Intl.DateTimeFormatOptions = {
	month: "short",
	day: "2-digit",
	year: "numeric",
};
const publishDate = localTime(article.data.publishedAt, dateOptions);

const sameCalendarDayUtc = (a: Date, b: Date): boolean =>
	a.getUTCFullYear() === b.getUTCFullYear() &&
	a.getUTCMonth() === b.getUTCMonth() &&
	a.getUTCDate() === b.getUTCDate();

const wasUpdated =
	article.data.updatedAt &&
	article.data.updatedAt.getTime() > article.data.publishedAt.getTime() &&
	!sameCalendarDayUtc(article.data.updatedAt, article.data.publishedAt);

const updateDate = wasUpdated
	? localTime(article.data.updatedAt as Date, dateOptions)
	: undefined;

// Breadcrumb trail.
const breadcrumbs = [
	{ label: "Read", href: "/read" },
	{ label: article.data.title, current: true },
];

const subtitle = article.data.openGraph?.subtitle || article.data.subtitle;
---

<Page
	title={`${article.data.openGraph?.title || article.data.title}`}
	subtitle={subtitle}
	description={article.data.description}
	image={imageUrl ? {
		image: imageUrl,
		text: article.data.title,
		format: "png" as const
	} : undefined}
	useImageDirectly={true}
	isArticle={true}
	publishedAt={article.data.publishedAt}
	updatedAt={article.data.updatedAt}
	authors={authors}
	articleSection={badgeConfig.label}
	articleTags={tags.map((tag) => tag.label)}
	{...(howToJsonLd ? { jsonLd: howToJsonLd } : {})}
>
	{/*
		A single slotted element with a conditional spread — a ternary holding
		two `slot="extra-head"` branches makes Astro drop every slotted
		sibling that follows it (the feed links below never reached the head).
	*/}
	<ArticleJsonLd
		slot="extra-head"
		article={article}
		authors={authors}
		{...(imageUrl ? { imageUrl } : {})}
	/>
	<BreadcrumbJsonLd
		slot="extra-head"
		elements={[
			{ title: "Home", link: "/" },
			{ title: "Read", link: "/read" },
			{ title: article.data.title, link: `/read/${article.id}` },
		]}
	/>
	<link slot="extra-head" rel="alternate" type="application/rss+xml" title="Rawkode Academy - Articles (RSS)" href="/api/feeds/articles.xml" />
	<link slot="extra-head" rel="alternate" type="application/atom+xml" title="Rawkode Academy - Articles (Atom)" href="/api/feeds/articles.atom" />
	<link slot="extra-head" rel="alternate" type="application/feed+json" title="Rawkode Academy - Articles (JSON Feed)" href="/api/feeds/articles.json" />

	<div class={doc.root}>
		<div class={doc.progressRule} aria-hidden="true"></div>
		<ArticleHeader
			breadcrumbs={breadcrumbs}
			kicker={badgeConfig.label}
			title={article.data.title}
			dek={subtitle}
		>
			<ArticleByline
				authors={authors}
				date={publishDate}
				updatedDate={updateDate}
				readingTime={readingTime.text}
				tags={tags}
			/>
		</ArticleHeader>

		<div class={doc.body}>
			<div class={doc.main}>
				<article class={styles.prose}>
					<Updates updates={article.data.updates} />
					<RichText html={html} />
				</article>

				<EndSlug date={publishDate} />

				<Resources resources={article.data.resources} />
			</div>

			<ArticleTOC headings={headings} />
		</div>

		<div class={doc.section}>
			<RelatedArticles
				currentArticle={article}
				articles={relatedArticles}
				limit={RELATED_ARTICLE_LIMIT}
			/>
			<RelatedVideos currentArticle={article} limit={3} />
			<NewsletterCTA />
		</div>
	</div>
</Page>
