---
import { getCollection } from "astro:content";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import Page from "@/wrappers/page.astro";
import { academyDocument } from "@rawkodeacademy/design-system";

const doc = academyDocument();

export const prerender = true;

const shows = await getCollection("shows");
const publishedShows = shows.filter((show) => show.data.publish);

const feedGroups = [
	{
		title: "All content",
		body: "Articles, news, videos, and podcasts in one combined feed.",
		links: [
			{ label: "RSS", href: "/api/feeds/all.xml" },
			{ label: "Atom", href: "/api/feeds/all.atom" },
			{ label: "JSON", href: "/api/feeds/all.json" },
		],
	},
	{
		title: "Articles",
		body: "Articles and tutorials from Rawkode Academy.",
		links: [
			{ label: "RSS", href: "/api/feeds/articles.xml" },
			{ label: "Atom", href: "/api/feeds/articles.atom" },
			{ label: "JSON", href: "/api/feeds/articles.json" },
		],
	},
	{
		title: "News",
		body: "Cloud native, Kubernetes, and AI infrastructure news for engineers.",
		links: [
			{ label: "RSS", href: "/api/feeds/news.xml" },
			{ label: "Atom", href: "/api/feeds/news.atom" },
			{ label: "JSON", href: "/api/feeds/news.json" },
		],
	},
	{
		title: "Videos",
		body: "New episodes, live sessions, and video releases.",
		links: [
			{ label: "RSS", href: "/api/feeds/videos.xml" },
			{ label: "Atom", href: "/api/feeds/videos.atom" },
			{ label: "JSON", href: "/api/feeds/videos.json" },
		],
	},
];

const formatNotes = [
	"RSS 2.0 is the broadest reader-compatible format.",
	"Atom 1.0 is a structured XML format with richer metadata.",
	"JSON Feed is useful for modern readers and programmatic consumers.",
	"OPML lets you import many feeds into a reader at once.",
];
---

<Page title="Feeds" description="Subscribe to Rawkode Academy via RSS, Atom, JSON Feed, or OPML.">
	<EditorialShell title="Feeds" lede="Follow the Academy in your feed reader. Choose a topic below, or import all feeds at once." compact>
		<a slot="actions" class={doc.link} href="/feeds.opml" download>Download all feeds (OPML) ↓</a>

		<section class="feed-section" aria-labelledby="main-feeds">
			<h2 id="main-feeds" class={doc.sectionTitle}>Main feeds</h2>
			<div class="feed-list">
				{feedGroups.map((group) => (
					<article class="feed-row">
						<div>
							<h3 class={doc.cardTitle}>{group.title}</h3>
							<p class={doc.copy}>{group.body}</p>
						</div>
						<div class="feed-links">
							{group.links.map((link) => <a class="feed-link" href={link.href} aria-label={`${group.title} ${link.label} feed`}>{link.label} ↗</a>)}
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="feed-section" aria-labelledby="show-feeds">
			<h2 id="show-feeds" class={doc.sectionTitle}>Podcast feeds</h2>
			<div class="feed-list">
				{publishedShows.length > 0 ? publishedShows.map((show) => (
					<article class="feed-row">
						<div>
							<h3 class={doc.cardTitle}>{show.data.name}</h3>
							<p class={doc.copy}>{show.data.description}</p>
						</div>
						<div class="feed-links">
							<a class="feed-link" href={`/api/feeds/shows/${show.data.id}.xml`} aria-label={`${show.data.name} podcast RSS feed`}>RSS ↗</a>
						</div>
					</article>
				)) : <p class={doc.copy}>No podcast feeds are published yet.</p>}
			</div>
		</section>

		<details class="feed-formats">
			<summary>Which format should I choose?</summary>
			<ul class="editorial-list">{formatNotes.map((note) => <li>{note}</li>)}</ul>
		</details>
	</EditorialShell>
</Page>

<style>
	.feed-section { padding: 2.5rem var(--spacing-academy-gutter); }
	.feed-section h2 { margin-bottom: 1.5rem; }
	.feed-list { border-top: 1px solid var(--colors-academy-border); }
	.feed-row {
		display: grid;
		gap: 1rem;
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--colors-academy-border);
	}
	.feed-row h3 { margin: 0 0 0.5rem; }
	.feed-row p { margin: 0; }
	.feed-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: center; }
	.feed-link {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-family: var(--fonts-academy-mono), monospace;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--colors-academy-accent);
		text-underline-offset: 0.2em;
	}
	.feed-link:hover { text-decoration: underline; }
	.feed-link:focus-visible, .feed-formats summary:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}
	.feed-formats { margin: 0 var(--spacing-academy-gutter) 3rem; }
	.feed-formats summary {
		width: fit-content;
		min-height: 2.75rem;
		padding-block: 0.625rem;
		cursor: pointer;
		font-weight: 600;
	}
	.feed-formats ul { padding-top: 1rem; }
	@media (min-width: 1024px) {
		.feed-section { padding-inline: 0; }
		.feed-formats { margin-inline: 0; }
		.feed-row { grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: start; }
	}
</style>
