---
import MinimalLayout from "@/layouts/minimal.astro";
import WebContainerEmbed from "@/components/courses/WebContainerEmbed.vue";
import { getWebContainerDemo } from "@/lib/payload-content";
import type { PayloadWebContainerDemo } from "@/lib/payload-content";
import { academyMedia } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

const url = new URL(Astro.request.url);
const courseSlug = url.searchParams.get("course");
const moduleSlug = url.searchParams.get("module");
const resourceKey = url.searchParams.get("resource");

let title = "WebContainer Demo";
let files: Record<string, string> = {};
let startCommand = "npm run dev";
let error: string | null = null;
const media = academyMedia();

function readDemoFiles(value: unknown): Record<string, string> | undefined {
	if (!value || typeof value !== "object" || Array.isArray(value)) return undefined;

	const entries = Object.entries(value as Record<string, unknown>);
	if (entries.length === 0 || entries.length > 256) return undefined;

	const result: Record<string, string> = {};
	let totalBytes = 0;
	for (const [path, contents] of entries) {
		const parts = path.split("/");
		if (
			!path ||
			path.length > 512 ||
			path.startsWith("/") ||
			/[\\\u0000-\u001f\u007f]/.test(path) ||
			parts.some(
				(part) =>
					!part ||
					part === "." ||
					part === ".." ||
					part === "__proto__" ||
					part === "prototype" ||
					part === "constructor",
			) ||
			typeof contents !== "string"
		) {
			return undefined;
		}

		totalBytes += new TextEncoder().encode(contents).byteLength;
		if (totalBytes > 1_000_000) return undefined;
		result[path] = contents;
	}

	return result;
}

if (!courseSlug || !moduleSlug || !resourceKey) {
	Astro.response.status = 400;
	error = "Missing course, module, or resource parameter.";
} else {
	const fullModuleSlug = `${courseSlug}/${moduleSlug}`;
	const slugPartPattern = /^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$/;
	const moduleParts = fullModuleSlug.split("/");
	const validLookup =
		slugPartPattern.test(courseSlug) &&
		slugPartPattern.test(resourceKey) &&
		fullModuleSlug.length <= 240 &&
		moduleParts.length >= 2 &&
		moduleParts[0] === courseSlug &&
		moduleParts.every((part) => slugPartPattern.test(part));

	if (!validLookup) {
		Astro.response.status = 404;
		error = "This WebContainer demo could not be found.";
	} else {
		let demo: PayloadWebContainerDemo | undefined;
		try {
			demo = await getWebContainerDemo(courseSlug, fullModuleSlug, resourceKey);
		} catch (cause) {
			console.error("Failed to read WebContainer demo from Payload:", cause);
			Astro.response.status = 503;
			Astro.response.headers.set("Cache-Control", "no-store");
			error = "This WebContainer demo is temporarily unavailable.";
		}

		if (!error && !demo) {
			Astro.response.status = 404;
			error = "This WebContainer demo could not be found.";
		} else if (!error && demo) {
			const demoFiles = readDemoFiles(demo.files);
			if (!demoFiles) {
				Astro.response.status = 404;
				error = "This WebContainer demo could not be found.";
			} else {
				files = demoFiles;
				title = demo.title || title;
				startCommand = demo.startCommand || startCommand;
			}
		}
	}
}

// This page resolves its selected demo during each server-side request.
export const prerender = false;
---

<MinimalLayout title={title} noindex>
 <style>
 body {
 margin: 0;
 padding: 0;
 overflow: hidden;
 }
 #app {
 width: 100vw;
 height: 100vh;
 }
 .error {
 display: flex;
 align-items: center;
 justify-content: center;
 height: 100vh;
 color: #ef4444;
 font-size: 1.25rem;
 text-align: center;
 padding: 2rem;
 }
 .error a {
 color: #60a5fa;
 text-decoration: underline;
 }
 </style>

 {error ? (
 <div class:list={[media.root, media.canvas, "error"]}>
 <div>
 <p>{error}</p>
 <p><a href="javascript:history.back()">Go back</a></p>
 </div>
 </div>
 ) : (
 <div id="app" class:list={[media.root, media.canvas]}>
 <WebContainerEmbed
 client:only="vue"
 title={title}
 files={files}
 startCommand={startCommand}
 />
 </div>
 )}
</MinimalLayout>
