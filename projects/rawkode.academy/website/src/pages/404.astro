---
import Page from "@/wrappers/page.astro";
import { academySearch } from "@rawkodeacademy/design-system";
export const prerender = true;
const s = academySearch();
---

<Page title="Page not found" description="This page could not be found. Search the Academy or return to the homepage." noindex>
	<div class={s.root}>
		<section class={s.header}>
			<p class={s.count}>Error 404</p>
			<h1 class={s.title}>This page isn’t here.</h1>
			<p class={s.lede}>The link may be out of date. Search for what you need, or head back to the Academy.</p>
			<form action="/search" method="get" role="search" class={s.form}>
				<label class={s.field} for="not-found-search">Search the Academy
					<input class={s.input} type="search" name="q" id="not-found-search" placeholder="Kubernetes, eBPF, GitOps…" required />
				</label>
				<button class={s.button} type="submit">Search</button>
			</form>
			<nav aria-label="Page recovery" class={s.filters}>
				<a class={s.more} href="/">Back to the homepage →</a>
				<a class={s.more} href="https://github.com/rawkode-academy/rawkode-academy/issues/new/choose">Report a broken link</a>
			</nav>
		</section>
	</div>
</Page>
