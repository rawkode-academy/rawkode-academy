---
import { getCollection } from "astro:content";
import DefaultHead from "@/components/html/head.astro";
import AcademyPreview from "@/components/preview/AcademyPreview.vue";
import { getPublishedVideos } from "@/lib/content";
import { getVideoThumbnailUrl } from "@/lib/video-thumbnail";
import "@rawkodeacademy/design-system/styles.css";

const route = Astro.params.slug?.replace(/^\/+|\/+$/g, "") ?? "";
const page = route === "learn" || route === "watch" ? route : "home";

const compactCopy = (text: string | undefined, maxLength: number) => {
	const normalized = (text ?? "").replace(/\s+/g, " ").trim();
	if (!normalized) return "Practical lessons from the Rawkode Academy archive.";
	const firstSentence = normalized.match(/^.*?[.!?](?:\s|$)/)?.[0]?.trim();
	if (firstSentence && firstSentence.length <= maxLength) return firstSentence;
	if (normalized.length <= maxLength) return normalized;
	return `${normalized.slice(0, maxLength).trimEnd()}…`;
};

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
	});

const formatDuration = (seconds?: number | null) => {
	if (!seconds || seconds <= 0) return "Session";
	const minutes = Math.floor(seconds / 60);
	if (minutes < 60) return `${minutes} min`;
	return `${Math.floor(minutes / 60)}h ${minutes % 60}m`;
};

const allVideos = await getPublishedVideos();
const videos = allVideos.slice(0, 6).map((video) => ({
	href: `/watch/${video.data.slug}`,
	title: video.data.title,
	description: compactCopy(video.data.subtitle || video.data.description, 220),
	meta: [
		video.data.type === "live" ? "Live session" : "Recorded session",
		formatDuration(
			typeof video.data.duration === "number" ? video.data.duration : undefined,
		),
	],
	mediaSrc: getVideoThumbnailUrl(video.data.id),
}));

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const articles = allArticles
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	.slice(0, 6)
	.map((article) => ({
		href: `/read/${article.id}`,
		title: article.data.title,
		description: compactCopy(
			article.data.openGraph?.subtitle ||
				article.data.subtitle ||
				article.data.description,
			220,
		),
		meta: ["Article", formatDate(article.data.publishedAt)],
	}));

const allNews = await getCollection("news");
const news = allNews
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	.slice(0, 6)
	.map((item) => ({
		href: `/news/${item.id}`,
		title: item.data.title,
		description: compactCopy(item.data.description, 220),
		meta: ["News", formatDate(item.data.publishedAt)],
	}));

const allLearningPaths = await getCollection("learningPaths");
const learningPaths = allLearningPaths
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
	.slice(0, 6)
	.map((path) => ({
		href: `/learning-paths/${path.id}`,
		title: path.data.title,
		description: compactCopy(path.data.description, 220),
		meta: [
			path.data.difficulty,
			path.data.estimatedDuration
				? `${Math.round(path.data.estimatedDuration / 60)}h route`
				: "Self-paced",
		] as [string, string],
	}));

const featured = videos[0] ?? {
	href: "/watch",
	title: "Cloud native is complex. It does not need to be hard.",
	description:
		"Hands-on lessons, candid trade-offs, and real build sessions for engineers who want signal instead of slideware.",
	meta: ["Rawkode Academy", "Start here"],
};

const totalHours = Math.floor(
	allVideos.reduce(
		(total, video) =>
			total +
			(typeof video.data.duration === "number" ? video.data.duration : 0),
		0,
	) / 3600,
);

const pageTitle =
	page === "learn"
		? "Learn by building"
		: page === "watch"
			? "Watch working systems"
			: "Rawkode Academy preview";
---

<html lang="en">
	<DefaultHead
		title={pageTitle}
		description="A Panda CSS v2 and Ark UI preview for the Rawkode Academy website."
	/>
	<body>
		<AcademyPreview
			client:load
			page={page}
			featured={featured}
			videos={videos}
			articles={articles}
			news={news}
			learningPaths={learningPaths}
			stats={[
				{ value: `${allVideos.length}`, label: "Lessons" },
				{ value: `${totalHours}+`, label: "Hours" },
				{ value: `${allLearningPaths.length}`, label: "Paths" },
				{ value: "2019", label: "Since" },
			]}
		/>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		padding: 0;
		min-width: 320px;
	}

	body {
		background: #0a1220;
	}

	button,
	input {
		font: inherit;
	}

	ul {
		margin: 0;
		padding-inline-start: 1.25rem;
	}

	a {
		color: inherit;
	}
</style>
