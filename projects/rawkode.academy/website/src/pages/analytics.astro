---
import { env } from "cloudflare:workers";
import EditorialShell from "@/components/ui/EditorialShell.astro";
import {
	REACH_DAYS,
	type ReachQuery,
	reachQueries,
	reachWindow,
} from "@/lib/analytics/reach";
import { basinQuery, type Row } from "@/server/basin";
import Page from "@/wrappers/page.astro";

export const prerender = false;

// Signed-in members only. Everything below is aggregate: no per-video or
// per-person data, and no bots (see the methodology note).
const user = Astro.locals.user;
if (!user && !import.meta.env.DEV) {
	return Astro.redirect(
		`/api/auth/sign-in?returnTo=${encodeURIComponent("/analytics")}`,
	);
}
Astro.response.headers.set("Cache-Control", "private, no-store");

const vars = env as unknown as {
	BASIN_BUCKET?: string;
	BASIN_SQL_TOKEN?: string;
	CLOUDFLARE_ACCOUNT_ID?: string;
};
const config = {
	accountId: vars.CLOUDFLARE_ACCOUNT_ID ?? "",
	bucket: vars.BASIN_BUCKET ?? "rawkode-analytics",
	token: vars.BASIN_SQL_TOKEN ?? "",
};
const configured = Boolean(config.accountId && config.token);

const span = reachWindow();
const queries = reachQueries(span);
const results = Object.fromEntries(
	await Promise.all(
		(Object.keys(queries) as ReachQuery[]).map(async (name) => {
			if (!configured) return [name, { rows: [] as Row[], failed: true }];
			try {
				// Reach numbers move slowly; cache for 30 minutes at the edge.
				const rows = await basinQuery(config, queries[name], {
					ttlSeconds: 1800,
				});
				return [name, { rows, failed: false }];
			} catch {
				return [name, { rows: [] as Row[], failed: true }];
			}
		}),
	),
) as Record<ReachQuery, { rows: Row[]; failed: boolean }>;

const num = (value: unknown) => Number(value ?? 0);
const fmt = new Intl.NumberFormat("en-GB");
const compact = new Intl.NumberFormat("en-GB", {
	notation: "compact",
	maximumFractionDigits: 1,
});
const regions = new Intl.DisplayNames(["en"], { type: "region" });
const countryName = (code: unknown) => {
	try {
		return regions.of(String(code)) ?? String(code);
	} catch {
		return String(code);
	}
};
const longDay = new Intl.DateTimeFormat("en-GB", {
	day: "numeric",
	month: "short",
	timeZone: "UTC",
});
const dayLabel = (day: string) => longDay.format(new Date(`${day.slice(0, 10)}T00:00:00Z`));

const web = results.totals.rows[0] ?? {};
const webDaily = results.daily.rows.map((row) => ({
	day: String(row.day).slice(0, 10),
	views: num(row.views),
	visitors: num(row.visitors),
}));
const referrers = results.referrers.rows.map((row) => ({
	name: row.referrer === "direct" ? "Direct" : String(row.referrer),
	views: num(row.views),
}));
const countries = results.countries.rows.map((row) => ({
	name: countryName(row.country),
	views: num(row.views),
}));

// YouTube lags about three days; show the latest 30 days it has.
const ytDaily = results.youtube.rows
	.map((row) => ({
		day: String(row.day),
		views: num(row.views),
		engaged: num(row.engaged_views),
		minutes: num(row.minutes_watched),
		gained: num(row.subscribers_gained),
		lost: num(row.subscribers_lost),
	}))
	.slice(-REACH_DAYS);
const sum = (key: "views" | "engaged" | "minutes" | "gained" | "lost") =>
	ytDaily.reduce((total, row) => total + row[key], 0);
const ytFirst = ytDaily.at(0);
const ytLast = ytDaily.at(-1);
const webFirst = webDaily.at(0);
const webLast = webDaily.at(-1);
const ytRange =
	ytFirst && ytLast ? `${dayLabel(ytFirst.day)} – ${dayLabel(ytLast.day)}` : "";
const watchHours = Math.round(sum("minutes") / 60);

// Weekly bars would hide the shape; draw one bar per day.
function bars(values: number[]) {
	const max = Math.max(1, ...values);
	const width = 100 / Math.max(values.length, 1);
	return values.map((value, i) => ({
		x: i * width,
		width: width * 0.8,
		height: (value / max) * 100,
	}));
}
const webBars = bars(webDaily.map((row) => row.visitors));
const ytBars = bars(ytDaily.map((row) => row.views));
const share = (value: number, rows: { views: number }[]) => {
	const total = rows.reduce((t, row) => t + row.views, 0);
	return total > 0 ? Math.round((value / total) * 100) : 0;
};
const unavailable = Object.values(results).some((result) => result.failed);
---

<Page title="Reach" description="Rawkode Academy audience over the last 30 days." noindex>
	<EditorialShell
		eyebrow="Members"
		title="Reach"
		lede={`Rawkode Academy audience over the last ${REACH_DAYS} days: the website and the YouTube channel. Aggregate only.`}
	>
		{
			unavailable && (
				<p class="notice">
					Some figures are unavailable right now. Reload in a minute; nothing here is estimated.
				</p>
			)
		}

		<section class="block" aria-labelledby="web-heading">
			<h2 id="web-heading">Website</h2>
			<p class="range">{dayLabel(span.start)} – {dayLabel(
				new Date(Date.parse(`${span.end}T00:00:00Z`) - 86_400_000).toISOString(),
			)}</p>
			<dl class="stats">
				<div><dt>Visitors</dt><dd>~{fmt.format(num(web.visitors))}</dd></div>
				<div><dt>Page views</dt><dd>{fmt.format(num(web.views))}</dd></div>
				<div><dt>Countries</dt><dd>{fmt.format(num(web.countries))}</dd></div>
			</dl>
			{
				webFirst && webLast && (
					<figure>
						<svg viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label={`Daily visitors, ${webFirst.day} to ${webLast.day}, peak ${Math.max(...webDaily.map((row) => row.visitors))}`}>
							{webBars.map((bar, i) => (
								<rect x={bar.x} y={100 - bar.height} width={bar.width} height={bar.height}>
									<title>{dayLabel(webDaily[i]?.day ?? "")}: {fmt.format(webDaily[i]?.visitors ?? 0)} visitors</title>
								</rect>
							))}
						</svg>
						<figcaption>Daily visitors</figcaption>
					</figure>
				)
			}
			<div class="grid">
				<div>
					<h3>Where visitors come from</h3>
					<table>
						<thead><tr><th>Source</th><th>Share of views</th></tr></thead>
						<tbody>
							{referrers.map((row) => (
								<tr><td>{row.name}</td><td>{share(row.views, referrers)}%</td></tr>
							))}
						</tbody>
					</table>
				</div>
				<div>
					<h3>Top countries</h3>
					<table>
						<thead><tr><th>Country</th><th>Share of views</th></tr></thead>
						<tbody>
							{countries.map((row) => (
								<tr><td>{row.name}</td><td>{share(row.views, countries)}%</td></tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<section class="block" aria-labelledby="yt-heading">
			<h2 id="yt-heading">YouTube</h2>
			{ytRange && <p class="range">{ytRange}</p>}
			<dl class="stats">
				<div><dt>Views</dt><dd>{fmt.format(sum("views"))}</dd></div>
				<div><dt>Watch time</dt><dd>{fmt.format(watchHours)} hours</dd></div>
				<div><dt>Engaged views</dt><dd>{fmt.format(sum("engaged"))}</dd></div>
				<div><dt>Net new subscribers</dt><dd>{sum("gained") - sum("lost") >= 0 ? "+" : "−"}{fmt.format(Math.abs(sum("gained") - sum("lost")))}</dd></div>
			</dl>
			{
				ytFirst && ytLast && (
					<figure>
						<svg viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label={`Daily YouTube views, ${ytFirst.day} to ${ytLast.day}, peak ${compact.format(Math.max(...ytDaily.map((row) => row.views)))}`}>
							{ytBars.map((bar, i) => (
								<rect x={bar.x} y={100 - bar.height} width={bar.width} height={bar.height}>
									<title>{dayLabel(ytDaily[i]?.day ?? "")}: {fmt.format(ytDaily[i]?.views ?? 0)} views</title>
								</rect>
							))}
						</svg>
						<figcaption>Daily views</figcaption>
					</figure>
				)
			}
		</section>

		<section class="method">
			<h2>How these are counted</h2>
			<p>
				Website figures come from our own first-party analytics. Automated traffic is
				removed, and visitors are approximate distinct anonymous browsers, so one
				person on two devices counts twice. YouTube figures are channel totals from
				YouTube Analytics, a few days behind. Nothing here identifies a person or a video.
			</p>
		</section>
	</EditorialShell>
</Page>

<style>
	.block {
		border-top: 2px solid var(--colors-academy-text);
		padding-block: 1rem 2rem;
	}
	.block h2,
	.method h2 {
		font-size: 1.5rem;
		margin-block-end: 0.25rem;
	}
	.range {
		color: var(--colors-academy-text-muted);
		font-family: var(--fonts-academy-mono);
		font-size: 0.8125rem;
		margin-block-end: 1rem;
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 1.5rem;
		margin: 0 0 1.5rem;
	}
	.stats dt {
		color: var(--colors-academy-text-soft);
		font-size: 0.875rem;
	}
	.stats dd {
		margin: 0;
		font-family: var(--fonts-academy-display);
		font-size: 2.25rem;
		font-variant-numeric: tabular-nums;
		color: var(--colors-academy-text);
	}
	figure {
		margin: 0 0 1.5rem;
	}
	figure svg {
		width: 100%;
		height: 9rem;
		display: block;
		border-bottom: 1px solid var(--colors-academy-border);
	}
	figure rect {
		fill: var(--colors-academy-accent);
	}
	figcaption {
		margin-block-start: 0.375rem;
		font-size: 0.8125rem;
		color: var(--colors-academy-text-muted);
	}
	.grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
	}
	h3 {
		font-size: 1rem;
		margin-block-end: 0.5rem;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
	}
	th,
	td {
		padding: 0.375rem 0;
		border-bottom: 1px solid var(--colors-academy-border);
		text-align: right;
	}
	th:first-child,
	td:first-child {
		text-align: left;
	}
	th {
		font-weight: 500;
		color: var(--colors-academy-text-muted);
	}
	.method {
		border-top: 2px solid var(--colors-academy-text);
		padding-block: 1rem 2rem;
		color: var(--colors-academy-text-soft);
		max-width: 44rem;
	}
	.notice {
		font-size: 0.875rem;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--colors-academy-status-rust);
		color: var(--colors-academy-text-soft);
		margin-block-end: 1rem;
	}
</style>
