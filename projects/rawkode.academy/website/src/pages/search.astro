---
import { env } from "cloudflare:workers";
import Page from "@/wrappers/page.astro";
import { captureServerEvent, getDistinctId } from "@/server/analytics";
import { shouldCaptureSearchAnalytics } from "@/lib/search-analytics";
import {
	getSearchIndex,
	isSearchType,
	searchEntries,
	SEARCH_TYPE_LABELS,
	SEARCH_TYPES,
	type SearchResult,
	type SearchType,
} from "@/lib/search";
import { academySearch } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

const searchQuery = (Astro.url.searchParams.get("q") || "").trim();
const typeParam = (Astro.url.searchParams.get("type") || "").trim();
const activeType: SearchType | undefined = isSearchType(typeParam)
	? typeParam
	: undefined;

const index = searchQuery ? await getSearchIndex() : [];
const allRanked = searchQuery ? searchEntries(index, searchQuery) : [];
const ranked = activeType
	? allRanked.filter((result) => result.type === activeType)
	: allRanked;

if (shouldCaptureSearchAnalytics(searchQuery)) {
	const analytics = env.ANALYTICS as Fetcher | undefined;
	await captureServerEvent(
		{
			event: "search_performed",
			properties: {
				query: searchQuery,
				results_count: ranked.length,
				search_type: activeType ?? "all",
			},
			distinctId: getDistinctId(Astro),
		},
		analytics,
	);
}

// Group ranked results by content type, preserving rank order: groups are
// ordered by their best-ranked result, items stay ranked within each group.
const GROUP_LIMIT = activeType ? 24 : 12;
const pageCount = Math.max(1, Math.ceil(ranked.length / GROUP_LIMIT));
const requestedPage = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const page = activeType && Number.isFinite(requestedPage) ? Math.min(pageCount, Math.max(1, requestedPage)) : 1;
const offset = (page - 1) * GROUP_LIMIT;

const groups: { type: SearchType; results: SearchResult[]; total: number }[] =
	[];
const groupByType = new Map<SearchType, (typeof groups)[number]>();
for (const result of ranked) {
	let group = groupByType.get(result.type);
	if (!group) {
		group = { type: result.type, results: [], total: 0 };
		groupByType.set(result.type, group);
		groups.push(group);
	}
	group.total += 1;
	if (group.total > offset && group.results.length < GROUP_LIMIT) {
		group.results.push(result);
	}
}

const countsByType = new Map<SearchType, number>();
for (const result of allRanked) {
	countsByType.set(result.type, (countsByType.get(result.type) ?? 0) + 1);
}

const searchHref = (type?: SearchType, pageNumber = 1): string => {
	const params = new URLSearchParams({ q: searchQuery });
	if (type) params.set("type", type);
	if (pageNumber > 1) params.set("page", String(pageNumber));
	return `/search?${params.toString()}`;
};

const typeFilters = [
	{
		label: "All",
		href: searchHref(),
		count: allRanked.length,
		active: !activeType,
	},
	...SEARCH_TYPES.filter((type) => (countsByType.get(type) ?? 0) > 0).map(
		(type) => ({
			label: SEARCH_TYPE_LABELS[type],
			href: searchHref(type),
			count: countsByType.get(type) ?? 0,
			active: activeType === type,
		}),
	),
];

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	day: "2-digit",
	month: "short",
	year: "numeric",
});

const truncate = (text: string, maxLength: number): string => {
	const normalized = text.replace(/\s+/g, " ").trim();
	if (normalized.length <= maxLength) return normalized;
	return `${normalized.slice(0, maxLength).trimEnd()}…`;
};

const suggestions = [
	{ label: "Kubernetes", href: "/search?q=kubernetes" },
	{ label: "Cilium", href: "/search?q=cilium" },
	{ label: "GitOps", href: "/search?q=gitops" },
	{ label: "eBPF", href: "/search?q=ebpf" },
	{ label: "Talos", href: "/search?q=talos" },
	{ label: "OpenTelemetry", href: "/search?q=opentelemetry" },
];
const s = academySearch();
---

<Page title={searchQuery ? `Search results for "${searchQuery}"` : "Search"} description="Find videos, articles, news, courses, learning paths, shows, and technologies from Rawkode Academy." pageType="SearchResultsPage" noindex>
	<div class={s.root}>
		<header class={s.header}>
			<h1 class={s.title}>{searchQuery ? `Results for “${searchQuery}”` : "Find your next lesson."}</h1>
			<p class={s.lede}>{searchQuery ? `${ranked.length} ${ranked.length === 1 ? "result" : "results"}${activeType ? ` in ${SEARCH_TYPE_LABELS[activeType].toLowerCase()}` : " across the Academy"}.` : "Search videos, articles, courses, and the technologies behind them."}</p>
			<form class={s.form} method="get" action="/search" role="search">
				<label class={s.field} for="academy-search-query">Search the Academy
					<input id="academy-search-query" class={s.input} type="search" name="q" value={searchQuery} placeholder="Kubernetes, eBPF, GitOps…" autocomplete="off" />
				</label>
				{activeType && <input type="hidden" name="type" value={activeType} />}
				<button class={s.button} type="submit">Search</button>
			</form>
			{!searchQuery && <nav aria-label="Suggested searches"><ul class={s.filters}>{suggestions.map((suggestion) => <li><a class={s.filter} href={suggestion.href}>{suggestion.label}</a></li>)}</ul></nav>}
			{searchQuery && allRanked.length > 0 && <nav aria-label="Filter results by type"><ul class={s.filters}>{typeFilters.map((filter) => <li><a class={s.filter} href={filter.href} aria-current={filter.active ? "page" : undefined}>{filter.label} · {filter.count}</a></li>)}</ul></nav>}
		</header>
		{searchQuery && ranked.length === 0 && <section class={s.empty}>
			<h2>No results found.</h2>
			<p>{activeType ? <>Try <a href={searchHref()}>all content types</a> or a different keyword.</> : <>Try a broader keyword, or browse <a href="/watch">the video library</a>.</>}</p>
		</section>}
		{groups.length > 0 && <div class={s.groups}>{groups.map((group) => <section aria-label={SEARCH_TYPE_LABELS[group.type]}>
			<header class={s.groupHeader}><h2>{SEARCH_TYPE_LABELS[group.type]}</h2><span class={s.count}>{group.total} {group.total === 1 ? "match" : "matches"}</span></header>
			<ul class={s.list}>{group.results.map((result) => <li>
				<a class={s.result} href={result.href}>
					<h3 class={s.resultTitle}>{result.title}</h3>
					{result.description && <p class={s.description}>{truncate(result.description, 180)}</p>}
					{result.date && <time class={s.date} datetime={result.date}>{dateFormatter.format(new Date(result.date))}</time>}
				</a>
			</li>)}</ul>
			{!activeType && group.total > group.results.length && <a class={s.more} href={searchHref(group.type)}>All {group.total} {SEARCH_TYPE_LABELS[group.type].toLowerCase()} →</a>}
		</section>)}</div>}
		{activeType && pageCount > 1 && <nav class={s.pager} aria-label="Search result pages">
			{page > 1 ? <a class={s.more} href={searchHref(activeType, page - 1)}>← Previous</a> : <span />}
			<span class={s.count}>Page {page} of {pageCount}</span>
			{page < pageCount ? <a class={s.more} href={searchHref(activeType, page + 1)}>Next →</a> : <span />}
		</nav>}
	</div>
</Page>
