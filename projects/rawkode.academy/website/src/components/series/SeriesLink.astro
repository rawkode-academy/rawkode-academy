---
import { academyDocument } from "@rawkodeacademy/design-system";
const doc = academyDocument();
import type { CollectionEntry } from "@/lib/payload-content";

type Props = {
	series: CollectionEntry<"series">;
};

const { series } = Astro.props;
---

<p class={doc.cardTitle}>
	Part of the series: <a
		class={doc.link}
		href={`/series/${series.slug}`}>{series.data.title}</a
	>
</p>
