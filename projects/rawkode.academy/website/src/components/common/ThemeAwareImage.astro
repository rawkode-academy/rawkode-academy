---
export interface Props {
	lightSrc: ImageMetadata | string;
	darkSrc: ImageMetadata | string;
	alt: string;
	class?: string;
	loading?: "eager" | "lazy";
}

const {
	lightSrc,
	darkSrc,
	alt,
	class: className = "",
	loading = "lazy",
} = Astro.props;

const lightUrl = typeof lightSrc === "string" ? lightSrc : lightSrc.src;
const darkUrl = typeof darkSrc === "string" ? darkSrc : darkSrc.src;
const lightWidth = typeof lightSrc === "string" ? undefined : lightSrc.width;
const lightHeight = typeof lightSrc === "string" ? undefined : lightSrc.height;
const darkWidth = typeof darkSrc === "string" ? undefined : darkSrc.width;
const darkHeight = typeof darkSrc === "string" ? undefined : darkSrc.height;
---

<div class={`theme-aware-image ${className}`}>
	<img
		src={lightUrl}
		alt={alt}
		class="theme-light-only"
		loading={loading}
		width={lightWidth}
		height={lightHeight}
		decoding="async"
	/>
	<img
		src={darkUrl}
		alt={alt}
		class="theme-dark-only"
		loading={loading}
		width={darkWidth}
		height={darkHeight}
		decoding="async"
	/>
</div>

<style>
	.theme-aware-image {
		position: relative;
		width: 100%;
		height: auto;
	}

	/* Display light image by default and hide dark image */
	.theme-light-only {
		display: block;
	}
	.theme-dark-only {
		display: none;
	}

	/* When user prefers dark mode, show dark image and hide light image */
	@media (prefers-color-scheme: dark) {
		.theme-light-only { display: none; }
		.theme-dark-only { display: block; }
	}

	/* Respect explicit dark mode via .dark class (overrides OS if user chose) */
	:root.dark .theme-light-only { display: none; }
	:root.dark .theme-dark-only { display: block; }

	.theme-light-only,
	.theme-dark-only {
		width: 100%;
		height: auto;
	}
</style>
