---
export interface Props {
	href?: string;
	text?: string;
}

const { href = "#main-content", text = "Skip to main content" } = Astro.props;
---

<a href={href} class="skip-link">
	{text}
</a>

<style>
	/* Visually hidden until it takes keyboard focus. */
	.skip-link {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.skip-link:focus {
		top: 1rem;
		left: 1rem;
		z-index: 50;
		width: auto;
		height: auto;
		margin: 0;
		padding: 0.5rem 1rem;
		overflow: visible;
		clip: auto;
		clip-path: none;
		background: var(--colors-academy-accent);
		color: var(--colors-academy-accent-foreground);
		font-family: var(--fonts-academy-text);
		font-weight: 600;
		text-decoration: none;
		border-radius: var(--radii-academy-s);
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 2px;
	}
</style>
