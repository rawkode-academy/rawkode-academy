---
import { academyDocument } from "@rawkodeacademy/design-system";
const doc = academyDocument();
import { getCollection, type CollectionEntry } from "astro:content";
import MLabel from "@/components/ui/MLabel.vue";
import { getTypeBadgeConfig } from "@/utils/article-types";

interface Props {
	articles: CollectionEntry<"articles">[];
	totalCount?: number | undefined;
}

const { articles, totalCount } = Astro.props as Props;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
	month: "short",
	day: "2-digit",
	year: "numeric",
});

// Derive dispatch numbers from the article's position in the full
// sorted corpus so they stay stable + match other surfaces (/read index,
// article header). Cached at module level; getCollection is memoised
// across renders inside Astro.
const corpus = (
	await getCollection("articles", ({ data }) => !data.draft)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const indexById = new Map<string, number>(
	corpus.map((a, i) => [a.id, corpus.length - i]),
);

const items = articles.slice(0, 3).map((a) => ({
	href: `/read/${a.id}`,
	dispatchNum: String(indexById.get(a.id) ?? corpus.length).padStart(3, "0"),
	kicker: getTypeBadgeConfig(a.data.type || "tutorial").label,
	title: a.data.title,
	date: dateFormatter.format(a.data.publishedAt),
	readingTime: a.body
		? `${Math.max(1, Math.round(a.body.split(/\s+/).length / 220))} min`
		: undefined,
}));
---

<footer class={doc.related}>
	<div class={[doc.container, doc.stack].join(" ")}>
		<div class={doc.rowBetween}>
			<MLabel tone="spruce">Read next</MLabel>
			<div class={doc.spacer} aria-hidden="true"></div>
			{totalCount !== undefined && (
				<MLabel>{items.length} of {totalCount}</MLabel>
			)}
		</div>

		<div class={doc.grid}>
			{items.map((item) => (
				<a
					class={doc.relatedCard}
					href={item.href}
				>
					<MLabel tone="spruce">№{item.dispatchNum} · {item.kicker}</MLabel>
					<h3 class={doc.cardTitle}>{item.title}</h3>
					<MLabel>{item.date}{item.readingTime ? ` · ${item.readingTime}` : ""}</MLabel>
				</a>
			))}
		</div>
	</div>
</footer>
