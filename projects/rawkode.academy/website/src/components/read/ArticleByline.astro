---
import { academyDocument } from "@rawkodeacademy/design-system";
const doc = academyDocument();
import type { ContentEntry } from "@/lib/live-content";
import type { LocalTimeValue } from "@/lib/local-time";

interface Tag {
	label: string;
	href: string;
}

interface Props {
	authors: ContentEntry<"people">[];
	// Pass a `localTime(...)` value so the date follows the reader's zone.
	date: string | LocalTimeValue;
	updatedDate?: string | LocalTimeValue | undefined;
	readingTime?: string | undefined;
	tags?: Tag[];
}

const {
	authors,
	date,
	updatedDate,
	readingTime,
	tags = [],
} = Astro.props as Props;
---

<div class={doc.byline}>
	{authors.map((author) => (
		<a class={doc.author} href={`/people/${author.data.id}`}>
			{author.data.avatarUrl && <img class={doc.avatar} src={author.data.avatarUrl} alt="" width="40" height="40" loading="lazy" />}
			<span class={doc.authorMeta}>{author.data.name}</span>
		</a>
	))}
	{typeof date === "string"
		? <span class={doc.meta}>{date}</span>
		: <time class={doc.meta} {...date.attrs}>{date.text}</time>}
	{updatedDate && (typeof updatedDate === "string"
		? <span class={doc.meta}>Updated {updatedDate}</span>
		: <span class={doc.meta}>Updated <time {...updatedDate.attrs}>{updatedDate.text}</time></span>)}
	{readingTime && <span class={doc.meta}>{readingTime}</span>}

	<span class={doc.spacer}></span>

	{tags.length > 0 && (
		<div class={doc.tagList}>
			{tags.map((t) => (
				<a class={doc.tag} href={t.href}>#{t.label}</a>
			))}
		</div>
	)}
</div>
