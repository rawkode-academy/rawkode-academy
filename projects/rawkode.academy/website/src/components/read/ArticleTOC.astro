---
import { academyDocument } from "@rawkodeacademy/design-system";
const doc = academyDocument();
import type { MarkdownHeading } from "astro";
import MLabel from "@/components/ui/MLabel.vue";
import type { SeriesEntry } from "@/lib/live-content";

interface Props {
	headings: MarkdownHeading[];
	maxDepth?: 2 | 3;
	/** The article's series; its parts are listed above the sections. */
	series?: SeriesEntry | undefined;
	currentId?: string;
}

const { headings, maxDepth = 2, series, currentId } = Astro.props as Props;

const parts = (series?.parts ?? []).map((part, index) => ({
	href: `/read/${part.id}`,
	title: part.data.title,
	number: String(index + 1).padStart(2, "0"),
	current: part.id === currentId,
}));
const partNumber = parts.findIndex((part) => part.current) + 1;

const sections = headings
	.filter((h) => h.depth >= 2 && h.depth <= maxDepth)
	.map((h) => ({
		slug: h.slug,
		text: h.text,
		depth: h.depth,
	}));
---

{(sections.length > 0 || series) && <aside class={doc.toc}>
	{series && <details class={doc.tocMobile}>
		<summary class={doc.tocSummary}>{series.data.title} · Part {partNumber} of {parts.length}</summary>
		<nav aria-label={`Series: ${series.data.title}`}>
			<ol>{parts.map((part) => <li><a class={doc.tocLink} href={part.href} aria-current={part.current ? "page" : undefined}><span class={doc.meta}>{part.number}</span> {part.title}</a></li>)}</ol>
			<a class={doc.tocLink} href={`/series/${series.id}`}>About this series <span aria-hidden="true">→</span></a>
		</nav>
	</details>}
	{sections.length > 0 && <details class={doc.tocMobile}>
		<summary class={doc.tocSummary}>On this page · {sections.length} sections</summary>
		<nav aria-label="On this page">
			{sections.map((section) => <a class={doc.tocLink} href={`#${section.slug}`} data-depth={section.depth} data-toc-slug={section.slug}>{section.text}</a>)}
		</nav>
	</details>}
	<div class={doc.tocDesktop}>
		{series && <MLabel><a class={doc.link} href={`/series/${series.id}`}>{series.data.title}</a></MLabel>}
		{series && <nav aria-label={`Series: ${series.data.title}`}>
			<ol>{parts.map((part) => <li><a class={doc.tocLink} href={part.href} aria-current={part.current ? "page" : undefined}><span class={doc.meta}>{part.number}</span> {part.title}</a></li>)}</ol>
		</nav>}
		{sections.length > 0 && <MLabel>On this page</MLabel>}
		{sections.length > 0 && <nav aria-label="On this page">
			{sections.map((section) => <a class={doc.tocLink} href={`#${section.slug}`} data-depth={section.depth} data-toc-slug={section.slug}>{section.text}</a>)}
		</nav>}
	</div>
</aside>}

<script>
	// Recompute reading position even when a fast scroll skips a whole heading.
	const links = document.querySelectorAll<HTMLAnchorElement>(
		"[data-toc-slug]",
	);
	const headingsBySlug = new Map<string, HTMLElement>();
	for (const link of links) {
		const slug = link.dataset.tocSlug;
		if (!slug) continue;
		const el = document.getElementById(slug);
		if (el) headingsBySlug.set(slug, el);
	}

	if (headingsBySlug.size > 0) {
		let framePending = false;
		let activeSlug: string | undefined;
		const update = () => {
			framePending = false;
			const readingLine = Math.min(160, window.innerHeight * 0.3);
			let current: string | undefined;
			for (const [slug, heading] of headingsBySlug) {
				if (heading.getBoundingClientRect().top <= readingLine) current = slug;
				else break;
			}
			if (current === activeSlug) return;
			activeSlug = current;
			for (const link of links) {
				if (link.dataset.tocSlug === current) {
					link.setAttribute("aria-current", "location");
				} else {
					link.removeAttribute("aria-current");
				}
			}
		};
		const scheduleUpdate = () => {
			if (framePending) return;
			framePending = true;
			window.requestAnimationFrame(update);
		};
		window.addEventListener("scroll", scheduleUpdate, { passive: true });
		window.addEventListener("resize", scheduleUpdate);
		window.addEventListener("load", scheduleUpdate, { once: true });
		update();
	}
</script>
