---
import { academyDocument } from "@rawkodeacademy/design-system";
const doc = academyDocument();
import type { MarkdownHeading } from "astro";
import MLabel from "@/components/ui/MLabel.vue";

interface Props {
	headings: MarkdownHeading[];
	tools?: string[];
}

const { headings, tools = [] } = Astro.props as Props;

const sections = headings
	.filter((h) => h.depth === 2)
	.map((h) => ({
		slug: h.slug,
		text: h.text,
	}));
---

<aside class={doc.toc}>
	<div class={doc.stack}>
		<MLabel>Contents</MLabel>
		<nav class={doc.stackSmall} aria-label="On this page">
			{sections.map((s) => (
				<a
					class={doc.tocLink}
					href={`#${s.slug}`}
					data-toc-slug={s.slug}
				>
					<span class={doc.tocText}>{s.text}</span>
				</a>
			))}
		</nav>

		{tools.length > 0 && (
			<div class={[doc.rule, doc.stackSmall].join(" ")}>
				<MLabel>Tools used</MLabel>
				<ul class={doc.list}>
					{tools.map((t) => (
						<li>
							<MLabel>{t}</MLabel>
						</li>
					))}
				</ul>
			</div>
		)}
	</div>
</aside>

<script>
	// Highlight the active section as the user scrolls.
	const links = document.querySelectorAll<HTMLAnchorElement>(
		"[data-toc-slug]",
	);
	const headingsBySlug = new Map<string, HTMLElement>();
	for (const link of links) {
		const slug = link.dataset.tocSlug;
		if (!slug) continue;
		const el = document.getElementById(slug);
		if (el) headingsBySlug.set(slug, el);
	}

	if (headingsBySlug.size > 0 && "IntersectionObserver" in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						const slug = entry.target.id;
						for (const link of links) {
							if (link.dataset.tocSlug === slug) {
								link.setAttribute("aria-current", "location");
							} else {
								link.removeAttribute("aria-current");
							}
						}
					}
				}
			},
			{ rootMargin: "0px 0px -70% 0px", threshold: 0 },
		);

		for (const el of headingsBySlug.values()) observer.observe(el);
	}
</script>
