---
import { academyDocument } from "@rawkodeacademy/design-system";
const doc = academyDocument();
import MLabel from "@/components/ui/MLabel.vue";

interface BreadcrumbItem {
	label: string;
	href?: string;
	current?: boolean;
}

interface Props {
	breadcrumbs?: BreadcrumbItem[];
	kicker: string;
	categoryTrail?: string | undefined;
	title: string;
	dek?: string | undefined;
	eyebrow?: string | undefined;
}

const {
	breadcrumbs = [],
	kicker,
	categoryTrail,
	title,
	dek,
	eyebrow,
} = Astro.props as Props;

const visibleBreadcrumbs = breadcrumbs.filter((item) => !item.current);
const eyebrowText =
	eyebrow ?? `${kicker}${categoryTrail ? ` · ${categoryTrail}` : ""}`;
---

{visibleBreadcrumbs.length > 0 && (
	<div class={doc.breadcrumb}>
		{visibleBreadcrumbs.map((b, i) => (
			<>
				{i > 0 && <span class={doc.meta}>/</span>}
				{b.href ? (
					<a class={doc.link} href={b.href}>{b.label}</a>
				) : (
					<span class={doc.meta}>{b.label}</span>
				)}
			</>
		))}
		<span class={doc.spacer}></span>
	</div>
)}

<header class={doc.hero}>
	<div class={[doc.container, doc.stack].join(" ")}>
		<MLabel tone="spruce">
			<span class={doc.dot} aria-hidden="true"></span>
			{eyebrowText}
		</MLabel>

		<h1 class={doc.title} set:html={title}></h1>

		{dek && <p class={doc.lede}>{dek}</p>}

		<slot />
	</div>
</header>
