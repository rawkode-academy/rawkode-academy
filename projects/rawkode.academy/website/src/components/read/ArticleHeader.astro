---
import { academyDocument } from "@rawkodeacademy/design-system";
const doc = academyDocument();
import Breadcrumb from "@/components/breadcrumb/Breadcrumb.astro";
import MLabel from "@/components/ui/MLabel.vue";

interface BreadcrumbItem {
	label: string;
	href?: string;
	current?: boolean;
}

interface Props {
	breadcrumbs?: BreadcrumbItem[];
	kicker: string;
	categoryTrail?: string | undefined;
	title: string;
	dek?: string | undefined;
	eyebrow?: string | undefined;
}

const {
	breadcrumbs = [],
	kicker,
	categoryTrail,
	title,
	dek,
	eyebrow,
} = Astro.props as Props;

// Parent links only: the title below is the current page.
const parents = breadcrumbs.flatMap((item) =>
	item.current || !item.href ? [] : [{ title: item.label, link: item.href }],
);
const eyebrowText =
	eyebrow ?? `${kicker}${categoryTrail ? ` · ${categoryTrail}` : ""}`;
---

<header class={doc.hero}>
	<div class={[doc.container, doc.stack].join(" ")}>
		<Breadcrumb parents={parents} />
		{eyebrowText && <MLabel tone="accent">
			{eyebrowText}
		</MLabel>}

		<h1 class={doc.title} set:html={title}></h1>

		{dek && <p class={doc.lede}>{dek}</p>}

		<slot />
	</div>
</header>
