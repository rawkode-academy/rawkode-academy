---
import { academyNavigation } from "@rawkodeacademy/design-system";
import BreadcrumbJsonLd from "./BreadcrumbJsonLd.astro";

interface Props { elements: { title: string; link: string }[]; }
const { elements } = Astro.props;
const visibleElements = elements.slice(0, -1);
const styles = academyNavigation();
---
<BreadcrumbJsonLd elements={elements} />
{visibleElements.length > 0 && <nav class={styles.breadcrumb} aria-label="Breadcrumb">
	<ol class={styles.trail}>
		{visibleElements.map((element, index) => <li>
			{index > 0 && <span class={styles.separator} aria-hidden="true">/</span>}
			<a class={styles.crumb} href={element.link}>{element.title}</a>
		</li>)}
	</ol>
</nav>}
