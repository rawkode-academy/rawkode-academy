---
import { academyCourse } from "@rawkodeacademy/design-system";
import { type CollectionEntry, getCollection } from "astro:content";
import { getCourseModuleSlug } from "@/utils/course-path";

type Props = {
	course: CollectionEntry<"courses">;
	modules?: CollectionEntry<"courseModules">[];
};

const { course, modules } = Astro.props;
const s = academyCourse();

const courseModules = (modules ?? (await getCollection("courseModules")))
	.filter((module) => module.data.course.id === course.id)
	.sort((a, b) => a.data.order - b.data.order);

const groupedModules = new Map<string, typeof courseModules>();
for (const module of courseModules) {
	const section = module.data.section ?? "Lessons";
	const group = groupedModules.get(section) ?? [];
	group.push(module);
	groupedModules.set(section, group);
}

const publishedOrderById = new Map(
	courseModules
		.filter((module) => !module.data.draft)
		.map((module, index) => [module.id, index + 1]),
);

function formatDuration(minutes: number): string {
	const hours = Math.floor(minutes / 60);
	const mins = minutes % 60;
	if (hours > 0 && mins > 0) return `${hours}h ${mins}m`;
	if (hours > 0) return `${hours}h`;
	return `${mins}m`;
}
---

{courseModules.length === 0 ? (
	<p class={s.emptyCurriculum}>No lessons have been added yet.</p>
) : (
	<div class={s.lessonGroups}>
		{Array.from(groupedModules, ([sectionName, sectionModules]) => (
			<section class={s.lessonGroup}>
				<header class={s.lessonHeader}>
					<h3 class={s.lessonTitle}>{sectionName}</h3>
					<span class={s.status}>
						{sectionModules.filter((module) => !module.data.draft).length} of {sectionModules.length} available
					</span>
				</header>
				<ol class={s.lessonList} role="list">
					{sectionModules.map((module) => {
						const isDraft = module.data.draft;
						const displayOrder = publishedOrderById.get(module.id);
						const moduleSlug = getCourseModuleSlug(course.id, module.id);
						const Element = isDraft ? "div" : "a";
						const elementProps = isDraft
							? { class: [s.lessonRow, s.unpublished].join(" ") }
							: {
								href: `/courses/${course.id}/${moduleSlug}`,
								class: [s.lessonRow, s.lessonLink].join(" "),
							};

						return (
							<li value={displayOrder}>
								<Element {...elementProps}>
									<span class={s.lessonIndex} aria-hidden="true">{displayOrder === undefined ? "—" : String(displayOrder).padStart(2, "0")}</span>
									<div class={s.lessonCopy}>
										<span class={s.lessonTitle}>{module.data.title}</span>
										<p class={s.lessonDescription}>{module.data.description}</p>
									</div>
									{(isDraft || (module.data.duration != null && module.data.duration > 0)) && (
										<span class={s.lessonMeta}>
											{isDraft ? "Not published" : formatDuration(module.data.duration!)}
										</span>
									)}
								</Element>
							</li>
						);
					})}
				</ol>
			</section>
		))}
	</div>
)}
