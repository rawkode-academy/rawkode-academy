---
import { academyForms } from "@rawkodeacademy/design-system";

const s = academyForms();
---

<div class:list={[s.root, s.panel]}>
	<p class={s.kicker}>Rawkode Academy newsletter</p>
	<h3 class={s.heading}>Get cloud native tutorials and news by email.</h3>
	<p class={s.copy}>Subscribe for tutorials, technical articles, and cloud native news.</p>
	<form class={s.form} action="https://email.rawkode.academy/subscribe" method="post">
		<label class={s.field}>
			<span class={s.label}>Email address</span>
			<input class={s.input} type="email" name="email" required autocomplete="email" placeholder="you@where-you.work" />
		</label>
		<button class={s.button} type="submit">Subscribe</button>
	</form>
</div>
