---
import { academyCatalog } from "@rawkodeacademy/design-system";
import type { ContentEntry } from "@/lib/live-content";
import { localTime } from "@/lib/local-time";

interface Props {
	story: ContentEntry<"news">;
}

const { story } = Astro.props;
const styles = academyCatalog();
// Calendar-day stories stay on their UTC day; timed stories follow the
// reader's time zone (see src/lib/local-time.ts).
const day = localTime(story.data.publishedAt, { day: "2-digit" }, "en-GB");
const month = localTime(
	story.data.publishedAt,
	{ month: "short", year: "numeric" },
	"en-GB",
);
---

<a class={styles.editorialRow} href={`/news/${story.id}`} data-media="false">
	<time class={styles.editorialDate} datetime={story.data.publishedAt.toISOString()}><strong data-datetime={day.iso} data-local-time={day.attrs["data-local-time"]}>{day.text}</strong><span data-datetime={month.iso} data-local-time={month.attrs["data-local-time"]}>{month.text}</span></time>
	<div class={styles.editorialBody} data-body>
		<h3 class={styles.editorialTitle}>{story.data.title}</h3>
		<p class={styles.editorialDescription}>{story.data.description}</p>
	</div>
</a>
