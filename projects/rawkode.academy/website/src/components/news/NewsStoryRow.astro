---
import type { CollectionEntry } from "astro:content";
import { academyCatalog } from "@rawkodeacademy/design-system";

interface Props {
	story: CollectionEntry<"news">;
}

const { story } = Astro.props;
const styles = academyCatalog();
const date = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<a class={styles.editorialRow} href={`/news/${story.id}`} data-media="true">
	<time class={styles.editorialDate} datetime={story.data.publishedAt.toISOString()}>{date.format(story.data.publishedAt)}</time>
	<span class={styles.editorialMedia}><img class={styles.editorialImage} src="/images/news/news-generic.svg" alt="" width="1200" height="675" loading="lazy" /></span>
	<div class={styles.editorialBody}>
		<h3 class={styles.editorialTitle}>{story.data.title}</h3>
		<p class={styles.editorialDescription}>{story.data.description}</p>
	</div>
</a>
