---
import { type CollectionEntry, getCollection } from "@/lib/payload-content";
import { academyCatalog, academyLayout } from "@rawkodeacademy/design-system";
import NewsStoryRow from "@/components/news/NewsStoryRow.astro";
import { selectRelatedNews } from "@/lib/related-news";

interface Props {
	currentStory: CollectionEntry<"news">;
	limit?: number;
}

const { currentStory, limit = 3 } = Astro.props;
const layout = academyLayout({ width: "wide" });
const candidates = await getCollection("news");
const related = selectRelatedNews<CollectionEntry<"news">>(
	currentStory.id,
	currentStory.data.technologies,
	candidates,
	limit,
);
const catalog = academyCatalog();
---

{related.length > 0 && (
	<section>
		<div class={layout.sectionHeader}><h2 class={layout.sectionTitle}>More stories</h2></div>
		<div class={catalog.editorialList}>
			{related.map((story) => <NewsStoryRow story={story} />)}
		</div>
	</section>
)}
