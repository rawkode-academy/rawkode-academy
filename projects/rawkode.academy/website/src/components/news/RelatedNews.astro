---
import { academyCatalog, academyLayout } from "@rawkodeacademy/design-system";
import NewsStoryRow from "@/components/news/NewsStoryRow.astro";
import type { ContentEntry } from "@/lib/live-content";
import { selectRelatedNews } from "@/lib/related-news";

interface Props {
	currentStory: ContentEntry<"news">;
	// The page fetches the candidates and lists "news" in setContentCache, so
	// this component loads no content of its own.
	stories: ReadonlyArray<ContentEntry<"news">>;
	limit?: number;
}

const { currentStory, stories, limit = 3 } = Astro.props;
const layout = academyLayout({ width: "wide" });
const related = selectRelatedNews(currentStory.id, currentStory.data.technologies ?? [], stories, limit);
const catalog = academyCatalog();
---

{related.length > 0 && (
	<section>
		<div class={layout.sectionHeader}><h2 class={layout.sectionTitle}>More stories</h2></div>
		<div class={catalog.editorialList}>
			{related.map((story) => <NewsStoryRow story={story} />)}
		</div>
	</section>
)}
