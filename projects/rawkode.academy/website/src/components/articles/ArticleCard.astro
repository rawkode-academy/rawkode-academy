---
import { Image } from "astro:assets";
import { type CollectionEntry, getEntries } from "astro:content";
import BaseCard from "../common/BaseCard.vue";
import { calculateReadingTime } from "@/utils/reading-time";
import { getTypeBadgeConfig } from "@/utils/article-types";
import { academyDocument } from "@rawkodeacademy/design-system";

type Props = {
	article: CollectionEntry<"articles">;
	headingLevel?: 2 | 3;
};

const { article, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h2";
const doc = academyDocument();
const authors = await getEntries(article.data.authors);
const readingTime = calculateReadingTime(article.body || "");

const articleType = article.data.type || "tutorial";
const badgeConfig = getTypeBadgeConfig(articleType);

const formattedDate = new Intl.DateTimeFormat("en-US", {
	year: "numeric",
	month: "short",
	day: "numeric",
}).format(article.data.publishedAt);
---

<BaseCard
	href={`/read/${article.id}`}
	aria-label={article.data.title}
	showCover={Boolean(article.data.cover)}
	showFooter={authors.length > 0}
>
	{article.data.cover && (
		<Fragment slot="cover">
			<Image
				src={article.data.cover.image}
				alt={article.data.cover.alt}
				loading="lazy"
			/>
		</Fragment>
	)}

	<Fragment slot="content">
		<div class:list={[doc.meta, "article-card__meta"]}>
			<span class="article-card__type">{badgeConfig.label}</span>
			<span aria-hidden="true">·</span>
			<time datetime={article.data.publishedAt.toISOString()}>{formattedDate}</time>
			{article.body?.trim() && <><span aria-hidden="true">·</span><span>{readingTime.text}</span></>}
		</div>

		<Heading class:list={[doc.cardTitle, "article-card__title"]}>{article.data.title}</Heading>

		{article.data.openGraph?.subtitle && (
			<p class:list={[doc.copy, "article-card__body"]}>{article.data.openGraph.subtitle}</p>
		)}
	</Fragment>

	{authors.length > 0 && <Fragment slot="footer">
		<p class={doc.meta}>{authors.map((author) => author.data.name).join(", ")}</p>
	</Fragment>}
</BaseCard>

<style>
	.article-card__meta {
		gap: 0.375rem;
		overflow-wrap: anywhere;
		margin-bottom: 0.875rem;
	}

	.article-card__type { color: var(--colors-academy-accent); }

	.article-card__title {
		font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
		line-height: 1.3;
		overflow-wrap: anywhere;
		margin: 0 0 0.75rem;
	}

	.article-card__body {
		font-family: var(--fonts-academy-text), sans-serif;
		font-size: 0.9rem;
		overflow-wrap: anywhere;
		margin: 0 0 1rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
