---
import {
	type ContentEntry,
	getCollection,
	optionalContent,
} from "@/lib/live-content";
import ArticleCard from "./ArticleCard.astro";
import { academyRelatedContent } from "@rawkodeacademy/design-system";

interface Props {
	currentArticle: ContentEntry<"articles">;
	/**
	 * Candidate pool. Pages pass the articles they already fetched (and hand
	 * them to setContentCache); without it the component fetches the list.
	 */
	articles?: ReadonlyArray<ContentEntry<"articles">> | undefined;
	limit?: number;
}

const { currentArticle, articles, limit = 3 } = Astro.props;
const styles = academyRelatedContent();

// Related reading is optional: if the content layer is unavailable the
// section is left out rather than failing the article page.
const allArticles: ReadonlyArray<ContentEntry<"articles">> =
	articles ?? (await optionalContent(getCollection("articles"), []));

// Most recent articles, excluding the current one (articles have no series).
const finalRelatedArticles = allArticles
	.filter((article) => article.id !== currentArticle.id)
	.sort(
		(a, b) =>
			new Date(b.data.publishedAt).getTime() -
			new Date(a.data.publishedAt).getTime(),
	)
	.slice(0, Math.max(0, limit));
---

{finalRelatedArticles.length > 0 && (
	<section class:list={[styles.section, styles.related]}>
		<h2 class={styles.heading}>
			Related Articles
		</h2>
		<div class={styles.grid}>
			{finalRelatedArticles.map((article) => (
				<ArticleCard article={article} headingLevel={3} />
			))}
		</div>
	</section>
)}
