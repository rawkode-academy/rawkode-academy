---
import { academyDiagram } from "@rawkodeacademy/design-system";

interface Props {
	id: string;
	title: string;
	description: string;
}

const { id, title, description } = Astro.props;
const styles = academyDiagram();
---

<figure class={styles.root} aria-labelledby={`${id}-caption`}>
	<figcaption class={styles.caption} id={`${id}-caption`}>{title}</figcaption>
	<label class={styles.toggle}>
		<input type="checkbox" data-diagram-toggle aria-controls={`${id}-viewport`} />
		Enlarge diagram
	</label>
	<div
		id={`${id}-viewport`}
		class={styles.viewport}
		data-diagram-viewport
		role="region"
		aria-label={`${title} — scroll to explore when enlarged`}
		tabindex="0"
	>
		<div class={styles.image} data-diagram-image role="img" aria-label={title} aria-describedby={`${id}-description`}>
			<slot />
		</div>
	</div>
	<div class={styles.description} id={`${id}-description`}>{description}</div>
</figure>

<script>
	for (const toggle of document.querySelectorAll<HTMLInputElement>("[data-diagram-toggle]")) {
		toggle.addEventListener("change", () => {
			const viewport = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
			if (!viewport) return;
			viewport.scrollTo({
				left: toggle.checked ? Math.max(0, (viewport.scrollWidth - viewport.clientWidth) / 2) : 0,
				top: 0,
				behavior: "instant",
			});
		});
	}
</script>
