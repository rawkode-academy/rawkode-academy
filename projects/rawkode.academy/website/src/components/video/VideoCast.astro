---
import type { ContentEntry } from "@/lib/live-content";
import { academyWatch } from "@rawkodeacademy/design-system";

interface Props {
	hosts: ContentEntry<"people">[];
	guests: ContentEntry<"people">[];
}

const { hosts, guests } = Astro.props;
const speakers = [
	...hosts.map((person) => ({ person, role: "Host" })),
	...guests.map((person) => ({ person, role: "Guest" })),
];
const initials = (name: string) => name.trim().split(/\s+/u).slice(0, 2)
	.map((part) => Array.from(part)[0] ?? "").join("").toLocaleUpperCase();
const watch = academyWatch();
---

{speakers.length > 0 && (
	<section class={watch.cast} aria-labelledby="watch-detail-cast-heading">
		<h2 id="watch-detail-cast-heading" class={watch.railHeading}>Cast</h2>
		<ul class={watch.castGrid}>
			{speakers.map(({ person, role }) => (
				<li>
					<a href={`/people/${person.data.id}`} class={watch.castCard}>
						{person.data.avatarUrl && <img
							src={person.data.avatarUrl}
							alt=""
							class={watch.castAvatar}
							width="48"
							height="48"
							loading="lazy"
							decoding="async"
							onerror="this.hidden=true; this.nextElementSibling.hidden=false;"
						/>}
						<span
							class:list={[watch.castAvatar, watch.castInitials]}
							hidden={Boolean(person.data.avatarUrl)}
							aria-hidden="true"
						>{initials(person.data.name)}</span>
						<div class={watch.castBody}>
							<h3 class={watch.castName}>{person.data.name}</h3>
							<p class={watch.castMeta}>{role}{person.data.handles?.github && ` · @${person.data.handles.github}`}</p>
						</div>
					</a>
				</li>
			))}
		</ul>
	</section>
)}
