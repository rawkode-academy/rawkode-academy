---
import type { CollectionEntry } from "astro:content";
import { academyWatch } from "@rawkodeacademy/design-system";

interface Props {
	hosts: CollectionEntry<"people">[];
	guests: CollectionEntry<"people">[];
}

const { hosts, guests } = Astro.props;
const hasSpeakers = hosts.length > 0 || guests.length > 0;
const watch = academyWatch();
---

{hasSpeakers && (
	<section class={watch.cast}>
		<h2 class={watch.railTitle}>
			Meet the Cast
		</h2>
		<div class={watch.castGrid}>
			{hosts.map((person) => (
				<a
					href={`/people/${person.data.id}`}
					class={watch.castCard}
				>
					<div class={watch.castAvatarWrap}>
						<img
							src={person.data.avatarUrl || '/images/avatars/default.png'}
							alt={person.data.name}
							class={watch.castAvatar}
							width="48"
							height="48"
							loading="lazy"
							decoding="async"
						/>
						<span class={watch.castBadge}>
							HOST
						</span>
					</div>
					<div class={watch.commentContent}>
						<h3 class={watch.castName}>
							{person.data.name}
						</h3>
						<p class={watch.castMeta}>
							@{person.data.github ? person.data.github.split('/').pop() : person.data.id}
						</p>
					</div>
				</a>
			))}

			{guests.map((person) => (
				<a
					href={`/people/${person.data.id}`}
					class={watch.castCard}
				>
					<div class={watch.castAvatarWrap}>
						<img
							src={person.data.avatarUrl || '/images/avatars/default.png'}
							alt={person.data.name}
							class={watch.castAvatar}
							width="48"
							height="48"
							loading="lazy"
							decoding="async"
						/>
						<span class={watch.castBadge}>
							GUEST
						</span>
					</div>
					<div class={watch.commentContent}>
						<h3 class={watch.castName}>
							{person.data.name}
						</h3>
						<p class={watch.castMeta}>
							@{person.data.github ? person.data.github.split('/').pop() : person.data.id}
						</p>
					</div>
				</a>
			))}
		</div>
	</section>
)}
