---
import type { CollectionEntry } from "astro:content";
import { formatVideoRuntimeLabel } from "@/lib/video-runtime";
import { academyWatch } from "@rawkodeacademy/design-system";

interface Props {
	show: CollectionEntry<"shows">;
	videos: Array<{
		id: string;
		title: string;
		thumbnailUrl: string;
		slug: string;
		duration: number | undefined;
		publishedAt?: Date | string | undefined;
		type?: string | undefined;
	}>;
	totalVideos?: number;
}

const { show, videos, totalVideos } = Astro.props;

const hasMoreVideos =
	typeof totalVideos === "number" && totalVideos > videos.length;
const watch = academyWatch();
---

{videos.length > 0 && (
	<section class={watch.rail}>
		<div class={watch.railHeader}>
			<h2 class={watch.railTitle}>
				More from {show.data.name}
			</h2>
			<a
				href={`/shows/${show.id}`}
				class={watch.railLink}
			>
				{hasMoreVideos ? `View all ${totalVideos} episodes` : "View show"}
				<svg
					class={watch.railIcon}
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M9 5l7 7-7 7"
					/>
				</svg>
			</a>
		</div>

		<div class={watch.railGrid}>
			{videos.map((video) => (
				<a
					href={`/watch/${video.slug}`}
					class={watch.railCard}
				>
					<div class={watch.railMedia}>
						<img
							src={video.thumbnailUrl}
							alt=""
							class={watch.railImage}
							width="1280"
							height="720"
							loading="lazy"
							decoding="async"
						/>
						<div class={watch.railRuntime}>
							{formatVideoRuntimeLabel(video)}
						</div>
					</div>
					<div class={watch.railCardBody}>
						<h3 class={watch.railCardTitle}>
							{video.title}
						</h3>
					</div>
				</a>
			))}
		</div>
	</section>
)}
