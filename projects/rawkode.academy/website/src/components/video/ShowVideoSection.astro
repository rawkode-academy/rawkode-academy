---
import type { ContentEntry } from "@/lib/live-content";
import { academyPage, academyWatch } from "@rawkodeacademy/design-system";
import VideoCard from "./VideoCard.astro";

interface Props {
	show: ContentEntry<"shows">;
	videos: Array<{
		id: string;
		title: string;
		thumbnailUrl: string;
		slug: string;
		duration: number | undefined;
		publishedAt?: Date | string | undefined;
		type?: string | undefined;
	}>;
	totalVideos?: number;
}

const { show, videos, totalVideos } = Astro.props;

const hasMoreVideos =
	typeof totalVideos === "number" && totalVideos > videos.length;
const watch = academyWatch();
const page = academyPage();
---

{videos.length > 0 && (
	<section class={watch.rail}>
		<div class={watch.railHeader}>
			<h2 class={watch.railTitle}>
				More from {show.data.name}
			</h2>
			<a href={`/shows/${show.id}`} class={page.textLink}>
				{hasMoreVideos ? `All ${totalVideos} episodes` : "View the show"} <span aria-hidden="true">→</span>
			</a>
		</div>

		<div class={page.feedGrid}>
			{videos.map((video) => (
				<VideoCard
					href={`/watch/${video.slug}`}
					title={video.title}
					thumbnailUrl={video.thumbnailUrl}
					duration={video.duration}
					publishedAt={video.publishedAt}
					type={video.type}
				/>
			))}
		</div>
	</section>
)}
