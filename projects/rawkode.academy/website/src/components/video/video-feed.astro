---
import VideoProgressBar from "@/components/video/VideoProgressBar.vue";
import { getVideoThumbnailUrl } from "@/lib/video-thumbnail";
import { formatVideoRuntimeLabel } from "@/lib/video-runtime";
import { academyDocument } from "@rawkodeacademy/design-system";

const doc = academyDocument();

interface Video {
	id: string;
	title: string;
	thumbnailUrl: string;
	duration: number;
	slug: string;
	publishedAt: string;
	streamUrl: string;
	type?: string | undefined;
}

interface Props {
	title: string;
	description: string;
	videos?: Video[];
	watchPositions?: Record<string, number>;
	isAuthenticated?: boolean;
}

const {
	title,
	description,
	videos: passedVideos = [],
	watchPositions = {},
	isAuthenticated = false,
} = Astro.props;

const videos = passedVideos.map((v) => ({
	id: v.id,
	title: v.title,
	slug: v.slug,
	publishedAt: v.publishedAt,
	thumbnailUrl: v.thumbnailUrl || getVideoThumbnailUrl(v.id),
	streamUrl:
		v.streamUrl || `https://content.rawkode.academy/videos/${v.id}/stream.m3u8`,
	duration: v.duration ?? 0,
	type: v.type,
	runtimeLabel: formatVideoRuntimeLabel(v),
}));

function formatDate(dateString: string) {
	return new Date(dateString).toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}

function calculateProgress(videoId: string, duration: number): number | null {
	const positionSeconds = watchPositions[videoId];
	if (!positionSeconds || duration <= 0) {
		return null;
	}
	const progress = (positionSeconds / duration) * 100;
	return Math.min(progress, 100);
}
---

<section class="vfeed">
	{(title.trim() || description.trim()) && <header class="vfeed__head">
		{title.trim() && <h2 class:list={[doc.sectionTitle, "vfeed__title"]}>{title}</h2>}
		{description.trim() && <p class:list={[doc.copy, "vfeed__body"]}>{description}</p>}
	</header>}

	<div class="vfeed__grid">
		{videos.map((video) => (
			<a href={`/watch/${video.slug}`} class="vfeed__item focus-ring">
				<div class="vfeed__thumb">
					<img src={video.thumbnailUrl} alt={video.title} class="vfeed__img" width="1280" height="720" loading="lazy" decoding="async" />
					{(() => {
						if (!isAuthenticated) return null;
						const progress = calculateProgress(video.id, video.duration);
						return progress !== null ? (
							<VideoProgressBar progress={progress} overlay={true} client:visible />
						) : null;
					})()}
					{video.runtimeLabel !== "--:--" && <div class="vfeed__runtime">{video.runtimeLabel}</div>}
				</div>
				<div class="vfeed__body-wrap">
					<div class:list={[doc.meta, "vfeed__meta"]}>
						<time datetime={video.publishedAt}>{formatDate(video.publishedAt)}</time>
					</div>
					<h3 class:list={[doc.cardTitle, "vfeed__item-title"]}>{video.title}</h3>
				</div>
			</a>
		))}
	</div>
</section>

<style>
	.vfeed {
		padding: clamp(1.5rem, 4vw, 3rem) 0;
		min-width: 0;
		font-family: var(--fonts-academy-text), sans-serif;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.vfeed__head {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--colors-academy-border);
	}

	.vfeed__title {
		font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
		line-height: 1.2;
		overflow-wrap: anywhere;
	}

	.vfeed__body {
		font-size: 1rem;
		line-height: 1.55;
		max-width: 40rem;
		margin: 0;
	}

	.vfeed__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: 2rem 1.5rem;
	}

	.vfeed__item {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		text-decoration: none;
		color: var(--colors-academy-text);
		position: relative;
	}

	.vfeed__item:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 4px;
	}

	.vfeed__thumb {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--colors-academy-ground);
		border: 1px solid var(--colors-academy-border);
		border-radius: var(--radii-academy-m);
		transition: border-color var(--duration-base) var(--ease-standard);
	}

	.vfeed__item:hover .vfeed__thumb { border-color: var(--colors-academy-accent); }

	.vfeed__img { width: 100%; height: 100%; object-fit: cover; display: block; }

	.vfeed__runtime {
		position: absolute;
		bottom: 0.5rem;
		right: 0.5rem;
		padding: 0.2rem 0.5rem;
		font-family: var(--fonts-academy-mono), monospace;
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.5;
		background: var(--colors-academy-text);
		color: var(--colors-academy-canvas);
		border-radius: var(--radii-academy-s);
	}

	.vfeed__body-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.vfeed__meta {
		overflow-wrap: anywhere;
	}

	.vfeed__item-title {
		font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	@media (prefers-reduced-motion: reduce) {
		.vfeed__thumb { transition: none; }
	}
</style>
