---
import VideoCard from "@/components/video/VideoCard.astro";
import VideoProgressBar from "@/components/video/VideoProgressBar.vue";
import { getVideoThumbnailUrl } from "@/lib/video-thumbnail";
import { academyDocument, academyPage } from "@rawkodeacademy/design-system";

const doc = academyDocument();
const page = academyPage();

interface Video {
	id: string;
	title: string;
	thumbnailUrl: string;
	duration: number;
	slug: string;
	publishedAt: string;
	streamUrl: string;
	type?: string | undefined;
}

interface Props {
	title: string;
	description: string;
	videos?: Video[];
	watchPositions?: Record<string, number>;
	isAuthenticated?: boolean;
}

const {
	title,
	description,
	videos = [],
	watchPositions = {},
	isAuthenticated = false,
} = Astro.props;

function watchProgress(video: Video): number | null {
	if (!isAuthenticated) return null;
	const positionSeconds = watchPositions[video.id];
	if (!positionSeconds || !(video.duration > 0)) return null;
	return Math.min((positionSeconds / video.duration) * 100, 100);
}
---

<section class="vfeed">
	{(title.trim() || description.trim()) && <header class="vfeed__head">
		{title.trim() && <h2 class:list={[doc.sectionTitle, "vfeed__title"]}>{title}</h2>}
		{description.trim() && <p class:list={[doc.copy, "vfeed__body"]}>{description}</p>}
	</header>}

	<div class={page.feedGrid}>
		{videos.map((video) => {
			const progress = watchProgress(video);
			return (
				<VideoCard
					href={`/watch/${video.slug}`}
					title={video.title}
					thumbnailUrl={video.thumbnailUrl || getVideoThumbnailUrl(video.id)}
					duration={video.duration}
					publishedAt={video.publishedAt}
					type={video.type}
				>
					{progress !== null && (
						<VideoProgressBar slot="progress" progress={progress} overlay={true} client:visible />
					)}
				</VideoCard>
			);
		})}
	</div>
</section>

<style>
	.vfeed {
		padding: clamp(1.5rem, 4vw, 3rem) 0;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.vfeed__head {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--colors-academy-border);
	}

	.vfeed__title {
		font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
		line-height: 1.2;
		overflow-wrap: anywhere;
	}

	.vfeed__body {
		font-size: 1rem;
		line-height: 1.55;
		max-width: 40rem;
		margin: 0;
	}
</style>
