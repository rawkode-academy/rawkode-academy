---
import type { ContentEntry } from "@/lib/live-content";
import { academyWatch } from "@rawkodeacademy/design-system";
import { formatRuntimeLabel } from "@/lib/video-runtime";

interface Props {
	technology: ContentEntry<"technologies">;
	videos: Array<{
		id: string;
		title: string;
		thumbnailUrl: string;
		slug: string;
		duration: number | undefined;
		publishedAt?: Date | string | undefined;
		type?: string | undefined;
	}>;
	totalVideos?: number;
}

const { technology, videos, totalVideos } = Astro.props;

// Technology ids carry no "/index" in the live content layer.
const techId = technology.id;
const techName = technology.data.name;

const hasMoreVideos = totalVideos && totalVideos > videos.length;
const watch = academyWatch();
// The ink pane has room for three; the show or technology page has the rest.
const UP_NEXT_LIMIT = 3;
---

{videos.length > 0 && (
	<section class={watch.extrasBlock}>
		<div class={watch.inkHeader}>
			<h2 class={watch.inkHeading}>More about {techName}</h2>
			<a href={`/technology/${techId}`} class={watch.inkLink}>
				{hasMoreVideos ? `All ${totalVideos} videos` : `About ${techName}`} <span aria-hidden="true">→</span>
			</a>
		</div>
		<ul class={watch.upNextList}>
			{videos.slice(0, UP_NEXT_LIMIT).map((video) => (
				<li>
					<a href={`/watch/${video.slug}`} class={watch.upNextLink} data-up-next-link>
						<span class={watch.upNextStill} data-still>
							<img src={video.thumbnailUrl} alt="" class={watch.upNextImage} width="320" height="180" loading="lazy" decoding="async" />
						</span>
						<span class={watch.upNextBody}>
							{formatRuntimeLabel(video) && <span class={watch.upNextMeta}>{formatRuntimeLabel(video)}</span>}
							<h3 class={watch.upNextTitle} data-title>{video.title}</h3>
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
)}
