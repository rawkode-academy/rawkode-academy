---
import type { CollectionEntry } from "astro:content";
import { formatVideoRuntimeLabel } from "@/lib/video-runtime";
import { resolveTechnologyIconUrl } from "@/utils/resolve-technology-icon";
import { academyWatch } from "@rawkodeacademy/design-system";

interface Props {
	technology: CollectionEntry<"technologies">;
	videos: Array<{
		id: string;
		title: string;
		thumbnailUrl: string;
		slug: string;
		duration: number | undefined;
		publishedAt?: Date | string | undefined;
		type?: string | undefined;
	}>;
	totalVideos?: number;
}

const { technology, videos, totalVideos } = Astro.props;

const techId = technology.id.replace(/\/index$/, "");
const techName = technology.data.name;
const iconUrl = resolveTechnologyIconUrl(technology.id, technology.data.logos);

const hasMoreVideos = totalVideos && totalVideos > videos.length;
const watch = academyWatch();
---

{videos.length > 0 && (
	<section class={watch.rail}>
		<div class={watch.railHeader}>
			<div class={watch.commentRow}>
				{iconUrl && (
					<div class={watch.techIcon}>
						<img
							src={iconUrl}
							alt=""
							width="24"
							height="24"
							loading="lazy"
							decoding="async"
							onerror="this.parentElement.hidden=true"
						/>
					</div>
				)}
				<h2 class={watch.railTitle}>
					More about {techName}
				</h2>
			</div>
			<a
				href={`/technology/${techId}`}
				class={watch.railLink}
			>
				{hasMoreVideos ? `View all ${totalVideos} videos` : "View technology"}
				<svg class={watch.railIcon} fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
				</svg>
			</a>
		</div>

		<div class={watch.railGrid}>
			{videos.map((video) => (
				<a
					href={`/watch/${video.slug}`}
					class={watch.railCard}
				>
					<div class={watch.railMedia}>
						<img
							src={video.thumbnailUrl}
							alt=""
							class={watch.railImage}
							width="1280"
							height="720"
							loading="lazy"
							decoding="async"
						/>
						<div class={watch.railRuntime}>
							{formatVideoRuntimeLabel(video)}
						</div>
					</div>
					<div class={watch.railCardBody}>
						<h3 class={watch.railCardTitle}>
							{video.title}
						</h3>
					</div>
				</a>
			))}
		</div>
	</section>
)}
