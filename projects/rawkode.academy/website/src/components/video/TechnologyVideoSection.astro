---
import type { ContentEntry } from "@/lib/live-content";
import { academyPage, academyWatch } from "@rawkodeacademy/design-system";
import VideoCard from "./VideoCard.astro";

interface Props {
	technology: ContentEntry<"technologies">;
	videos: Array<{
		id: string;
		title: string;
		thumbnailUrl: string;
		slug: string;
		duration: number | undefined;
		publishedAt?: Date | string | undefined;
		type?: string | undefined;
	}>;
	totalVideos?: number;
}

const { technology, videos, totalVideos } = Astro.props;

// Technology ids carry no "/index" in the live content layer.
const techId = technology.id;
const techName = technology.data.name;

const hasMoreVideos = totalVideos && totalVideos > videos.length;
const watch = academyWatch();
const page = academyPage();
---

{videos.length > 0 && (
	<section class={watch.rail}>
		<div class={watch.railHeader}>
			<h2 class={watch.railTitle}>
				More about {techName}
			</h2>
			<a href={`/technology/${techId}`} class={page.textLink}>
				{hasMoreVideos ? `All ${totalVideos} videos` : `About ${techName}`} <span aria-hidden="true">→</span>
			</a>
		</div>

		<div class={page.feedGrid}>
			{videos.map((video) => (
				<VideoCard
					href={`/watch/${video.slug}`}
					title={video.title}
					thumbnailUrl={video.thumbnailUrl}
					duration={video.duration}
					publishedAt={video.publishedAt}
					type={video.type}
				/>
			))}
		</div>
	</section>
)}
