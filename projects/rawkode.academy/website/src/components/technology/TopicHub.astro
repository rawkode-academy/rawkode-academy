---
import { getCollection } from "astro:content";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import { academyRelatedContent } from "@rawkodeacademy/design-system";
import { isNewsPublished } from "@/lib/news-publication";

export interface Props {
	technologyId: string;
	technologyName: string;
	videos: Array<{
		id: string;
		title: string;
		thumbnailUrl: string;
		slug: string;
	}>;
	showArticles?: boolean;
	showVideos?: boolean;
	showNews?: boolean;
	showLearningPaths?: boolean;
	newsLimit?: number;
	learningPathLimit?: number;
}

const {
	technologyId,
	technologyName,
	videos = [],
	showArticles = true,
	showVideos = true,
	showNews = true,
	showLearningPaths = true,
	newsLimit = 6,
	learningPathLimit = 6,
} = Astro.props;
const s = academyRelatedContent();

// Technology IDs from the collection look like "kubernetes/index"; raw IDs
// (as used in news/article frontmatter) drop the suffix. Match both forms.
const normalizedTechnologyId = technologyId.replace(/\/index$/, "");
const matchesTechnology = (technologies: ReadonlyArray<string | { id: string }> | undefined) =>
	Array.isArray(technologies) && technologies.some(reference => {
		const id = typeof reference === "string" ? reference : reference.id;
		return id.replace(/\/index$/, "") === normalizedTechnologyId;
	});

// Get all articles that mention this technology
const now = new Date();
const allArticles = await getCollection("articles", ({ data }) => {
	return data.publishedAt <= now && matchesTechnology(data.technologies);
});

// Sort articles by date
const articles = allArticles.sort(
	(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

// Get news matching this technology
const allNews = showNews
	? (await getCollection("news"))
			.filter((story) => isNewsPublished(story.data.publishedAt, now) && matchesTechnology(story.data.technologies))
			.sort(
				(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
			)
			.slice(0, newsLimit)
	: [];

const learningPaths = showLearningPaths
	? (await getCollection("learningPaths"))
			.filter((path) => path.data.publishedAt <= now && matchesTechnology(path.data.technologies))
			.sort(
				(a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
			)
			.slice(0, learningPathLimit)
	: [];

const hasArticles = showArticles && articles.length > 0;
const hasVideos = showVideos && videos.length > 0;
const hasNews = showNews && allNews.length > 0;
const hasLearningPaths = showLearningPaths && learningPaths.length > 0;
const isEmpty = !hasArticles && !hasVideos && !hasNews && !hasLearningPaths;

const newsDateFormatter = new Intl.DateTimeFormat("en-US", {
	month: "short",
	day: "numeric",
	year: "numeric",
});

const difficultyLabel: Record<string, string> = {
	beginner: "Beginner",
	intermediate: "Intermediate",
	advanced: "Advanced",
};
function formatLearningPathDuration(minutes: number): string {
	if (!Number.isFinite(minutes) || minutes <= 0) return "";
	const h = Math.floor(minutes / 60);
	const m = minutes % 60;
	if (!h) return `${m}m`;
	if (!m) return `${h}h`;
	return `${h}h ${m}m`;
}
---

<div class={s.root}>
	{hasLearningPaths && (
		<section class={s.section}>
			<h2 class={s.heading}>{technologyName} learning paths</h2>
			<div class={s.pathGrid}>
				{learningPaths.map((path) => (
					<a href={`/learning-paths/${path.id}`} class:list={[s.card, s.path]}>
						<div class={s.metadata}>
							<span>{difficultyLabel[path.data.difficulty] ?? path.data.difficulty}</span>
							{formatLearningPathDuration(path.data.estimatedDuration) && (
								<span>{formatLearningPathDuration(path.data.estimatedDuration)}</span>
							)}
						</div>
						<h3 class={s.title}>{path.data.title}</h3>
						<p class={s.copy}>{path.data.description}</p>
					</a>
				))}
			</div>
		</section>
	)}
	{hasNews && (
		<section class={s.section}>
			<h2 class={s.heading}>Recent {technologyName} news</h2>
			<ul class={s.newsList}>
				{allNews.map((story) => (
					<li class={s.newsItem}>
						<article>
							<time class={s.metadata} datetime={story.data.publishedAt.toISOString()}>
								{newsDateFormatter.format(story.data.publishedAt)}
							</time>
							<h3 class={s.title}>
								<a href={`/news/${story.id}`} class={s.link}>{story.data.title}</a>
							</h3>
							<p class={s.copy}>{story.data.description}</p>
						</article>
					</li>
				))}
			</ul>
		</section>
	)}
	{hasArticles && (
		<section class={s.section}>
			<h2 class={s.heading}>Articles about {technologyName}</h2>
			<div class={s.grid}>
				{articles.map((article) => <ArticleCard article={article} headingLevel={3} />)}
			</div>
		</section>
	)}
	{hasVideos && (
		<section class={s.section}>
			<h2 class={s.heading}>Videos about {technologyName}</h2>
			<div class={s.grid}>
				{videos.map((video) => (
					<a href={`/watch/${video.slug}`} class={s.card}>
						<div class={s.media}>
							<img src={video.thumbnailUrl} alt={video.title} class={s.image}
								width="1280" height="720" loading="lazy" decoding="async" />
						</div>
						<div class={s.body}><h3 class={s.title}>{video.title}</h3></div>
					</a>
				))}
			</div>
		</section>
	)}
	{isEmpty && <p class={s.empty}>No related content is available for {technologyName}.</p>}
</div>
