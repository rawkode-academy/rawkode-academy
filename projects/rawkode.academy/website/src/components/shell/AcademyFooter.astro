---
import { academyShell } from "@rawkodeacademy/design-system";
import AcademyBrand from "@/components/branding/AcademyBrand.astro";
import { navigationGroups } from "@/lib/navigation";
const styles = academyShell();
---

<footer class={styles.footer}>
	<div class={styles.footerInner}>
		<div class={styles.footerLead}>
			<AcademyBrand />
			<p class={styles.footerTagline}>Practical cloud native education. Real builds, real people, and every decision on screen.</p>
		</div>
		<nav id="academy-footer-navigation" class={styles.footerGroups} aria-label="Footer navigation" tabindex="-1">
			{navigationGroups.map((group) => (
				<div class={styles.footerGroup}>
					<h2 class={styles.footerTitle}>{group.label}</h2>
					{group.items.map((item) => <a class={styles.footerLink} href={item.href}>{item.label}</a>)}
				</div>
			))}
		</nav>
		<p class={styles.copyright}>© {new Date().getFullYear()} Rawkode Academy</p>
	</div>
</footer>
