---
export const prerender = false;

import { env } from "cloudflare:workers";
import NewsletterWidget from "./NewsletterWidget.vue";
import { createLearnerId } from "@/actions/newsletter";
import { academyMarketing } from "@rawkodeacademy/design-system";

interface Props {
	class?: string;
	badge?: string;
	headline?: string;
	subtitle?: string;
	audience?: string;
	pagePath?: string;
	variant?: "card" | "section";
}

const {
	class: className,
	badge = "Rawkode Academy newsletter",
	headline = "Academy publications by email",
	subtitle = "Get an email when Rawkode Academy publishes new tutorials, articles, and videos.",
	audience = "academy",
	pagePath = Astro.url.pathname,
	variant = "card",
} = Astro.props;

const user = Astro.locals.user;
let isSubscribed = false;
let preferencesUnavailable = Boolean(user);

if (user && import.meta.env.PROD) {
	try {
		const prefixedUserId = createLearnerId(user.id);
		const prefs = await env.EMAIL_PREFERENCES.getPreferences(
			prefixedUserId,
			"newsletter",
			audience,
		);
		isSubscribed = prefs.length > 0;
		preferencesUnavailable = false;
	} catch (e) {
		preferencesUnavailable = true;
		console.error("Failed to fetch preferences", e);
	}
}

const signInUrl = `/api/auth/sign-in?returnTo=${encodeURIComponent(pagePath)}`;

// Check for the newsletter subscription cookie (server-side)
const hasNewsletterCookie =
	Astro.cookies.get(`newsletter:${audience}:updates`)?.value === "true";

// For anonymous users with the cookie, hide the CTA entirely
const shouldHide = !user && hasNewsletterCookie;
const marketing = academyMarketing({ newsletterVariant: variant });
---

{!shouldHide && (
	<section class:list={[marketing.newsletter, className]}>
		<div
			class={marketing.newsletterSection}
		>

			<div class={marketing.newsletterGrid}>
				<div class={marketing.newsletterCopy}>
					<div class={marketing.newsletterBadge}>
						<span>{badge}</span>
					</div>
					<h2 class={marketing.newsletterTitle}>
						{headline}
					</h2>
					<p class={marketing.newsletterLead}>
						{subtitle}
					</p>
				</div>

				<div class={marketing.newsletterWidget}>
					<NewsletterWidget
						client:visible
						isSignedIn={!!user}
						isSubscribed={isSubscribed}
						preferencesUnavailable={preferencesUnavailable}
						signInUrl={signInUrl}
						pagePath={pagePath}
						audience={audience}
					/>
					<noscript>
						<p>Email signup requires JavaScript. You can <a href="/settings">manage email preferences in account settings</a>.</p>
					</noscript>
				</div>
			</div>
		</div>
	</section>
)}
