---
// Navy masthead for a release page: title, a mono line, the stage counts
// derived from the cards, and the three ways into the page.
import { academyDocument, academyLayout } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";
import type {
	KubeTrackReleaseEntry,
	KubeTrackStage,
} from "@/lib/kubetrack/types";
import { STAGE_ORDER, stageCounts, stageLabel } from "@/lib/kubetrack/version";
import StageBadge from "./StageBadge.astro";

interface Props {
	entry: KubeTrackReleaseEntry;
}

const { entry } = Astro.props;
const release = entry.data;
const counts = stageCounts(release.features);
const stages = STAGE_ORDER.filter((stage) => counts[stage] > 0);
const total = release.features.length;
const upstream = release.upstreamCounts;
const upstreamTotal = upstream
	? STAGE_ORDER.reduce((sum, stage) => sum + upstream[stage], 0)
	: undefined;
// Equal totals can still hide a different split, so compare stage by stage.
const countsDiffer =
	upstream !== undefined &&
	STAGE_ORDER.some((stage) => upstream[stage] !== counts[stage]);
const breakdown = (by: Record<KubeTrackStage, number>) =>
	STAGE_ORDER.filter((stage) => by[stage] > 0)
		.map((stage) => `${by[stage]} ${stageLabel(stage).toLowerCase()}`)
		.join(", ");
const released = new Intl.DateTimeFormat("en-GB", {
	day: "numeric",
	month: "short",
	year: "numeric",
	timeZone: "UTC",
}).format(release.releasedAt);
const metaLine = [
	release.codename,
	`released ${released}`,
	`${total} ${total === 1 ? "enhancement" : "enhancements"}`,
]
	.filter(Boolean)
	.join(" · ");

// "1.37" -> "1-37" so the ids are valid selectors.
const idSuffix = entry.id.replace(/[^a-z0-9]+/gi, "-");
const layout = academyLayout();
const doc = academyDocument();
---

<section
	class:list={[layout.masthead, "kubetrack-hero"]}
	aria-labelledby={`kubetrack-${idSuffix}-title`}
	data-kubetrack-hero
>
	<div class={layout.container}>
		<div class={layout.mastheadInner}>
			<div class={layout.mastheadCopy}>
				<h1
					class:list={[layout.mastheadTitle, "kubetrack-hero-title"]}
					id={`kubetrack-${idSuffix}-title`}
				>
					{release.title}
				</h1>
				<p class="kubetrack-hero-meta">
					<time datetime={release.releasedAt.toISOString()}>{metaLine}</time>
				</p>
				<p class={layout.mastheadDescription}>{release.summary}</p>
			</div>

			{stages.length > 0 && (
				<div class="kubetrack-hero-counts">
					<p class="kubetrack-hero-counts-label" id={`kubetrack-${idSuffix}-counts`}>
						Enhancements by stage
					</p>
					<ul class="kubetrack-hero-counts-list" aria-labelledby={`kubetrack-${idSuffix}-counts`}>
						{stages.map((stage) => (
							<li>
								<StageBadge stage={stage} count={counts[stage]} tone="ink" />
							</li>
						))}
					</ul>
					{countsDiffer && upstream && (
						<p class="kubetrack-hero-note">
							The release blog counts {upstreamTotal} enhancements
							({breakdown(upstream)}); these cards cover {total} ({breakdown(counts)}).
						</p>
					)}
				</div>
			)}

			<div class={doc.actions}>
				<a class={doc.button} href="#cards">
					Start flip book
				</a>
				<a class:list={[doc.buttonSecondary, "kubetrack-hero-secondary"]} href="#quiz">
					Skip to quiz
				</a>
				{release.releaseBlogUrl && (
					<a
						class="kubetrack-hero-link"
						href={release.releaseBlogUrl}
						rel="noopener"
						target="_blank"
					>
						Read the release blog<span class="kubetrack-hero-external"> (opens in a new tab)</span>
					</a>
				)}
			</div>
		</div>
	</div>
</section>

<style>
	.kubetrack-hero-title {
		font-size: var(--font-sizes-academy-title);
	}
	.kubetrack-hero-meta {
		margin: 0;
		color: var(--colors-academy-ink-text-soft);
		font-family: var(--fonts-academy-mono);
		font-size: var(--font-sizes-sm);
	}
	.kubetrack-hero-counts {
		display: grid;
		gap: var(--spacing-2);
	}
	.kubetrack-hero-counts-label,
	.kubetrack-hero-note {
		margin: 0;
		color: var(--colors-academy-ink-text-muted);
		font-family: var(--fonts-academy-mono);
		font-size: var(--font-sizes-xs);
	}
	.kubetrack-hero-counts-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2) var(--spacing-5);
		margin: 0;
		padding-block: var(--spacing-3);
		padding-inline: 0;
		list-style: none;
		border-block: var(--borders-hairline);
		border-color: var(--colors-academy-ink-border);
	}
	.kubetrack-hero-secondary {
		background: transparent;
		color: var(--colors-academy-ink-text);
		border-color: var(--colors-academy-ink-border);
	}
	.kubetrack-hero-link {
		display: inline-flex;
		align-items: center;
		min-height: var(--spacing-11);
		color: var(--colors-academy-ink-text);
		text-underline-offset: 0.2em;
	}
	.kubetrack-hero-link:hover {
		color: var(--colors-academy-ink-accent);
	}
	.kubetrack-hero-link:focus-visible,
	.kubetrack-hero-secondary:focus-visible {
		outline: var(--borders-focus);
		outline-color: var(--colors-academy-ink-accent);
		outline-offset: 2px;
	}
	.kubetrack-hero-external {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
