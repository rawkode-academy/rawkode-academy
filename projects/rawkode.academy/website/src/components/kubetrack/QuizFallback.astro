---
// The release quiz without JavaScript: every question as a list, with the
// answer and explanation behind a disclosure so readers can still test
// themselves. Rendered inside <noscript>, so it never shows beside the island.
import type { QuizQuestionProps } from "@/lib/kubetrack/view-model";
import StageBadge from "./StageBadge.astro";

interface Props {
	questions: QuizQuestionProps[];
}

const { questions } = Astro.props;

const hint = (question: QuizQuestionProps) => {
	if (question.kind === "true_false") return "True or false?";
	if (question.kind === "multiple")
		return `Choose ${question.answerIds.length} answers.`;
	return "Choose one answer.";
};
const answerText = (question: QuizQuestionProps) =>
	question.choices
		.filter((choice) => question.answerIds.includes(choice.id))
		.map((choice) => choice.text)
		.join("; ");
---

{
	questions.length > 0 && (
		<noscript>
			<div class="kt-fallback">
				<p class="kt-fallback-intro">
					Work through each question, then open it to check your answer.
				</p>
				<ol class="kt-fallback-list">
					{questions.map((question, index) => (
						<li class="kt-fallback-item">
							<p class="kt-fallback-meta">
								<span>
									Question {index + 1} of {questions.length}
								</span>
								{question.stage && <StageBadge stage={question.stage} />}
							</p>
							<div class="kt-fallback-prompt" set:html={question.promptHtml} />
							<p class="kt-fallback-hint">{hint(question)}</p>
							<ul class="kt-fallback-choices">
								{question.choices.map((choice) => (
									<li>{choice.text}</li>
								))}
							</ul>
							<details class="kt-fallback-answer">
								<summary>Show answer</summary>
								<p class="kt-fallback-correct">
									<span>
										{question.answerIds.length > 1 ? "Answers" : "Answer"}:
									</span>{" "}
									{answerText(question)}
								</p>
								<div
									class="kt-fallback-explanation"
									set:html={question.explanationHtml}
								/>
								{question.featureSlug && (
									<a class="kt-fallback-link" href={`#${question.featureSlug}`}>
										Review card <span aria-hidden="true">→</span>
									</a>
								)}
							</details>
						</li>
					))}
				</ol>
			</div>
		</noscript>
	)
}

<style>
	.kt-fallback {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 42.5rem;
		margin: 0 auto;
	}

	.kt-fallback-intro {
		margin: 0;
		color: var(--colors-academy-text-soft);
	}

	.kt-fallback-list {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.kt-fallback-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem 0;
		border-top: 1px solid var(--colors-academy-border);
	}

	.kt-fallback-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin: 0;
		font-family: var(--fonts-academy-mono);
		font-size: 0.8125rem;
		color: var(--colors-academy-text-muted);
	}

	.kt-fallback-prompt {
		font-family: var(--fonts-academy-display);
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--colors-academy-text);
	}

	.kt-fallback-prompt :global(p) {
		margin: 0;
	}

	.kt-fallback-hint {
		margin: 0;
		font-family: var(--fonts-academy-mono);
		font-size: 0.8125rem;
		color: var(--colors-academy-text-muted);
	}

	.kt-fallback-choices {
		margin: 0;
		padding-left: 1.25rem;
		color: var(--colors-academy-text);
	}

	.kt-fallback-answer {
		padding: 0.75rem 1rem;
		border: 1px solid var(--colors-academy-border);
		border-radius: 4px;
		background: var(--colors-academy-panel);
	}

	.kt-fallback-answer summary {
		min-height: 2.75rem;
		display: flex;
		align-items: center;
		font-weight: 600;
		cursor: pointer;
	}

	.kt-fallback-correct {
		margin: 0.5rem 0;
		font-weight: 600;
		color: var(--colors-academy-text);
	}

	.kt-fallback-explanation {
		line-height: 1.6;
		color: var(--colors-academy-text-soft);
	}

	.kt-fallback-explanation :global(p) {
		margin: 0;
	}

	.kt-fallback-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		min-height: 2.75rem;
		font-weight: 600;
		color: var(--colors-academy-text);
	}
</style>
