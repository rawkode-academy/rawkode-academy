---
import { PARTNERSHIP_EMAIL } from "@/lib/partnerships";
import { academyMarketing } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

/**
 * Plain-text contact fallback for the partnership pages.
 *
 * The primary CTAs are prefilled mailto: links, which fail silently on
 * machines without a configured mail handler. This panel keeps the
 * funnel open: a visible email address and the brief template, each
 * with a copy button.
 */

interface Props {
	/** Plain-text brief template (the mailto body, unencoded). */
	template: string;
	/** Suggested subject line, shown above the template. */
	subject: string;
}

const { template, subject } = Astro.props;
const marketing = academyMarketing();
---

<aside class:list={[marketing.contact, "contact-fallback"]} aria-label="Email details for copy and paste">
	<p class={marketing.eyebrow}>No mail client? Copy instead</p>

	<div class:list={[marketing.contactRow, "contact-fallback__row"]}>
		<code class="contact-fallback__email">{PARTNERSHIP_EMAIL}</code>
		<button
			type="button"
			class:list={[marketing.copyButton, "contact-fallback__copy"]}
			data-copy-text={PARTNERSHIP_EMAIL}
			data-copy-kind="Email address"
		>
			Copy email
		</button>
	</div>

	<p class="contact-fallback__label">
		Brief template <span class="contact-fallback__subject">subject: {subject}</span>
	</p>

	<pre class="contact-fallback__template">{template}</pre>
	<button
		type="button"
		class:list={[marketing.copyButton, "contact-fallback__copy"]}
		data-copy-text={template}
		data-copy-kind="Template"
	>
		Copy template
	</button>
	<p role="status" aria-live="polite" aria-atomic="true" class="sr-only" data-copy-status></p>
</aside>

<script>
	const copyWithFallback = async (text: string): Promise<boolean> => {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			// Clipboard API unavailable (insecure context, permissions):
			// select the text in an off-screen textarea and use execCommand.
			const previousFocus = document.activeElement;
			const textarea = document.createElement("textarea");
			textarea.value = text;
			textarea.setAttribute("readonly", "");
			textarea.style.position = "fixed";
			textarea.style.left = "-9999px";
			document.body.appendChild(textarea);
			textarea.select();
			let copied = false;
			try {
				copied = document.execCommand("copy");
			} catch {
				copied = false;
			}
			const restoreFocus = document.activeElement === textarea;
			textarea.remove();
			if (restoreFocus && previousFocus instanceof HTMLElement) previousFocus.focus();
			return copied;
		}
	};

	for (const button of document.querySelectorAll<HTMLButtonElement>(
		".contact-fallback__copy[data-copy-text]",
	)) {
		const original = button.textContent;
		const status = button.closest(".contact-fallback")?.querySelector<HTMLElement>("[data-copy-status]");
		let resetTimer: number | undefined;
		button.addEventListener("click", async () => {
			window.clearTimeout(resetTimer);
			if (status) status.textContent = "";
			const copied = await copyWithFallback(button.dataset.copyText ?? "");
			button.textContent = copied ? "Copied" : "Copy failed";
			if (status) status.textContent = copied
				? `${button.dataset.copyKind} copied to clipboard.`
				: "Copy failed. Select and copy the text shown above.";
			resetTimer = window.setTimeout(() => {
				button.textContent = original;
			}, 2000);
		});
	}
</script>

<style>
	.contact-fallback {
		max-width: 46rem;
	}

	.contact-fallback__label {
		font-family: var(--fonts-academy-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--colors-academy-text-muted);
		margin: 0;
	}

	.contact-fallback__label + .contact-fallback__label,
	.contact-fallback__template + .contact-fallback__copy {
		margin-top: 0.25rem;
	}

	.contact-fallback__subject {
		text-transform: none;
		letter-spacing: 0.04em;
		font-weight: 500;
	}

	.contact-fallback__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.contact-fallback__email {
		font-family: var(--fonts-academy-mono);
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--colors-academy-text);
		user-select: all;
	}

	.contact-fallback__template {
		width: 100%;
		margin: 0;
		padding: 0.85rem 1rem;
		border: 1px solid var(--colors-academy-border);
		background: var(--colors-academy-ground);
		color: var(--colors-academy-text-soft);
		font-family: var(--fonts-academy-mono);
		font-size: 0.8rem;
		line-height: 1.6;
		white-space: pre-wrap;
		overflow-x: auto;
	}

</style>
