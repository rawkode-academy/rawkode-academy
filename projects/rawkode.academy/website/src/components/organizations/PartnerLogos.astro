---
/**
 * Current status comes from David; past teams come from the partnerships-page
 * history. Missing marks use the company name rather than an invented logo.
 */
import controlplane from "@/components/partner/logos/controlplane.svg?url";
import datum from "@/components/partner/logos/datum.svg?url";
import fermyon from "@/components/partner/logos/fermyon.svg?url";
import guidepad from "@/components/partner/logos/guidepad.svg?url";
import heroku from "@/components/partner/logos/heroku.svg?url";
import microsoft from "@/components/partner/logos/microsoft.svg?url";
import ngrok from "@/components/partner/logos/ngrok.svg?url";
import spectrocloud from "@/components/partner/logos/spectrocloud.svg?url";
import teleport from "@/components/partner/logos/teleport.svg?url";
import wundergraph from "@/components/partner/logos/wundergraph.svg?url";
import zitadel from "@/components/partner/logos/zitadel.svg?url";

interface Company {
	name: string;
	src?: string;
	/** Show the name beside marks that are an icon only. */
	wordmark?: boolean;
	/** Height in the grid tiles, so marks read at the same optical size. */
	tileHeight?: string;
}

const currentCompanies: Company[] = [
	{ name: "Datum Cloud", src: datum, tileHeight: "1.35rem" },
];

const pastCompanies: Company[] = [
	{ name: "Spectro Cloud", src: spectrocloud, tileHeight: "2rem" },
	{ name: "Teleport", src: teleport },
	{ name: "ControlPlane", src: controlplane },
	{ name: "Fermyon", src: fermyon, tileHeight: "1rem" },
	{ name: "Guidepad", src: guidepad },
	{ name: "Heroku", src: heroku, tileHeight: "2rem" },
	{ name: "Microsoft Azure", src: microsoft, tileHeight: "1.75rem" },
	{ name: "ngrok", src: ngrok },
	{ name: "WunderGraph", src: wundergraph, wordmark: true },
	{ name: "Zitadel", src: zitadel, tileHeight: "2rem" },
];

const allCompanies = [...currentCompanies, ...pastCompanies].sort((a, b) =>
	a.name.localeCompare(b.name, "en", { sensitivity: "base" }),
);
---

<ul class="partner-grid">
	{allCompanies.map((company) => (
		<li class="partner-grid__tile">
			{company.src && (
				<img
					src={company.src}
					alt={company.wordmark ? "" : company.name}
					loading="lazy"
					decoding="async"
					height="28"
					style={company.tileHeight ? `height: ${company.tileHeight}` : undefined}
				/>
			)}
			{(!company.src || company.wordmark) && <span class="partner-logos__wordmark">{company.name}</span>}
		</li>
	))}
</ul>

<style>
	.partner-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 40rem) {
		.partner-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.partner-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.partner-grid__tile {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 4rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--colors-academy-border);
		border-radius: var(--radii-academy-m);
		background: var(--colors-academy-panel);
	}

	.partner-grid__tile img {
		display: block;
		width: auto;
		max-width: 100%;
		height: 1.5rem;
		object-fit: contain;
		filter: brightness(0);
		opacity: 0.72;
	}

	:global(html.dark) .partner-grid__tile img {
		filter: brightness(0) invert(1);
		opacity: 0.8;
	}

	.partner-logos__wordmark {
		font-family: var(--fonts-academy-text), system-ui, sans-serif;
		font-size: 1.05rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		color: var(--colors-academy-text);
		opacity: 0.72;
	}
</style>
