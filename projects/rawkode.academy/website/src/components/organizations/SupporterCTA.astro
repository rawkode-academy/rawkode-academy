---
import { button } from "@rawkodeacademy/design-system";
import { supportAcademyOffer } from "@/lib/partnerships";

interface Props {
	surface: "video" | "article";
}

const { surface } = Astro.props;
---

<aside class="supporter-cta" aria-labelledby={`supporter-cta-${surface}`} data-supporter-cta={surface}>
	<h2 id={`supporter-cta-${surface}`}>Free for everyone. Funded by companies.</h2>
	<p>Teams that rely on this work back it from {supportAcademyOffer.priceShort}, with a supporter badge on their technology page.</p>
	<a class={button()} href="/organizations/support-our-work" data-supporter-cta-link={surface}>Become a supporter</a>
</aside>

<script>
	import { captureGrowthClientEvent, GROWTH_EVENTS } from "@/lib/analytics/growth";

	for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-supporter-cta-link]")) {
		link.addEventListener("click", () => {
			captureGrowthClientEvent(GROWTH_EVENTS.SUPPORTER_CTA_CLICKED, {
				surface: link.dataset.supporterCtaLink,
			});
		});
	}
</script>

<style>
	.supporter-cta { display: grid; justify-items: start; gap: 0.75rem; margin-block: 0 2rem; padding: 1.25rem; border: 1px solid var(--colors-academy-accent); border-radius: var(--radii-academy-l); background: var(--colors-academy-panel); }
	.supporter-cta h2 { margin: 0; font-family: var(--fonts-academy-display), system-ui, sans-serif; font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.25; }
	.supporter-cta p { margin: 0; line-height: 1.6; max-width: 44rem; }
</style>
