---
interface Props {
	userId?: string | undefined;
}

const { userId } = Astro.props;
---

<script define:vars={{ userId }}>
	const PH_KEY = "phc_8BUP734dzskih8urQFkFL1qxT5veRDm6zzXwROZND4M";
	const PH_HOST = "https://eu.i.posthog.com";
	let posthogInitialized = false;
	let initInFlight = false;

	const UTM_KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
	const readAttribution = (name) => {
		try {
			const prefix = `${name}=`;
			const raw = document.cookie.split(";").map(part => part.trim()).find(part => part.startsWith(prefix))?.slice(prefix.length);
			if (!raw) return {};
			const parsed = JSON.parse(decodeURIComponent(raw));
			// Only consume snapshots normalized by first-party analytics.
			if (parsed.schema_version !== 1) return {};
			return Object.fromEntries([...UTM_KEYS, "landing_page", "initial_referrer", "captured_at"].flatMap(key => typeof parsed[key] === "string" && parsed[key] ? [[key, parsed[key]]] : []));
		} catch { return {}; }
	};
	const registerAttributionSuperProperties = () => {
		if (navigator.doNotTrack === "1" || window.doNotTrack === "1") return;
		try {
			const first = readAttribution("rk_first_touch"), last = readAttribution("rk_last_touch");
			const campaign = Object.fromEntries([...UTM_KEYS, "landing_page"].flatMap(key => last[key] ? [[key,last[key]]] : []));
			for (const key of UTM_KEYS) {
				if (!campaign[key]) window.posthog.unregister(key);
			}
			if (Object.keys(campaign).length) window.posthog.register(campaign);
			const once = Object.fromEntries(Object.entries(first).map(([key,value]) => [`first_touch_${key}`,value]));
			if (Object.keys(once).length) window.posthog.register_once(once);
		} catch { /* PostHog remains a best-effort dual-run destination. */ }
	};
	window.addEventListener("rk:attribution", () => {
		if (posthogInitialized) registerAttributionSuperProperties();
	});

	const bootstrapPostHog = () => {
		!(function (t, e) {
			let o;
			let n;
			let p;
			let r;
			if (e.__SV) return;
			window.posthog = e;
			e._i = [];
			e.init = function (i, s, a) {
				function g(target, fn) {
					const parts = fn.split(".");
					if (parts.length === 2) {
						target = target[parts[0]];
						fn = parts[1];
					}
					target[fn] = function () {
						target.push(
							[fn].concat(Array.prototype.slice.call(arguments, 0)),
						);
					};
				}
				p = t.createElement("script");
				p.type = "text/javascript";
				p.crossOrigin = "anonymous";
				p.async = true;
				p.src = `${s.api_host.replace(".i.posthog.com", "-assets.i.posthog.com")}/static/array.js`;
				r = t.getElementsByTagName("script")[0];
				if (r?.parentNode) {
					r.parentNode.insertBefore(p, r);
				} else {
					document.head.appendChild(p);
				}
				let u = e;
				if (a !== undefined) {
					u = e[a] = [];
				} else {
					a = "posthog";
				}
				u.people = u.people || [];
				u.toString = function (noStub) {
					let d = "posthog";
					if (a !== "posthog") {
						d += `.${a}`;
					}
					if (!noStub) {
						d += " (stub)";
					}
					return d;
				};
				u.people.toString = function () {
					return `${u.toString(1)}.people (stub)`;
				};
				o =
					"capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(
						" ",
					);
				for (n = 0; n < o.length; n++) {
					g(u, o[n]);
				}
				e._i.push([i, s, a]);
			};
			e.__SV = 1;
		})(document, window.posthog || []);
	};

	const captureCanonicalPageView = () => {
		window.posthog.capture("page_view", {
			path: location.pathname,
			title: document.title,
			url: location.href,
			referrer: document.referrer || "",
		});
	};

	const initializePostHog = () => {
		if (navigator.doNotTrack === "1" || window.doNotTrack === "1") return;
		if (posthogInitialized || initInFlight) {
			return;
		}
		initInFlight = true;
		try {
			bootstrapPostHog();

			window.posthog.init(PH_KEY, {
				api_host: PH_HOST,
				autocapture: true,
				capture_pageview: false,
				respect_dnt: true,
				// Capture Core Web Vitals (LCP, INP, CLS, FCP, TTFB) as
				// $web_vitals events. GSC has no CWV data for the property
				// because field-traffic volume is below the CrUX threshold;
				// these events are our own measurement until that changes.
				capture_performance: {
					web_vitals: true,
					network_timing: false,
				},
				// Skip loading rrweb-record entirely. We sample at 0 anyway,
				// and the recorder bundle (12 KiB + ~390 ms main-thread time)
				// is a measured PSI culprit. Flip to false to re-enable.
				disable_session_recording: true,
				session_recording: {
					maskAllInputs: true,
					sampling: { rate: 0 },
				},

			});

			registerAttributionSuperProperties();

			if (userId) {
				window.posthog.identify(userId);
			}

			captureCanonicalPageView();
			posthogInitialized = true;
		} catch (error) {
			console.warn("Failed to initialize PostHog:", error);
		} finally {
			initInFlight = false;
		}
	};

	const schedulePostHogEnable = () => {
		// Wait for first user interaction OR a generous idle window, whichever
		// comes first. PSI flagged PostHog as a top main-thread blocker; the
		// vast majority of sessions never need analytics during the initial
		// paint, so we trade a small delay for a quieter critical path.
		const INTERACTION_EVENTS = [
			"pointerdown",
			"keydown",
			"scroll",
			"touchstart",
		];
		let started = false;
		const start = () => {
			if (started) return;
			started = true;
			for (const ev of INTERACTION_EVENTS) {
				window.removeEventListener(ev, start, { capture: true });
			}
			initializePostHog();
		};
		for (const ev of INTERACTION_EVENTS) {
			window.addEventListener(ev, start, {
				capture: true,
				passive: true,
			});
		}
		if ("requestIdleCallback" in window) {
			window.requestIdleCallback(start, { timeout: 5000 });
			return;
		}
		window.setTimeout(start, 4000);
	};

	// Initialize PostHog lazily after page load.
	if (document.readyState === "complete") {
		schedulePostHogEnable();
	} else {
		window.addEventListener("load", schedulePostHogEnable, { once: true });
	}
</script>
