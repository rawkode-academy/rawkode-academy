---
import { academyLayout, academyMarketing, academyEditorial } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

interface Props {
	eyebrow?: string;
	title: string;
	lede?: string;
	compact?: boolean;
}

const { eyebrow, title, lede, compact = false } = Astro.props as Props;
const layout = academyLayout({ width: compact ? "reading" : "wide" });
const marketing = academyMarketing();
const editorial = academyEditorial();
---

<div class:list={[layout.root, editorial.root]}>
	<header class={layout.hero}>
		<div class={layout.container}>
			{eyebrow && <p class={marketing.eyebrow}>{eyebrow}</p>}
			<h1 class={layout.title}>{title}</h1>
			{lede && <p class={layout.description}>{lede}</p>}
			{Astro.slots.has("actions") && (
				<div class={marketing.actions}><slot name="actions" /></div>
			)}
		</div>
	</header>
	<div class={layout.container}>
		<slot />
	</div>
</div>
