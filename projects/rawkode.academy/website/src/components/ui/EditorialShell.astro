---
import {
	academyLayout,
	academyMarketing,
	academyEditorial,
} from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

interface Props {
	eyebrow?: string;
	title: string;
	lede?: string;
	compact?: boolean;
}

const { eyebrow, title, lede, compact = false } = Astro.props as Props;
const layout = academyLayout({ width: compact ? "reading" : "wide" });
const marketing = academyMarketing();
const editorial = academyEditorial();
const hasAside = Astro.slots.has("aside");
// Pages with an aside get the two-column hero; the rest keep a single column.
const HeroInner = hasAside ? "div" : Fragment;
const heroInnerProps = hasAside
	? { class: layout.heroInner, style: "align-items: center" }
	: {};
---

<div class:list={[layout.root, editorial.root]} data-reading={compact}>
	<header class={layout.hero}>
		<div class={layout.container}>
			<HeroInner {...heroInnerProps}>
				<div class={layout.heroCopy}>
				{eyebrow && <p class={marketing.eyebrow}>{eyebrow}</p>}
				<h1 class={layout.title}>{title}</h1>
				{lede && <p class={layout.description}>{lede}</p>}
				<slot name="intro" />
				{Astro.slots.has("actions") && (
					<div class={marketing.actions}><slot name="actions" /></div>
				)}
				</div>
				{hasAside && <slot name="aside" />}
			</HeroInner>
		</div>
	</header>
	<div class={layout.container}>
		<slot />
	</div>
</div>
