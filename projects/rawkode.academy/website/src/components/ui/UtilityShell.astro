---
import { academyLayout, academyMarketing } from "@rawkodeacademy/design-system";
import "@rawkodeacademy/design-system/styles.css";

interface Props {
	kicker?: string;
	title: string;
	description?: string;
	tone?: "neutral" | "success" | "danger";
}

const { kicker = "Rawkode Academy", title, description, tone = "neutral" } = Astro.props as Props;
const layout = academyLayout({ width: "reading" });
const marketing = academyMarketing();
const mark = tone === "success" ? "✓" : tone === "danger" ? "!" : "→";
---

<main class:list={[layout.root, "utility-page"]}>
	<div class:list={[layout.container, marketing.utility]}>
		<div class={marketing.utilityMark} aria-hidden="true">{mark}</div>
		<p class={marketing.eyebrow}>{kicker}</p>
		<h1 class={layout.title}>{title}</h1>
		{description && <p class={layout.description}>{description}</p>}
		{Astro.slots.has("default") && <div class={layout.notice}><slot /></div>}
		{Astro.slots.has("actions") && (
			<div class:list={[marketing.utilityActions, "utility-shell__actions"]}><slot name="actions" /></div>
		)}
	</div>
</main>

<style>
	.utility-page { min-height: calc(100vh - 4rem); }
	.utility-shell__actions :global(a),
	.utility-shell__actions :global(button) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		padding: 0.75rem 1.25rem;
		border: 1px solid transparent;
		border-radius: var(--radii-academy-s);
		background: var(--colors-academy-accent);
		color: var(--colors-academy-accent-foreground);
		font-weight: 700;
		text-decoration: none;
	}
</style>
