---
import {
	bespokeProjectOffer,
	communityChallengeOffer,
	supportAcademyOffer,
	ongoingPartnershipOffer,
	type PartnershipOffer,
} from "@/lib/partnerships";

interface Props {
	showInAllPages?: boolean;
}

const { showInAllPages = false } = Astro.props;

// Only show on homepage or if explicitly requested
const shouldShow = Astro.url.pathname === "/" || showInAllPages;

if (!shouldShow) return;

// Offers come from the same copy module as the partnerships page, so prices
// in search results cannot drift from what the page says.
const PARTNERSHIPS_URL = "https://rawkode.academy/organizations/partnerships";
const SUPPORT_URL = "https://rawkode.academy/organizations/support-our-work";
const usdAmount = (price: string) =>
	price.match(/\$([\d,]+)/)?.[1]?.replaceAll(",", "") ?? "";
const partnerOffer = (offer: PartnershipOffer, anchor: string, baseUrl = PARTNERSHIPS_URL) => ({
	"@type": "Offer",
	name: offer.name,
	...(offer.price.startsWith("$") ? { price: usdAmount(offer.price), priceCurrency: "USD" } : {}),
	url: `${baseUrl}${anchor}`,
	itemOffered: {
		"@type": "Service",
		name: offer.name,
		description: offer.summary,
	},
});

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": "https://rawkode.academy/#organization",
	name: "Rawkode Academy",
	url: "https://rawkode.academy",
	logo: {
		"@type": "ImageObject",
		url: "https://rawkode.academy/android-chrome-512x512.png",
		width: 512,
		height: 512,
	},
	description:
		"Rawkode Academy provides cloud-native education and partnerships for companies building technical products for practitioners.",
	sameAs: [
		"https://github.com/rawkode-academy",
		"https://www.youtube.com/@RawkodeAcademy",
		"https://x.com/RawkodeAcademy",
		"https://www.linkedin.com/company/rawkode-academy",
	],
	contactPoint: {
		"@type": "ContactPoint",
		contactType: "partnerships",
		email: "david@rawkode.academy",
		url: "https://rawkode.academy/organizations/lets-chat",
	},
	founder: {
		"@type": "Person",
		name: "David Flanagan",
		url: "https://github.com/rawkode",
		sameAs: ["https://x.com/rawkode", "https://www.linkedin.com/in/rawkode"],
	},
	foundingDate: "2021",
	areaServed: {
		"@type": "Place",
		name: "Global",
	},
	knowsAbout: [
		"Cloud Native",
		"Kubernetes",
		"DevOps",
		"Platform Engineering",
		"Infrastructure as Code",
		"GitOps",
		"Observability",
		"Site Reliability Engineering",
	],
	offers: [
		{
			...partnerOffer(supportAcademyOffer, "#supporter", SUPPORT_URL),
			priceSpecification: {
				"@type": "UnitPriceSpecification",
				price: usdAmount(supportAcademyOffer.price),
				priceCurrency: "USD",
				unitText: "month",
				unitCode: "MON",
			},
		},
		{
			...partnerOffer(ongoingPartnershipOffer, "#pricing"),
			priceSpecification: {
				"@type": "UnitPriceSpecification",
				price: usdAmount(ongoingPartnershipOffer.price),
				priceCurrency: "USD",
				unitText: "quarter",
			},
		},
		partnerOffer(bespokeProjectOffer, "#bespoke"),
		{
			...partnerOffer(communityChallengeOffer, "#challenges"),
			priceSpecification: {
				"@type": "PriceSpecification",
				minPrice: usdAmount(communityChallengeOffer.price),
				priceCurrency: "USD",
			},
		},
		{
			"@type": "Offer",
			itemOffered: {
				"@type": "Course",
				name: "Online Courses",
				description: "Self-paced online courses for cloud native technologies",
			},
		},
	],
};
---

<script
	type="application/ld+json"
	set:html={JSON.stringify(organizationSchema)}
	is:inline
></script>
