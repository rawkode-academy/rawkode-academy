---
import {
	bespokeProjectOffer,
	communityChallengeOffer,
	supportAcademyOffer,
	ongoingPartnershipOffer,
	type PartnershipOffer,
} from "@/lib/partnerships";

interface Props {
	showInAllPages?: boolean;
}

const { showInAllPages = false } = Astro.props;

// Show on homepage, about page, or if explicitly requested
const normalizedPathname =
	Astro.url.pathname.length > 1
		? Astro.url.pathname.replace(/\/+$/, "")
		: Astro.url.pathname;
const shouldShow =
	normalizedPathname === "/" ||
	normalizedPathname === "/about" ||
	showInAllPages;

// Offers come from the same copy module as the partnerships page, so prices
// in search results cannot drift from what the page says.
const PARTNERSHIPS_URL = "https://rawkode.academy/organizations/partnerships";
const SUPPORT_URL = "https://rawkode.academy/organizations/support-our-work";
const usdAmount = (price: string) =>
	price.match(/\$([\d,]+)/)?.[1]?.replaceAll(",", "") ?? "";
const partnerOffer = (offer: PartnershipOffer, anchor: string, baseUrl = PARTNERSHIPS_URL) => ({
	"@type": "Offer",
	name: offer.name,
	...(offer.price.startsWith("$") ? { price: usdAmount(offer.price), priceCurrency: "USD" } : {}),
	url: `${baseUrl}${anchor}`,
	itemOffered: {
		"@type": "Service",
		name: offer.name,
		description: offer.summary,
	},
});

const organizationSchema = shouldShow
	? {
			"@context": "https://schema.org",
	"@type": ["EducationalOrganization", "Organization"],
	"@id": "https://rawkode.academy/#organization",
	name: "Rawkode Academy",
	url: "https://rawkode.academy",
	logo: {
		"@type": "ImageObject",
		"@id": "https://rawkode.academy/#logo",
		url: "https://rawkode.academy/android-chrome-512x512.png",
		contentUrl: "https://rawkode.academy/android-chrome-512x512.png",
		width: 512,
		height: 512,
		caption: "Rawkode Academy",
	},
	image: "https://rawkode.academy/android-chrome-512x512.png",
	description:
		"Rawkode Academy provides hands-on cloud-native education, tutorials, courses, live shows, and technical partnerships for practitioners.",
	sameAs: [
		"https://github.com/rawkode-academy",
		"https://www.youtube.com/@RawkodeAcademy",
		"https://bsky.app/profile/rawkode.academy",
		"https://www.linkedin.com/company/rawkode-academy",
		"https://x.com/RawkodeAcademy",
	],
	contactPoint: {
		"@type": "ContactPoint",
		contactType: "partnerships",
		email: "david@rawkode.academy",
		url: "https://rawkode.academy/organizations/lets-chat",
	},
	founder: {
		"@type": "Person",
		name: "David Flanagan",
		url: "https://rawkode.academy/people/rawkode",
		sameAs: [
			"https://github.com/rawkode",
			"https://x.com/rawkode",
			"https://www.linkedin.com/in/rawkode",
		],
	},
	foundingDate: "2021",
	areaServed: {
		"@type": "Place",
		name: "Global",
	},
	knowsAbout: [
		"Cloud Native",
		"Kubernetes",
		"DevOps",
		"Platform Engineering",
		"Infrastructure as Code",
		"GitOps",
		"Observability",
		"Site Reliability Engineering",
	],
	offers: [
		{
			...partnerOffer(supportAcademyOffer, "#supporter", SUPPORT_URL),
			priceSpecification: {
				"@type": "UnitPriceSpecification",
				price: usdAmount(supportAcademyOffer.price),
				priceCurrency: "USD",
				unitText: "month",
				unitCode: "MON",
			},
		},
		{
			...partnerOffer(ongoingPartnershipOffer, "#pricing"),
			priceSpecification: {
				"@type": "UnitPriceSpecification",
				price: usdAmount(ongoingPartnershipOffer.price),
				priceCurrency: "USD",
				unitText: "quarter",
			},
		},
		partnerOffer(bespokeProjectOffer, "#bespoke"),
		{
			...partnerOffer(communityChallengeOffer, "#challenges"),
			priceSpecification: {
				"@type": "PriceSpecification",
				minPrice: usdAmount(communityChallengeOffer.price),
				priceCurrency: "USD",
			},
		},
		{
			"@type": "Offer",
			itemOffered: {
				"@type": "Course",
				name: "Online Courses",
				description: "Self-paced online courses for cloud native technologies",
			},
		},
		],
	}
	: undefined;
---

{organizationSchema && (
	<script
		type="application/ld+json"
		set:html={JSON.stringify(organizationSchema)
			.replace(/</g, "\\u003c")
			.replace(/\u2028/g, "\\u2028")
			.replace(/\u2029/g, "\\u2029")}
		is:inline
	></script>
)}
