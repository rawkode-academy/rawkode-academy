---
import type { ContentEntry } from "@/lib/live-content";
import { buildPersonJsonLd } from "@/lib/person-jsonld";

interface Props {
	article: ContentEntry<"articles">;
	authors: ContentEntry<"people">[];
	imageUrl?: URL; // absolute URL if available
	// Allow placement into a named slot in parents (for TS exactOptionalPropertyTypes)
	slot?: string;
}

const { article, authors, imageUrl } = Astro.props;
const siteOrigin = (Astro.site ?? Astro.url).origin;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "TechArticle",
	headline: article.data.title,
	description: article.data.description,
	author: authors.map((author) => buildPersonJsonLd(author.data, siteOrigin)),
	datePublished: new Date(article.data.publishedAt).toISOString(),
	dateModified: new Date(
		article.data.updatedAt ?? article.data.publishedAt,
	).toISOString(),
	mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.href },
	url: Astro.url.href,
	image: imageUrl
		? imageUrl.href
		: new URL("/android-chrome-512x512.png", Astro.site || Astro.url).href,
	publisher: {
		"@type": "Organization",
		name: "Rawkode Academy",
		url: siteOrigin,
		logo: {
			"@type": "ImageObject",
			url: new URL("/android-chrome-512x512.png", siteOrigin).href,
		},
	},
	speakable: {
		"@type": "SpeakableSpecification",
		cssSelector: [".article-header h1"],
	},
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
