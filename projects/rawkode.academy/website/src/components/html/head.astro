---
import { Font } from "astro:assets";
import {
	clampDescription,
	formatPageTitle,
	resolveCanonicalUrl,
	serializeJsonLd,
} from "@/lib/open-graph";
import { SITE_DESCRIPTION } from "@/lib/site";
import type { OpenGraphProps } from "@/types/opengraph";
import Analytics from "../analytics/index.astro";
import PostHog from "../posthog/index.astro";
import Grafana from "../grafana/index.astro";
import Opengraph from "./opengraph.astro";
import SearchActionJsonLd from "./search-action-jsonld.astro";
import OrganizationJsonLd from "./organization-jsonld.astro";
import ThemeScript from "../theme/ThemeScript.astro";

interface Props extends OpenGraphProps {
	userId?: string | undefined;
}

const { userId } = Astro.props;
const normalizedTitle = formatPageTitle(Astro.props.title);
const metaDescription = clampDescription(
	Astro.props.description?.trim() ? Astro.props.description : SITE_DESCRIPTION,
);
const canonicalURL = resolveCanonicalUrl(
	Astro.props.canonicalUrl,
	Astro.url.pathname,
	Astro.site,
);
---

<style is:global>
	/* Body font + mono fallbacks. Heading font + body backdrop are owned
	 by global.css (@layer base + body{}). */
	pre,
	code,
	kbd,
	samp,
	tt {
		font-family:
			var(--font-red-hat-mono),
			ui-monospace,
			SFMono-Regular,
			Menlo,
			monospace;
	}
</style>

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="color-scheme" content="light dark" />
	<Font cssVariable="--font-red-hat-display" preload />
	<Font cssVariable="--font-red-hat-text" preload />
	<Font cssVariable="--font-red-hat-mono" />

	{/*
		Editorial favicons — light scheme shows ink on paper (icon-dark.svg),
		dark scheme shows paper on ink (icon-light.svg). Modern browsers pick
		the matching SVG via the `media` attribute; PNG fallbacks remain for
		legacy and pinned-tab contexts (still on the prior brand pending regen).
	*/}
	<link rel="icon" href="/favicon.ico" sizes="48x48" />
	<link rel="icon" type="image/svg+xml" href="/icon-dark.svg" media="(prefers-color-scheme: light)" />
	<link rel="icon" type="image/svg+xml" href="/icon-light.svg" media="(prefers-color-scheme: dark)" />
	<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
	<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
	<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
	<link rel="manifest" href="/site.webmanifest" />
	<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#0a1220" />
	<meta name="msapplication-TileColor" content="#f4f7fb" />
	{/* ThemeScript keeps browser chrome aligned with the applied preference,
	    including when it overrides the operating-system scheme. */}
	<meta
		name="theme-color"
		content="#f4f7fb"
		data-light-color="#f4f7fb"
		data-dark-color="#0a1220"
	/>
	<meta
		name="description"
		content={metaDescription}
	/>

	<title>{normalizedTitle}</title>

	{Astro.props.noindex && (
		<meta name="robots" content="noindex,follow" />
	)}

	<!-- Canonical URL -->
	<link rel="canonical" href={canonicalURL.href} />

	<Opengraph {...Astro.props} canonicalUrl={canonicalURL} />
	{!Astro.props.noindex && Astro.props.jsonLd && (
		<script
			is:inline
			type="application/ld+json"
			set:html={serializeJsonLd(Astro.props.jsonLd)}
		/>
	)}
	{!Astro.props.noindex && (
		<>
			<SearchActionJsonLd />
			<OrganizationJsonLd />
		</>
	)}

	<!-- Resource hints for performance -->
	<link rel="preconnect" href="https://content.rawkode.academy" />
	<link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />
	<link rel="dns-prefetch" href="https://image.rawkode.academy" />
	<link rel="dns-prefetch" href="https://discord.gg" />

	<!-- Preload critical fonts -->

	<slot name="extra-head" />

	<link rel="sitemap" href="/sitemap-index.xml" />
	<link
		rel="search"
		type="application/opensearchdescription+xml"
		title="Rawkode Academy"
		href="/opensearch.xml"
	/>

	<!-- PostHog analytics (loaded lazily, respects DNT) -->
	<PostHog userId={userId} />
	<Analytics />

	<!-- Grafana Faro observability (loaded lazily, skips localhost) -->
	<Grafana />

	<!-- Initial theme script: applies the saved preference before paint. -->
	<ThemeScript />

	{import.meta.env.DEV && (
		<link rel="stylesheet" href="/src/styles/global.css" />
	)}
</head>
