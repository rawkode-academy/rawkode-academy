---
import type { CollectionEntry } from "astro:content";

interface Props {
	course: CollectionEntry<"courses">;
	modules: CollectionEntry<"courseModules">[];
	authors: CollectionEntry<"people">[];
	imageUrl?: URL;
}

const { course, modules, authors, imageUrl } = Astro.props;

const publishedModules = modules.filter((module) => !module.data.draft);
const hasDuration = (minutes: number | undefined): minutes is number =>
	typeof minutes === "number" && Number.isFinite(minutes) && minutes > 0;
const totalDurationMinutes =
	publishedModules.length > 0 &&
	publishedModules.every((module) => hasDuration(module.data.duration))
		? publishedModules.reduce(
				(total, module) => total + module.data.duration!,
				0,
			)
		: undefined;

// Map difficulty to skill level
const getSkillLevel = (difficulty: string) => {
	switch (difficulty) {
		case "beginner":
			return "Beginner";
		case "intermediate":
			return "Intermediate";
		case "advanced":
			return "Advanced";
		default:
			return "Intermediate";
	}
};

// Create hasCourseInstance for each module
const courseInstances = publishedModules.map((module) => ({
	"@type": "CourseInstance",
	name: module.data.title,
	description: module.data.description,
	courseMode: "online",
	...(hasDuration(module.data.duration)
		? { courseWorkload: `PT${module.data.duration}M` }
		: {}),
}));

const courseUrl = new URL(`/courses/${course.id}`, Astro.site).href;

// Create structured data for the course
const courseJsonLd = {
	"@context": "https://schema.org",
	"@type": "Course",
	name: course.data.title,
	description: course.data.description,
	url: courseUrl,
	provider: {
		"@type": "Organization",
		name: "Rawkode Academy",
		sameAs: "https://rawkode.academy",
		logo: {
			"@type": "ImageObject",
			url: "https://rawkode.academy/android-chrome-512x512.png",
		},
	},
	...(courseInstances.length ? { hasCourseInstance: courseInstances } : {}),
	...(totalDurationMinutes === undefined
		? {}
		: { timeRequired: `PT${totalDurationMinutes}M` }),
	inLanguage: "en-US",
	availableLanguage: ["en-US"],
	datePublished: course.data.publishedAt.toISOString(),
	dateModified:
		course.data.updatedAt?.toISOString() ||
		course.data.publishedAt.toISOString(),
	image:
		imageUrl?.toString() ||
		"https://rawkode.academy/android-chrome-512x512.png",
	creator: authors.map((author) => ({
		"@type": "Person",
		name: author.data.name,
		url: author.data.github,
	})),
	teaches: publishedModules.map((module) => module.data.title),
	educationalLevel: getSkillLevel(course.data.difficulty),
	learningResourceType: "Online Course",
	interactivityType: "active",
	isAccessibleForFree: true,
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
		...(publishedModules.length
			? { availability: "https://schema.org/InStock" }
			: {}),
		category: "Educational",
	},
};
---

<script
	type="application/ld+json"
	set:html={JSON.stringify(courseJsonLd)}
	is:inline
></script>
