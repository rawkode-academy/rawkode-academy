---
import { buildBroadcastEventJsonLd } from "@/lib/broadcast-event-jsonld";
import { plainTextDescription } from "@/lib/plain-text-description";

interface PersonRef {
	name: string;
	url?: string;
}

interface SeriesRef {
	name: string;
	url: string;
}

interface Props {
	title: string;
	description: string;
	thumbnailUrl?: string | undefined;
	publishedAt?: string | undefined;
	duration?: number | null | undefined;
	streamUrl?: string | undefined;
	embedUrl?: string | undefined; // Only when a true embeddable player URL (e.g., YouTube/Vimeo)
	captionUrl?: string | undefined;
	transcript?: string | undefined;
	keywords?: string[] | undefined;
	isLiveBroadcast?: boolean | undefined;
	category?: string | undefined;
	isVideoList?: boolean | undefined;
	clips?:
		| Array<{ name: string; startOffset: number; endOffset?: number }>
		| undefined;
	creators?: PersonRef[] | undefined;
	guests?: PersonRef[] | undefined;
	partOfSeries?: SeriesRef | undefined;
	slot?: string | undefined;
}

const {
	title,
	description,
	thumbnailUrl,
	publishedAt,
	duration,
	streamUrl,
	embedUrl,
	captionUrl,
	transcript,
	keywords = [],
	isLiveBroadcast = false,
	category,
	isVideoList = false,
	clips = [],
	creators,
	guests = [],
	partOfSeries,
} = Astro.props;

// Default to the channel host if no specific creators are provided.
const resolvedCreators: PersonRef[] =
	creators && creators.length > 0
		? creators
		: [
				{
					name: "David Flanagan",
					url: "https://rawkode.academy/people/rawkode",
				},
			];

const plainDescription = plainTextDescription(description, 500);
const pageUrl = new URL(
	Astro.url.pathname,
	Astro.site ?? Astro.url ?? "https://rawkode.academy",
).href;

const normalizedStreamUrl =
	typeof streamUrl === "string" && streamUrl.trim().length > 0
		? streamUrl.trim()
		: undefined;
const normalizedCaptionUrl =
	typeof captionUrl === "string" && captionUrl.trim().length > 0
		? captionUrl.trim()
		: undefined;
const normalizedEmbedUrl =
	typeof embedUrl === "string" && embedUrl.trim().length > 0
		? embedUrl.trim()
		: undefined;
const wholeDurationSeconds =
	typeof duration === "number" && Number.isFinite(duration)
		? Math.floor(duration)
		: 0;
const hasPositiveDuration = wholeDurationSeconds >= 1;
const publishedTimestamp =
	typeof publishedAt === "string" && publishedAt.trim().length > 0
		? new Date(publishedAt).getTime()
		: Number.NaN;
const hasValidPublishedAt = Number.isFinite(publishedTimestamp);
const isUpcomingBroadcast = Boolean(
	isLiveBroadcast && hasValidPublishedAt && publishedTimestamp > Date.now(),
);

// Format duration from seconds to ISO 8601
function formatDuration(seconds: number): string {
	const hours = Math.floor(seconds / 3600);
	const minutes = Math.floor((seconds % 3600) / 60);
	const remainingSeconds = Math.floor(seconds % 60);

	let result = "PT";
	if (hours > 0) {
		result += `${hours}H`;
	}
	if (minutes > 0) {
		result += `${minutes}M`;
	}
	if (remainingSeconds > 0 || (hours === 0 && minutes === 0)) {
		result += `${remainingSeconds}S`;
	}
	return result;
}

const formattedDuration =
	hasPositiveDuration && !isUpcomingBroadcast
		? formatDuration(wholeDurationSeconds)
		: undefined;

// Generate structured data
// Compute a safe embedUrl: only use if explicitly provided or clearly an embed player URL
const computedEmbedUrl = (() => {
	if (normalizedEmbedUrl) return normalizedEmbedUrl;
	if (!normalizedStreamUrl) return undefined;
	const s = normalizedStreamUrl.toLowerCase();
	if (
		s.includes("youtube.com/embed/") ||
		s.includes("youtu.be/") ||
		s.includes("player.vimeo.com/")
	) {
		return normalizedStreamUrl;
	}
	return undefined; // Avoid using HLS/MP4 as embedUrl
})();

const broadcastEvent =
	isLiveBroadcast && publishedAt && hasValidPublishedAt
		? buildBroadcastEventJsonLd({
				startDate: publishedAt,
				durationSeconds:
					!isUpcomingBroadcast && hasPositiveDuration
						? wholeDurationSeconds
						: undefined,
			})
		: undefined;

const clipBaseUrl = pageUrl;
const normalizedKeywords = keywords
	.map((keyword) => keyword.trim())
	.filter((keyword) => keyword.length > 0);

const structuredData = isVideoList
	? undefined
	: {
			"@context": "https://schema.org",
			"@type": "VideoObject",
			name: title,
			description: plainDescription,
			...(thumbnailUrl ? { thumbnailUrl: [thumbnailUrl] } : {}),
			...(hasValidPublishedAt && publishedAt
				? { uploadDate: publishedAt }
				: {}),
			...(formattedDuration ? { duration: formattedDuration } : {}),
			...(broadcastEvent ? { publication: broadcastEvent } : {}),
			...(normalizedStreamUrl ? { contentUrl: normalizedStreamUrl } : {}),
			...(computedEmbedUrl ? { embedUrl: computedEmbedUrl } : {}),
			url: pageUrl,
			mainEntityOfPage: pageUrl,
			potentialAction: {
				"@type": "SeekToAction",
				target: `${pageUrl}?t={seek_to_second_number}`,
				"startOffset-input": "required name=seek_to_second_number",
			},
			// Additional required/recommended properties for Google Video Search
			publisher: {
				"@type": "Organization",
				"@id": "https://rawkode.academy/#organization",
				name: "Rawkode Academy",
				url: "https://rawkode.academy",
				logo: {
					"@type": "ImageObject",
					url: "https://rawkode.academy/android-chrome-512x512.png",
					width: 512,
					height: 512,
				},
			},
			creator:
				resolvedCreators.length === 1
					? {
							"@type": "Person",
							name: resolvedCreators[0]!.name,
							...(resolvedCreators[0]!.url
								? { url: resolvedCreators[0]!.url }
								: {}),
						}
					: resolvedCreators.map((person) => ({
							"@type": "Person",
							name: person.name,
							...(person.url ? { url: person.url } : {}),
						})),
			...(guests.length > 0 && {
				actor: guests.map((person) => ({
					"@type": "Person",
					name: person.name,
					...(person.url ? { url: person.url } : {}),
				})),
			}),
			...(partOfSeries && {
				partOfSeries: {
					"@type": "CreativeWorkSeries",
					name: partOfSeries.name,
					url: partOfSeries.url,
				},
			}),
			hasPart: clips?.length
				? clips.map((c) => ({
						"@type": "Clip",
						name: c.name,
						startOffset: c.startOffset,
						url: `${clipBaseUrl}?t=${c.startOffset}`,
						...(typeof c.endOffset === "number"
							? { endOffset: c.endOffset }
							: {}),
					}))
				: undefined,
			isAccessibleForFree: true,
			requiresSubscription: false,
			isFamilyFriendly: true,
			inLanguage: "en",
			...(category ? { genre: category } : {}),
			...(normalizedKeywords.length > 0
				? { keywords: normalizedKeywords.join(", ") }
				: {}),
			...(normalizedCaptionUrl
				? {
						caption: {
							"@type": "MediaObject",
							contentUrl: normalizedCaptionUrl,
							encodingFormat: "text/vtt",
							inLanguage: "en",
							name: `${title} captions`,
						},
					}
				: {}),
			...(transcript ? { transcript } : {}),
		};
---

{!isVideoList && (
	<>
		<!-- Preload video thumbnail to improve LCP on detail pages -->
		{thumbnailUrl && (
			<link rel="preload" as="image" href={thumbnailUrl} fetchpriority="high" />
		)}

		<!-- Video-specific meta tags (og:type and the Twitter card come from opengraph.astro) -->
		{normalizedStreamUrl && <meta property="og:video" content={normalizedStreamUrl} />}
		{normalizedStreamUrl && <meta property="og:video:url" content={normalizedStreamUrl} />}
		{normalizedStreamUrl && normalizedStreamUrl.startsWith("https://") && (
			<meta property="og:video:secure_url" content={normalizedStreamUrl} />
		)}
		{normalizedStreamUrl && /\.m3u8(?:$|[?#])/i.test(normalizedStreamUrl) && (
			<meta property="og:video:type" content="application/x-mpegURL" />
		)}
		{normalizedStreamUrl && hasPositiveDuration && !isUpcomingBroadcast && (
			<meta
				property="og:video:duration"
				content={String(wholeDurationSeconds)}
			/>
		)}
		{normalizedStreamUrl && hasValidPublishedAt && publishedAt && (
			<meta property="og:video:release_date" content={publishedAt} />
		)}

		<!-- Structured Data -->
		{structuredData && (
			<script
				is:inline
				type="application/ld+json"
				set:html={JSON.stringify(structuredData)
					.replace(/</g, "\\u003c")
					.replace(/\u2028/g, "\\u2028")
					.replace(/\u2029/g, "\\u2029")}
			/>
		)}
	</>
)}
