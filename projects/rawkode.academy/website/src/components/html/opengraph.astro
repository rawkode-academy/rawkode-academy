---
import type { ContentEntry } from "@/lib/live-content";
import {
	BRAND_NAME,
	clampDescription,
	normalizeTwitterHandle,
	resolveCanonicalUrl,
	resolveOpenGraphImage,
	serializeJsonLd,
	TWITTER_SITE_HANDLE,
} from "@/lib/open-graph";
import { SITE_DESCRIPTION } from "@/lib/site";

const {
	title,
	ogTitle,
	subtitle,
	description,
	canonicalUrl,
	image,
	useImageDirectly = false,
	isArticle = false,
	ogType = "website",
	twitterCard = "summary_large_image",
	twitterCreator: twitterCreatorProp,
	publishedAt,
	updatedAt,
	authors,
	noindex = false,
	pageType = "WebPage",
	mainEntity,
	articleSection,
	articleTags,
} = Astro.props;

const normalizedTitle =
	typeof title === "string" && title.replace(/\s+/g, " ").trim().length > 0
		? title.replace(/\s+/g, " ").trim()
		: BRAND_NAME;
const normalizedOgTitle =
	typeof ogTitle === "string" ? ogTitle.replace(/\s+/g, " ").trim() : "";
const socialTitle =
	normalizedOgTitle.length > 0 ? normalizedOgTitle : normalizedTitle;

const openGraphUrl = resolveCanonicalUrl(
	canonicalUrl,
	Astro.url.pathname,
	Astro.site,
);

const openGraphDescription = clampDescription(
	typeof description === "string" && description.trim().length > 0
		? description
		: SITE_DESCRIPTION,
);

const openGraphImage = resolveOpenGraphImage({
	title: socialTitle,
	ogTitle,
	subtitle,
	description: openGraphDescription,
	image,
	pageUrl: openGraphUrl,
	useImageDirectly,
});

// Show article-specific meta tags only when the caller opts in via the
// `isArticle` prop. The previous heuristic also matched `/blog/` (a route
// that doesn't exist) and `/series/` (a CollectionPage - not an Article).
const shouldShowArticleMeta = isArticle;

const authorTwitterCandidate = shouldShowArticleMeta
	? authors?.find(
			(author: ContentEntry<"people">) =>
				(typeof author.data.handles?.twitter === "string" &&
					author.data.handles.twitter.trim().length > 0) ||
				(typeof author.data.twitter === "string" &&
					author.data.twitter.trim().length > 0),
		)
	: undefined;

const twitterCreator =
	normalizeTwitterHandle(twitterCreatorProp) ??
	normalizeTwitterHandle(
		authorTwitterCandidate?.data.handles?.twitter ??
			authorTwitterCandidate?.data.twitter,
	);

// Mastodon and other Fediverse servers credit the post creator on link
// previews when this meta tag is present and points at a profile URL.
const firstAuthorMastodon = shouldShowArticleMeta
	? authors?.find(
			(author: ContentEntry<"people">) =>
				typeof author.data.mastodon === "string" &&
				author.data.mastodon.trim().length > 0,
		)?.data.mastodon
	: undefined;
---

<meta
	property="og:type"
	content={shouldShowArticleMeta ? "article" : ogType}
/>
<meta property="og:site_name" content="Rawkode Academy" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={openGraphDescription} />
<meta property="og:url" content={openGraphUrl.href} />
<meta property="og:image" content={openGraphImage.url} />
<meta property="og:image:secure_url" content={openGraphImage.url} />
<meta property="og:image:alt" content={openGraphImage.alt} />
{openGraphImage.type && (
	<meta property="og:image:type" content={openGraphImage.type} />
)}
{typeof openGraphImage.width === "number" && (
	<meta property="og:image:width" content={String(openGraphImage.width)} />
)}
{typeof openGraphImage.height === "number" && (
	<meta property="og:image:height" content={String(openGraphImage.height)} />
)}
{firstAuthorMastodon && (
	<meta name="fediverse:creator" content={firstAuthorMastodon} />
)}

<!-- Article specific Open Graph meta tags -->
{
	shouldShowArticleMeta && publishedAt && (
		<meta
			property="article:published_time"
			content={publishedAt.toISOString()}
		/>
	)
}
{
	shouldShowArticleMeta && updatedAt && (
		<meta property="article:modified_time" content={updatedAt.toISOString()} />
	)
}
{
	shouldShowArticleMeta && (
		<>
			<meta property="article:publisher" content="https://rawkode.academy" />
			{articleSection && (
				<meta property="article:section" content={articleSection} />
			)}
			{articleTags?.map((tag: string) => (
				<meta property="article:tag" content={tag} />
			))}
			{authors && authors.map((author: ContentEntry<"people">) => (
				author.data.github && <meta property="article:author" content={author.data.github} />
			))}
			{authors && authors.length > 0 && (
				<meta
					name="author"
					content={authors.map((author: ContentEntry<"people">) => author.data.name).join(", ")}
				/>
			)}
		</>
	)
}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:site" content={TWITTER_SITE_HANDLE} />
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
<meta property="twitter:domain" content={openGraphUrl.hostname} />
<meta property="twitter:url" content={openGraphUrl.href} />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={openGraphDescription} />
<meta name="twitter:image" content={openGraphImage.url} />
<meta name="twitter:image:alt" content={openGraphImage.alt} />

{!shouldShowArticleMeta && !noindex && (
	<script
		is:inline
		type="application/ld+json"
		set:html={serializeJsonLd({
			"@context": "https://schema.org",
			"@type": pageType,
			"@id": `${openGraphUrl.href}#webpage`,
			name: normalizedTitle,
			description: openGraphDescription,
			image: openGraphImage.url,
			url: openGraphUrl.href,
			inLanguage: "en",
			isPartOf: {
				"@id": "https://rawkode.academy/#website",
			},
			publisher: {
				"@id": "https://rawkode.academy/#organization",
			},
			...(mainEntity ? { mainEntity } : {}),
		})}
	></script>
)}
