---
import { buildNewsItemListJsonLd, type NewsListEntry } from "@/lib/news-itemlist-jsonld";

interface Props {
	stories: ReadonlyArray<NewsListEntry>;
	listUrl: string;
	limit?: number;
	slot?: string;
}

const { stories, listUrl, limit } = Astro.props;

const jsonLd = buildNewsItemListJsonLd({
	siteUrl: (Astro.site ?? Astro.url).origin,
	listUrl,
	stories,
	...(typeof limit === "number" ? { limit } : {}),
});
---

<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify(jsonLd)}
/>
