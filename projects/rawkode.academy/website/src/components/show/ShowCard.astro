---
import type { ShowSummary } from "@/types/show";
import { academyCatalog, academyLayout } from "@rawkodeacademy/design-system";

/**
 * The one show card: the show's artwork, a mono line with its real episode
 * count (or its status), the name, its tagline and the latest episode. Used
 * by Shows and by a person's hosted shows.
 */
interface Props {
	show: ShowSummary;
	heading?: "h2" | "h3";
}

const { show, heading: Heading = "h3" } = Astro.props as Props;
const styles = academyLayout({ width: "wide" });
const catalog = academyCatalog();

const isComingSoon = show.status === "coming-soon";
const comingSoonCta = "Get notified →";
const episodes = isComingSoon
	? []
	: (show.episodes ?? []).filter(
			(episode): episode is NonNullable<typeof episode> =>
				episode !== null && episode.video !== null,
		);
const publishedTime = (value: string | null | undefined) =>
	value ? new Date(value).getTime() : 0;
const latestEpisode = [...episodes].sort(
	(a, b) =>
		publishedTime(b.video?.publishedAt) - publishedTime(a.video?.publishedAt),
)[0];
const artwork = show.cover?.image.src ?? latestEpisode?.video?.thumbnailUrl;
const statusLine = isComingSoon
	? "Coming soon"
	: `${show.status === "archived" ? "Archived · " : ""}${episodes.length} published ${episodes.length === 1 ? "episode" : "episodes"}`;
---

<a class={styles.card} href={`/shows/${show.id}`} data-show-status={show.status}>
	{artwork && (
		<span class={catalog.featuredMedia}>
			<img class={catalog.featuredImage} src={artwork} alt="" loading="lazy" />
		</span>
	)}
	<div class={styles.cardBody}>
		<span class={catalog.rowMeta}>{statusLine}</span>
		<Heading class={styles.cardTitle}>{show.name}</Heading>
		{show.tagline && <span class={catalog.rowDescription}>{show.tagline}</span>}
		{latestEpisode?.video?.title && <span class={catalog.rowDescription}>Latest: {latestEpisode.video.title}</span>}
		{isComingSoon && <span class={catalog.rowMeta}>{comingSoonCta}</span>}
	</div>
</a>
