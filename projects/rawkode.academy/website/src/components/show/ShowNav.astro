---
import { academyNavigation } from "@rawkodeacademy/design-system";
import type { ShowNavItem } from "@/lib/shows/types";

interface Props { showId: string; nav: ShowNavItem[]; active?: string | null; }
const { showId, nav, active = null } = Astro.props;
const styles = academyNavigation();
const tabs = [
	{ slug: null as string | null, label: "Episodes", href: `/shows/${showId}` },
	...nav.map((item) => ({ slug: item.slug, label: item.label, href: `/shows/${showId}/${item.slug}` })),
];
---
<nav aria-label="Show sections" class={styles.sections}>
	<ul class={styles.sectionList}>
		{tabs.map((tab) => <li>
			<a href={tab.href} class={styles.sectionLink} aria-current={tab.slug === active ? "page" : undefined}>{tab.label}</a>
		</li>)}
	</ul>
</nav>
