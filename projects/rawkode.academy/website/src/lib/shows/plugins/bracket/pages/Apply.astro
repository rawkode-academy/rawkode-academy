---
import { button } from "@rawkodeacademy/design-system";
import type { MyParticipation } from "../queries";

interface Props {
	showId: string;
	isSignedIn: boolean;
	participation: MyParticipation;
}

const { showId, isSignedIn, participation } = Astro.props;
const cards = participation.brackets;
// A view has one solid button: the first bracket still open to this viewer.
const primaryId = cards.find((card) => !card.applied)?.bracketId;
const applyPath = `/shows/${showId}/apply`;
const signInUrl = `/api/auth/sign-in?returnTo=${encodeURIComponent(applyPath)}`;
const actionUrl = `/api/shows/${showId}/apply`;
const manageUrl = (kind: string) =>
	kind === "team"
		? "https://klustered.dev/me/team"
		: "https://klustered.dev/me/profile";
const manageLabel = (kind: string, hasTeam: boolean) => {
	if (kind !== "team") return "Manage your profile";
	return hasTeam ? "Manage your team" : "Set up your team";
};
---

<div class="bracket-apply">
	{
		cards.length === 0 ? (
			<div class="bracket-apply__closed">
				<p class="bracket-apply__closed-title">Applications are closed</p>
				<p class="bracket-apply__note">
					There are no brackets open for entry right now.
				</p>
			</div>
		) : (
			<Fragment>
			{!isSignedIn && (
				<p class="bracket-apply__sign-in">
					<a href={signInUrl} class={button()}>
						Sign in to apply
					</a>
				</p>
			)}
			<div class="bracket-apply__grid">
				{cards.map((card) => (
					<section class="bracket-apply__card">
						<div class="bracket-apply__header">
							<div>
								<p class="bracket-apply__kind">
									{card.bracketKind === "team" ? "Team" : "Individual"}
								</p>
								<h2 class="bracket-apply__name">{card.bracketName}</h2>
							</div>
							{card.applied && (
								<span class="bracket-apply__entered">Entered</span>
							)}
						</div>

						{card.bracketKind === "team" && (
							<p class="bracket-apply__note">
								Teams are capped at {card.teamSize} competitors.
							</p>
						)}

						{isSignedIn && (
						<div class="bracket-apply__action">
							{card.applied ? (
								<a
									href={manageUrl(card.bracketKind)}
									class={button({ variant: "outline" })}
								>
									{manageLabel(card.bracketKind, Boolean(card.team))}
								</a>
							) : (
								<form method="POST" action={actionUrl}>
									<input type="hidden" name="bracketId" value={card.bracketId} />
									<button
										type="submit"
										class={button({
											variant:
												card.bracketId === primaryId ? "solid" : "outline",
										})}
									>
										Apply for {card.bracketKind === "team" ? "Team" : "Individual"}
									</button>
								</form>
							)}
						</div>
						)}
					</section>
				))}
			</div>
			</Fragment>
		)
	}
</div>

<style>
	.bracket-apply {
		max-width: 48rem;
	}

	.bracket-apply__sign-in {
		margin: 0 0 1rem;
	}

	.bracket-apply__closed,
	.bracket-apply__card {
		border: 1px solid var(--colors-academy-border);
		border-radius: var(--radii-academy-m);
		background: var(--colors-academy-panel);
	}

	.bracket-apply__closed {
		padding: 3rem;
		text-align: center;
	}

	.bracket-apply__closed-title {
		margin: 0;
		color: var(--colors-academy-text-soft);
		font-size: var(--font-sizes-lg);
		font-weight: 500;
	}

	.bracket-apply__grid {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 768px) {
		.bracket-apply__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.bracket-apply__card {
		padding: 1.25rem;
	}

	.bracket-apply__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.bracket-apply__kind,
	.bracket-apply__entered {
		font-family: var(--fonts-academy-mono);
		font-size: var(--font-sizes-xs);
	}

	.bracket-apply__kind {
		margin: 0;
		color: var(--colors-academy-text-muted);
	}

	.bracket-apply__name {
		margin: 0.25rem 0 0;
		color: var(--colors-academy-text);
		font-size: var(--font-sizes-xl);
		font-weight: 600;
	}

	.bracket-apply__entered {
		padding: 0.25rem 0.5rem;
		border: 1px solid var(--colors-academy-border);
		border-radius: var(--radii-sm);
		color: var(--colors-academy-text);
	}

	.bracket-apply__note {
		margin: 0.75rem 0 0;
		color: var(--colors-academy-text-muted);
		font-size: var(--font-sizes-sm);
	}

	.bracket-apply__closed .bracket-apply__note {
		margin-top: 0.5rem;
	}

	.bracket-apply__action {
		margin-top: 1.25rem;
	}
</style>
