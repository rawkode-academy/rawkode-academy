---
import type { BracketMatch } from "../queries";
import { localTime } from "@/lib/local-time";

interface Props {
	matches: BracketMatch[];
}

const { matches } = Astro.props;
const now = Date.now();
const timestamp = (match: BracketMatch): number =>
	Date.parse(match.scheduledAt ?? "");
const isPast = (match: BracketMatch): boolean =>
	match.status !== "live" && (match.status === "completed" || timestamp(match) < now);

function byDate(a: BracketMatch, b: BracketMatch, direction = 1): number {
	const at = timestamp(a);
	const bt = timestamp(b);
	if (!Number.isFinite(at)) return Number.isFinite(bt) ? 1 : 0;
	if (!Number.isFinite(bt)) return -1;
	return direction * (at - bt);
}

const scheduled = matches
	.filter((m) => m.status !== "cancelled")
	.sort((a, b) => byDate(a, b));

const groups = [
	{
		title: "Live and upcoming matches",
		matches: scheduled.filter((m) => !isPast(m) && (m.status === "live" || Number.isFinite(timestamp(m)))),
	},
	{
		title: "Times to be announced",
		matches: scheduled.filter((m) => !isPast(m) && m.status !== "live" && !Number.isFinite(timestamp(m))),
	},
	{
		title: "Past matches",
		matches: scheduled.filter(isPast).sort((a, b) => byDate(a, b, -1)),
	},
].filter((group) => group.matches.length > 0);

function fmt(iso?: string | null) {
	const date = new Date(iso ?? "");
	if (!Number.isFinite(date.getTime())) return null;
	const time = localTime(
		date,
		{
			weekday: "short",
			day: "numeric",
			month: "short",
			year: "numeric",
			hour: "2-digit",
			minute: "2-digit",
			timeZoneName: "short",
		},
		"en-GB",
	);
	return { iso: time.iso, label: time.text, attrs: time.attrs };
}
---

{
	scheduled.length === 0 ? (
		<div class="schedule-empty">
			<p class="schedule-empty__title">Nothing scheduled yet</p>
			<p class="schedule-empty__copy">
				Match times appear here once brackets are drawn.
			</p>
		</div>
	) : (
		<div class="schedule">
			{groups.map((group) => (
				<section>
					<h2 class="schedule__title">{group.title}</h2>
					<ul class="schedule__list" role="list">
						{group.matches.map((m) => {
							const date = fmt(m.scheduledAt);
							return (
								<li class="schedule__match">
									<div class="schedule__sides">
										<span class="schedule__side">{m.sideA?.displayName ?? "TBD"}</span>
										<span class="schedule__versus">vs</span>
										<span class="schedule__side">{m.sideB?.displayName ?? "TBD"}</span>
									</div>
									<div class="schedule__meta">
										{date ? <time {...date.attrs}>{date.label}</time> : <span>{m.status === "completed" ? "Time unavailable" : "Time to be announced"}</span>}
										{m.status === "live" && <span class="schedule__live">● LIVE</span>}
										{m.status === "completed" && (
											<span class="schedule__status">{m.winner?.displayName ? `${m.winner.displayName} won` : "Completed"}</span>
										)}
										{m.status !== "live" && m.status !== "completed" && <span class="schedule__status">{m.status}</span>}
									</div>
								</li>
							);
						})}
					</ul>
				</section>
			))}
		</div>
	)
}

<style>
	.schedule-empty,
	.schedule__match {
		background: var(--colors-academy-panel);
		border: 1px solid var(--colors-academy-border);
		border-radius: var(--radii-academy-s);
	}

	.schedule-empty {
		max-width: 42rem;
		margin-inline: auto;
		padding: 3rem;
		text-align: center;
	}

	.schedule-empty__title {
		margin: 0;
		font-size: 1.125rem;
		line-height: 1.75rem;
		font-weight: 500;
		color: var(--colors-academy-text-soft);
	}

	.schedule-empty__copy {
		margin: 0.5rem 0 0;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--colors-academy-text-muted);
	}

	.schedule {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.schedule__title {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
		line-height: 1.75rem;
		font-weight: 600;
		color: var(--colors-academy-text);
	}

	.schedule__list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.schedule__match {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1rem;
	}

	.schedule__sides,
	.schedule__meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}

	.schedule__side {
		font-weight: 500;
		color: var(--colors-academy-text);
		overflow-wrap: anywhere;
	}

	.schedule__versus,
	.schedule__status {
		font-size: 0.75rem;
		line-height: 1rem;
	}

	.schedule__versus,
	.schedule__meta {
		color: var(--colors-academy-text-muted);
	}

	.schedule__meta {
		flex-wrap: wrap;
		font-size: 0.875rem;
		line-height: 1.25rem;
	}

	.schedule__live {
		font-weight: 600;
		color: var(--colors-academy-accent);
	}
</style>
