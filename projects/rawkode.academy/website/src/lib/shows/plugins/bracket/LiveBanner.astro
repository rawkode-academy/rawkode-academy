---
import type { BracketMatch } from "./queries";
import { academyLayout } from "@rawkodeacademy/design-system";

interface Props {
	match: BracketMatch | null;
}

const { match } = Astro.props;
const layout = academyLayout({ width: "wide" });
---

{
	match && (
		<div class:list={[layout.notice, "live-banner"]}>
			<div class:list={[layout.container, "live-banner__inner"]}>
				<span class="live-banner__label">● Live now</span>
				<span class="live-banner__match">
					{match.sideA?.displayName ?? "TBD"} vs{" "}
					{match.sideB?.displayName ?? "TBD"}
				</span>
			</div>
		</div>
	)
}

<style>
	.live-banner {
		background: var(--colors-academy-accent);
		color: var(--colors-academy-accent-foreground);
	}

	.live-banner__inner {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-block: 0.5rem;
		font-size: 0.875rem;
	}

	.live-banner__label {
		flex-shrink: 0;
		font-weight: 600;
	}

	.live-banner__match {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
