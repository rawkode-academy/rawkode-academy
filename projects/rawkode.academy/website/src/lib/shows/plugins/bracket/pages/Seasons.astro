---
import type { BracketSeason } from "../queries";
import { isRegistrationOpen } from "../presentation";

interface Props {
	showId: string;
	seasons: BracketSeason[];
}

const { showId, seasons } = Astro.props;
const now = Date.now();

function fmt(iso?: string | null): string {
	if (!iso) return "TBD";
	return new Date(iso).toLocaleDateString("en-GB", {
		weekday: "short",
		day: "numeric",
		month: "short",
		year: "numeric",
		timeZone: "UTC",
	});
}

function fmtRange(season: BracketSeason): string {
	if (!season.startDate && !season.endDate) return "Dates TBD";
	if (season.startDate && season.endDate) {
		return `${fmt(season.startDate)} - ${fmt(season.endDate)}`;
	}
	return season.startDate
		? `Starts ${fmt(season.startDate)}`
		: `Ends ${fmt(season.endDate)}`;
}
---

{
	seasons.length === 0 ? (
		<div class="seasons-empty">
			<p class="seasons-empty__title">No seasons yet</p>
			<p class="seasons-empty__copy">
				No seasons are available for this show.
			</p>
		</div>
	) : (
		<div class="seasons">
			{seasons.map((season) => (
				<section class="season">
					<div class="season__header">
						<div>
							<p class="season__slug">
								{season.slug}
							</p>
							<h2 class="season__name">
								{season.name}
							</h2>
							<p class="season__dates">{fmtRange(season)}</p>
						</div>
						<span class="season__status">
							{season.status}
						</span>
					</div>

					{season.brackets.length > 0 && (
						<div class="season__brackets">
							{season.brackets.map((bracket) => (
								<a
									href={isRegistrationOpen(bracket, now)
										? `/shows/${showId}/apply`
										: `/shows/${showId}/brackets`}
									class="season-bracket"
								>
									<div class="season-bracket__header">
										<div>
											<h3 class="season-bracket__name">
												{bracket.name}
											</h3>
											<p class="season-bracket__kind">
												{bracket.kind === "team"
													? `Team (${bracket.teamSize ?? 4})`
													: "Individual"}
											</p>
										</div>
										<span class="season-bracket__status">
											{bracket.status}
										</span>
									</div>
									<p class="season-bracket__start">
										Start: {fmt(bracket.startsAt)}
									</p>
									<p class="season-bracket__action">
										{isRegistrationOpen(bracket, now) ? "Apply or manage entry" : "View bracket"}
									</p>
								</a>
							))}
						</div>
					)}
				</section>
			))}
		</div>
	)
}

<style>
	.seasons-empty,
	.season {
		background: var(--colors-academy-panel);
		border: 1px solid var(--colors-academy-border);
		border-radius: var(--radii-academy-s);
	}

	.seasons-empty {
		max-width: 42rem;
		margin-inline: auto;
		padding: 3rem;
		text-align: center;
	}

	.seasons-empty__title {
		margin: 0;
		font-size: 1.125rem;
		line-height: 1.75rem;
		font-weight: 500;
		color: var(--colors-academy-text-soft);
	}

	.seasons-empty__copy {
		margin: 0.5rem 0 0;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--colors-academy-text-muted);
	}

	.seasons {
		display: grid;
		gap: 1.25rem;
	}

	.season {
		padding: 1.25rem;
	}

	.season__header,
	.season-bracket__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.season__header {
		flex-wrap: wrap;
	}

	.season__slug {
		margin: 0;
		font-family: var(--fonts-academy-mono);
		font-size: 0.75rem;
		line-height: 1rem;
		color: var(--colors-academy-text-muted);
	}

	.season__name {
		margin: 0.25rem 0 0;
		font-size: 1.5rem;
		line-height: 2rem;
		font-weight: 700;
		color: var(--colors-academy-text);
	}

	.season__dates,
	.season-bracket__kind,
	.season-bracket__start {
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--colors-academy-text-muted);
	}

	.season__dates {
		margin: 0.5rem 0 0;
	}

	.season__status {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--colors-academy-border);
		border-radius: var(--radii-academy-pill);
		font-family: var(--fonts-academy-mono);
		font-size: 0.75rem;
		line-height: 1rem;
		font-weight: 500;
		color: var(--colors-academy-text-muted);
	}

	.season__brackets {
		display: grid;
		gap: 0.75rem;
		margin-top: 1.25rem;
	}

	@media (min-width: 48rem) {
		.season__brackets {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.season-bracket {
		display: block;
		padding: 1rem;
		border: 1px solid var(--colors-academy-border);
		border-radius: var(--radii-academy-s);
		color: inherit;
		text-decoration: none;
		transition: border-color var(--durations-base)
			var(--easings-academy-standard);
	}

	.season-bracket:hover {
		border-color: var(--colors-academy-accent);
	}

	.season-bracket:focus-visible {
		outline: 2px solid var(--colors-academy-accent);
		outline-offset: 2px;
	}

	.season-bracket__name {
		margin: 0;
		font-weight: 600;
		color: var(--colors-academy-text);
	}

	.season-bracket__kind {
		margin: 0.25rem 0 0;
	}

	.season-bracket__status {
		font-size: 0.75rem;
		line-height: 1rem;
		color: var(--colors-academy-text-muted);
	}

	.season-bracket__start {
		margin: 0.75rem 0 0;
	}

	.season-bracket__action {
		margin: 0.75rem 0 0;
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 500;
		color: var(--colors-academy-text);
	}

	@media (prefers-reduced-motion: reduce) {
		.season-bracket {
			transition: none;
		}
	}
</style>
