---
import { academyShell } from "@rawkodeacademy/design-system";
import AcademyHeader from "@/components/shell/AcademyHeader.astro";
import AcademyFooter from "@/components/shell/AcademyFooter.astro";
const styles = academyShell();
---

<div class={styles.root} data-ui-shell="panda-v2">
	<a class={styles.skip} href="#main-content">Skip to main content</a>
	<AcademyHeader />
	<main id="main-content" class={styles.main} tabindex="-1">
		<slot />
	</main>
	<AcademyFooter />
</div>
