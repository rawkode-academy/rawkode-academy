# Names of the Worker secrets the deploy task uploads with `wrangler deploy
# --secrets-file`. Values come from the process environment, which cuenv fills
# from Infisical (/projects/rawkode-academy/platform/youtube-sync). This file holds no secret values.
YOUTUBE_SYNC_CLIENT_ID=${YOUTUBE_SYNC_CLIENT_ID}
YOUTUBE_SYNC_CLIENT_SECRET=${YOUTUBE_SYNC_CLIENT_SECRET}
YOUTUBE_SYNC_REFRESH_TOKEN=${YOUTUBE_SYNC_REFRESH_TOKEN}
SYNC_ADMIN_TOKEN=${SYNC_ADMIN_TOKEN}
