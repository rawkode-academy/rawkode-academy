{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rawkode-academy-youtube-sync",
  "main": "src/main.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "traces": { "enabled": true, "destinations": ["grafana-traces"] },
    "logs": { "enabled": true, "destinations": ["grafana-logs"] }
  },
  "vars": {
    "YOUTUBE_CHANNEL_ID": "UCrber_mFvp_FEF7D9u8PDEA",
    // The site owns these YouTube fields: any of "title", "description", "thumbnail".
    "MANAGED_FIELDS": "title,description,thumbnail",
    // The standing approval for the daily cron: after each plan, queue up to this many
    // changes for writing (0 = plan only). About a day's quota; the commit is the record.
    "AUTO_APPLY_LIMIT": "80",
    // Push a video as soon as the video-updates Worker commits a change to it (queue platform-video-updated).
    "PUSH_ON_UPDATE": "true",
    // Empty: every scheduled broadcast gets a stream (and stream key) of its own, which the operator MCP tool reads through
    // the StreamKeys entrypoint. A stream id here binds every new broadcast to that one reusable stream instead.
    "YOUTUBE_STREAM_ID": ""
  },
  // Converts the site's WebP thumbnails to JPEG for YouTube.
  "images": { "binding": "IMAGES" },
  "d1_databases": [
    { "binding": "DB", "database_name": "platform-youtube-sync", "database_id": "dc6b56d6-d32d-4a22-90f7-6dffdd6edf93", "migrations_dir": "migrations" }
  ],
  // ANALYTICS: write audit events to the Basin lake. VIDEO_CHANNELS: the YouTube
  // IDs the Academy maps to its videos. ACADEMY_API: the GraphQL gateway.
  "services": [
    { "binding": "ANALYTICS", "service": "rawkode-tools-observability-collector" },
    { "binding": "VIDEO_CHANNELS", "service": "platform-video-channels-read-model" },
    { "binding": "ACADEMY_API", "service": "platform-api-gateway" },
    // Creates videos and writes the YouTube id of a new broadcast back (RPC).
    { "binding": "VIDEO_UPDATES", "service": "platform-video-updates", "entrypoint": "VideoUpdates" }
  ],
  // Writes run through a queue, one message per video. Failed messages retry
  // with backoff, then go to the dead-letter queue, which the Worker records
  // and the daily monitor alerts on. One at a time keeps the quota count exact.
  // The deploy creates both queues (see env.cue).
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "platform-youtube-sync" }],
    "consumers": [
      { "queue": "platform-youtube-sync", "max_batch_size": 1, "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 6, "dead_letter_queue": "platform-youtube-sync-dlq" },
      { "queue": "platform-youtube-sync-dlq", "max_batch_size": 10, "max_batch_timeout": 5 },
      // Update events from the video-updates Worker: each becomes a one-video plan and a message on the write queue above.
      { "queue": "platform-video-updated", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "dead_letter_queue": "platform-video-updated-dlq" },
      { "queue": "platform-video-updated-dlq", "max_batch_size": 10, "max_batch_timeout": 5 }
    ]
  },
  // Daily: plan, then queue up to AUTO_APPLY_LIMIT of its changes. apply.json still
  // approves a bigger or targeted run by hand.
  "triggers": { "crons": ["47 9 * * *"] }
}
