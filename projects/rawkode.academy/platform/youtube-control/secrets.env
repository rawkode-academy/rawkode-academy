# Names of the Worker secrets the deploy task uploads with `wrangler deploy
# --secrets-file`. Values come from the process environment, which cuenv fills
# from Infisical (/projects/rawkode-academy/platform/youtube-control). This file holds no secret values.
YOUTUBE_CLIENT_ID=${YOUTUBE_CLIENT_ID}
YOUTUBE_CLIENT_SECRET=${YOUTUBE_CLIENT_SECRET}
YOUTUBE_REFRESH_TOKEN=${YOUTUBE_REFRESH_TOKEN}
BASIN_SQL_TOKEN=${BASIN_SQL_TOKEN}
