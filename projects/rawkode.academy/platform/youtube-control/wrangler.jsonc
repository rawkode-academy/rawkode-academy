{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rawkode-academy-youtube-analytics",
  "main": "src/main.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "traces": { "enabled": true, "destinations": ["grafana-traces"] },
    "logs": { "enabled": true, "destinations": ["grafana-logs"] }
  },
  "vars": {
    "YOUTUBE_CHANNEL_ID": "UCrber_mFvp_FEF7D9u8PDEA"
  },
  // Report rows become CloudEvents in analytics.events_archive
  // (R2 bucket rawkode-analytics) through the observability collector.
  "services": [{ "binding": "ANALYTICS", "service": "rawkode-tools-observability-collector" }],
  // Daily: the last 28 days of reports, after YouTube's overnight processing.
  "triggers": { "crons": ["17 8 * * *"] }
}
