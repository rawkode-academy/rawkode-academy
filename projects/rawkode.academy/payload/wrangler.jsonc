{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rawkode-academy-payload",
  "main": "worker.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "8e77ba09-dc5a-4760-99da-c7b27bf0a059",
      "database_name": "rawkode-academy-payload",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "rawkode-academy-payload",
      "remote": false
    }
  ],
  "workflows": [
    {
      "binding": "MEDIA_WORKFLOW",
      "name": "rawkode-academy-payload-media",
      "class_name": "MediaWorkflow"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rawkode-academy-payload"
    }
  ],
  "vars": {
    "OIDC_ISSUER": "https://id.rawkode.academy",
    "OIDC_CLIENT_ID": "rawkode-academy-preview",
    "OIDC_REDIRECT_URI": "http://127.0.0.1:3100/api/auth/callback",
    "OIDC_STAFF_SUBJECTS": "[]",
    "OIDC_SESSION_TTL_SECONDS": "3600",
    "POC_DEV_LOCAL_AUTH": "false"
  },
  "previews": {
    "workflows": [
      {
        "binding": "MEDIA_WORKFLOW",
        "name": "rawkode-academy-payload-media",
        "class_name": "MediaWorkflow"
      }
    ],
    "services": [
      {
        "binding": "WORKER_SELF_REFERENCE",
        "service": "rawkode-academy-payload"
      }
    ],
    "d1_databases": [
      {
        "binding": "D1",
        "database_id": "dffc7272-ef5e-4d7f-91ac-d85f504ca2ae",
        "database_name": "rawkode-academy-payload-preview"
      }
    ],
    "r2_buckets": [
      {
        "binding": "R2",
        "bucket_name": "rawkode-academy-payload-preview"
      }
    ],
    "vars": {
      "OIDC_ISSUER": "https://id.rawkode.academy",
      "OIDC_CLIENT_ID": "rawkode-academy-preview",
      "OIDC_REDIRECT_URI": "https://admin.rawkode.academy/api/auth/callback",
      "OIDC_STAFF_SUBJECTS": "[]",
      "OIDC_SESSION_TTL_SECONDS": "3600",
      "POC_DEV_LOCAL_AUTH": "false"
    }
  }
}
