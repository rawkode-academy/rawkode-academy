{
  "name": "@rawkodeacademy/payload",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "POC_CLOUDFLARE_ENV_FILE=.runtime/local.vars WRANGLER_LOG_PATH=.runtime/wrangler.log next dev --hostname 127.0.0.1 --port 3100",
    "build": "WRANGLER_LOG_PATH=.runtime/wrangler.log POC_CLI=1 POC_MIGRATION_CHAIN=cuid2 POC_BUILD=1 NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "import": "tsx scripts/import.ts",
    "import:static": "tsx scripts/import-static.ts",
    "import:klustered": "tsx scripts/import-klustered.ts",
    "export:klustered": "tsx scripts/export-klustered.ts",
    "reconcile:static": "tsx scripts/reconcile-static.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/oidc.test.ts tests/content-import.test.ts tests/public-content-bridge.test.ts tests/pr-preview-resources.test.mjs tests/preview-readiness.test.ts tests/media-security.test.ts tests/migrations.test.ts tests/migration-target.test.ts tests/review.test.ts tests/intake.test.ts tests/staff-http.test.ts tests/thumbnails.test.ts tests/review-container.test.ts tests/ingress.test.ts tests/wrangler-config.test.ts tests/admin-config.test.ts tests/admin-importmap.test.ts tests/admin-theme.test.ts tests/remote-target.test.ts tests/reconcile.test.ts tests/revision-grants.test.ts",
    "build:worker": "node scripts/check-review-container-recipe.mjs && tsx scripts/check-importmap.ts && WRANGLER_LOG_PATH=.runtime/wrangler.log opennextjs-cloudflare build",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "deploy:preview-runtime": "node scripts/check-review-container-recipe.mjs && wrangler deploy --config wrangler.preview-runtime.jsonc --secrets-file .dev.vars",
    "preview": "node scripts/preview-local.mjs",
    "setup": "node scripts/setup.mjs",
    "migrate:create": "WRANGLER_LOG_PATH=.runtime/wrangler.log POC_CLI=1 POC_MIGRATION_CHAIN=cuid2 payload migrate:create",
    "migrate": "WRANGLER_LOG_PATH=.runtime/wrangler.log tsx scripts/migrate-production.ts --target=local",
    "migrate:remote": "WRANGLER_LOG_PATH=.runtime/wrangler.log tsx scripts/migrate-production.ts",
    "migrate:preview": "tsx scripts/migrate-preview.ts",
    "migrate:rehearsal": "WRANGLER_LOG_PATH=.runtime/wrangler.log tsx scripts/migrate-production.ts --target=rehearsal",
    "migrate:status": "WRANGLER_LOG_PATH=.runtime/wrangler.log tsx scripts/migrate-status.ts",
    "generate:importmap": "WRANGLER_LOG_PATH=.runtime/wrangler.log POC_CLI=1 POC_MIGRATION_CHAIN=cuid2 payload generate:importmap",
    "check:importmap": "tsx scripts/check-importmap.ts",
    "capture:field-shape": "tsx scripts/capture-field-shape.ts",
    "types:cloudflare": "WRANGLER_LOG_PATH=.runtime/wrangler.log wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "bootstrap": "node scripts/bootstrap.mjs",
    "test:admin": "tsx scripts/test-admin.ts",
    "test:oidc": "node --import tsx --test tests/oidc.test.ts",
    "test:oidc:worker": "node --import tsx scripts/test-oidc-worker.ts",
    "seed:oidc:tests": "POC_CLOUDFLARE_ENV_FILE=.runtime/local.vars WRANGLER_LOG_PATH=.runtime/wrangler.log POC_CLI=1 POC_MIGRATION_CHAIN=cuid2 node --import tsx scripts/seed-oidc-tests.ts",
    "test:container": "node scripts/check-review-container-recipe.mjs && node --test container/runner.test.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "@payloadcms/db-d1-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-mcp": "3.90.2",
    "@payloadcms/storage-r2": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@terrastruct/d2": "0.1.33",
    "graphql": "16.14.2",
    "gray-matter": "4.0.3",
    "next": "16.3.8",
    "oauth4webapi": "3.8.8",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.8.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  }
}
