{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "platform-api-gateway",
	"main": "./src/index.ts",
	"compatibility_date": "2025-04-05",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": false,
	"minify": true,
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.graphql"],
			"fallthrough": true
		}
	],
	"routes": [
		{
			"pattern": "api.rawkode.academy",
			"custom_domain": true
		}
	],
	"observability": {
		"traces": {
			"enabled": true,
			"destinations": ["grafana-traces"]
		},
		"logs": {
			"enabled": true,
			"destinations": ["grafana-logs"]
		}
	},
	"placement": {
		"mode": "smart"
	},
	"workers_dev": true,
	"services": [
		{ "binding": "PEOPLE", "service": "platform-people-read-model" },
		{ "binding": "TECHNOLOGIES", "service": "platform-technologies-read-model" },
		{ "binding": "SHOWS", "service": "platform-shows-read-model" },
		{ "binding": "VIDEOS", "service": "platform-videos-read-model" },
		{ "binding": "VIDEO_GUESTS", "service": "platform-video-guests-read-model" },
		{ "binding": "VIDEO_TECHNOLOGIES", "service": "platform-video-technologies-read-model" },
		{ "binding": "SHOW_HOSTS", "service": "platform-show-hosts-read-model" },
		{ "binding": "EPISODES", "service": "platform-episodes-read-model" },
		{ "binding": "CHAPTERS", "service": "platform-chapters-read-model" },
		{ "binding": "PEOPLE_LINKS", "service": "platform-people-links-read-model" },
		{ "binding": "PEOPLE_BIOGRAPHIES", "service": "platform-people-biographies-read-model" },
		{ "binding": "TRANSCRIPTION_TERMS", "service": "platform-transcription-terms-read-model" },
		{ "binding": "ARTICLES", "service": "platform-articles-read-model" },
		{ "binding": "NEWS", "service": "platform-news-read-model" },
		{ "binding": "CHANGELOG", "service": "platform-changelog-read-model" },
		{ "binding": "ADRS", "service": "platform-adrs-read-model" },
		{ "binding": "TESTIMONIALS", "service": "platform-testimonials-read-model" },
		{ "binding": "COURSES", "service": "platform-courses-read-model" },
		{ "binding": "EMOJI_REACTIONS", "service": "platform-emoji-reactions-read-model" },
		{ "binding": "EMAIL_PREFERENCES", "service": "platform-email-preferences-read-model" },
		{ "binding": "WATCH_HISTORY", "service": "platform-watch-history-read-model" },
		{ "binding": "BRACKETS", "service": "platform-brackets-read-model" },
		{ "binding": "LEADERBOARD", "service": "platform-leaderboard-read-model" },
		{ "binding": "ACHIEVEMENTS", "service": "platform-achievements-read-model" },
		{ "binding": "IDENTITY", "service": "rawkode-academy-identity" }
	]
}
