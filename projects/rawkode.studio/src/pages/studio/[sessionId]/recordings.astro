---
import StudioLayout from "../../../layouts/StudioLayout.astro";
import {
	listStudioRecordings,
	getStudioSession,
	getStudioSessionWatchUrl,
	userCanManageStudioSession,
} from "../../../server/studio";
import { env } from "cloudflare:workers";

if (!Astro.locals.user) {
	return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const sessionId = Astro.params.sessionId ?? "";
const session = await getStudioSession(env, sessionId);
if (!session) {
	return new Response("Studio session not found", { status: 404 });
}
if (!(await userCanManageStudioSession(env, session, Astro.locals.user))) {
	return new Response("Studio session management access is required", {
		status: 403,
	});
}
const readyMarkerKey = `studio/recordings/${sessionId}/<recording-id>/ready.json`;
const recordings = await listStudioRecordings(env, session.id);
const publicVodUrl = getStudioSessionWatchUrl(session);
const localOnly = session.streamEnvironment !== "prod" || !session.contentVideoId;
---

<StudioLayout title={`Recordings ${session.title} | Rawkode Studio`} active="recordings">
	<section class="role-panel">
		<p class="eyebrow">{localOnly ? "Local programme recording" : "Canonical VOD recording"}</p>
		<h1>{session.title}</h1>
		{
			session.streamEnvironment === "test" ? (
				<p>
					Test-mode recordings stay in the browser and download as a local WebM.
					This session cannot create an R2 upload, ready marker, or canonical VOD claim.
				</p>
			) : !session.contentVideoId ? (
				<p>
					Standalone production recordings stay in the browser and download as a
					local WebM. They do not create an R2 upload, ready marker, or canonical VOD claim.
				</p>
			) : (
				<p>
					The first prod recording permanently claims this content video. Its ready
					marker is <code>{readyMarkerKey}</code>; only an exact immutable retry of
					the same recording and source is accepted.
				</p>
			)
		}
		<div class="recording-contract">
			<dl>
				<div>
					<dt>MODE</dt>
					<dd>{localOnly ? "local-only" : "one canonical prod VOD"}</dd>
				</div>
				<div>
					<dt>SESSION_ID</dt>
					<dd>{session.id}</dd>
				</div>
				{
					session.contentVideoId ? (
						<div>
							<dt>VIDEO_ID</dt>
							<dd>{session.contentVideoId}</dd>
						</div>
					) : null
				}
				{
					publicVodUrl ? (
						<div>
							<dt>WATCH_URL</dt>
							<dd><a href={publicVodUrl}>Rawkode watch page</a></dd>
						</div>
					) : null
				}
				{
					!localOnly ? (
						<>
							<div>
								<dt>RECORDING_PREFIX</dt>
								<dd><code>{session.recordingPrefix}</code></dd>
							</div>
							<div>
								<dt>SOURCE_KEY</dt>
								<dd>private R2 recording object path</dd>
							</div>
							<div>
								<dt>OUTPUT_PREFIX</dt>
								<dd><code>videos/&lt;VIDEO_ID&gt;/</code></dd>
							</div>
						</>
					) : null
				}
			</dl>
		</div>
	</section>

	<section class="recording-list" aria-label="Studio recording handoffs">
		{
			recordings.length === 0 ? (
				<p class="recording-empty">
					{localOnly
						? "Local-only recordings stay in the browser and do not appear in this handoff list."
						: "This content video has not claimed its canonical Studio recording yet."}
				</p>
			) : (
				recordings.map((recording) => (
					<article class="recording-row">
						<div>
							<p class="eyebrow">{recording.status}</p>
							<h2>{recording.recordingId}</h2>
							<p>
								<code>{recording.readyMarkerKey}</code>
							</p>
						</div>
						<dl>
							<div>
								<dt>Output</dt>
								<dd>
									<code>{recording.outputPrefix}</code>
								</dd>
							</div>
							<div>
								<dt>Transcode</dt>
								<dd>
									{recording.transcode?.status ?? "waiting"}
									{recording.transcode?.streamUrl ? (
										<>
											{" "}
											<a href={recording.transcode.streamUrl}>stream</a>
										</>
									) : null}
									{publicVodUrl && recording.status === "vod-ready" ? (
										<>
											{" "}
											<a href={publicVodUrl}>watch</a>
										</>
									) : null}
								</dd>
							</div>
							<div>
								<dt>Handoff</dt>
								<dd>{recording.handoffStatus}</dd>
							</div>
							<div>
								<dt>Updated</dt>
								<dd>{new Date(recording.updatedAt * 1000).toLocaleString()}</dd>
							</div>
						</dl>
					</article>
				))
			)
		}
	</section>
</StudioLayout>
