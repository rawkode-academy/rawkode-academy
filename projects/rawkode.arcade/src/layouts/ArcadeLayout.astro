---
import "@/styles/global.css";
import ArcadeHeader from "@/components/ArcadeHeader.astro";
import { arcadeShell } from "@/styles/arcade";
const { title = "Rawkode Arcade", active = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#080d1d" />
		<meta name="description" content="Live technical game shows for developers." />
		<title>{title}</title>
	</head>
	<body>
		<ArcadeHeader active={active} />
		<main class={arcadeShell}><slot /></main>
		<footer>RAWKODE ARCADE <span>•</span> Built for the live stream <span>•</span> © {new Date().getFullYear()}</footer>
	</body>
</html>
<style is:global>
	main { min-height: calc(100vh - 136px); }
	footer { border-top: 1px solid var(--line); color: var(--mist); font-family: "IBM Plex Mono", monospace; font-size: .68rem; letter-spacing: .08em; margin: 4rem auto 0; max-width: 1440px; padding: 1.5rem 2rem; text-align: center; }
	footer span { color: var(--cyan); padding: 0 .45rem; }
</style>
