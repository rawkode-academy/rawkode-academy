---
import ArcadeLayout from "@/layouts/ArcadeLayout.astro";
---
<ArcadeLayout title="Lobby — Rawkode Arcade">
	<section class="lobby"><div class="room-code"><span>Room code</span><b>SHIPIT</b><small>Share this code with players</small></div><div class="waiting"><p class="eyebrow"><i></i> Lobby open</p><h1>We’re getting the gang <em>back together.</em></h1><p>The host starts when every team is ready. Keep this screen open; your room will begin automatically.</p><div class="people"><span>SK</span><span>MD</span><span>RD</span><span>+1,281</span></div><a href="/audience">I’m ready <span>→</span></a></div></section>
</ArcadeLayout>
<style>
.lobby { align-items: center; display: grid; gap: clamp(2rem, 10vw, 10rem); grid-template-columns: minmax(280px, .85fr) 1.2fr; margin: auto; max-width: 1050px; min-height: calc(100vh - 180px); padding: 3rem 2rem; }.room-code { background: linear-gradient(145deg, rgb(24 38 74 / 90%), rgb(16 26 53 / 90%)); border: 1px solid rgb(77 232 255 / 35%); border-radius: 18px; box-shadow: var(--shadow); display: grid; gap: .7rem; padding: 1.5rem; text-align: center; }.room-code span, .eyebrow { color: var(--cyan); font-family: "IBM Plex Mono", monospace; font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; }.room-code b { font-family: "IBM Plex Mono", monospace; font-size: clamp(2.8rem, 7vw, 5rem); letter-spacing: .09em; }.room-code small { color: var(--mist); font-size: .7rem; }.waiting h1 { font-family: "Space Grotesk", sans-serif; font-size: clamp(2.8rem, 6vw, 5rem); letter-spacing: -.09em; line-height: .86; margin: .9rem 0 1.1rem; max-width: 9ch; }.waiting h1 em { color: var(--cyan); font-style: normal; }.waiting > p:not(.eyebrow) { color: var(--mist); line-height: 1.65; max-width: 45ch; }.eyebrow i { background: var(--lime); border-radius: 50%; display: inline-block; height: 8px; margin-right: .45rem; width: 8px; }.people { display: flex; margin: 1.7rem 0; }.people span { align-items: center; background: linear-gradient(135deg, var(--violet), var(--cyan)); border: 2px solid var(--ink); border-radius: 50%; color: var(--ink); display: flex; font-family: "IBM Plex Mono", monospace; font-size: .65rem; font-weight: 700; height: 40px; justify-content: center; margin-right: -8px; width: 40px; }.people span:last-child { background: var(--panel-raised); color: var(--cloud); width: 58px; }.waiting a { background: var(--cyan); border-radius: 8px; color: var(--ink); display: inline-block; font-size: .85rem; font-weight: 800; padding: .75rem .9rem; }@media (max-width: 720px) { .lobby { grid-template-columns: 1fr; min-height: auto; padding: 3rem 1rem; }.room-code { order: 2; } }
</style>
