---
import ArcadeLayout from "@/layouts/ArcadeLayout.astro";
---
<ArcadeLayout title="Leaderboards — Rawkode Arcade" active="leaderboard">
	<section class="board"><p>VERIFIED RESULTS</p><h1>Every scoreboard belongs to a <em>real room.</em></h1><p>Open the result link emitted when a host completes a game to read the freshly projected leaderboard.</p><a href="/leaderboards">View a room result</a></section>
</ArcadeLayout>
<style>.board { margin: auto; max-width: 850px; padding: 5rem 2rem; }.board > p:first-child { color: var(--cyan); font-family: "IBM Plex Mono", monospace; font-size: .65rem; letter-spacing: .1em; }.board h1 { font-family: "Space Grotesk", sans-serif; font-size: clamp(3rem, 7vw, 5.5rem); letter-spacing: -.08em; line-height: .86; }.board em { color: var(--cyan); font-style: normal; }.board > p:last-of-type { color: var(--mist); line-height: 1.6; max-width: 52ch; }.board a { background: var(--cyan); border-radius: 8px; color: var(--ink); display: inline-block; font-weight: 800; margin-top: 1.2rem; padding: .75rem 1rem; }</style>
