---
import ArcadeLayout from "@/layouts/ArcadeLayout.astro";
import JoinRoomForm from "@/components/JoinRoomForm.vue";
import { css } from "@/../styled-system/css";
import { control, shell, slug, text } from "@/styles/arcade";

const joinPage = css({ display: "grid", gridTemplateColumns: { base: "1fr", md: "1fr auto" }, gap: "sectionTight", py: "section" });
const intro = css({ display: "grid", alignContent: "start", justifyItems: "start", gap: "4", maxW: "measure" });
---

<ArcadeLayout title="Join the live audience: Rawkode Live">
	<section class:list={[shell, joinPage]}>
		<div class={intro}>
			<p class={slug({ tone: "crowd" })}>Live show participation</p>
			<h1 class={text({ style: "headline" })}>Join when invited.</h1>
			<p class={text({ tone: "soft" })}>The producer opens participation during selected live shows. Use the code shared on air, or return to the live stream to watch.</p>
			<a class={control({ tone: "quiet" })} href="/">Watch the show</a>
		</div>
		<JoinRoomForm client:load />
	</section>
</ArcadeLayout>
