{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"types": ["@cloudflare/workers-types", "bun"],
		"lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
		"baseUrl": ".",
		"paths": { "@/*": ["src/*"] },
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "astro.config.mts"]
}
