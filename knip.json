{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "knip.json",
        "devenv.yaml",
        "devenv.nix",
        "env.cue",
        "presentations/cloud-native-2.0/demo/set_url/{webpack.config,src/index}.js"
      ]
    },
    "projects/rawkode.academy/website": {
      "entry": [
        "scripts/*.ts",
        "src/live.config.ts",
        "src/lib/live-content/render/shiki-*.ts",
        "public/notification-service-worker.js"
      ],
      "ignore": [
        "src/webcontainer-demos/**"
      ],
      "playwright": {
        "config": ["visual/playwright.config.ts"],
        "entry": ["visual/**/*.visual.ts", "visual/serve.ts"]
      }
    },
    "projects/rawkode.academy/platform/*": {
      "entry": [
        "{read-model,write-model,http,rpc}/main.ts",
        "read-model/publish.ts",
        "drizzle.config.ts",
        "scripts/*.ts"
      ]
    },
    "projects/rawkode.academy/games/secrets-of-kubernetes/*": {
      "entry": ["http/main.ts", "drizzle.config.ts"]
    },
    "projects/rawkode.arcade": {
      "bun": false,
      "entry": [
        "{src,tests}/**/*.test.ts",
        "scripts/load-rehearsal.ts",
        "src/testing/worker-entry.ts"
      ],
      "playwright": {
        "config": ["e2e/playwright.config.ts"]
      },
      "postcss": true
    },
    "projects/klustered.dev": {
      "ignoreDependencies": ["@unocss/reset"]
    },
    "projects/rawkode.academy/content": {
      "entry": ["http/main.ts"]
    },
    "projects/rawkode.academy/identity": {
      "entry": ["src/lib/auth.config.ts"]
    },
    "projects/rawkode.tools/observability-collector": {
      "entry": ["basin/reconcile.ts"]
    }
  },
  "astro": true,
  "vitest": true,
  "storybook": true,
  "graphql-codegen": true,
  "typescript": true,
  "ignoreDependencies": ["wrangler"],
  "ignore": [
    ".claude/**",
    ".github/skills/**",
    "extensions/**",
    "packages/rich-text/tests/fixtures/**",
    "projects/rawkode.academy/platform/youtube-to-structured-json/**",
    "projects/rawkode.academy/platform/zitadel-zulip-connector/src/zitadel/actions/**",
    "projects/rawkode.academy/tasks/content-cutover/**",
    "projects/rawkode.academy/tasks/mp3-extraction-job/**",
    "projects/rawkode.academy/tasks/transcoding-job/**",
    "projects/rocko/**"
  ]
}
